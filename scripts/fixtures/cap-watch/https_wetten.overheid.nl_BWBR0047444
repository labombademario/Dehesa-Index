                                          <ul role="list" aria-label="Lijst met mogelijke acties voor Artikel 2. Bevoegdheden minister.">
                                             <li role="listitem" aria-label="Actie: Toon relaties in LiDO." class="action--relations aantallen-lido-onbekend visually-hidden" data-bwbngid="http://wetten.overheid.nl/id/BWBR0047444/2026-07-11/0/Hoofdstuk2/Paragraaf1/Artikel2"><a href="/jci1.3:c:BWBR0047444&amp;hoofdstuk=2&amp;paragraaf=1&amp;artikel=2&amp;z=2026-07-11&amp;g=2026-07-11" class="popuplidorelaties" data-juriconnectverwijzing="jci1.3:c:BWBR0047444&amp;hoofdstuk=2&amp;paragraaf=1&amp;artikel=2&amp;z=2026-07-11&amp;g=2026-07-11" data-decorator="init-modal" data-handler="open-modal" data-modal="popuplidorelaties"><span>Toon relaties in LiDO</span></a></li>

	</item>
<item>
		<title>Novas oportunidades de financiamento LEADER</title>
		<link>https://pepacc.pt/novas-oportunidades-de-financiamento-leader/</link>
		
		<dc:creator><![CDATA[Paula Pinheiro]]></dc:creator>
		<pubDate>Wed, 23 Sep 2026 13:34:51 +0000</pubDate>
				<category><![CDATA[Sem categoria]]></category>
		<guid isPermaLink="false">https://pepacc.pt/?p=13925</guid>

					<description><![CDATA[Já estão disponíveis novas oportunidades de financiamento LEADER: Apoio à promoção da inovação, comercialização de produtos agrícolas, desenvolvimento de cadeias curtas e dinamização de mercados locais. Promovida pelos Grupos de Ação Local (GAL), enquadrada pelas Estratégias de Desenvolvimento Local de Base Comunitária (DLBC), e estruturada em três componentes de apoio complementares, esta nova medida de [&#8230;]]]></description>
										
					
		
		<enclosure url="https://pepacc.pt/wp-content/uploads/2026/09/1o-aviso-D.1.1.1.4-GAL-ABERTURA-DE-CANDIDATURAS-Post-para-Instagram-45.mp4" length="30010786" type="video/mp4" />

		<media:content url="https://pepacc.pt/wp-content/uploads/2026/09/1o-aviso-D.1.1.1.4-GAL-ABERTURA-DE-CANDIDATURAS-Post-para-Instagram-45.mp4" medium="video" width="858" height="1072">
			<media:player url="https://pepacc.pt/wp-content/uploads/2026/09/1o-aviso-D.1.1.1.4-GAL-ABERTURA-DE-CANDIDATURAS-Post-para-Instagram-45.mp4" />
			<media:title type="plain">Novas oportunidades de financiamento LEADER - PEPAC no Continente</media:title>
			<media:description type="html"><![CDATA[Já estão disponíveis novas oportunidades de financiamento LEADER: Apoio à promoção da inovação, comercialização de produtos agrícolas, desenvolvimento de cadeias curtas e dinamização de mercados locais.]]></media:description>
			<media:thumbnail url="https://pepacc.pt/wp-content/uploads/2025/05/Intervencoes-LEADER-D.1.1.1.4.png" />

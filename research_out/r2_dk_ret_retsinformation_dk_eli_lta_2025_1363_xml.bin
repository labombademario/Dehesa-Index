    <Ref_Af REFid="change_1">2026-09-14</Ref_Af>
    <Ref_Text REFid="change_1">Bekendtgørelse om ændring af bekendtgørelse om grundbetaling m.v. til landbrugere for 2026</Ref_Text>
    <Republished>Nej</Republished>
    <Sign id="sign" />
    <Signature REFid="sign">Lars Gregersen</Signature>
    <Sub-Sign id="subsign" />
    <Signature REFid="subsign">Nina Aksig Nørland</Signature>
    <PlaceOfSignature>Styrelsen for Grøn Arealomlægning og vandmiljø</PlaceOfSignature>
    <JournalNumber>25-11-000026</JournalNumber>
    <Ministry>Ministeriet for Natur og Dyrevelfærd</Ministry>
    <AdministrativeAuthority>Styrelsen for Grøn Arealomlægning og Vandmiljø</AdministrativeAuthority>
  </Meta>
  <TitelGruppe id="id37541595-3fc1-4bd7-b896-265c6703d4ee">
    <Titel id="id0da6ef09-5d7d-42e5-9bb3-3bb813cf5414">
      <Linea>
        <Char>Bekendtgørelse om grundbetaling m.v. til landbrugere for 2026</Char>
      </Linea>
    </Titel>
  </TitelGruppe>
  <DokumentIndhold id="idc5e97607-2664-467d-9a00-e4edc96b5735">
    <Indledning id="idbdaf8f99-97cc-4c05-b984-a8b62a49caa1">
      <Exitus>
        <Linea>
          <Char>I medfør af § 2, stk. 1, 2 og 4, § 4, § 13, stk. 1, og § 19, stk. 1 og 2, i lov nr. 407 af 25. april 2023 om administration af den fælles landbrugspolitik m.v. fastsættes efter bemyndigelse:</Char>
        </Linea>
      </Exitus>
    </Indledning>
    <Afsnit id="id4a51414c-5358-41b6-9c3f-440cfb8ead42" localId="1">
      <Kapitel id="idab5711a3-ca10-4b20-953d-235380526f73" localId="1">
        <Explicatus>Kapitel 1</Explicatus>
        <Rubrica id="idb0bba719-2df5-4f71-bd2b-0673d3ad66e3">
          <Linea>
            <Char>Bekendtgørelsens anvendelsesområde</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idccd5b3b6-1586-4520-86c0-84d7b88df06c" localId="1">
            <Explicatus>§ 1.</Explicatus>
            <Stk id="id6d417835-c64e-420e-ad5a-997c1cc80dd0">
              <Exitus>
                <Linea>
                  <Char>Inden for rammerne af den fælles landbrugspolitik kan der ydes tilskud i form af grundbetaling efter reglerne i artikel 21 og 22 i Europa-Parlamentets og Rådets forordning (EU) 2021/2115 om grundlæggende indkomststøtte med henblik på bæredygtighed.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id87672eff-62b0-4cdb-8862-a8dffba1dd4e" localId="2">
            <Explicatus>§ 2.</Explicatus>
            <Stk id="id587ffe38-ba1a-4a34-8ebe-258cb806ffeb">
              <Exitus>
                <Linea>
                  <Char>Der kan desuden ydes tilskud til arealer, der dyrkes med en stivelseskartoffelsort på bedriftens omdriftsarealer.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id5664cdd5-e5bc-42c7-986f-06ab1e230e7a" localId="3">
            <Explicatus>§ 3.</Explicatus>
            <Stk id="id51a12478-be9b-4ab0-bf00-d16750c79539">
              <Exitus>
                <Linea>
                  <Char>Der kan derudover ydes tilskud til de af bedriftens arealer, som ligger på visse øer.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id74a52db6-1365-4583-be53-ea28af3975d8">
            <Linea>
              <Char>Definitioner</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="ide1c11369-0f55-495a-8085-72686582aa42" localId="4">
            <Explicatus>§ 4.</Explicatus>
            <Stk id="id13c4ff70-9d51-4878-b4ac-c7e65d5ddc5d">
              <Exitus>
                <Linea>
                  <Char>I denne bekendtgørelse forstås ved:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idba293222-cbfa-477e-9ce7-3238acd40c01">
                <Index>
                  <Indentatio id="idade2d5ab-0a7c-43de-96b5-f033529d5b94" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøgt areal: Det areal, der søges om tilskud til under en tilskudsordning.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id82ac9822-02ba-41cf-bb35-5d27a9de9201" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Braklagt areal: Omdriftsareal uden produktion af afgrøder eller afgræsning, som opretholdes i en stand, der gør det egnet til landbrugsproduktion uden forberedende foranstaltninger udover brug af de sædvanlige landbrugsmetoder og -maskiner.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idca2c65e3-1170-40ed-8c73-efc7d27db9b5" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Forpligtelser: De forpligtelser, der gælder for ansøger til at udføre eller undlade en handling efter den ansøgte tilskudsordning.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id00be34fe-8e9d-4121-9add-37de3d41cc81" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>GLM: Minimumsstandarder for god landbrugs- og miljømæssig stand som omhandlet i artikel 13 i forordning (EU) 2021/2115 og §§ 4-21 i bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id620aa17a-cb02-47f7-89db-ec74f4629796" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Godkendt, ansøgt areal: Den del af det ansøgte areal, hvor kriterierne for tilskudsberettigelse er opfyldt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id283cf254-61af-4e11-86f5-c0f3badfe02d" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Kriterier for tilskudsberettigelse: De kriterier, der skal opfyldes for at kunne få tilskud efter den ansøgte tilskudsordning.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5b6c0a3e-f93f-4d57-9dcb-983dc5ec83f0" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Landbrugsareal: Omdriftsareal, herunder braklagt areal, areal med permanente afgrøder og permanente græsarealer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ida949b121-6a70-42d9-884b-5f8de4ed9607" formaInd="Nummer">
                    <Explicatus>8)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Markblok: En geografisk sammenhængende enhed af arealer, der har varige ydre afgrænsninger, og som i korttemaet ”Markblokke 2026” og tilhørende korttemaer i Ministeriet for Grøn Treparts Internet Markkort indeholder registrerede oplysninger om arealernes karakter og de maksimale tilskudsberettigede hektar.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2b587da7-d9b1-4578-a117-b45eb91758cc" formaInd="Nummer">
                    <Explicatus>9)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Omdriftsareal: Areal med produktion af afgrøder, der ikke anses som permanente afgrøder eller permanent græs, eller arealer, der er til rådighed for produktion af afgrøder, men som ligger brak.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5025bd3f-df01-49c9-9546-0a11ad425642" formaInd="Nummer">
                    <Explicatus>10)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Overtrådt areal: Den del af det godkendte, ansøgte areal, hvor en eller flere forpligtelser ikke er opfyldt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id48781272-2472-41c6-a21f-2d61f15c28c4" formaInd="Nummer">
                    <Explicatus>11)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Permanente afgrøder: Afgrøder, der holdes ude af omdriften, bortset fra permanent græs, og som dyrkes på arealerne i 5 år eller mere og giver udbytte i flere år.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="iddb1ce0c0-b36c-495e-b5aa-98db818c37ae" formaInd="Nummer">
                    <Explicatus>12)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Permanent græs: Arealer, der dyrkes med græs eller andet grøntfoder, og som er holdt uden for omdriften i 5 år eller mere.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2a56ca8d-db23-4d35-81f3-405e864e5b21" formaInd="Nummer">
                    <Explicatus>13)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Planteskole: Virksomhed, der på friland producerer planter beregnet til videresalg, herunder også vedplanter.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id4c4f62a0-cf19-4147-b839-a13e54275a3c" formaInd="Nummer">
                    <Explicatus>14)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Sanktionsfaktor: Den faktor, som det overtrådte areal ganges med for at fastlægge sanktionen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idfb37f4ce-2166-46f2-ab3c-a448b437678b" formaInd="Nummer">
                    <Explicatus>15)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Småbiotop: Små arealer, der kan friholdes for landbrugsaktiviteter, og som med tilgroning, tilplantning eller vådgøring kan adskille sig i deres karakter fra de omkringliggende landbrugsjorder.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id72614aa7-c769-434e-ae59-ad768bb4d78a" formaInd="Nummer">
                    <Explicatus>16)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Styrelsen: Styrelsen for Grøn Arealomlægning og Vandmiljø.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc9ab0c18-2bf9-4b4a-9a0e-721035b7e4c8" formaInd="Nummer">
                    <Explicatus>17)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud til pleje af græs- og naturarealer: Tilsagn givet under tilskudsordningerne tilskud til pleje af græs- og naturarealer efter reglerne i artikel 28 i Europa-Parlamentets og Rådets forordning (EU) nr. 1305/2013 eller artikel 70 i Europa-Parlamentets og Rådets forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id696ab622-eba3-46fd-a51e-533408b2b2d7" formaInd="Nummer">
                    <Explicatus>18)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskudsberettigede arealer: Arealer, hvor kriterier og forpligtelser er opfyldte.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id2420586c-c154-4d6b-b412-c264edce1806" localId="2">
        <Explicatus>Kapitel 2</Explicatus>
        <Rubrica id="id68d38b8a-660e-4742-9d24-26841f80d243">
          <Linea>
            <Char>Ansøgning m.v.</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id4d5fee2d-924a-4d13-9c60-462203b26216" localId="5">
            <Explicatus>§ 5.</Explicatus>
            <Stk id="id95fcd970-c16f-4e74-965f-fa635beb93ac">
              <Exitus>
                <Linea>
                  <Char>Ansøgning om tilskud skal ske i henhold til §§ 3-9, § 14, stk. 1, 2 og 4, og § 15, § 16, stk. 1 og § 17 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id1f0ddd53-9177-46c9-8710-e6db37c62084" localId="6">
            <Explicatus>§ 6.</Explicatus>
            <Stk id="idbedd5a5a-17a1-4f35-b52c-cbf3f32d5dec">
              <Exitus>
                <Linea>
                  <Char>Der kan ydes tilskud til landbrugsarealer.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idfdf015c6-5620-4df4-90fc-be5625e8888a">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Der kan desuden ydes  tilskud til ethvert af bedriftens arealer, der er dækket af landskabstræk i form af GLM søer og fortidsminder i henhold til bevarelseskravet i GLM – norm 8, eller arealer, som opfylder forpligtelser i bio-ordningen midlertidig ekstensivering samt arealer med andre landskabstræk i form af småbiotoper, jf. § 22, og markkrat, jf. § 26.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id3719ba1f-9c56-480c-9ae0-81cea9e93300">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Arealer, der indgår som en del af en bio-ordning, kan blive berettiget til tilskud efter grundbetalingsordningen, uanset om forpligtelsen under en bio-ordning medfører, at arealet ikke udgør et landbrugsareal, der anvendes til produktion eller i øvrigt ikke kan opretholdes i en landbrugsmæssig stand.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ide679605e-21e6-4164-8074-01fa6aee4647">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Der kan herudover ydes tilskud til arealer, der er omfattet af foranstaltninger som led i gennemførelsen af mindst et af følgende:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id6a37e7c1-a521-4629-aeaa-8469f1ff2c89">
                <Index>
                  <Indentatio id="idec99041e-e5a7-45a9-8f82-06720e677b2e" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Habitatdirektivet (Rådets direktiv 92/43/EØF af 21. maj 1992 om bevaring af naturtyper samt vilde dyr og planter – Natura 2000).</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id845902b8-ab36-4a8e-a953-3044cce9feb6" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Vandrammedirektivet (Europa-Parlamentets og Rådets direktiv 2000/60/EF af 23. oktober 2000 om fastlæggelse af en ramme for Fællesskabets vandpolitiske foranstaltninger).</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide3911f92-fdf1-4a44-a7c1-1f53d001c392" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Fuglebeskyttelsesdirektivet (Europa-Parlamentets og Rådets direktiv 2009/147/EF af 30. november 2009 om beskyttelse af vilde fugle – Natura 2000).</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd3478eb0-f695-4205-ad93-e8a30e9e10e3" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilsagnsordninger, der omhandler</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="ide915f5e1-b4c9-46eb-a313-362766998209">
                      <Index>
                        <Indentatio id="id7f59237c-0726-42cc-929d-b45db4916148" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>tilsagn om skovtilplantning, hvor tilsagnsforpligtelserne fortsat er gældende, eller</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="ida972ec05-f918-491c-8889-d3b27ffb63b5" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>tilsagn med miljøvenligt landbrug som formål, hvor tilsagnsforpligtelserne fortsat er gældende.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id99a55b76-7d8d-427f-a232-fc2ca80476bd" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Nationale ordninger for reduktion af drivhusgasudledning, der bidrager til målsætningerne i artikel 6, stk. 1, litra d), i Europa-Parlamentets og Rådets forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id479d5cd1-751b-4328-8771-0e4ac70f5806">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at være omfattet af stk. 4, at arealet har været tilskudsberettiget under grundbetalingsordningen og har været omfattet af en ansøgning om direkte arealstøtte efter Europa-Parlamentets og Rådets forordning (EU) nr. 1307/2013 eller er omfattet af Europa-Parlamentets og Rådets forordning (EU) 2021/2115.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id3ee8c586-1e89-41ea-a121-2b4a8d76f52f">
              <Explicatus>Stk. 6.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at være omfattet af stk. 4, at ansøger har angivet arealet som omfattet af artikel 4, stk. 4, litra c), i Europa-Parlamentets og Rådets forordning (EU) 2021/2115, senest på tidspunktet for indgivelse af ændring af fællesskemaet, jf. § 6 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, og hvis foranstaltningerne som nævnt i stk. 4, ikke tidligere er vurderet som medvirkende til gennemførelsen af stk. 4, nr. 1-3, at ansøger senest på samme frist har vedlagt en erklæring herom til fællesskemaet.</Char>
                </Linea>
                <Linea>
                  <Char>Det er endvidere et kriterie, at erklæringen indgives på et særligt skema, der tilgås via styrelsens hjemmeside eller kan fås ved henvendelse til styrelsen.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id8f498f26-d72b-4f33-b114-af99f1c244dd">
              <Explicatus>Stk. 7.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Et areal, der ikke er angivet som omfattet af artikel 4, stk. 4, litra c, i Europa-Parlamentets og Rådets forordning (EU) 2021/2115 i fællesskemaet, kan anerkendes til direkte betalinger i det år, foranstaltningen igangsættes, hvis arbejdet i forbindelse med foranstaltningen efter stk. 4 er iværksat på et landbrugsareal efter ændringsfristen for fællesskema, jf. § 6 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id1e4e49dc-6d25-49f6-b364-d2740b9342b7" localId="7">
            <Explicatus>§ 7.</Explicatus>
            <Stk id="idcf84013e-e058-4640-8da2-2e0f92dd5b80">
              <Exitus>
                <Linea>
                  <Char>Følgende omdriftsarealer fastholdes som omdriftsarealer:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idc45e6974-4ee6-4770-bfb4-6128db0044de">
                <Index>
                  <Indentatio id="id6f7808c5-128b-41ce-858e-dccfbdf682b0" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer indberettet som brak under bio-ordningen midlertidig ekstensivering.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id0fdcf681-ecf2-431c-b6d7-7ccceb5c6887" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer indberettet under pleje af græs- og naturarealer – Natura 2000 eller til fastholdelse af vådområder og lavbundsprojekter eller under permanent ekstensivering i medfør af artikel 28 i Europa-Parlamentets og Rådets forordning (EU) nr. 1305/2013 og artikel 70 i medfør af Europa-Parlamentets og Rådets forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id10c858b1-2833-4836-a4c6-4001d02faddd" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der indgår i betingelser i medfør af artikel 22, 23 og 24 i Rådets forordning (EF) nr. 1257/1999.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id830b09e5-f570-4acc-9f4f-7e0c22bc0170" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der indgår i betingelser i medfør af artikel 39 i Rådets forordning (EF) nr. 1698/2005.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id29b5c4fb-5026-4d88-abd1-ecaf91c35c07">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger kan få registreret omdriftsarealer omfattet af stk. 1, nr. 2-4 som permanent græs, hvis ansøger indsender dokumentation for, at arealet opfylder definitionen af permanent græs, jf. § 4, nr. 12, inden tilsagnet, jf. stk. 1, nr. 2-4, blev indgået.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id4a9a7d90-5b5f-4d3d-8d9e-dd269712adcc">
            <Linea>
              <Char>Fælles kriterier for tilskudsberettigelse</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id7a7f4933-777d-4934-a3d8-8dbc944d9b3b" localId="8">
            <Explicatus>§ 8.</Explicatus>
            <Stk id="id9ea0d0ef-c038-4a08-aba2-c572e30dee8b">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud, at ansøger råder over de arealer, der indgår i ansøgningen om tilskud, og at disse er tilknyttet ansøgers bedrift på tidspunktet for ansøgningsfristen for fællesskemaet, der fremgår af § 3 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id2a6f9c03-15b2-46f4-b19e-3eddbee844df" localId="9">
            <Explicatus>§ 9.</Explicatus>
            <Stk id="idd72e59ad-5e07-4b40-8905-84e8320fb78f">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud, at ansøger i kalenderåret er aktiv landbruger, jf. dog stk. 2.</Char>
                </Linea>
                <Linea>
                  <Char>Ansøger er aktiv landbruger, hvis mindst ét af følgende kriterier er opfyldt:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id3cecae2a-ee9e-48e7-8e27-312981ac58e3">
                <Index>
                  <Indentatio id="idaa763ed1-7785-4eb4-bf57-cc71e09e74f3" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger godkendes til tilskud for et areal på mindst 40 tilskudsberettigede hektar i kalenderåret.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idaf9ccc28-0849-4d6f-b462-3cae5f14896e" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger modtog direkte betalinger i 2025, der var højst 5.000 EUR.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id62e93ad6-79e1-426a-ad4b-eed499f67564" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger er tilmeldt Register for Gødningsregnskab, eller ansøgers bedrift er certificeret til økologisk jordbrugsproduktion eller omfattet af ansøgning herom senest ved fristen for indgivelse af ansøgning om direkte betaling, jf. § 3 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ideef14b2c-2253-4148-b2f5-684b1b3585d4" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger råder over hektar omfattet af artikel 4, stk. 4, litra c), i Europa-Parlamentets og Rådets forordning (EU) 2021/2115 og har minimum 0,30 hektar, hvor der udføres en landbrugsaktivitet.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id34bc21f1-3b23-46bc-96e0-ac13764e5419" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>En ny ansøger, der ikke er omfattet af kriterierne i nr. 1, 2, 3 eller 4, kan få status som aktiv landbruger ved at erklære, at den pågældende hverken personligt, gennem en juridisk enhed, hvor den pågældende er ejer eller gennem sine ejere, har modtaget landbrugsstøtte i form af direkte betalinger de seneste tre ansøgningsår.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id6092547c-5fcb-4b4a-8e18-c58f3cc19c60">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>En ansøger, hvis arealer samtidigt er omfattet af tilsagn om tilskud til pleje af græs- og naturarealer, anses som aktiv landbruger, når der leves op til plejeforpligtelsen i tilsagnet.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idf469e61f-908e-4bb0-bac4-fdfe4d878a57">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>En ansøger, der er tilmeldt Register for Gødningsregnskab eller certificeret til økologisk jordbrugsproduktion, jf. stk. 1, nr. 3, er, uanset en overdragelse af ansøgerens bedrift eller en ændring af ansøgers CVR-nummer efter fristen for indgivelse af ansøgning, jf. § 3 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, aktiv landbruger, hvis erhververen fra overdragelsesdagen tilmeldes Register for Gødningsregnskab eller søger om certificering til økologisk jordbrugsproduktion senest samtidig med overdragelsen og overholder kriterier og forpligtelser forbundet med den ansøgte tilskudsordning.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id9fd68dc3-f302-4473-b6e7-0161d641355c">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>En erhverver af en bedrift, jf. stk. 3, skal for at få status som aktiv landbruger tilmelde sig Register for Gødningsregnskab fra overdragelsesdagen eller søge om certificering til økologisk jordbrugsproduktion senest samtidig med overdragelsen.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id84a4f4b9-cb17-4166-8848-1a606e8f987a" localId="10">
            <Explicatus>§ 10.</Explicatus>
            <Stk id="idb35db91d-4930-42fa-a5d4-02a574f913ba">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud, at det samlede godkendte, ansøgte areal udgør mindst 2,00 hektar, eller at tilskuddet i form af ko- eller slagtepræmie udgør mindst 300 EUR, jf. bekendtgørelse om ko- og slagtepræmie.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id2dea70f6-7880-4833-a8c5-c5fa34ff9a89" localId="11">
            <Explicatus>§ 11.</Explicatus>
            <Stk id="idacb22ebb-a395-4851-80bf-5fd2a699e17e">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud, at det godkendte, ansøgte areal, udgør et sammenhængende areal på mindst 0,30 hektar, jf. dog stk. 2.</Char>
                </Linea>
                <Linea>
                  <Char>Arealer betragtes som sammenhængende, hvis de ligger i samme markblok og er forbundet af en passage, som udgør et godkendt, ansøgt areal, der er mindst 5 meter bredt.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id73fe21ac-9b28-4b2e-8c56-338c8ae72c27">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Kriteriet i stk. 1 om et mindsteareal på 0,30 hektar gælder ikke arealer i væksthuse.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id93103d92-df4e-42c9-b0b0-21136bc8719c">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Et areal med permanent græs under 0,30 hektar kan udelukkende anses som sammenhængende efter stk. 1, med andre landbrugsarealer med permanent græs.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id268b5e79-e207-468e-90ec-a9ddd2e0c576">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Et areal med lavskov under 0,30 hektar kan udelukkende anses som sammenhængende efter stk. 1, med andre landbrugsarealer med lavskov.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id7114f874-96da-40ee-b7c8-a52e0304bf98">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Et areal med omdrift eller permanente afgrøder under 0,30 hektar kan udelukkende anses som</Char>
                </Linea>
              </Exitus>
              <Exitus>
                <Linea>
                  <Char>sammenhængende efter stk. 1, med andre landbrugsarealer med henholdsvis omdrift eller permanente afgrøder.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id87f3bd18-0494-4631-9045-fc30d76ed965" localId="3">
        <Explicatus>Kapitel 3</Explicatus>
        <Rubrica id="idce9609e3-67fc-462d-b97f-75086f517384">
          <Linea>
            <Char>Grundbetaling</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Rubrica id="idfbb0433f-da8b-4a70-89b5-16978f52cb31">
            <Linea>
              <Char>Kriterier for tilskudsberettigelse og forpligtelser for grundbetaling</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id443d2553-2208-40bf-92f1-e104c2ef1fa4" localId="12">
            <Explicatus>§ 12.</Explicatus>
            <Stk id="idff01e24f-01bc-4432-88ab-80315a5bab72">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at landbrugsarealerne under normale vejrforhold kan dyrkes eller høstes i dyrkningsperioden 15. marts til og med 25. oktober, jf. dog § 14, stk. 1.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idf8341cf0-4ed0-4beb-b082-f26894bd9ea4" localId="13">
            <Explicatus>§ 13.</Explicatus>
            <Stk id="idab5c96be-d484-4340-9bb3-24ec7864d9b1">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at anvende landbrugsarealet til produktion af landbrugsprodukter eller til at opretholde arealet i en landbrugsmæssig stand, der gør det egnet til dyrkning eller afgræsning, jf. dog stk. 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idb5decccc-b107-4ebb-ba57-dca0290b9ae3">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at der på arealet ikke sker opvækst af træer og buske udover, hvad der er angivet i § 18, § 20, §§ 27 og 28 og §§ 30-34, jf. dog stk. 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id41842764-c475-4017-b6ee-183b7bffeb84">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er berettiget til tilskud, selvom det ikke er muligt at opfylde forpligtelserne i stk. 1 og 2, hvis det skyldes foranstaltninger i medfør af gennemførelsen af habitatdirektivet, vandrammedirektivet, fuglebeskyttelsesdirektivet, landdistriktsprogrammer for skovtilplantning eller miljøvenligt landbrug eller nationale ordninger for reduktion af drivhusgasudledning, jf. § 6.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="iddbd5fbd1-c4a6-47c2-9617-1dc6d795057b">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er ved produktion af landbrugsprodukter forpligtet til at anvende arealet landbrugsmæssigt ved udførelse af mindst én af følgende landbrugsaktiviteter i dyrkningsperioden 15. marts til og med den 25. oktober, jf. dog stk. 6:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idc8e93a77-e2e2-4b8f-8331-d83f50fe2a7d">
                <Index>
                  <Indentatio id="idc35e816b-1863-4f95-a0ab-6e616fe69ef2" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Jordbearbejdning.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide485ba7f-1753-461d-b769-fb7b07688693" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tydelig slåning eller afgræsning med husdyr af græsarealer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd9284190-f9b7-4b52-8101-f11588878644" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Opdræt og hold af husdyr.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd51cb03a-8483-44ef-a96a-1e1df4311564" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Dyrkning og tilstedeværelse af landbrugsprodukter, herunder lavskov med kort omdriftstid og paludikulturer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idfe9dfaa7-5684-468e-aab9-53af2e9b2500" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Opfyldelse af plejeforpligtelsen slæt eller plejeforpligtelsen græsning med plejeformen synligt græsset eller synligt afgræsset under tilskudsordningerne tilskud til pleje af græs- og naturarealer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idba4f24c7-a914-4ee8-bbf0-26b933557b4d">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet at opretholde et areal, der ikke anvendes til produktion, i landbrugsmæssig stand i form af slåning i perioden 1. april til og med 25. oktober eller anden vedligeholdelse, der sikrer ansøgers forpligtelse efter stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id85172f10-f131-4afb-b0b1-43dbc10cfa54">
              <Explicatus>Stk. 6.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er ikke forpligtet til at udføre en landbrugsaktivitet på arealer med småbiotoper.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id8c2ae04a-96a7-4a9e-9a70-95f44c04c27a">
              <Explicatus>Stk. 7.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger, der også anvender et areal til andet end landbrug, er forpligtet til at sikre, at den anden anvendelse ikke i væsentlig grad medfører, at landbrugsaktiviteten ikke kan udføres eller bliver hæmmet af den anden aktivitet på arealet i dyrkningsperioden 15. marts til og med 25. oktober.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id8cac4345-81ee-4ead-97e4-85b14f1618fe" localId="14">
            <Explicatus>§ 14.</Explicatus>
            <Stk id="id1f4d5d42-dde0-4964-ae28-db9fe08a1e80">
              <Exitus>
                <Linea>
                  <Char>På arealer med græs, brak eller permanent græs er ansøger forpligtet til årligt at udføre mindst én landbrugsaktivitet inden for de perioder, der fremgår af § 15, og § 23, stk. 2, jf. dog stk. 2 og 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id3944a335-b0dc-4837-8699-b4ade2080b72">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Forpligtelsen i stk. 1 gælder ikke for arealer indberettet efter § 6, stk. 4, hvis arealets beskaffenhed forhindrer det på grund af foranstaltninger efter § 6, stk. 4, eller formålet med disse.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idff80a1ab-d860-43df-9770-e7dbc714c8e4">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>GLM-landskabstræk, markkrat og småbiotoper, jf. § 14 og § 17, stk. 1, nr. 1, 4 og 6, i bekendtgørelse om konditionalitet og social konditionalitet for 2026, er ikke omfattet af forpligtelsen nævnt i stk. 1.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id24cc2a06-d37c-455e-9b20-ef740cf0eeb1">
            <Linea>
              <Char>Græsarealer</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id376a7f08-b240-4d24-97f4-1d6b8113f144" localId="15">
            <Explicatus>§ 15.</Explicatus>
            <Stk id="id6b68fdc7-dd77-4b3d-b6d2-6aaecbbf67c4">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at slå eller afgræsse arealer, der dyrkes med permanent græs og græs i omdrift, jf. § 13, stk. 5, inden for perioden 1. juni til 25. oktober.</Char>
                </Linea>
                <Linea>
                  <Char>Grønkorn betragtes som græs.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id64be531f-e157-4e30-9409-f6057e1584e3">
            <Linea>
              <Char>Arealer med paludikultur</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id39230441-60d3-4aa5-9484-d051a271a39e" localId="16">
            <Explicatus>§ 16.</Explicatus>
            <Stk id="idc57051b9-6520-4b09-b99d-949cfe74432e">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til på våde arealer, der dyrkes med landbrugsprodukter, at udføre mindst én årlig landbrugsaktivitet, jf. § 13, stk. 4.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id3437f827-78e2-4ed0-8a95-6c10da38832c">
            <Linea>
              <Char>Arealer på planteskoler</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="ida95e3726-d7ba-4e70-b4ab-08301f15a1bc" localId="17">
            <Explicatus>§ 17.</Explicatus>
            <Stk id="id2464bb24-54dc-4a53-8ba3-35caf3494727">
              <Exitus>
                <Linea>
                  <Char>Ansøger er på planteskoler med gartneriafgrøder og planteskolekulturer forpligtet til at sikre, at gartneriafgrøderne og planteskolekulturerne plantes direkte i bundjorden uanset, om de dyrkes på friland eller under glas eller anden form for overdækning.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id93adc92a-2fce-4399-b7c1-eaf0d3dad25e">
            <Linea>
              <Char>Arealer med klynger af træer og buske</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id2b26cbb4-d8b9-425f-a100-ba472777d456" localId="18">
            <Explicatus>§ 18.</Explicatus>
            <Stk id="idaa3aee11-8ff6-4cec-9106-8bacbca2f8f7">
              <Exitus>
                <Linea>
                  <Char>Ansøger er på arealer med klynger af træer og buske forpligtet til at sikre, at der ikke er klynger af træer og buske uden produktion på arealet.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id12a01fdf-d80f-4b2d-b48b-ba6e401cdbaa">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved klynger forstås grupper af træer og buske, hvor trækronerne eller buskene tilsammen overstiger et areal på 100 m², dog undtaget arealer, der er omfattet af § 22, § 26 eller § 31.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="idab82416d-8d8e-4a6c-8280-c0ce65f5030f">
            <Linea>
              <Char>Arealer med skov eller ikketilskudsberettigede permanente afgrøder</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id34117425-1a8d-4812-abb4-267f20209e93" localId="19">
            <Explicatus>§ 19.</Explicatus>
            <Stk id="id3afe3983-a05b-4891-9314-f59b6792845d">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at rødderne på arealer, hvorpå der har været skov eller ikketilskudsberettigede permanente afgrøder, jf. § 28, stk. 2, er fjernet, og at arealet fremstår som dyrkningsegnet landbrugsjord inden den 15. marts 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="idab525a28-6031-4f1a-94b9-1af70b3632ee">
            <Linea>
              <Char>Arealer med træer og buske</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="ida322e097-5aa9-4616-8659-e17b2ef67563" localId="20">
            <Explicatus>§ 20.</Explicatus>
            <Stk id="ide157e219-1317-4b78-8cee-1aca0368303d">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at der udover afgrøden på arealet højst er 100 træer eller buske pr. hektar på følgende arealer:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id714c425d-1303-4087-965a-8c4cf4c502ea">
                <Index>
                  <Indentatio id="id843cdcf4-8933-476d-8ed7-5cdabd7685ab" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Omdriftsarealer, herunder braklagte arealer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2b5bc7a7-6962-48d5-a098-046a4e4927b6" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer med permanente afgrøder.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5c8e042c-c046-4fa2-9712-b929be7b5d96" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer med lavskov, jf. dog stk. 2.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idba865f9f-e9da-4133-8c79-6f2dc253aacb" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer med permanent græs.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idacb71c39-0688-4748-9bd0-cefb4ac77a16">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at der på arealer med lavskov beplantet med poppelarter, jf. § 31, stk. 1, 2. pkt., højst er 400 andre enkeltstående træer og buske pr. hektar.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idfb80cb05-1f77-4548-bc22-c69355afb0f3">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hvis der på arealer med permanent græs sker opvækst af træer og buske udover, hvad der er angivet i stk. 1, vil den del af arealet, der overstiger 100 træer eller buske pr. hektar, ikke indgå i de tilskudsberettigede arealer, jf. § 51.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="idf2f9031b-9b87-4b24-b33d-192ef5a8d2c8">
            <Linea>
              <Char>Grøfter og grøblerender</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id82773b69-256c-4241-bd03-78200bed3c62" localId="21">
            <Explicatus>§ 21.</Explicatus>
            <Stk id="ide5faaa37-9085-44f9-af20-e976c6b605c4">
              <Exitus>
                <Linea>
                  <Char>Grøfter og grøblerender med en bredde på op til 2 meter, der er etableret på omdriftsarealer, permanente afgrøder eller permanente græsarealer, anses som en del af de samlede arealer, ansøger kan få tilskud til, hvis det omkringliggende areal opfylder § 11, stk. 1, §§ 12 og 13, § 18 og § 20.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id067c9b2b-1609-4037-a850-8e19ee205542">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud, at grøfter og grøblerender ikke</Char>
                </Linea>
              </Exitus>
              <Exitus id="id4a46924f-0ae8-4f69-8ed4-234351975ec5">
                <Index>
                  <Indentatio id="id35aa9696-ed93-40d7-9d14-cf74ab814fa8" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>gennemskærer hele markblokken,</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idbd049ea1-bf5d-4b3a-b78f-936c4f0b4636" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>ligger i kanten af en mark,</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id97169245-82e6-4f9e-9f85-e0879df2ee6e" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>er tilvokset med buske eller træer, eller</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9216162a-f1a3-4634-8ea3-52e0c17b81a7" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>er frahegnet fra begge sider.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id81f49ea3-15a4-4c4b-a88c-e6d4b0daf85f">
            <Linea>
              <Char>Småbiotoper</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id377e6bab-701f-44b9-90d2-43a835a11b30" localId="22">
            <Explicatus>§ 22.</Explicatus>
            <Stk id="id0a6a3550-f07e-44e8-be19-796edaace027">
              <Exitus>
                <Linea>
                  <Char>Følgende kriterier skal være opfyldt for at få tilskud til småbiotoper:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idc96bead5-177d-4bcc-847b-9d39d144c610">
                <Index>
                  <Indentatio id="id49fade1f-9818-48ca-a5d8-dc9ac7352882" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>En småbiotop skal være etableret på en mark inden for et landbrugsareal tidligst 2023.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idfc4e87ea-8a0a-4166-8575-6cfe6df30551" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>En småbiotop skal være indberettet efter § 4, stk. 1, nr. 3, i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8763a6d4-1184-4f61-9929-fa370798e34f" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>En småbiotop må højst udgøre 1,00 hektar.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide8182f2c-19eb-4872-a315-be811e75683c" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Der er en afstand på mindst 5 meter mellem småbiotopen og andre småbiotoper inden for samme mark.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id6a732289-b2a2-4c91-bf27-42a194d2e381" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis en småbiotop ligger mindre end 5 meter fra et areal med markkrat, må det samlede areal af småbiotopen og arealet med markkrat ikke udgøre mere end 1 hektar.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id246e86c9-e484-4bbc-893d-7bd9997dbc07" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis en småbiotop ligger mindre end 5 meter fra en småbiotop, som indgår i bio-ordningen midlertidig ekstensivering, jf. §§ 26 og 27 i bekendtgørelse om tilskud til bio-ordninger for 2026, må det samlede areal af småbiotoperne ikke udgøre mere end 1 hektar.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9c31feab-8304-4196-94f8-7f2a7a12300e" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede areal med småbiotoper på marken må ikke udgøre mere end 20 pct. af marken.</Char>
                      </Linea>
                      <Linea>
                        <Char>Småbiotopen kan dog udgøre hele marken, hvis småbiotopen indgår i bio-ordningen midlertidig ekstensivering, jf. bekendtgørelse om tilskud til bio-ordninger for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id0401e706-8948-4267-8228-3b5a61f73617" formaInd="Nummer">
                    <Explicatus>8)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Permanent opbevaring af ikkelandbrugsprodukter eller forekomst af menneskeskabte konstruktioner kan ikke udgøre en del af en småbiotop.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="ida1ef02fe-e04d-4fd5-9658-f024d66f1aa5">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie, at småbiotoper, der udgør hele marken, indgår i bio-ordningen midlertidig ekstensivering, jf. §§ 26 og 27 i bekendtgørelse om tilskud til bio-ordninger for 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id0e8ab46c-9a13-483e-9673-2b693a708e4a">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Indberettes et areal, som var betragtet som permanent græs forud for ansøgningsfristen, jf. § 3 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, betragtes arealet fortsat som permanent græs uagtet indberetningen og realiseringen af afgrøde på den mark som småbiotopen er placeret på.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id40c62932-76aa-47a2-bdb2-9a1ef9196b05">
            <Linea>
              <Char>Braklagte arealer</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id313f7160-a50c-46bf-8f1b-5e0b95796b89" localId="23">
            <Explicatus>§ 23.</Explicatus>
            <Stk id="ide058956c-1758-4681-841a-08e59e78333a">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud til braklagte arealer, at arealet indberettes som brak i det pågældende kalenderår under grundbetaling efter § 4, stk. 1, nr. 1, i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id4a2e4e60-482a-49d6-96cc-1a3c7a782ee2">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at det braklagte areal årligt slås i overensstemmelse med § 13, stk. 5, eller sikre, at arealet er etableret med en blomsterblanding senest den 30. april 2026, jf. dog stk. 3-4.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id772f2798-63f0-4ca8-97f3-f54f6d195069">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Mekanisk jordbehandling og etablering af enten blomsterbrak, der pr. m</Char>
                  <Char formaChar="Superscript">2</Char>
                  <Char> består af mindst to forskellige frø- og nektarproducerende plantearter, eller bestøverbrak, der pr. m</Char>
                  <Char formaChar="Superscript">2</Char>
                  <Char> består af mindst tre forskellige plantearter, som er omfattet af bilag 1, kan dog foregå hvert andet år.</Char>
                </Linea>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at mekanisk jordbehandling og etablering af blomster- eller bestøverbrak foregår mindst hvert andet år.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idc92fe93f-f427-40e3-acb6-432f60c67eda">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>I tilfælde af uforudsete vejrhændelser, der gør jorden uegnet til etablering inden for fristen, jf. stk. 2, kan styrelsen meddele ansøgerne en udsættelse af etableringsfristen med op til 14 dage.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idf39a79e1-68b1-47a5-bf01-f5895bbfd64a">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hvis det konstateres, at et braklagt areal anvendes til andre aktiviteter tilknyttet landbrugsmæssig produktion, udover de i stk. 2 og 3 nævnte, herunder opbevaring af landbrugsprodukter, kan styrelsen i forbindelse med kontrolbesøg ændre afgrødekoden for marken fra brak til den afgrøde, der konstateres på arealet.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id025250c7-1310-4fd5-be86-5a2299062792">
              <Explicatus>Stk. 6.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hvis det konstateres, at et areal med bestøverbrak ikke opfylder betingelserne for bestøverbrak, men i stedet betingelserne for blomsterbrak, kan styrelsen i forbindelse med kontrolbesøg ændre afgrødekoden til blomsterbrak.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id35f4dc51-fb18-4ac8-87f6-431f549768f8" localId="24">
            <Explicatus>§ 24.</Explicatus>
            <Stk id="id9648ae3d-95c5-4dce-8a20-9f5ef285b660">
              <Exitus>
                <Linea>
                  <Char>Hvis det konstateres, at et braklagt areal anvendes landbrugsmæssigt i forbudsperioden 1. maj til og med 31. juli, kan styrelsen i forbindelse med kontrolbesøg ændre afgrødekoden for marken fra brak til den afgrøde, der konstateres på arealet, medmindre</Char>
                </Linea>
              </Exitus>
              <Exitus id="idd334591b-0c2b-4425-9f4c-1deef6753830">
                <Index>
                  <Indentatio id="id6ebb85ad-ddbe-4efc-bc0f-f19ea7d048f9" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>arealet er beliggende inden for de afstandsforpligtelser, der gælder efter bekendtgørelse om markfrø og om sædekorn, og landbrugeren har ansøgt om slåning for at undgå fremmed bestøvning fra plantedækket på de braklagte arealer af de frø eller sædekorn, der ønskes certificeret, eller</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idda956db0-d6df-4e0a-a288-c3a7e67ca0b6" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>der er slået eller anvendt sprøjtemidler som følge af selektiv bekæmpelse af  engbrandbæger (Senecio jacobaea), vår-brandbæger (Senecio vernalis), ager-rævehale (Alopecurus myosuroides), agertidsel (Cirsium arvense), kæmpebjørneklo (Heracleum mantegazzianum) eller flyvehavre (Avena fatua).</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="ida89a027c-fd5c-4617-9162-679a54a99326">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Plantemateriale fra det braklagte areal må ikke fjernes efter slåning eller nedvisning, jf. stk. 1, nr. 2, medmindre der er tale om bekæmpelse af flyvehavre, jf. bekendtgørelse om flyvehavre, eller bekæmpelse af kæmpebjørneklo i overensstemmelse med en indsatsplan fra kommunen mod bekæmpelse af kæmpebjørneklo.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id6c078fdb-dcee-4506-9518-82967b7dbf3c">
            <Linea>
              <Char>Bræmmer</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idacab8142-4bbf-4733-8f62-019424e82cfc" localId="25">
            <Explicatus>§ 25.</Explicatus>
            <Stk id="idab0d6be4-935f-4d77-a9b6-488262c8bc8c">
              <Exitus>
                <Linea>
                  <Char>For at få tilskud til 2-metersbræmmer langs vandløb og søer, der er omfattet af vandløbslovens § 69, stk. 1, og 2-metersbræmmer rundt om fortidsminder, jf. museumsloven, samt 3-metersbræmmer, der er udlagt efter GLM 4, jf. § 6 og § 17, stk. 1, nr. 3, i bekendtgørelse om konditionalitet og social konditionalitet for 2026, er ansøger forpligtet til at slå bræmmerne i overensstemmelse med § 13, stk. 5.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id7c8e150a-baab-4b79-905d-16d3583717a2">
            <Linea>
              <Char>Arealer med markkrat</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idf92ed801-d5c2-40c4-bcb6-f29e1ab59614" localId="26">
            <Explicatus>§ 26.</Explicatus>
            <Stk id="id454caec6-1c54-4c39-b4d6-30d5fa0b91bc">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud til områder på et landbrugsareal med markkrat, at markkrattet senest den 10. maj 2024 var registreret som markkrat i Internet Markkort.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idff6369cf-e38e-4142-879b-56715f703634">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at arealet med markkrat er mindst 10 meter bredt.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id84c31e63-4852-4cdd-90f3-48acab7e3088">
            <Linea>
              <Char>Flerårige og permanente afgrøder</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="ida1f0dd8a-1e5d-47dc-bdc2-9392e92199c2" localId="27">
            <Explicatus>§ 27.</Explicatus>
            <Stk id="id8ce73793-38d0-487b-b2c7-8d307697eee0">
              <Exitus>
                <Linea>
                  <Char>Hvis et areal ved ansøgningsårets begyndelse fremstår med en allerede etableret flerårig produktionsafgrøde, som ikke høstes i ansøgningsåret, er ansøger forpligtet til at vedligeholde arealet med henblik på dyrkning af afgrøden, så hovedafgrøden ikke hæmmes væsentligt af ukrudt.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id12414949-04e1-4ef0-acc7-b19a562cee0e" localId="28">
            <Explicatus>§ 28.</Explicatus>
            <Stk id="id91defb46-21f7-4c17-9d87-a1d7f8c6e096">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at vedligeholde arealer, der dyrkes med permanente afgrøder, samt sørge for, at de fremstår i en god plantagemæssig stand, der sikrer, at hovedafgrøden ikke hæmmes væsentligt af ukrudt, buskads og andre træer.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id7399697a-4f50-4caa-abac-a806f7627944">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Klippegrønt, pyntegrønt, juletræer, frøproduktion til skovfrø og anden skovdrift anses ikke som permanente afgrøder.</Char>
                </Linea>
                <Linea>
                  <Char>Arbejdsarealer, skovstier og arbejdsveje tilknyttet denne drift anses ikke som landbrugsarealer.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idb4a34d0a-cfbb-40a8-b312-9fc3aa529955" localId="29">
            <Explicatus>§ 29.</Explicatus>
            <Stk id="id28e53a9f-f0dd-4ce6-a05d-62deef3202cc">
              <Exitus>
                <Linea>
                  <Char>For at få tilskud til arealer med elefantgræs og rørgræs er ansøger forpligtet til at drive arealerne landbrugsmæssigt i overensstemmelse med § 28, stk. 1.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id7ff37a3b-0fb8-43de-b41c-12bd90d121d8">
            <Linea>
              <Char>Lavskov</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id83785217-b9a2-460e-ab88-c77c9ce8e710" localId="30">
            <Explicatus>§ 30.</Explicatus>
            <Stk id="ide5a5d37d-404f-4187-abc7-b7f1b296ee79">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud til arealer med lavskov, der dyrkes med kort omdriftstid, at lavskoven er etableret på arealet senest den 15. maj og dyrkes inden for følgende slægter: Hassel (Corylus spp.), løn (Acer spp.), ask (Fraxinus spp.), avnbøg (Carpinus spp.), birk (Betula spp.), el (Alnus spp.), eg (Quercus spp.), elm (Ulmus spp.), lind (Tilia ssp.), kastanje (Castanea ssp.), almindelig bøg (Fagus sylvatica ssp.), valnød (Juglans ssp.) pil (Salix spp.) og poppel (Populus spp.) samt kirsebær (Prunus ssp.) dog undtaget glansbladet hæg (prunus serotina).</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="ida2c78e01-cf2a-48e7-96e3-e681dfa40f9d" localId="31">
            <Explicatus>§ 31.</Explicatus>
            <Stk id="idb16381fb-fec7-4444-8359-3e6266731209">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at beplantninger med lavskov til enhver tid består af mindst 8.000 plantede træer pr. hektar af de i § 30 nævnte slægter.</Char>
                </Linea>
                <Linea>
                  <Char>For beplantninger af poppelarter i renkultur skal plantetætheden til enhver tid bestå af mindst 1.000 plantede træer pr. hektar.</Char>
                </Linea>
                <Linea>
                  <Char>Højst 20 pct. af arealet må udgøres af ubefæstede arbejdsarealer.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id25c2277b-ec3b-4501-ae0a-32e5802c134f">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at plante lavskoven i en bredde på minimum 7,5 meter og til at sikre, at lavskovsplanterne er plantet i rækker som en plantage og ikke er selvsåede.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ide5ee69a7-aec2-4f6c-895d-482fb405bd67">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at stævne lavskoven mindst hvert tiende år.</Char>
                </Linea>
                <Linea>
                  <Char>Ansøger er dog forpligtet til at stævne beplantninger af poppelarter, jf. stk. 1, 2. pkt., som er etableret eller stævnet i 2011 eller senere, mindst hvert tyvende år.</Char>
                </Linea>
                <Linea>
                  <Char>Etableringsåret eller stævningsåret medregnes i den tiårige eller tyveårige stævningsperiode.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idfb0d7d24-f0bf-4a9e-9d21-d63bc6d3df81">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til årligt at vedligeholde arealer med lavskov i en god plantagemæssig stand, der sikrer, at afgrøden ikke hæmmes væsentligt af ukrudt, buskads eller af andre træer på arealet.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id3973499b-de20-422e-a3ce-39cc4f39343d">
            <Linea>
              <Char>Skovlandbrug</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id418295a8-cec7-4a04-a590-c24a89e50459" localId="32">
            <Explicatus>§ 32.</Explicatus>
            <Stk id="id75bcffbd-766d-4f35-bd5f-e5cb9e0723a8">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud, at arealer, der indberettes som skovlandbrug, jf. bilag 1 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, udgøres af permanente afgrøder i form af træer og buske med frugt, bær eller nødder, som nævnt i bilag 2, og dyrkes i kombination med mindst én anden tilskudsberettiget afgrøde, dog ikke lavskov eller brak.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="ide37159e8-f041-437d-9f96-7fbb0ae8d799" localId="33">
            <Explicatus>§ 33.</Explicatus>
            <Stk id="idb35b9716-4d3f-4c12-95bf-e454fcc24f7c">
              <Exitus>
                <Linea>
                  <Char>Det er et kriterie for at få tilskud efter § 32, at træerne og buskene står i række.</Char>
                </Linea>
                <Linea>
                  <Char>Rækker af træer eller buske med frugt, bær eller nødder må indgå i bælter bestående af højst tre rækker.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id53d74ba8-6c0c-46a4-a836-12fcc0611a9c">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>På et areal med skovlandbrug er det et kriterie,  at der er mere end 100 træer eller buske med frugt, bær eller nødder pr. hektar.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id3d6933d6-9439-4f28-85fa-6d48e291bc23">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>På ethvert sted på arealer med skovlandbrug, hvor der ikke er en afgrøde bestående af træer eller buske med frugt, bær eller nødder, er det et kriterie, at der højst er 40 meter til træer eller buske, jf. stk. 1, eller til kanten af marken.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id0dffce66-5118-4c3f-bdb6-1826b1c79e06" localId="34">
            <Explicatus>§ 34.</Explicatus>
            <Stk id="ida85f7db2-d8e5-476e-a6ba-b3efc838e26a">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til på arealer med skovlandbrug at udføre årlige landbrugsaktiviteter i overensstemmelse med § 13, stk. 4, græs, jf. § 15, flerårige afgrøder, jf. § 27, eller permanente afgrøder, jf. § 28.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id0bd6c92f-29fe-4d2e-97f3-e10aac22a40a">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>På arealer med skovlandbrug med træer og buske med frugt, bær eller nødder er ansøger forpligtet til at vedligeholde arealet som en plantage, jf. § 28.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idc24c6de7-ed45-4b74-b647-93088b8077a6" localId="4">
        <Explicatus>Kapitel 4</Explicatus>
        <Rubrica id="id2dea6d66-c702-46d5-9522-db7b641fb320">
          <Linea>
            <Char>Ø-støtte, kriterier</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idee09de05-7997-4e6e-86cf-81354616d600" localId="35">
            <Explicatus>§ 35.</Explicatus>
            <Stk id="id8203b86c-e1bc-4cc4-813f-7a076d041250">
              <Exitus>
                <Linea>
                  <Char>Tilskud i form af ø-støtte er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="ide2f55f31-7804-49da-86cb-789f3b700be8">
                <Index>
                  <Indentatio id="id3fb1d23f-ca9c-44f2-9674-a6f5ce61c44b" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal have søgt om grundbetaling til arealerne i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd40a6f90-b7c3-410c-88eb-f70823f786d1" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger og arealerne skal være tilskudsberettigede til grundbetaling i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id09b8bffd-be89-4925-a136-1d7ace2251ac" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>De tilskudsberettigede arealer skal ligge på en eller flere øer, der fremgår af https://kort.lbst.dk/685.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idbaee00c2-4698-499f-8cb7-7925bb7f8d00">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Der kan højst udbetales tilskud for 100 hektar pr. bedrift.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id9a8540d9-7ac9-44c5-87e2-9bde669bc3e1" localId="5">
        <Explicatus>Kapitel 5</Explicatus>
        <Rubrica id="id4e5fc424-b272-4ec9-9ef5-4de9baa8327b">
          <Linea>
            <Char>Tilskud til arealer med stivelseskartofler, kriterier og forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idad970b7d-4793-4456-9d81-07ca37d020d7" localId="36">
            <Explicatus>§ 36.</Explicatus>
            <Stk id="idae0217bd-3417-43cb-8065-2bc083e51152">
              <Exitus>
                <Linea>
                  <Char>Tilskud til omdriftsarealer med stivelseskartofler er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idae49e2f1-1220-491b-b1bb-e3ca3407b26f">
                <Index>
                  <Indentatio id="idefba2624-3b68-4ddb-9b15-29c0394735a5" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal have ansøgt om grundbetaling i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2e793091-aa3a-4c37-a99c-3f492392d98a" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>De ansøgte arealer skal være tilskudsberettigede til grundbetaling i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id82f0e3b3-e4f3-4837-871d-d088bf2cff8a" localId="37">
            <Explicatus>§ 37.</Explicatus>
            <Stk id="id328c61e4-3540-45c1-9406-6d5cdc8f6544">
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at dyrke omdriftsarealer, hvortil der er ansøgt om tilskud til stivelseskartofler, med en stivelseskartoffelsort.</Char>
                </Linea>
                <Linea>
                  <Char>Den anvendte stivelseskartoffelsort skal fremgå af bilag 3 eller dokumenteres ved ansøgers leveringskontrakt med en kartoffelmelsfabrik for ansøgningsåret.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idabe799e8-d6c7-4465-8147-3b103459244e" localId="6">
        <Explicatus>Kapitel 6</Explicatus>
        <Rubrica id="ida6ab9956-02fd-46db-aad1-55a3ab3ed020">
          <Linea>
            <Char>Tilskuddets størrelse m.v.</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idfde63675-4829-4974-a31a-0135a6c0c58d" localId="38">
            <Explicatus>§ 38.</Explicatus>
            <Stk id="id95fd8033-8a03-4f2d-8c3c-181aef652fa9">
              <Exitus>
                <Linea>
                  <Char>Størrelsen på grundbetalingen fastsættes på grundlag af den økonomiske ramme for tilskudsordningen og udgør 211,23 EUR pr. hektar, jf. dog stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idd8725eb9-b816-48f1-a391-dc1e52301c34">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved underansøgning til grundbetalingsordningen eller arealbaserede tilskudsordninger efter artikel 31 i Europa-Parlamentets og Rådets forordning (EU) 2021/2115, kan det i stk. 1 anførte tilskud blive forhøjet med op til 5 pct. Ved overansøgning til grundbetalingsordningen eller arealbaserede tilskudsordninger efter artikel 31 i Europa-Parlamentets og Rådets forordning (EU) 2021/2115,  kan det i stk. 1 anførte tilskud blive nedsat.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id5279c28d-ff12-40f8-aeb7-e9deb7325e7a" localId="39">
            <Explicatus>§ 39.</Explicatus>
            <Stk id="id50589e6f-2426-42c3-bf24-7010aa4f5bdd">
              <Exitus>
                <Linea>
                  <Char>Størrelsen på ø-støtte udgør 500 kr. pr. hektar.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="ide39cf8bf-e635-4d93-a401-8065456a67fe" localId="40">
            <Explicatus>§ 40.</Explicatus>
            <Stk id="id5018d121-0011-45de-a032-2b8b6a0fa69e">
              <Exitus>
                <Linea>
                  <Char>Størrelsen på tilskuddet til arealer med stivelseskartofler i 2026 udgør maksimalt 42 EUR pr. hektar.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id0fc477a9-1df5-4d9f-9b0f-d0f09e4b9512">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved overansøgning kan det i stk. 1 anførte maksimale tilskud nedsættes.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id8a58a956-9341-4ece-a572-f63817055359" localId="41">
            <Explicatus>§ 41.</Explicatus>
            <Stk id="iddc223f6b-93f4-4dd8-acea-0a3762c0b9a1">
              <Exitus>
                <Linea>
                  <Char>Hvis et areal, hvortil der er søgt tilskud, bliver overdraget, vil tilskuddet uanset overdragelsen blive udbetalt til ansøger.</Char>
                </Linea>
                <Linea>
                  <Char>Ansøger forbliver ansvarlig for overholdelse af forpligtelser og kriterier for tilskud.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id9b7beafb-c312-4d8b-9c3a-c7790d102894">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Stk. 1 finder tilsvarende anvendelse, hvis rådigheden over et areal, hvortil der er søgt tilskud, overgår til en anden landbruger i 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id8ff7c7de-c817-4d03-8ae3-768c679c1efc" localId="42">
            <Explicatus>§ 42.</Explicatus>
            <Stk id="id83f0f096-632b-4c3a-98d0-4ef8bc6ea1bb">
              <Exitus>
                <Linea>
                  <Char>Der ydes ikke tilskud, hvis ansøgers samlede tilskudsberettigede areal, jf. § 49, er mindre end 2,00 hektar, medmindre der ydes ko- eller slagtepræmie på mindst 300 EUR.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idb767ef95-7af4-48d6-9bad-d3abea02d585" localId="7">
        <Explicatus>Kapitel 7</Explicatus>
        <Rubrica id="id9bf4c380-4773-4e34-a57b-30c8935ac76a">
          <Linea>
            <Char>Nedsættelse af tilskud og sanktioner m.v.</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Rubrica id="idec333d0b-d062-4d7a-919b-152e49f6358f">
            <Linea>
              <Char>Manglende opfyldelse af kriterier for tilskudsberettigelse og forpligtelser</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id3a2b3ee9-4465-4751-8206-7807475cbee3" localId="43">
            <Explicatus>§ 43.</Explicatus>
            <Stk id="id083cc920-1c85-469c-b0bf-687f3aa359da">
              <Exitus>
                <Linea>
                  <Char>Opfylder ansøger ikke kriterierne, jf. § 6, stk. 4 og 5, § 8, § 9, stk. 1, § 10, § 11, stk. 1, § 21, stk. 2, § 22, stk. 1 og 2, § 23, stk. 1, § 26, stk. 1, § 30, §§ 32 og 33, §§ 35 og 36, er ansøger ikke berettiget til tilskud og eventuelt udbetalt tilskud skal tilbagebetales.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idb72cdc31-815f-4f46-b9e6-614cb27a9135">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Opfylder ansøger ikke de forpligtelser, der gælder, jf. § 12, § 13, stk. 1, 2, 4, 5 og 7, § 14, stk. 1, § 15, stk. 1, §§ 16 og 17, § 18, stk. 1, § 19, § 20, stk. 1 og 2, § 23, stk. 2 og 3, § 25, § 26, stk. 2, § 27, § 28, stk. 1, § 29, § 31, § 34 og § 37, nedsættes tilskuddet helt eller delvist for de ansøgte arealer, som forpligtelsen vedrører.</Char>
                </Linea>
                <Linea>
                  <Char>Eventuelt udbetalt tilskud, der er omfattet heraf, skal tilbagebetales.</Char>
                </Linea>
                <Linea>
                  <Char>Ansøger pålægges en administrativ sanktion afhængig af alvor, omfang og varighed af den manglende opfyldelse af forpligtelser.</Char>
                </Linea>
                <Linea>
                  <Char>Tilskudsnedsættelse som følge af manglende opfyldelse af forpligtelser samt administrativ sanktion beregnes efter reglerne i § 50.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id78ac42ee-426b-4316-8038-4f4bd8173942">
            <Linea>
              <Char>Forsinket indgivelse af ansøgning, dokumentation, m.v.</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idd269ee8d-88c2-4c86-aaba-bf3ff6ae9bda" localId="44">
            <Explicatus>§ 44.</Explicatus>
            <Stk id="id34bf4e1d-1ee9-4027-8931-a18a48464b52">
              <Exitus>
                <Linea>
                  <Char>Ved overskridelse af fristen for rettidig indgivelse af ansøgningen i fællesskema, der fremgår af § 3 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, overskrides, pålægges ansøger en administrativ sanktion svarende til en nedsættelse på 1 pct. pr. arbejdsdag af det tilskud, som ansøger ved rettidig indgivelse ville være berettiget til i kalenderåret.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id874f7422-c34b-4606-b2c7-db73ce9ca06f">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Reglen i stk. 1 finder tilsvarende anvendelse ved forsinket indgivelse af kontrakter, erklæringer, bilag eller øvrig påkrævet dokumentation, der skal medfølge indgivelse af det skema, der er omtalt i stk. 1.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id1a123e6a-3a27-4190-8adf-528a6b836ff8">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Har ansøger fået dispensation fra den gældende frist for indgivelse eller frist for forsinket indgivelse i henhold til § 9 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, finder reglerne i henholdsvis stk. 1 og 2 anvendelse på de nye frister, der meddeles ansøger.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id1aeeb43b-011e-4734-96be-6053d87c0c32">
            <Linea>
              <Char>Manglende indberetning af alle bedriftens landbrugsarealer</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idbdb36bf7-a7d3-4652-9fc1-d9986412d283" localId="45">
            <Explicatus>§ 45.</Explicatus>
            <Stk id="id4da17cd0-f318-419f-868b-aeff99027cf3">
              <Exitus>
                <Linea>
                  <Char>Har ansøger ikke indberettet alle bedriftens landbrugsarealer, jf. § 4, stk. 1, nr. 1, i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, pålægges en administrativ sanktion efter følgende regler:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id01358deb-87e9-4c02-bc8a-78a8c9a8c984">
                <Index>
                  <Indentatio id="id88111c5f-8c80-430e-953b-88eb6b4d309d" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskuddet under den pågældende tilskudsordning nedsættes med 1 pct., når de arealer, der ikke er indberettede, udgør mere end 3 pct. og op til og med 10 pct. af det indberettede areal.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id6c49f9d4-4297-43d1-84e1-e7666698fe06" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskuddet under den pågældende tilskudsordning nedsættes med 1 pct., når de arealer, der ikke er indberettede, udgør mere end 10 pct. og op til og med 20 pct. af det indberettede areal, og når de arealer, der ikke er indberettede, ikke overstiger 5,00 hektar.</Char>
                      </Linea>
                      <Linea>
                        <Char>Tilskuddet nedsættes med 2 pct., hvis de arealer, der ikke er indberettede, er over 5,00 hektar.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id4cf3111f-8e0b-4ca9-bf9b-70afac46a40d" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskuddet under den pågældende tilskudsordning nedsættes med 1 pct., når de arealer, der ikke er indberettede, udgør mere end 20 pct. af de arealer, der er indberettede, men ikke overstiger 5,00 hektar.</Char>
                      </Linea>
                      <Linea>
                        <Char>Tilskuddet nedsættes med 2 pct., når de arealer, der ikke er indberettede, udgør mere end 20 pct. af det indberettede areal og er på mere end 5,00 hektar, men ikke overstiger 10,00 hektar.</Char>
                      </Linea>
                      <Linea>
                        <Char>Tilskuddet nedsættes med 3 pct., hvis de arealer, der ikke er indberettede, udgør mere end 20 pct. af det indberettede areal og overstiger 10,00 hektar.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id17a485bd-9491-451b-9216-2ba6d59532fa">
            <Linea>
              <Char>Force majeure og usædvanlige omstændigheder</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id7934eabd-13eb-4c75-9d45-69f877003179" localId="46">
            <Explicatus>§ 46.</Explicatus>
            <Stk id="idb9bd1ed2-1092-4b25-b83d-f69e6da9d009">
              <Exitus>
                <Linea>
                  <Char>Kan en ansøger ikke opfylde kriterier for tilskudsberettigelse eller forpligtelser som følge af force majeure eller usædvanlige omstændigheder, bevarer ansøgeren retten til tilskud for de arealer, der var tilskudsberettigede på det tidspunkt, hvor der indtraf force majeure eller usædvanlige omstændigheder.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id1d11e0bf-0fa4-4ee4-bc8e-c1f6c57d2e24" localId="47">
            <Explicatus>§ 47.</Explicatus>
            <Stk id="idb45a5f2c-b409-4777-b91d-439b8cd20664">
              <Exitus>
                <Linea>
                  <Char>I tilfælde af force majeure eller usædvanlige omstændigheder skal ansøger meddele styrelsen skriftligt herom sammen med en fyldestgørende dokumentation herfor senest 15 arbejdsdage fra det tidspunkt, hvor ansøgeren eller dennes stedfortræder er i stand til at give en sådan meddelelse.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idf7f50259-8638-4a5a-abe7-a5806cf3828a" localId="8">
        <Explicatus>Kapitel 8</Explicatus>
        <Rubrica id="id283ff2fc-ad2c-48fb-9ed8-8b04ad78eae4">
          <Linea>
            <Char>Beregning af tilskudsnedsættelse og administrative sanktioner m.v.</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id45cc4c62-fb06-4d84-be22-12fa450372bf" localId="48">
            <Explicatus>§ 48.</Explicatus>
            <Stk id="id8e1e70e8-1c6e-4c53-8d22-da5da6ce82e8">
              <Exitus>
                <Linea>
                  <Char>Der beregnes en overtrædelsesprocent ved at dividere det overtrådte areal med det godkendte, ansøgte areal, jf. dog stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id59290671-ca4c-4b54-883f-b0172fa74c9f">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved ansøgning om tilskud til arealer, som er registreret i Internet Markkort som beliggende i en markblok af typen permanent græs (PGR) med en tilknyttet tilskudsprocent, jf. § 51, skal henholdsvis det godkendte, ansøgte areal samt et eventuelt overtrådt areal ganges med den tilskudsprocent, der er gældende for markblokken, inden der foretages en beregning af overtrædelsesprocenten.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id8fa252d4-0a2a-46d3-8ac1-0aebda08c609" localId="49">
            <Explicatus>§ 49.</Explicatus>
            <Stk id="iddae7d6bd-77dd-4e4e-b171-24b34516c184">
              <Exitus>
                <Linea>
                  <Char>Det tilskudsberettigede areal fastsættes som det samlede godkendte, ansøgte areal fratrukket summen af overtrådte arealer, jf. dog stk. 2 og 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idf6a22a72-50e1-477b-ac0f-439a802c4ba5">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Er forskellen mellem det tilskudsberettigede areal og det samlede ansøgte areal på 0,10 hektar eller derunder, betragtes det tilskudsberettigede areal som lig med det samlede, ansøgte areal.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id9c733483-e3ce-4a24-9cca-753218257664">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Bestemmelsen i stk. 2 finder ikke anvendelse, hvis forskellen mellem det tilskudsberettigede areal og det samlede ansøgte areal udgør mere end 20 pct. af det samlede ansøgte areal.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idebc9d595-826d-4e3f-abfe-3f55087f53d3" localId="50">
            <Explicatus>§ 50.</Explicatus>
            <Stk id="id5d3b44a5-2b4f-4963-93d0-22fd7799d45f">
              <Exitus>
                <Linea>
                  <Char>Tilskudsnedsættelse som følge af helt eller delvist bortfald af tilskud ved manglende opfyldelse af forpligtelser samt administrative sanktioner herfor fastsættes som følger:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id25cc51c6-2c3a-4aed-807b-78cbc7dbecdc">
                <Index>
                  <Indentatio id="id240f75d8-b027-4ea2-bbe9-4d2f1de24578" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis overtrædelsesprocenten er højst 5 pct., og det overtrådte areal højst udgør 2,00 hektar, udbetales tilskud for det tilskudsberettigede areal.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idbdc29da1-b007-41d1-aaf4-6ff27d0e2145" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis overtrædelsesprocenten er over 5 pct., eller det overtrådte areal er over 2,00 hektar, men overtrædelsesprocenten er højst 20 pct., udbetales tilskud for det tilskudsberettigede areal minus en sanktion på 0,5 gange det overtrådte areal.</Char>
                      </Linea>
                      <Linea>
                        <Char>Hvis ansøgeren også i tidligere år i perioden 2023-2027 har haft en overtrædelse på over 5 pct. under den samme tilskudsordning, er sanktionen det overtrådte areal gange en sanktionsfaktor på 1,0.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd95162cb-ad3d-4201-8066-75eec435cecb" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis overtrædelsesprocenten er over 20 pct., udbetales tilskud for det tilskudsberettigede areal minus en sanktion på 1 gange det overtrådte areal.</Char>
                      </Linea>
                      <Linea>
                        <Char>Hvis ansøgeren herudover i tidligere år i perioden 2023-2027 har haft en overtrædelse på over 5 pct. under den samme tilskudsordning, er sanktionen det overtrådte areal gange en sanktionsfaktor på 1,2.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="ide4758dcc-7775-4ac0-86a3-3b4edbcc802b" localId="51">
            <Explicatus>§ 51.</Explicatus>
            <Stk id="id316fbe00-3487-4be6-ae94-769696db1fa6">
              <Exitus>
                <Linea>
                  <Char>Hvis det areal, der ansøges om tilskud for, er registreret som beliggende i en markblok af typen Permanent græs (PGR) i Internet Markkort, og markblokken indeholder permanente græsarealer med spredte naturarealer, der ikke er berettigede til grundbetaling, og som hver er under 0,05 hektar, kan disse naturarealer indgå i de tilskudsberettigede  arealer.</Char>
                </Linea>
                <Linea>
                  <Char>De tilskudsberettigede arealer opgøres herefter som følger:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id54bd0795-22a2-4583-8d11-ecea1293344d">
                <Index>
                  <Indentatio id="id015f9acc-092f-4a48-b46a-8ac405208837" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis arealer, der ikke er berettigede til grundbetaling, højst udgør 10 pct. i markblokken af markblokkens areal, medregnes hele markblokkens areal i det tilskudsberettigede areal i markblokken.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id09f14a01-4393-460c-b47d-3d65df4ef4ca" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis arealer, der ikke er berettigede til grundbetaling, udgør mere end 10 pct., men højst 30 pct. af markblokkens areal, medregnes 80 pct. af markblokkens areal i de tilskudsberettigede arealer i markblokken.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id1a2abb90-8a2d-4972-b886-d1fae8fc5335" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis arealer, der ikke er berettigede til grundbetaling, udgør mere end 30 pct. i markblokken, men højst 50 pct. af markblokkens areal, medregnes 60 pct. af markblokkens areal i de tilskudsberettigede arealer i markblokken.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5074ea28-eed6-468d-9b4e-3c781a75efc0" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis arealer, der ikke er berettigede til grundbetaling, udgør mere end 50 pct. i markblokken, medregnes de ikke i de tilskudsberettigede arealer i markblokken.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id32d2f176-84af-4d3c-9293-6574a2b26fbd">
            <Linea>
              <Char>Beregningsrækkefølge ved nedsættelse af tilskud m.v.</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id89229910-1cdf-428b-9eff-0df0405f699e" localId="52">
            <Explicatus>§ 52.</Explicatus>
            <Stk id="id330e5159-5054-49c1-b185-72c8c1a500c8">
              <Exitus>
                <Linea>
                  <Char>Ansøgers samlede tilskud for ansøgningsåret fra den pågældende tilskudsordning nedsættes i følgende rækkefølge:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idf9e97b78-d87e-45c6-b72b-ceaace158a84">
                <Index>
                  <Indentatio id="id7a7701cf-6404-4713-9a0b-a93fd23346c9" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>De nedsættelser og sanktioner, der er fastsat i § 50, anvendes på ansøgers tilskud.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id7ddfc669-ebb4-4fee-bb13-31c1b3cac946" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det beløb, der følger af anvendelsen af nr. 1, danner grundlag for beregningen af sanktioner ved for sen indgivelse af ansøgning eller dokumentation m.v. i henhold til § 44.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id7cca4a67-296b-46cd-b8f3-8f19d863350e" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det beløb, der følger af anvendelsen af nr. 2, danner grundlag for beregningen af sanktioner, der skal anvendes ved manglende anmeldelse af landbrugsarealer i henhold til § 45.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8134320b-c186-4692-bf1d-645c7b642a0b" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede beløb, der følger af anvendelsen af nr. 3, danner grundlag for anvendelse af den tilpasningssats, der er angivet i artikel 17 i Europa-Parlamentets og Rådets forordning (EU) 2021/2116 af 2. december 2021.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="ida9b52a86-0e22-456f-ae93-e6312c500a78">
            <Linea>
              <Char>Sanktionsloft</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idbf5381df-ba82-43af-aa98-36f1b59a4be3" localId="53">
            <Explicatus>§ 53.</Explicatus>
            <Stk id="id63667220-1601-4a82-b3e2-ca0b2370cd83">
              <Exitus>
                <Linea>
                  <Char>Ansøger kan maksimalt pålægges administrative sanktioner for overtrædelse af forpligtelser, der svarer til 100 pct. af tilskuddet for det godkendte, ansøgte areal for 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="iddcb95044-4860-46c5-bfee-cd352b9a2ff6">
            <Linea>
              <Char>Udelukkelse</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="ide79cbd68-8070-461f-906b-54b2ccb592ec" localId="54">
            <Explicatus>§ 54.</Explicatus>
            <Stk id="id5f725943-4f7c-4f38-9ec7-bbce0c9dd32c">
              <Exitus>
                <Linea>
                  <Char>Styrelsen kan udelukke en ansøger fra at søge en tilskudsordning i det følgende kalenderår, hvis ansøger i forbindelse med sin ansøgning til selvsamme tilskudsordning, har begået en meget alvorlig overtrædelse af loven, de i medfør af loven fastsatte regler eller Den Europæiske Unions forordninger omfattet af loven.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idcf4b61ef-8621-4ee1-8913-35cb7b3c68bd">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>I vurderingen af overtrædelsens alvor, jf. stk. 1, skal der henses til overtrædelsens omfang, varighed og hyppighed.</Char>
                </Linea>
                <Linea>
                  <Char>I vurderingen indgår herudover ansøgers forsæt til at begå overtrædelsen eller graden af ansøgers uagtsomhed.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id5a6fa809-238e-46a8-bf62-3d7e6082c099" localId="9">
        <Explicatus>Kapitel 9</Explicatus>
        <Rubrica id="id1285478c-4332-4de4-8db9-7fa5e3a279a2">
          <Linea>
            <Char>Kontrol</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Rubrica id="idcb332576-7ea1-4d7c-859d-a83405b28ada">
            <Linea>
              <Char>Satellitbaseret kontrol og georefererede billeder</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id2a11a19b-1ac8-4970-8771-ad9cb75130f4" localId="55">
            <Explicatus>§ 55.</Explicatus>
            <Stk id="id5bfbd82a-5fe9-4c56-b9e6-5caebaa59941">
              <Exitus>
                <Linea>
                  <Char>Ansøger informeres om de foreløbige resultater af den satellitbaserede kontrol for hvert enkelt ansøgt areal via en applikation, som styrelsen stiller til rådighed.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id72deaeff-7b02-423c-9ebb-da5a917c04df">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Viser den satellitbaserede kontrol, at ansøger ikke opfylder de kriterier og forpligtelser, der gælder for arealet i henhold til den ansøgte tilskudsordning, sendes kontrolresultatet i partshøring hos ansøger, der har de i nr. 1-3 anførte muligheder:</Char>
                </Linea>
              </Exitus>
              <Exitus id="ided85ef0e-780b-402b-b5a7-78aebb9f2f27">
                <Index>
                  <Indentatio id="idb5e8776a-eef2-40fc-a251-5ce8ad3c5b7c" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Afgive høringssvar ved at indsende billede af arealet, hvis ansøger mener, at kriteriet eller forpligtelsen allerede er opfyldt for det pågældende areal.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb453abe5-2c83-4e1d-b569-9216f1ce2773" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Opfylde kriteriet eller forpligtelsen, hvis det er muligt, og derefter afgive høringssvar ved at indsende billede, der dokumenterer kriteriets eller forpligtelsens opfyldelse.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9f45f68a-7d25-420f-b683-dab3e021684e" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ændre sit fællesskema vedrørende anvendelsen af arealet.</Char>
                      </Linea>
                      <Linea>
                        <Char>Hvis ændringen vedrørende anvendelsen af arealet angår dele af arealet, og arealet dermed opdeles, skal der indsendes billeddokumentation for de dele af arealet, hvor ansøgeren mener, at kriteriet eller forpligtelsen er opfyldt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idd1ad194b-8943-42e3-bc74-4cd57f51f724">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøgers billeddokumentation for opfyldelse af de for arealet gældende kriterier eller forpligtelser skal kunne dokumenteres med georefererede billeder ud fra følgende forhold:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id428dc1d5-3208-4c19-86fe-37cbf5691c0b">
                <Index>
                  <Indentatio id="id817c8d73-f330-4a43-9639-4e481f32214c" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Billederne skal være taget med brug af funktionerne i den i stk. 1 nævnte applikation, således at billederne har den fornødne tidsfasthed og stedfasthed.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ida692c29d-e392-47ff-b1f1-06012798c130" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealets beskaffenhed og eventuelle afgrøder skal fremgå tydeligt af billederne.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ida4f71607-617d-4153-9c87-67740f5884c5" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Billederne skal vise det areal, der ansøges om tilskud til.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id854dd7df-9bd3-455a-84af-320064f0760c" localId="10">
        <Explicatus>Kapitel 10</Explicatus>
        <Rubrica id="id2a898a76-928f-457e-a573-6b083e1b158a">
          <Linea>
            <Char>Obligatorisk digital kommunikation</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id0f1b6d0c-1833-4351-89c2-9dd613a26b0c" localId="56">
            <Explicatus>§ 56.</Explicatus>
            <Stk id="id7d156365-7cb3-4614-a177-095b499df354">
              <Exitus>
                <Linea>
                  <Char>Afgørelser sendes digitalt til ansøger via Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id85d3c17f-0e1b-4757-b183-00a7f359e81d" localId="57">
            <Explicatus>§ 57.</Explicatus>
            <Stk id="id17003f5c-3490-405d-8791-4abfca2cb19d">
              <Exitus>
                <Linea>
                  <Char>Skriftlige partshøringer efter forvaltningslovens § 19, skriftlige referater af telefoniske partshøringer efter forvaltningslovens § 19 og skriftlige anmodninger om supplerende oplysninger sendes til ansøger via Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id44360219-9d64-4bd1-8893-12bbb6ceaf32" localId="58">
            <Explicatus>§ 58.</Explicatus>
            <Stk id="id67fe6bfb-e743-429a-82d6-544ef951b4da">
              <Exitus>
                <Linea>
                  <Char>Ansøgers besvarelse af forhold efter § 57 skal indgives via Tast selv, jf. dog stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id45e1764a-ce2a-4b3d-9a54-992b1e87ad98">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Partshøringer efter forvaltningslovens § 19 om forhold, som konstateres ved satellitbaseret kontrol, skal ske ved digital indgivelse af billeddokumentation til styrelsen via den applikation, som styrelsen stiller til rådighed.</Char>
                </Linea>
                <Linea>
                  <Char>Supplerende oplysninger indgives via Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idecb5bf46-9c50-48e8-90ee-875a9ec07051">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Styrelsen kan dispensere fra kravet om, at høringssvar til kontrolresultatet fra den satellitbaserede kontrol skal afgives ved hjælp af den i stk. 2 nævnte applikation, hvis det på grund af omstændighederne ikke er muligt for ansøger at kommunikere digitalt med styrelsen via applikationen.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id6c467e1e-8d24-45c2-9de3-e9f6b39694a6" localId="11">
        <Explicatus>Kapitel 11</Explicatus>
        <Rubrica id="id13fe61a1-49dd-46d9-ae8b-c9143fe58104">
          <Linea>
            <Char>Ikrafttræden</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id60953915-124c-4b77-9473-de9ab22b10d9" localId="59">
            <Explicatus>§ 59.</Explicatus>
            <Stk id="id6a0a45a9-df61-4415-9828-510d3fb4da41">
              <Exitus>
                <Linea>
                  <Char>Bekendtgørelsen træder i kraft den 1. januar 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
    </Afsnit>
  </DokumentIndhold>
  <UnderskriftGruppe id="id45e47902-88ad-4af9-a51c-7ac6b3dd0ebb">

{"id":"HST88","text":"Harvesting of grain, rapeseed and pulses","description":"Harvesting of grain, rapeseed and pulses by province, crop, unit and time","unit":"-","suppressedDataValue":"0","updated":"2026-03-19T08:00:00","active":true,"contacts":[{"name":"Martin Lundø","phone":"+4551461512","mail":"mlu@dst.dk"}],"documentation":{"id":"31f48a74-30d5-4839-841f-c42ce9d54c9d","url":"https://www.dst.dk/documentationofstatistics/31f48a74-30d5-4839-841f-c42ce9d54c9d"},"footnote":{"text":"Figures for the most recent year are provisional until April of the following year. Sweet lupins, other grains, grain maize and corn-cob mix, triticale, spring cereal mixtures and spring wheat have some sampling uncertainty. The harvests 2006-2024 are covered by table HST77, 1990-2015 by HST6 (without regional breakdown) and 1920-1981 by HST1920 (selected crops). Other years are given in the Statistical Yearbook. Table GROV88 covers roughage and is published in March of the year following the production year. HST89 calculates the harvest by production type (organic/conventional).","mandatory":false},"variables":[{"id":"LANDSDEL","text":"province","elimination":true,"time":false,"map":"Denmark_region_07","values":[{"id":"000","text":"All Denmark"},{"id":"084","text":"Region Hovedstaden"},{"id":"15","text":"Provinces Byen København, Københavns omegn and Nordsjælland"},{"id":"04","text":"Province Bornholm"},{"id":"085","text":"Region Sjælland"},{"id":"083","text":"Region Syddanmark"},{"id":"07","text":"Province Fyn"},{"id":"08","text":"Province Sydjylland"},{"id":"082","text":"Region Midtjylland"},{"id":"09","text":"Province Østjylland"},{"id":"10","text":"Province Vestjylland"},{"id":"081","text":"Region Nordjylland"}]},{"id":"AFGRØDE","text":"crop","elimination":false,"time":false,"values":[{"id":"C0000","text":"CEREALS, TOTAL"},{"id":"C1111","text":"Winter wheat and spelt"},{"id":"C1112","text":"Spring wheat and spelt"},{"id":"C1210","text":"Rye"},{"id":"C1310","text":"Winter barley"},{"id":"C1320","text":"Spring barley"},{"id":"C1410","text":"Oats"},{"id":"C1420","text":"Spring cereal mixtures"},{"id":"C1500","text":"Grain maize and corn-cob-mix"},{"id":"C1600","text":"Triticale"},{"id":"C1990","text":"Other cereals n.e.c."},{"id":"P0000","text":"PULSES, TOTAL"},{"id":"P1100","text":"Field peas"},{"id":"P1200","text":"Broad and field beans"},{"id":"P1300","text":"Sweet lupins"},{"id":"I1110","text":"RAPE AND TURNIP RAPE SEEDS, TOTAL"}]},{"id":"MÆNGDE4","text":"unit","elimination":false,"time":false,"values":[{"id":"005","text":"Area (hectare)"},{"id":"020","text":"Average yield (hkg per hectare)"},{"id":"030","text":"Production (million kg)"}]},{"id":"Tid","text":"time","elimination":false,"time":true,"values":[{"id":"2025","text":"2025"}]}]}
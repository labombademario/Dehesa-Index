"Agrarische sector\",\"type\":\"sector\"}],\"tags\":[{\"id\":\"a68798d8-da60-45ea-b10f-ee823bdfdba1\",\"name\":\"Eco-activiteiten\",\"type\":\"tag\"},{\"id\":\"ed31047d-1b6d-42a7-a597-56f14dd884f7\",\"name\":\"2026\",\"type\":\"tag\"}],\"targets\":[{\"id\":\"c222fee6-dbc5-4776-a4d9-548a3dae0d9b\",\"name\":\"Agrarisch ondernemer\",\"type\":\"target\"}],\"countries\":[{\"id\":\"2535505c-f7f5-46eb-9c25-ef8991f20877\",\"name\":\"Nederland\",\"type\":\"country\",\"markers\":[],\"isoalpha2\":\"NL\"}],\"subsidies\":[{\"id\":\"e08e6b52-acb5-413b-ae4d-7b49ea917c60\",\"name\":\"Eco-regeling\",\"type\":\"subsidy_term\"},{\"id\":\"8c4a10ec-8493-4988-812d-ee5f27cede56\",\"name\":\"Agro 2\",\"type\":\"subsidy_term\"},{\"id\":\"0322663d-7a6b-4276-98ea-58b8040d0a0c\",\"name\":\"Gemeenschappelijk landbouwbeleid GLB\",\"type\":\"subsidy_term\"}],\"type\":\"subsidy\",\"budget\":{\"subsidyInformationTitle\":\"subsidy_budget\"},\"disableTime\":false,\"subsidyStatus\":{\"type\":\"taxonomy_term--subsidy_status\",\"id\":\"0a00df3d-3b84-41f1-8fd4-ae46029ae885\",\"name\":\"Gesloten voor aanvragen\",\"color\":\"#d51b1e\",\"links\":{\"self\":{\"href\":\"https://cms.rvo.nl/jsonapi/taxonomy_term/subsidy_status/0a00df3d-3b84-41f1-8fd4-ae46029ae885?resourceVersion=id%3A3235\"},\"working-copy\":{\"href\":\"https://cms.rvo.nl/jsonapi/taxonomy_term/subsidy_status/0a00df3d-3b84-41f1-8fd4-ae46029ae885?resourceVersion=rel%3Aworking-copy\"}},\"resourceIdObjMeta\":{\"drupal_internal__target_id\":3293}},\"notifications\":{\"subscriptionEnabled\":true,\"changes\":\"\"},\"audienceReferences\":[]}]\n"])</script><script>self.__next_f.push([1,"1a:[\"$\",\"$L2e\",null,{\"lang\":\"nl\",\"page\":{\"id\":\"ccdf615a-640d-4719-af29-930e029982bc\",\"associatedWith\":\"$19:props:associatedWith\",\"commissionedBy\":\"$19:props:commissionedBy\",\"contentElements\":\"$19:props:contentElements\",\"drupalNodeId\":2059352,\"breadcrumbs\":\"$19:props:breadcrumbs\",\"status\":true,\"title\":\"Eco-activiteiten, punten en waarde 2026\",\"created\":\"2025-11-06T13:12:00+00:00\",\"changed\":\"2026-09-09T11:54:11+00:00\",\"checked\":\"2026-09-09T13:54:11+02:00\",\"url\":\"/subsidies-financiering/glb-2026/eco-regeling/eco-activiteiten-punten-en-waarde\",\"intro\":\"\u003cp\u003eVoor de eco-regeling uit het Gemeenschappelijk landbouwbeleid (GLB) voert u eco-activiteiten uit. Elke eco-activiteit heeft punten en waarde per hectare. U haalt op alle 5 doelen van de eco-regeling voldoende punten en u haalt de drempelwaarde. U kunt eco-activiteiten combineren voor meer punten en waarde.\u003c/p\u003e\\n\u003cp\u003eAanvragen kon van 1 maart tot en met 18 mei 2026.\u003c/p\u003e\\n\",\"summary\":\"\u003cp\u003eVoor de eco-regeling uit het Gemeenschappelijk landbouwbeleid (GLB) voert u eco-activiteiten uit. Elke eco-activiteit heeft punten en waarde per hectare. U haalt op alle 5 doelen van de eco-regeling voldoende punten en u haalt de drempelwaarde. U kunt eco-activiteiten combineren voor meer punten en waarde.\u003c/p\u003e\\n\",\"metaTags\":\"$19:props:metaTags\",\"relatedLinks\":\"$19:props:relatedLinks\",\"belongsTo\":\"$19:props:belongsTo\",\"banner\":\"$19:props:banner\",\"subjects\":\"$19:props:subjects\",\"sectors\":\"$19:props:sectors\",\"tags\":\"$19:props:tags\",\"targets\":\"$19:props:targets\",\"countries\":\"$19:props:countries\",\"subsidies\":\"$19:props:subsidies\",\"type\":\"subsidy\",\"budget\":\"$19:props:budget\",\"disableTime\":false,\"subsidyStatus\":\"$19:props:subsidyStatus\",\"notifications\":\"$19:props:notifications\",\"audienceReferences\":\"$19:props:audienceReferences\"}}]\n"])</script><script>self.__next_f.push([1,"1b:[\"$\",\"$d\",null,{\"children\":[\"$\",\"$L2f\",null,{\"isInPreviewMode\":false}]}]\n"])</script></body></html>
[{"id":"4d0a8351-de35-4878-8a68-b83e23e196e7","title":"Landen en gebieden","created":"2022-02-10T13:30:54+00:00","changed":"2026-04-02T08:38:45+00:00","intro":"Bij het betreden van een buitenlandse markt komt nogal wat kijken. Wij helpen u zich op buitenlandse markten te oriënteren en zakenpartners te vinden. Op onze pagina's over landen, gebieden of regio's vindt u alles over handelswetgeving, sectoren, handelscijfers en subsidies.","countries":[],"sectors":[],"subjects":["Internationaal ondernemen","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Landen","Betalingsverkeer"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden"},{"id":"0f209776-fe40-4c4e-ac07-f1aabb2b0d85","title":"Missiegedreven innovatie","created":"2022-02-10T13:30:54+00:00","changed":"2026-06-22T09:40:30+00:00","intro":"Nederland staat voor grote maatschappelijke uitdagingen. Die vragen om stevige oplossingen en succesvolle innovaties. Bedrijven, kennisinstellingen, overheden en maatschappelijke organisaties werken daarom samen aan 5 centrale missies voor de toekomst. Met toonaangevende innovatie en kennis over energie, voedsel, water, zorg en veiligheid. U kunt hier ook van profiteren en impact maken. Zowel met technologische als met niet-technologische oplossingen.","countries":[],"sectors":["Landbouw","Tuinbouw","Chemische industrie","Creatieve industrie","Elektronica-industrie (waaronder HTSM)","ICT","Gezondheidszorg","Vervoer en logistiek","Voedings- en genotmiddelen","Watersector"],"subjects":["Innovatie, onderzoek en onderwijs"],"subsidies":[],"tags":["Topsectorenbeleid","Innovatief ondernemen"],"targets":["Grootbedrijf","MKB (ook zzp)","Non-profit / NGO","School / Kennisinstelling"],"type":"summary","url":"/onderwerpen/missiegedreven-innovatie"},{"id":"b4bdb116-6fb7-4cb2-8734-63c638c1e078","title":"Ondernemen in België","created":"2011-12-13T13:36:38+00:00","changed":"2026-09-29T10:46:59+00:00","intro":"Ons buurland België biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in de verduurzaming van de landbouw en circulaire bouw. Onderschat de cultuurverschillen tijdens het zakendoen niet. Belgen zijn formeler en beleefder dan Nederlanders en een vertrouwensband is heel belangrijk. Op deze pagina vindt u zowel specifieke informatie over België als algemene informatie voor uw exportplannen.","countries":[{"name":"België","isoalpha2":"BE"},{"name":"Europa","isoalpha2":""},{"name":"West-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/belgie"},{"id":"4c40bbdb-ff5c-434b-81ba-9d27b8223c7d","title":"Ondernemen in Duitsland","created":"2020-06-27T20:57:05+00:00","changed":"2026-09-25T08:29:29+00:00","intro":"Ons buurland Duitsland biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in de sectoren hernieuwbare energie en duurzame mobiliteit. Onderschat de cultuurverschillen tijdens het zakendoen in Duitsland niet. De Duitse zakencultuur is formeler dan in Nederland en geduld is vaak nodig. Op deze pagina vindt u zowel specifieke informatie over Duitsland als algemene informatie voor uw exportplannen.","countries":[{"name":"Duitsland","isoalpha2":"DE"},{"name":"Europa","isoalpha2":""},{"name":"West-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/duitsland"},{"id":"10f3b244-f74c-42c4-b197-9fcea4d33105","title":"Ondernemen in Frankrijk","created":"2011-07-01T08:32:14+00:00","changed":"2026-09-17T10:29:51+00:00","intro":"Frankrijk biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in de landbouw- en waterstofsector. Let wel op de verschillen in de zakencultuur. Het is in Frankrijk belangrijk om vertrouwen op te bouwen en minder direct te zijn. Op deze pagina vindt u zowel specifieke informatie over Frankrijk als algemene informatie voor uw exportplannen.","countries":[{"name":"Frankrijk","isoalpha2":"FR"},{"name":"Europa","isoalpha2":""},{"name":"West-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/frankrijk"},{"id":"fad2b59c-ff8d-4a6f-adc5-66bd197deb9c","title":"Ondernemen in Bulgarije","created":"2012-01-13T10:24:01+00:00","changed":"2026-09-30T11:09:31+00:00","intro":"Bulgarije biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in ICT, transport en de textielsector. Zakendoen gaat wel iets anders dan in Nederland en kan langer duren dan u gewend bent. Op deze pagina vindt u zowel specifieke informatie over Bulgarije als algemene informatie voor uw exportplannen.","countries":[{"name":"Bulgarije","isoalpha2":"BG"},{"name":"Europa","isoalpha2":""},{"name":"Oost-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/bulgarije"},{"id":"f3a80259-4671-44cf-8669-bb6990f3dc6a","title":"Ondernemen in Oostenrijk","created":"2011-09-21T08:25:31+00:00","changed":"2026-09-24T09:13:10+00:00","intro":"Oostenrijk biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in de (duurzame) mobiliteits- en auto-industrie. Het is verstandig om rekening te houden met cultuurverschillen tijdens het zakendoen. De Oostenrijkse zakencultuur is bijvoorbeeld formeler dan de Nederlandse. Op deze pagina vindt u zowel specifieke informatie over Oostenrijk als algemene informatie voor uw exportplannen.","countries":[{"name":"Oostenrijk","isoalpha2":"AT"},{"name":"Europa","isoalpha2":""},{"name":"Midden-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/oostenrijk"},{"id":"ee705d16-3726-48b3-b172-b37167ea5f6c","title":"Ondernemen in Zwitserland","created":"2012-08-07T09:16:10+00:00","changed":"2026-09-03T12:12:20+00:00","intro":"Zwitserland biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in de gezondheidszorg of fietsinfrastructuur. Wel is het handig om rekening te houden met de Zwitserse zakencultuur. Zo zijn Zwitsers precies, correct en formeel tijdens het zakendoen. Op deze pagina vindt u zowel specifieke informatie over Zwitserland als algemene informatie voor uw exportplannen.","countries":[{"name":"Zwitserland","isoalpha2":"CH"},{"name":"Europa","isoalpha2":""},{"name":"Midden-Europa","isoalpha2":""},{"name":"West-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/zwitserland"},{"id":"d272e7fa-3a27-45d0-b5d7-2566a8fecd9b","title":"Ondernemen in Hongarije","created":"2012-10-26T08:06:23+00:00","changed":"2026-09-30T11:14:19+00:00","intro":"Hongarije biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in precisielandbouw en hernieuwbare energie. Houd wel rekening met verschillen in de zakencultuur. Zo communiceren Hongaren niet zo direct als Nederlanders. Op deze pagina vindt u zowel specifieke informatie over Hongarije als algemene informatie voor uw exportplannen.","countries":[{"name":"Hongarije","isoalpha2":"HU"},{"name":"Europa","isoalpha2":""},{"name":"Midden-Europa","isoalpha2":""},{"name":"Oost-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/hongarije"},{"id":"1c7cb114-53c8-4a75-9718-65e7ba86159c","title":"Ondernemen in Polen","created":"2011-11-21T15:00:15+00:00","changed":"2026-09-30T11:18:52+00:00","intro":"Polen biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in waterstof en duurzame mobiliteit in steden. Wilt u zakendoen in Polen? Maak een goede start en verdiep uw kennis van de Poolse zakencultuur, markt, regels en meer. Ook vindt u hier handige algemene informatie voor uw exportplannen.","countries":[{"name":"Polen","isoalpha2":"PL"},{"name":"Europa","isoalpha2":""},{"name":"Midden-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/polen"},{"id":"d9597914-bfda-465b-9f6e-d8085cb6af56","title":"Ondernemen in Tsjechië","created":"2011-10-05T12:21:10+00:00","changed":"2026-09-30T15:29:52+00:00","intro":"Wat maakt zakendoen in Tsjechië anders dan in Nederland? Hoewel Tsjechië net als Nederland bij de Europese Unie hoort, zijn er toch verschillen. Het land gebruikt bijvoorbeeld de Tsjechische kroon (CZK) in plaats van de euro en de zakencultuur is anders. Tegelijkertijd liggen er mooie zakelijke kansen.","countries":[{"name":"Tsjechië","isoalpha2":"CZ"},{"name":"Europa","isoalpha2":""},{"name":"Midden-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/tsjechie"},{"id":"9fa6f30d-c36f-4445-aec5-ad0e2740f303","title":"Ondernemen in Roemenië","created":"2011-11-21T10:17:31+00:00","changed":"2026-09-30T11:20:47+00:00","intro":"Roemenië biedt veel mooie kansen voor Nederlandse ondernemers. Denk aan de bloemen- en gezondheidsector. Vertrouwen en een persoonlijke aanpak is essentieel bij het opbouwen van zakenrelaties in Roemenië. Houd hier rekening mee. Bekijk onze specifieke informatie over Roemenië en algemene informatie voor uw exportplannen.","countries":[{"name":"Roemenië","isoalpha2":"RO"},{"name":"Europa","isoalpha2":""},{"name":"Oost-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/roemenie"},{"id":"5b21494e-8206-4736-8526-ef0cc8853aba","title":"Ondernemen in Rusland","created":"2020-01-10T13:51:59+00:00","changed":"2026-06-08T14:17:54+00:00","intro":"De oorlog in Oekraïne heeft invloed op het zakendoen in Rusland. Informeer uzelf over de geldende sancties en breng in kaart wat de gevolgen zijn voor uw bedrijf.","countries":[{"name":"Rusland","isoalpha2":"RU"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/rusland"},{"id":"a9bf3157-84e9-4e51-ac56-8f3a826325a4","title":"Ondernemen in Oekraïne","created":"2011-11-14T14:57:02+00:00","changed":"2026-09-03T09:37:59+00:00","intro":"De Russische inval in Oekraïne heeft zakendoen in het land ingrijpend veranderd. Hoewel de oorlog in Oekraïne nog niet is afgelopen, wordt er al gewerkt aan de wederopbouw van het land. De Nederlandse overheid ondersteunt Nederlandse ondernemers die hier een rol in willen spelen. Bekijk onze informatie of neem contact op voor advies op maat.","countries":[{"name":"Oekraïne","isoalpha2":"UA"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/oekraine"},{"id":"b8093b0d-67f1-432e-a53c-aad1860e650c","title":"Ondernemen in Japan","created":"2011-06-22T14:51:51+00:00","changed":"2025-12-18T10:36:08+00:00","intro":"Japan biedt mooie kansen voor Nederlandse ondernemers. Zoals in technologie, gezondheidszorg en duurzame energie. Er zijn grote verschillen tussen de Nederlandse en Japanse zakencultuur. Zo zijn Japanse bedrijven hiërarchisch en worden beslissingen niet direct genomen. Op deze pagina vindt u zowel specifieke informatie over Japan als algemene informatie voor uw exportplannen.","countries":[{"name":"Japan","isoalpha2":"JP"},{"name":"Oost-Azië","isoalpha2":""},{"name":"Azië","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/japan"},{"id":"54dc8fa9-d5c4-4e5b-aeba-dd2fbb9b59f4","title":"Ondernemen in Zuid-Korea","created":"2012-07-25T13:01:41+00:00","changed":"2025-06-11T14:20:46+00:00","intro":"Zuid-Korea is een modern en snelgroeiend land met veel kansen voor Nederlandse bedrijven. Het land heeft een sterke economie, een goed opgeleide bevolking en een goede ligging als toegangspoort tot de grotere Aziatische markt. Ondernemen in Zuid-Korea vraagt wel om een goede voorbereiding en kennis van de lokale cultuur en regels.","countries":[{"name":"Zuid-Korea","isoalpha2":"KR"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/zuid-korea"},{"id":"d1f959dc-dc41-4ab8-a690-9232de139050","title":"Ondernemen in Taiwan","created":"2012-09-21T09:41:41+00:00","changed":"2026-09-07T09:52:45+00:00","intro":"Taiwan is een van de snelstgroeiende economieen ter wereld en zet vol in op innovatie. Dat biedt enorme kansen voor Nederlandse ondernemers. Wel zijn er verschillen op het gebied van zakencultuur. Op deze pagina vindt u zowel specifieke informatie over Taiwan als algemene informatie voor uw exportplannen.","countries":[{"name":"Taiwan","isoalpha2":"TW"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/taiwan"},{"id":"fb01125b-77a7-48fd-a5e3-5bc82edf1a45","title":"Ondernemen in China","created":"2012-12-11T14:01:36+00:00","changed":"2026-06-01T10:13:46+00:00","intro":"Zakendoen in China komt met kansen en risico's. Met 1,4 miljard inwoners zijn er grote regionale verschillen in welvaart, ontwikkeling en klimaat. Ga daarom goed voorbereid aan de slag. Op deze pagina vindt u zowel specifieke informatie over China als algemene informatie voor uw export- en investeringsplannen.&nbsp;","countries":[{"name":"China","isoalpha2":"CN"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/china"},{"id":"19fa9f0c-9fd9-48c7-adf7-5cf38158a63e","title":"Ondernemen in Argentinië","created":"2013-01-11T12:52:54+00:00","changed":"2026-06-30T12:27:08+00:00","intro":"Wat maakt zakendoen in Argentinië anders dan in Nederland? Het Zuid-Amerikaanse land biedt veel interessante sectoren om zaken in te doen, vooral in de dienstensector en energiewinning. Daarnaast maakt het toekomstige EU-Mercosur akkoord het voor Nederlandse ondernemers gemakkelijker om zaken te doen in Argentinië.","countries":[{"name":"Argentinië","isoalpha2":"AR"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen","Support International Business (SIB)","DHI","Partners for International Business (PIB)"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/argentinie"},{"id":"ff527051-d1c3-4320-954a-5ce76fe0b6e0","title":"Ondernemen in Brazilië","created":"2011-06-20T14:02:10+00:00","changed":"2026-06-30T12:27:05+00:00","intro":"Brazilië is een van de meest veelbelovende economieën ter wereld. Met rijke natuurlijke hulpbronnen, een groeiende middenklasse en een strategische ligging biedt het land talloze kansen voor Nederlandse ondernemers. Daarnaast maakt het toekomstige EU-Mercosur-akkoord het voor u als ondernemer gemakkelijker om zaken te doen in het land.","countries":[{"name":"Brazilië","isoalpha2":"BR"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen","Support International Business (SIB)","DHI"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/brazilie"},{"id":"ffcd0b58-ba73-4f3f-84a0-cc28dd52a7be","title":"Ondernemen in Chili","created":"2012-08-27T11:49:32+00:00","changed":"2026-02-12T15:10:08+00:00","intro":"Chili is een van de meest stabiele en open economieën in Latijns-Amerika, met een sterk juridisch kader, lage corruptie en een goed ontwikkelde infrastructuur. Het land biedt aantrekkelijke kansen voor ondernemers. Het land is ook een uitstekende basis voor internationale handel. Een goed netwerk en samenwerking met lokale partners maken het verschil.","countries":[{"name":"Chili","isoalpha2":"CL"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen","Support International Business (SIB)","DHI"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/chili"},{"id":"97224a72-3ed1-4763-a774-a30cb32db55f","title":"Ondernemen in Mexico","created":"2011-07-20T08:35:53+00:00","changed":"2026-09-30T14:10:39+00:00","intro":"Mexico biedt mooie kansen voor Nederlandse ondernemers. Het land is aantrekkelijk vanwege de jonge, goed opgeleide beroepsbevolking, lage operationele kosten en een groeiende economie. Daarnaast maakt het handelsakkoord EU - Mexico het voor Nederlandse ondernemers gemakkelijker om zaken te doen in Mexico.","countries":[{"name":"Mexico","isoalpha2":"MX"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen","Support International Business (SIB)","DHI"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/mexico"},{"id":"390588ae-f320-4389-8225-ab8f90b393fc","title":"Ondernemen in Spanje","created":"2011-06-14T19:53:37+00:00","changed":"2026-08-03T07:47:36+00:00","intro":"Wat maakt zakendoen in Spanje anders dan in Nederland? Hoewel Spanje net als Nederland bij de Europese Unie hoort, zijn er toch verschillen. De Spaanse bureaucratie is soms complex. Ook de zakencultuur is anders. Tegelijkertijd liggen er mooie kansen voor Nederlandse ondernemers.&nbsp;","countries":[{"name":"Spanje","isoalpha2":"ES"},{"name":"Europa","isoalpha2":""},{"name":"Zuid-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/spanje"},{"id":"d1207b4f-a3b9-42fc-99ca-b3645451bbe4","title":"Ondernemen in Portugal","created":"2011-07-20T09:52:49+00:00","changed":"2026-09-24T09:14:10+00:00","intro":"Wilt u ondernemen in Portugal? Ga goed voorbereid aan de slag. Op deze pagina vindt u zowel specifieke informatie over Portugal als algemene informatie voor uw exportplannen. Van exportregels tot internationaal maatschappelijk verantwoord ondernemen, wij helpen u verder.","countries":[{"name":"Portugal","isoalpha2":"PT"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/portugal"},{"id":"27e9e38a-460a-4946-af6f-2e172ce6bb65","title":"Ondernemen in Italië","created":"2012-07-17T08:19:02+00:00","changed":"2026-09-29T11:42:34+00:00","intro":"Wat maakt zakendoen in Italië anders dan in Nederland? Hoewel Italië net als Nederland bij de Europese Unie hoort, zijn er toch verschillen. De logistiek is soms complex, regio's hebben een sterke eigen identiteit en de zakencultuur is even wennen. Tegelijkertijd liggen er mooie kansen voor Nederlandse ondernemers.&nbsp;","countries":[{"name":"Italië","isoalpha2":"IT"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/italie"},{"id":"139b6264-44bd-4ddb-9521-8b48e825e025","title":"Ondernemen in Turkije","created":"2012-08-13T11:41:03+00:00","changed":"2026-08-19T20:53:15+00:00","intro":"Turkije biedt mooie kansen voor Nederlandse ondernemers. Denk aan duurzame energie of de circulaire economie. Houd wel rekening met verschillen in de zakelijke cultuur. Zo zijn oogcontact houden, mimiek en gebaren belangrijk in de Turkse communicatie. Op deze pagina vindt u zowel specifieke informatie over Turkije als algemene informatie voor uw exportplannen.","countries":[{"name":"Turkije","isoalpha2":"TR"},{"name":"Azië","isoalpha2":""},{"name":"West-Azië","isoalpha2":""},{"name":"Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/turkije"},{"id":"c93c38a7-5651-40d3-a956-f5053808c669","title":"Ondernemen in Zuid-Afrika","created":"2012-01-19T14:54:53+00:00","changed":"2026-08-26T14:03:26+00:00","intro":"De Zuid-Afrikaanse economie is een van de grootste economieën van Afrika. Er liggen mooie kansen voor Nederlandse ondernemers, bijvoorbeeld in de sectoren landbouw en infrastructuur. Ook de ontwikkelingen op het gebied van e-health en gezondheidszorgtechnologie bieden kansen. Op deze pagina vindt u zowel specifieke informatie over Zuid-Afrika als algemene informatie voor uw exportplannen.","countries":[{"name":"Zuid-Afrika","isoalpha2":"ZA"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/zuid-afrika"},{"id":"00f958ba-1fc4-4f5d-bb41-b47c0d5b942d","title":"Ondernemen in India","created":"2011-07-01T15:01:15+00:00","changed":"2026-05-12T12:28:50+00:00","intro":"India is het dichtstbevolkte land ter wereld en heeft een snelgroeiende economie. Dat biedt veel kansen voor Nederlandse ondernemers, bijvoorbeeld op het gebied van technologie, infrastructuur en duurzaamheid. De manier van zakendoen verschilt en ook de regels kunnen ingewikkeld zijn. Op deze pagina vindt u zowel specifieke informatie over India als algemene informatie voor uw export- en investeringsplannen.&nbsp;","countries":[{"name":"India","isoalpha2":"IN"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Economie","Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/india"},{"id":"7f9d5ed9-f3e3-4d13-8bcd-4e35e41c60c3","title":"Ondernemen in Saoedi-Arabië","created":"2012-08-16T11:26:59+00:00","changed":"2026-04-13T13:27:06+00:00","intro":"Saoedi-Arabië biedt mooie kansen voor Nederlandse ondernemers, bijvoorbeeld in duurzame energie, mobiliteit en landbouw. Maar houd ook rekening met zakelijke cultuurverschillen. Neem de tijd om een zakenrelatie op te bouwen in Saoedi-Arabië. Op deze pagina vindt u zowel specifieke informatie over Saoedi-Arabië als algemene informatie voor uw exportplannen.","countries":[{"name":"Saoedi-Arabië","isoalpha2":"SA"},{"name":"Golfstaten","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/saoedi-arabie"},{"id":"2579b397-96be-407a-89fd-5bc236eefde0","title":"Ondernemen in Qatar","created":"2013-03-22T13:53:37+00:00","changed":"2026-04-13T13:24:46+00:00","intro":"Qatar biedt mooie kansen voor Nederlandse ondernemers. Zoals in duurzame energie en mobiliteit. Let op culturele verschillen in het zakendoen. Zo zijn goede persoonlijke relaties belangrijk in Qatar. Op deze pagina vindt u zowel specifieke informatie over Qatar als algemene informatie voor uw exportplannen.","countries":[{"name":"Qatar","isoalpha2":"QA"},{"name":"Golfstaten","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/qatar"},{"id":"ad4d4f62-d287-413d-a4d7-f332d7619991","title":"Ondernemen in de Verenigde Arabische Emiraten (VAE)","created":"2012-10-22T13:37:02+00:00","changed":"2026-04-13T13:25:50+00:00","intro":"De Verenigde Arabische Emiraten bieden mooie kansen voor Nederlandse ondernemers, bijvoorbeeld op het gebied van waterstof en zonne-energie. Maar er zijn ook cultuurverschillen op zakelijk gebied. Zo is het belangrijk te investeren in persoonlijk contact en zakenrelaties. Op deze pagina vindt u zowel specifieke informatie over de VAE als algemene informatie voor uw exportplannen.","countries":[{"name":"Verenigde Arabische Emiraten","isoalpha2":"AE"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/vae"},{"id":"a14dad64-f9d3-4acc-a549-7fe4ab90dd27","title":"Ondernemen in Vietnam","created":"2012-10-30T16:24:02+00:00","changed":"2026-05-11T05:18:04+00:00","intro":"De Vietnamese economie blijft groeien. Nederlandse ondernemers zijn in Vietnam overal actief, van aquacultuur tot veeteelt. Ook de havensector, logistiek en hightech-industrie bieden zakelijke kansen. Op deze pagina vindt u zowel specifieke informatie over Vietnam als algemene informatie voor uw exportplannen.","countries":[{"name":"Vietnam","isoalpha2":"VN"},{"name":"Zuidoost-Azië","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/vietnam"},{"id":"a87e0495-a9d3-478a-a50e-be51c2388cc6","title":"Ondernemen in Australië","created":"2011-06-15T19:01:53+00:00","changed":"2026-04-17T08:27:38+00:00","intro":"Australië is een belangrijke handelspartner voor Nederland. De Australische zakenmentaliteit is vergelijkbaar met die in West-Europa. Het land heeft een sterke economie, transparante regelgeving en veel grondstoffen. Kansen voor ondernemers liggen er vooral in de sectoren agrifood, energie en afvalverwerking. Ook in de bouwsector zijn er mogelijkheden. Op deze pagina vindt u zowel specifieke informatie over Australië als algemene informatie voor uw exportplannen.","countries":[{"name":"Australië","isoalpha2":"AU"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/australie"},{"id":"34244ee5-9cf3-471e-9673-db0c584d490d","title":"Ondernemen in Egypte","created":"2011-06-20T13:18:33+00:00","changed":"2026-09-30T15:55:06+00:00","intro":"Egypte biedt mooie kansen voor Nederlandse ondernemers en hun expertise. Bijvoorbeeld als het gaat om het moderniseren van de agrosector of watermanagement. Tegelijkertijd zijn er wel uitdagingen, bijvoorbeeld op het gebied van maatschappelijk verantwoord ondernemen. Op deze pagina vindt u zowel specifieke informatie over zakendoen in Egypte als algemene informatie voor uw exportplannen.","countries":[{"name":"Egypte","isoalpha2":"EG"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/egypte"},{"id":"af803d61-7ae8-4cea-9f2e-921acbbd5736","title":"Ondernemen in Thailand","created":"2011-07-20T12:13:30+00:00","changed":"2026-03-24T15:12:07+00:00","intro":"Thailand ligt centraal in de Zuidoost-Aziatische regio. Het land biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld op het gebied van landbouw of havenontwikkeling. Op deze pagina vindt u zowel specifieke informatie over Thailand als algemene informatie voor uw exportplannen.","countries":[{"name":"Thailand","isoalpha2":"TH"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/thailand"},{"id":"fd7e6f05-ccc2-492e-a518-8abff1997721","title":"Ondernemen in Indonesië","created":"2012-07-19T07:45:12+00:00","changed":"2026-05-08T14:19:20+00:00","intro":"De Indonesische economie is de afgelopen jaren sterk gegroeid. Van alle Europese landen is Nederland de grootste investeerder in Indonesië. Veel Nederlandse ondernemers doen al met succes zaken in 's werelds grootste eilandenstaat. Op deze pagina vindt u zowel specifieke informatie over Indonesië als algemene informatie voor uw exportplannen.","countries":[{"name":"Indonesië","isoalpha2":"ID"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/indonesie"},{"id":"355d2371-af26-4058-a89f-3dca72b668da","title":"Ondernemen in Maleisië","created":"2011-07-20T08:25:01+00:00","changed":"2026-02-06T12:18:59+00:00","intro":"De Maleisische economie groeit gestaag. Het land ontwikkelt zich de komende jaren tot een hooginkomensland. Nederlandse ondernemers zijn in Maleisië al actief in onder meer de halfgeleiderindustrie, landbouw, havenontwikkeling en watermanagement. Op deze pagina vindt u zowel specifieke informatie over Maleisië als algemene informatie voor uw exportplannen.","countries":[{"name":"Maleisië","isoalpha2":"MY"},{"name":"Zuidoost-Azië","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["MKB (ook zzp)","Grootbedrijf"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/maleisie"},{"id":"d142d98c-994c-45bf-b953-27d5d5e5404e","title":"Ondernemen in Ghana","created":"2012-03-29T22:00:00+00:00","changed":"2026-05-08T09:07:57+00:00","intro":"Ghana biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in de landbouw, tuinbouw en cacaosector. Houd wel rekening met verschillen in de zakencultuur. Zo zijn Ghanezen indirect in de communicatie en is oogcontact belangrijk. Op deze pagina vindt u zowel specifieke informatie over Ghana als algemene informatie voor uw exportplannen.","countries":[{"name":"Ghana","isoalpha2":"GH"},{"name":"Afrika","isoalpha2":""},{"name":"West-Afrika","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/ghana"},{"id":"062c3bb7-8ad3-445a-bd3d-14d05632eb56","title":"Ondernemen in Hongkong SAR","created":"2011-07-04T22:00:00+00:00","changed":"2025-08-04T11:41:57+00:00","intro":"Wilt u ondernemen in Hongkong SAR (Special Administrative Region)? Ga goed voorbereid aan de slag. Verdiep u in de markt: hoe werkt export naar Hongkong SAR en hoe vindt u een betrouwbare zakenpartner? Gelukkig staat u niet alleen. RVO helpt u met uw internationale ambities. Heeft u zakelijke hulp ter plaatse nodig? Dan staat het consulaat-generaal in Hongkong SAR voor u klaar.","countries":[{"name":"Hongkong SAR","isoalpha2":"HK"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/hongkong-sar"},{"id":"53f9bc44-f350-441e-8585-d7b7789772bc","title":"Ondernemen in Marokko","created":"2012-01-24T12:31:11+00:00","changed":"2026-08-18T13:02:03+00:00","intro":"De Marokkaanse economie groeit hard. Het land is na Egypte onze belangrijkste handelspartner in Noord-Afrika. Zonne-energie is een van de meest veelbelovende markten in Marokko. Maar ook op het gebied van klimaatslimme landbouw en waterbeheer liggen er veel zakelijke kansen. Op deze pagina vindt u zowel specifieke informatie over Marokko als algemene informatie voor uw exportplannen.","countries":[{"name":"Marokko","isoalpha2":"MA"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/marokko"},{"id":"c231f5b4-62cf-4073-b6e9-33a13084040f","title":"Ondernemen in Colombia","created":"2012-10-04T09:27:37+00:00","changed":"2026-06-30T12:32:40+00:00","intro":"Wilt u ondernemen in Colombia? Ga goed voorbereid aan de slag. Gelukkig staat u niet alleen. RVO helpt u met uw internationale ambities. Op deze pagina vindt u zowel specifieke informatie over Colombia als algemene informatie voor uw exportplannen.","countries":[{"name":"Colombia","isoalpha2":"CO"}],"sectors":[],"subjects":["Internationaal ondernemen","Ontwikkelingssamenwerking","Landeninformatie"],"subsidies":["Programma zakendoen","Support International Business (SIB)","DHI"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/colombia"},{"id":"1c642e40-674f-4436-8c28-5aba81ae04d9","title":"Ondernemen in Iran","created":"2012-08-07T09:15:15+00:00","changed":"2026-04-13T13:22:55+00:00","intro":"Sancties beïnvloeden de handel tussen Iran en Nederland. Als u zaken wilt doen in Iran, moet u rekening houden met de uitdagingen die hierbij horen en u goed voorbereiden. Van exportregels tot internationaal maatschappelijk verantwoord ondernemen, wij helpen u verder.","countries":[{"name":"Iran","isoalpha2":"IR"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/iran"},{"id":"18346ddd-4316-4d28-a848-9548677a517d","title":"Ondernemen in Kenia","created":"2011-07-20T07:49:30+00:00","changed":"2026-09-30T09:08:09+00:00","intro":"Kenia biedt mooie kansen voor Nederlandse ondernemers. In de agrologistiek en duurzame energie bijvoorbeeld. Maar let op de grote verschillen tussen de Nederlandse en Keniaanse zakencultuur. Hiërarchie is erg belangrijk in Kenia en er is meer respect voor autoriteit dan in Nederland. Op deze pagina vindt u zowel specifieke informatie over Kenia, als algemene informatie voor uw exportplannen.","countries":[{"name":"Kenia","isoalpha2":"KE"}],"sectors":[],"subjects":["Internationaal ondernemen","Ontwikkelingssamenwerking","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/kenia"},{"id":"978c4daf-5b05-4f43-beb4-9ec7a5ad1df1","title":"Ondernemen in Singapore","created":"2012-08-09T09:41:29+00:00","changed":"2026-01-15T17:07:02+00:00","intro":"Het internationale karakter van Singapore biedt met veel mogelijkheden voor Nederlandse ondernemers. De kleine eilandstadstaat ligt centraal in Zuidoost-Azië en heeft een uitstekende digitale infrastructuur. Op deze pagina vindt u zowel specifieke informatie over Singapore als algemene informatie voor uw exportplannen.","countries":[{"name":"Singapore","isoalpha2":"SG"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/singapore"},{"id":"5bb3b4fc-fbb7-409c-8e34-5a18f3d76bf7","title":"Ondernemen in Suriname","created":"2011-07-20T12:07:01+00:00","changed":"2026-09-18T08:58:48+00:00","intro":"Suriname is een veelbelovende bestemming voor Nederlandse ondernemers. Door de strategische ligging aan de Atlantische kust, veel natuurlijke hulpbronnen en een groeiende economie biedt het land veel kansen voor investeringen. Suriname vormt een uniek knooppunt waar u succesvol zaken kunt doen en naartoe kunt exporteren.","countries":[{"name":"Suriname","isoalpha2":"SR"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen","Support International Business (SIB)","DHI"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/suriname"},{"id":"89b80356-6388-4f22-bbe7-369c5763fe24","title":"Ondernemen in Bangladesh","created":"2020-03-14T10:29:15+00:00","changed":"2026-05-08T08:54:58+00:00","intro":"Bangladesh heeft een snelgroeiende economie en stimuleert buitenlandse investeringen. Voor Nederlandse ondernemers biedt dat kansen in onder meer de landbouw- en tuinbouw, textiel en watermanagement. Op deze pagina vindt u zowel specifieke informatie over Bangladesh als algemene informatie voor uw exportplannen.","countries":[{"name":"Bangladesh","isoalpha2":"BD"},{"name":"Azië","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie","Ontwikkelingssamenwerking"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/bangladesh"},{"id":"40da667d-3fd8-4057-8f71-093f8231fae1","title":"Ondernemen in Estland","created":"2012-01-23T19:19:40+00:00","changed":"2026-09-24T09:02:25+00:00","intro":"Estland biedt veel mooie kansen voor Nederlandse ondernemers. Vooral in de ICT-sector, omdat Estland uitblinkt in digitalisering. Ook in de infrastructuursector is veel mogelijk. De Baltische staten, waaronder Estland, voeren namelijk een groot project uit om hun spoorwegen aan te sluiten op het Europese spoorwegnetwerk.&nbsp;&nbsp;","countries":[{"name":"Estland","isoalpha2":"EE"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen","Nordics & Baltics"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/estland"},{"id":"6df75bef-81d5-4d89-ac31-ca589d7a152c","title":"Ondernemen in Ierland","created":"2012-01-23T19:45:20+00:00","changed":"2026-09-24T09:05:25+00:00","intro":"Ierland biedt mooie kansen voor Nederlandse ondernemers. Bijvoorbeeld in de sectoren agrifood en energie. Zo heeft Ierland veel potentie voor de productie van offshore windenergie. Ieren bouwen graag een persoonlijke band op met hun zakenpartners. Op deze pagina vindt u zowel specifieke informatie over Ierland als algemene informatie voor uw exportplannen.","countries":[{"name":"Ierland","isoalpha2":"IE"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/ierland"},{"id":"c04d4dfb-a958-4bb5-adc8-09c5e8b728bd","title":"Ondernemen in Israël","created":"2012-10-22T13:04:22+00:00","changed":"2026-09-24T12:59:07+00:00","intro":"Doet u zaken in Israël? Op deze pagina vindt u zowel specifieke informatie over Israël als algemene informatie over exporteren. Van exportregels, zakelijke gewoonten tot internationaal maatschappelijk verantwoord ondernemen.","countries":[{"name":"Israël","isoalpha2":"IL"}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/israel"},{"id":"1522e07a-ffd9-4f44-a3d2-c9b8222b027b","title":"Ondernemen in Litouwen","created":"2012-01-23T20:15:31+00:00","changed":"2026-09-24T09:05:29+00:00","intro":"Litouwen biedt veel mooie kansen voor Nederlandse ondernemers. Zo liggen er bijvoorbeeld kansen in de Litouwse offshore windenergiesector. Wel is het goed om rekening te houden met de verschillen in de zakencultuur. Een zakenrelatie opbouwen kost tijd in Litouwen. Op deze pagina vindt u informatie over zakendoen in Litouwen en tips voor het maken van exportplannen.","countries":[{"name":"Litouwen","isoalpha2":"LT"},{"name":"Europa","isoalpha2":""},{"name":"Oost-Europa","isoalpha2":""}],"sectors":[],"subjects":["Internationaal ondernemen","Landeninformatie"],"subsidies":["Programma zakendoen"],"tags":["Landen"],"targets":["Grootbedrijf","MKB (ook zzp)"],"type":"summary","url":"/onderwerpen/landen-en-gebieden/litouwen"}]
{"id":"KVAEG5","text":"Number of cattle","description":"Number of cattle by region, type and time","unit":"Number","suppressedDataValue":"0","updated":"2026-07-24T08:00:00","active":true,"contacts":[{"name":"Mona Larsen","phone":"+4524816847","mail":"mla@dst.dk"}],"documentation":{"id":"c11ffd79-d81b-48d1-9059-c0bfe3031e6a","url":"https://www.dst.dk/documentationofstatistics/c11ffd79-d81b-48d1-9059-c0bfe3031e6a"},"footnote":{"text":"The survey date is on the last day of each quarter, i.e. March 31, June 30, September 30 and December 31. There is a minor break in series between March 31 and June 30, 2026 in the calculation of &quot;Heifers, 2 years and over, pregnant&quot;. It is estimated that previous calculations will be 5 percent higher than the current method.","mandatory":false},"variables":[{"id":"OMRÅDE","text":"region","elimination":true,"time":false,"map":"Denmark_region_07","values":[{"id":"000","text":"All Denmark"},{"id":"084","text":"Region Hovedstaden"},{"id":"15","text":"Provinces Byen København, Københavns omegn and Nordsjælland"},{"id":"04","text":"Province Bornholm"},{"id":"085","text":"Region Sjælland"},{"id":"083","text":"Region Syddanmark"},{"id":"07","text":"Province Fyn"},{"id":"08","text":"Province Sydjylland"},{"id":"082","text":"Region Midtjylland"},{"id":"09","text":"Province Østjylland"},{"id":"10","text":"Province Vestjylland"},{"id":"081","text":"Region Nordjylland"}]},{"id":"DYR","text":"type","elimination":false,"time":false,"values":[{"id":"D17","text":"Cattle, total"},{"id":"D2","text":"Bull-calves and steer-calves,- under 1/2 year"},{"id":"D3","text":"Bull-calves and steer-calves, 1/2-1 year"},{"id":"D39","text":"Bull-calves and steer-calves, total"},{"id":"D4","text":"Bulls and bullocks, 1-2 years"},{"id":"D5","text":"Bulls and bullocks, 2 years and over"},{"id":"D52","text":"Bulls and bullocks, total"},{"id":"D53","text":"Male cattle, total"},{"id":"D6","text":"Heifer-calves, under 1/2 year"},{"id":"D7","text":"Heifer-calves, 1/2
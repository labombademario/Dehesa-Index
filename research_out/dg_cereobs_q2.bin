{"data": [{"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2023-06-21T14:09:12.429000+00:00", "deleted": null, "description": "Historique du suivi hebdomadaire national et r\u00e9gional de l'\u00e9tat des cultures de ma\u00efs du semis \u00e0 la r\u00e9colte. Ces donn\u00e9es reposent sur les observations r\u00e9alis\u00e9es par des techniciens sur le terrain,  organis\u00e9s par zone g\u00e9ographique avec un maillage permettant de couvrir la totalit\u00e9 du territoire de chaque r\u00e9gion, dans le cadre du programme C\u00e9r\u00e9'Obs.\n\nLes rapports hebdomadaires de l\u2019ann\u00e9e en cours sont mis \u00e0 jour chaque vendredi (hors pause hivernale) sur le site **https://cereobs.franceagrimer.fr/**", "description_short": null, "extras": {}, "featured": false, "frequency": "weekly", "frequency_date": "2023-06-29T00:08:57+00:00", "harvest": null, "id": "64930488d4141f679ae78d17", "internal": {"created_at_internal": "2023-06-21T14:09:12.429000+00:00", "last_modified_internal": "2026-09-16T14:12:34.332000+00:00"}, "last_modified": "2026-09-16T14:12:34.332000+00:00", "last_update": "2026-09-16T14:12:34.331000+00:00", "license": "lov2", "metrics": {"dataservices": 1, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0}, "resources_downloads": 767, "reuses": 0, "reuses_by_months": {"2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0}, "views": 6961}, "organization": {"acronym": null, "badges": [{"kind": "public-service"}, {"kind": "certified"}], "clas
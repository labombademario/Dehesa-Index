{"data": [{"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2017-07-19T16:06:28.912000+00:00", "deleted": null, "description": "Nombre d'exploitations sur PMQ", "description_short": null, "extras": {}, "featured": false, "frequency": "unknown", "frequency_date": null, "harvest": null, "id": "596f676488ee3815c9592054", "internal": {"created_at_internal": "2017-07-19T16:06:28.912000+00:00", "last_modified_internal": "2017-07-19T16:08:06.981000+00:00"}, "last_modified": "2017-07-19T16:08:06.981000+00:00", "last_update": "2017-07-19T16:07:30.240000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 110, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 3174}, "organization": {"acronym": "PMQ", "badges": [{"kind": "certified"}, {"kind": "public-service"}], "class": "Organization", "id": "594d23e688ee380a6acd18af", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/39/e72f40f41a4a04abf5f6d690fa8439.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/39/e72f40f41a4a04abf5f6d690fa8439-100.jpg", "name": "Pays Midi Quercy", "page": "https://www.data.gouv.fr/organizations/pays-midi-quercy", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "pays-midi-quercy", "uri": "https://www.data.gouv.fr/api/1/organizations/pays-midi-quercy/"}, "owner": null, "page
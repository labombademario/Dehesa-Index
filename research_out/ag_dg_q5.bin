on des donn\u00e9es": "07/05/2012", "Langue": "fran\u00e7ais", "Type de donn\u00e9es": "recensement", "datagouv_ckan_id": "1e121013-16f4-4394-a386-6ee4332c2a18", "datagouv_ckan_last_sync": "2014-09-17T03:38:00.412000"}, "featured": false, "frequency": "punctual", "frequency_date": null, "harvest": null, "id": "5369931ea3a729239d2040dc", "internal": {"created_at_internal": "2013-07-08T11:03:24.645000+00:00", "last_modified_internal": "2014-11-18T03:15:01.703000+00:00"}, "last_modified": "2014-11-18T03:15:01.703000+00:00", "last_update": "2013-11-23T11:30:21.188000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 190, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 3272}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-donnees-communales-nombre-d-exploitations-agricoles-et-superficies-par-age-du-chef-ou-du-p-0", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": false, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": false, "score": 0.6666666666666666, "spatial": true, "temporal_coverage": true, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2014-05-07T03:57:50.859000+00:00", "description": "", "extras": {"check:available": false, "check:count-availability": 117, "check:date": "2024-10-28T14:30:34.021722+00:00", "check:error": "https:///IMG/zip/age_moyennes-2.zip - Invalid redirect URL origin", "check:headers:charset": "utf-8", "check:timeout": false, "check:url": "http://agreste.agriculture.gouv.fr/IMG/zip/age_moyennes-2.zip"}, "filesize": null, "filetype": "remote", "format": "autre", "harvest": null, "id": "d3209b68-249f-47c7-88f7-946939fb180a", "internal": {"created_at_internal": "2014-05-07T03:57:50.859000+00:00", "last_modified_internal": "2013-11-23T11:30:21.188000+00:00"}, "last_modified": "2013-11-23T11:30:21.188000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/d3209b68-249f-47c7-88f7-946939fb180a", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 202}, "mime": null, "preview_url": null, "schema": null, "title": "", "type": "main", "url": "http://agreste.agriculture.gouv.fr/IMG/zip/age_moyennes-2.zip"}], "schema": null, "slug": "agreste-donnees-communales-nombre-d-exploitations-agricoles-et-superficies-par-age-du-chef-ou-du-p-0", "spatial": {"geom": null, "granularity": "other", "zones": ["country:fr"]}, "tags": [], "temporal_coverage": {"end": "2010-12-31", "start": "2000-01-01"}, "title": "Agreste - Donn\u00e9es communales \u2013 Nombre d'exploitations agricoles et superficies par \u00e2ge du chef ou du premier coexploitant \u2013 champ : moyennes et grandes exploitations - recensements agricoles 2010 et 2000", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-donnees-communales-nombre-d-exploitations-agricoles-et-superficies-par-age-du-chef-ou-du-p-0/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-05-23T10:49:44.027000+00:00", "deleted": null, "description": "Recensements agricoles de 1988, 2000 et 2010 par commune.\n\nChamp : ensemble des exploitations (hors pacages collectifs).\n\nSource :\u00a0[Agreste](http://agreste.agriculture.gouv.fr/)\n\nLes donn\u00e9es sont localis\u00e9es au si\u00e8ge de l'exploitation.\n\n**Exploitation agricole** : unit\u00e9 \u00e9conomique qui participe \u00e0 la\nproduction agricole, qui atteint une certaine dimension (1 hectare de\nsuperficie agricole utilis\u00e9e ou 20 ares de cultures sp\u00e9cialis\u00e9es ou 1\nvache ou 6 brebis-m\u00e8res ou une production sup\u00e9rieure \u00e0 5 veaux de\nbatterie...) et de gestion courante ind\u00e9pendante.\u00a0\n\n**Travail dans les exploitations agricoles** :\u00a0en unit\u00e9 de travail\nannuel.\n\n**Unit\u00e9 de travail annuel** : mesure en \u00e9quivalent temps complet du\nvolume de travail fourni par les chefs d'exploitations et coexploitants,\nles personnes de la famille, les salari\u00e9s permanents, les salari\u00e9s\nsaisonniers et par les entreprises de travaux agricoles intervenant sur\nl'exploitation. Cette notion est une estimation du volume de travail\nutilis\u00e9 comme moyen de production et non une mesure de l'emploi sur les\nexploitations agricoles.\n\n**Superficie agricole utilis\u00e9e** : superficies des terres labourables,\nsuperficies des cultures permanentes, superficies toujours en herbe,\nsuperficies de l\u00e9gumes, fleurs et autres superficies cultiv\u00e9es de\nl'exploitation agricole (en hectare).\n\n**Cheptel**:\u00a0en unit\u00e9 de gros b\u00e9tail, tous aliments.\n\n**Unit\u00e9 gros b\u00e9tail tous aliments (UGBTA)** : unit\u00e9 employ\u00e9e pour\npouvoir comparer ou agr\u00e9ger des effectifs animaux d\u2019esp\u00e8ces ou de\ncat\u00e9gories diff\u00e9rentes (par exemple, une vache laiti\u00e8re = 1,45 UGBTA,\nune vache nourrice = 0,9 UGBTA, une truie-m\u00e8re = 0,45 UGBTA).\n\n**Orientation technico-\u00e9conomique de la commune** : production dominante\nde la commune, d\u00e9termin\u00e9e selon la contribution de chaque surface ou\ncheptel de l'ensemble des exploitations agricoles de la commune \u00e0 la\nproduction brute standard.\n\n**Superficie en terres labourables** : superficie en c\u00e9r\u00e9ales, cultures\nindustrielles, l\u00e9gumes secs et prot\u00e9agineux, fourrages (hors superficie\ntoujours en herbe), tubercules, l\u00e9gumes de plein champ, jach\u00e8res (en\nhectare).\n\n**Superficie en cultures permanentes**: superficie en vignes, vergers,\np\u00e9pini\u00e8res ornementales, fruiti\u00e8res et foresti\u00e8res, cultures de\nmiscanthus, jonc, m\u00fbrier, osier, arbre truffier, \u00e0 laquelle s'ajoute la\nsuperficie en arbres de No\u00ebl en 2010 (en hectare).\n\n**Superficie toujours en herbe** : prairies naturelles ou sem\u00e9es depuis\nsix ans ou plus (en hectare).", "description_short": null, "extras": {"datagouv_ckan_id": "3a6c4a7b-e407-4b43-92f2-9d0bfe469319", "datagouv_ckan_last_sync": "2014-09-16T10:03:22.711000", "remote_url": "http://data.corse.fr/explore/dataset/recensementagricole/"}, "featured": false, "frequency": "unknown", "frequency_date": null, "harvest": null, "id": "5380850fa3a7297e4d35d722", "internal": {"created_at_internal": "2014-05-23T10:49:44.027000+00:00", "last_modified_internal": "2016-03-15T17:33:36.881000+00:00"}
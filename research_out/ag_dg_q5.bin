_2020_2.explporcsengr20&selcodgeo=56123&t=A02"}, {"checksum": null, "created_at": "2014-05-07T03:57:49.288000+00:00", "description": "Tableaux interactifs mis \u00e0 disposition sur le site internet du Service statistique du Minist\u00e8re en charge de l'agriculture", "extras": {"check:available": false, "check:count-availability": 8, "check:date": "2024-06-10T08:32:15.463584+00:00", "check:error": "Cannot connect to host www.agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:1123)')]", "check:timeout": false, "check:url": "https://www.agreste.agriculture.gouv.fr/agreste-web/disaron/Recensements+agricoles/09facbca-808a-4f4a-b5c0-bec9618b88da!cda8b080-3e9e-4368-b41d-7a29c1da0be6/search/"}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "6cb5c9d2-933e-46c2-bd6d-58fd5eae1492", "internal": {"created_at_internal": "2014-05-07T03:57:49.288000+00:00", "last_modified_internal": "2020-06-15T18:40:17.680000+00:00"}, "last_modified": "2020-06-15T18:40:17.680000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/6cb5c9d2-933e-46c2-bd6d-58fd5eae1492", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 11022}, "mime": null, "preview_url": null, "schema": null, "title": "Donn\u00e9es issues des Recensement agricoles - Tableaux", "type": "api", "url": "https://www.agreste.agriculture.gouv.fr/agreste-web/disaron/Recensements+agricoles/09facbca-808a-4f4a-b5c0-bec9618b88da!cda8b080-3e9e-4368-b41d-7a29c1da0be6/search/"}], "schema": null, "slug": "agreste-donnees-communales-du-recensement-agricole-cartographie-2020-et-tableaux-interactifs-historiques", "spatial": {"geom": null, "granularity": "fr:commune", "zones": ["country:fr"]}, "tags": ["cheptel", "cultures", "emploi-agricole", "exploitations-agricoles", "superficie-agricole-utilisee", "territoire"], "temporal_coverage": {"end": "2020-12-31"
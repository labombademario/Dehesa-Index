{
  "odata.metadata":"https://opendata.cbs.nl/ODataApi/OData/85636NED/$metadata#Cbs.OData.WebAPI.DataProperties","value":[
    {
      "odata.type":"Cbs.OData.Dimension","ID":0,"Position":0,"ParentID":null,"Type":"Dimension","Key":"Gewassen","Title":"Gewassen","Description":""

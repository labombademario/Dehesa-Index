d161a5\",\"url\":\"/onderwerpen/over-ons\",\"title\":\"Over ons\",\"parent\":\"\"},{\"id\":\"menu_link_content:40cb41ca-425e-4e3e-85ac-1ad1185331d9\",\"url\":\"/onderwerpen/contact\",\"title\":\"Contact\",\"parent\":\"\"}]},\"social\":{\"items\":[{\"id\":\"menu_link_content:f111f970-366f-48da-98d5-8d1bedafb05f\",\"url\":\"https://www.facebook.com/rijksdienstvoorondernemendnederland\",\"title\":\"Facebook\",\"parent\":\"\"},{\"id\":\"menu_link_content:bd1bceed-f18c-450b-a7a6-a5a7fd2ce869\",\"url\":\"https://www.instagram.com/rvo.nl/\",\"title\":\"Instagram\",\"parent\":\"\"},{\"id\":\"menu_link_content:22d81668-ce8c-452d-a889-8c5bbb9145e0\",\"url\":\"https://www.linkedin.com/company/rijksdienstvoorondernemendnederland/?trk=biz-companies-cym\",\"title\":\"LinkedIn\",\"parent\":\"\"},{\"id\":\"menu_link_content:a403494c-128b-4c9c-9c10-11d040aa400a\",\"url\":\"/onderwerpen/rss\",\"title\":\"RSS\",\"parent\":\"\"}],\"tree\":[{\"id\":\"menu_link_content:f111f970-366f-48da-98d5-8d1bedafb05f\",\"url\":\"https://www.facebook.com/rijksdienstvoorondernemendnederland\",\"title\":\"Facebook\",\"parent\":\"\"},{\"id\":\"menu_link_content:bd1bceed-f18c-450b-a7a6-a5a7fd2ce869\",\"url\":\"https://www.instagram.com/rvo.nl/\",\"title\":\"Instagram\",\"parent\":\"\"},{\"id\":\"menu_link_content:22d81668-ce8c-452d-a889-8c5bbb9145e0\",\"url\":\"https://www.linkedin.com/company/rijksdienstvoorondernemendnederland/?trk=biz-companies-cym\",\"title\":\"LinkedIn\",\"parent\":\"\"},{\"id\":\"menu_link_content:a403494c-128b-4c9c-9c10-11d040aa400a\",\"url\":\"/onderwerpen/rss\",\"title\":\"RSS\",\"parent\":\"\"}]}},\"showSearchBar\":true,\"brand\":\"$undefined\",\"type\":\"subject\",\"children\":[\"$L17\",\"$L18\",\"$L19\",\"$L1a\"]}]\n"])</script><script>self.__next_f.push([1,"9:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"GLB-subsidies: van aanvraag tot uitbetaling | RVO.nl\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://www.rvo.nl/onderwerpen/glb-2026/glb-aanvraag-tot-uitbetaling\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:title\",\"content\":\"GLB-subsidies: van aanvraag tot uitbetaling\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:description\",\"content\":\"Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026. Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026.\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:url\",\"content\":\"https://www.rvo.nl/onderwerpen/glb-2026/glb-aanvraag-tot-uitbetaling\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:site_name\",\"content\":\"RVO.nl\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:locale\",\"content\":\"nl\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://www.rvo.nl/assets/logos/logo-nl-nowhitespace.svg\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"GLB-subsidies: van aanvraag tot uitbetaling\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026. Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026.\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:image\",\"content\":\"https://www.rvo.nl/assets/logos/logo-nl-nowhitespace.svg\"}]],\"error\":null,\"digest\":\"$undefined\"}\n"])</script><script>self.__next_f.push([1,"e:\"$9:metadata\"\n"])</script><script>self.__next_f.push([1,"1b:I[93357,[\"2476\",\"static/chunks/cef64d72-6e0dbf82ffebec77.js?dpl=48fc81a2-774981\",\"1131\",\"static/chunks/1131-99898fc6a3e15bc1.js?dpl=48fc81a2-774981\",\"5372\",\"static/chunks/5372-3f876454e7cf2dc8.js?dpl=48fc81a2-774981\",\"3766\",\"static/chunks/3766-f6733de2266df181.js?dpl=48fc81a2-774981\",\"9121\",\"static/chunks/9121-3892465c016e8f9d.js?dpl=48fc81a2-774981\",\"7905\",\"static/chunks/7905-8c0ceae5278472a8.js?dpl=48fc81a2-774981\",\"3114\",\"static/chunks/3114-bf8e4726fa40b6c5.js?dpl=48fc81a2-774981\",\"222\",\"static/chunks/222-9cbb8ff9b4742d8c.js?dpl=48fc81a2-774981\",\"8355\",\"static/chunks/app/%5Blocale%5D/%5B%5B...slug%5D%5D/page-7bb08863fbf4000e.js?dpl=48fc81a2-774981\"],\"default\"]\n22:I[7261,[\"2476\",\"static/chunks/cef64d72-6e0dbf82ffebec77.js?dpl=48fc81a2-774981\",\"1131\",\"static/chunks/1131-99898fc6a3e15bc1.js?dpl=48fc81a2-774981\",\"5372\",\"static/chunks/5372-3f876454e7cf2dc8.js?dpl=48fc81a2-774981\",\"3766\",\"static/chunks/3766-f6733de2266df181.js?dpl=48fc81a2-774981\",\"9121\",\"static/chunks/9121-3892465c016e8f9d.js?dpl=48fc81a2-774981\",\"7905\",\"static/chunks/7905-8c0ceae5278472a8.js?dpl=48fc81a2-774981\",\"3114\",\"static/chunks/3114-bf8e4726fa40b6c5.js?dpl=48fc81a2-774981\",\"222\",\"static/chunks/222-9cbb8ff9b4742d8c.js?dpl=48fc81a2-774981\",\"8355\",\"static/chunks/app/%5Blocale%5D/%5B%5B...slug%5D%5D/page-7bb08863fbf4000e.js?dpl=48fc81a2-774981\"],\"default\"]\n23:I[93978,[\"2476\",\"static/chunks/cef64d72-6e0dbf82ffebec77.js?dpl=48fc81a2-774981\",\"1131\",\"static/chunks/1131-99898fc6a3e15bc1.js?dpl=48fc81a2-774981\",\"5372\",\"static/chunks/5372-3f876454e7cf2dc8.js?dpl=48fc81a2-774981\",\"3766\",\"static/chunks/3766-f6733de2266df181.js?dpl=48fc81a2-774981\",\"9121\",\"static/chunks/9121-3892465c016e8f9d.js?dpl=48fc81a2-774981\",\"7905\",\"static/chunks/7905-8c0ceae5278472a8.js?dpl=48fc81a2-774981\",\"3114\",\"static/chunks/3114-bf8e4726fa40b6c5.js?dpl=48fc81a2-774981\",\"222\",\"static/chunks/222-9cbb8ff9b4742d8c.js?dpl=48fc81a2-774981\",\"8355\",\"static/chunks/app/%5Blocale%5D/%5B%5B...slug%5D%5D/page-7bb08863fbf4000e.js?dpl=48fc81a2-774981\"],\"default\"]\n17:[\"$\",\"script\",null,{\""])</script><script>self.__next_f.push([1,"id\":\"robin\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org/\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"headLine\\\":\\\"GLB-subsidies: van aanvraag tot uitbetaling\\\",\\\"dateModified\\\":\\\"2026-09-18T10:00:00+02:00\\\"}\"}}]\n1c:T69c,"])</script><script>self.__next_f.push([1,"\u003ch2\u003eUw GLB-subsidies aanvragen\u003c/h2\u003e\n\u003cp\u003eU kunt de volgende GLB-subsidies aanvragen:\u003c/p\u003e\n\u003cul\u003e\n\u003cli data-list-item-id=\"ed4a062b17f7623f81c9ee398e5493d9e\"\u003e\u003ca href=\"/subsidies-financiering/glb-2026/basispremie-en-extra-betaling-eerste-40-hectare\" data-entity-type=\"node\" data-entity-uuid=\"d174bc7a-51c2-4a5e-84ca-7a159201ca89\" data-entity-substitution=\"canonical\"\u003eBasispremie en extra betaling voor de eerste 40 hectare\u003c/a\u003e\u003c/li\u003e\n\u003cli data-list-item-id=\"e1a88a9ab9b660332f9ef9c142ce6a86c\"\u003e\u003ca href=\"/subsidies-financiering/glb-2026/eco-regeling\" data-entity-type=\"node\" data-entity-uuid=\"782a2282-0552-4f4b-bd20-9041de62043e\" data-entity-substitution=\"canonical\"\u003eEco-regeling\u003c/a\u003e\u003c/li\u003e\n\u003cli data-list-item-id=\"e7ad17d3d8d08c8645969c3e683954c97\"\u003e\u003ca href=\"/subsidies-financiering/glb-2026/extra-betaling-jonge-landbouwers\" data-entity-type=\"node\" data-entity-uuid=\"ee2572af-f2c5-4500-8dc1-3394fc31a6ed\" data-entity-substitution=\"canonical\"\u003eExtra betaling voor jonge landbouwers\u003c/a\u003e\u003c/li\u003e\n\u003cli data-list-item-id=\"e5495ae491d4c93c9d93183c20b684969\"\u003e\u003ca href=\"/subsidies-financiering/glb-2026/behoud-van-zeldzame-landbouwhuisdierrassen\" data-entity-type=\"node\" data-entity-uuid=\"8d7d37bd-9546-4ee3-8840-9226a76f1873\" data-entity-substitution=\"canonical\"\u003eBehoud van zeldzame landbouwhuisdierrassen (ZLH)\u003c/a\u003e\u003c/li\u003e\n\u003cli data-list-item-id=\"e24b72230f54bb3383789843d2d5a5e67\"\u003e\u003ca href=\"/subsidies-financiering/glb-2026/brede-weersverzekering\" data-entity-type=\"node\" data-entity-uuid=\"44aebd30-2e26-4e3f-ac13-dd692ed3f4e3\" data-entity-substitution=\"canonical\"\u003eBrede weersverzekering\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eU vraagt de GLB-subsidies aan in de Gecombineerde opgave. In de interactieve infographic ziet u wat u moet doen.\u003c/p\u003e\n"])</script><script>self.__next_f.push([1,"1d:T7b9,"])</script><script>self.__next_f.push([1,"\u003ch2\u003eTarieven per GLB-subsidie\u003c/h2\u003e\n\u003cp\u003eZodra de (voorlopige) tarieven per subsidie bekend zijn, ziet u deze terug op \u003ca href=\"/onderwerpen/glb-2026/tarieven-uitbetaling\" data-entity-type=\"node\" data-entity-uuid=\"9fd16c13-d21f-4d47-99ab-6bbe138cda99\" data-entity-substitution=\"canonical\"\u003eTarieven en uitbetaling GLB 2026\u003c/a\u003e.\u003c/p\u003e\n\u003ch2\u003eNa uw aanvraag\u003c/h2\u003e\n\u003cp\u003eNa uw subsidieaanvraag ontvangt u een bevestiging per e-mail. U vindt deze bevestiging ook in Mijn RVO. U kunt tot en met 15 oktober wijzigingen doorgeven. Vanaf 18 mei voeren wij controles uit.\u003c/p\u003e\n\u003ch3\u003eConditionaliteiten en controles\u003c/h3\u003e\n\u003cp\u003eAls u subsidie aanvraagt uit het GLB dan houdt u zich aan de conditonaliteiten. U leest op \u003ca href=\"/onderwerpen/glb-2026/conditionaliteiten\" data-entity-type=\"node\" data-entity-uuid=\"d086bc25-5cf1-4b85-9200-413cc96bb827\" data-entity-substitution=\"canonical\"\u003eConditionaliteiten GLB 2026\u003c/a\u003e welke normen en eisen dit zijn. En wat de gevolgen zijn als u zich niet aan de conditionaliteiten houdt.\u003c/p\u003e\n\u003cp\u003eOp \u003ca href=\"/onderwerpen/glb-2026/glb-controle\" data-entity-type=\"node\" data-entity-uuid=\"64b8003b-c328-40fe-8c44-0c7b30660f0a\" data-entity-substitution=\"canonical\"\u003eControleren en monitoren van GLB-subsidies\u003c/a\u003e leest u hoe wij de controles uitvoeren en wat u zelf kunt doen. We gaan uit van de feitelijke situatie. U kent uw situatie zelf het beste. U bent verplicht om uw bedrijfssituatie actueel te houden. Geef daarom de gegevens zo juist of precies mogelijk door. Zien we iets anders dan u heeft opgegeven? Dan krijgt u een melding in Mijn GLB-monitor. Controleer deze melding(en). Doen we een steekproefcontrole voor de eco-regeling? Dan krijgt u een melding dat u bewijs moet aanleveren met de app RVO GeoTag. U kunt wijzigingen doorgeven in de Gecombineerde opgave.\u003c/p\u003e\n\u003ch2\u003eUw GLB-aanvraag wijzigen\u003c/h2\u003e\n\u003cp\u003eVoor het GLB houdt u uw bedrijfssituatie actueel in Mijn percelen en de Gecombineerde opgave. U kunt uw subsidieaanvraag nog tot en met 15 oktober wijzigen.\u003c/p\u003e\n"])</script><script>self.__next_f.push([1,"1e:T83d,"])</script><script>self.__next_f.push([1,"\u003cp\u003eHeeft u een eco-activiteit opgegeven, maar heeft u het resultaat niet gehaald? Of weet u dat u het resultaat niet gaat halen? Bijvoorbeeld als u ziet dat uw perceel niet voldoende zichtbaar is bedekt? Dan is het belangrijk dat u de eco-activiteit zo snel mogelijk intrekt. Dit doet u in de Gecombineerde opgave. Dit kan tot uiterlijk 15 oktober 2026. U mag de eco-activiteit dan niet op een ander perceel toevoegen.\u003c/p\u003e\n\u003cp\u003eVanaf 18 mei voeren wij controles uit. Weet u al eerder dan 15 oktober dat een activiteit niet lukt? Trek deze activiteit dan gelijk in. Heeft u een activiteit niet ingetrokken en vindt er wel een controle plaats? Dan kunt u een sanctie verwachten.\u003c/p\u003e\n\u003ch4\u003eHoe intrekken\u003c/h4\u003e\n\u003cp\u003eVerwijder de eco-activiteit op het betreffende perceel in de Gecombineerde opgave. Dit doet u in het onderdeel Regelingen per perceel. Verstuur de Gecombineerde opgave daarna opnieuw.\u003c/p\u003e\n\u003ch4\u003eU heeft een eco-activiteit gedeeltelijk uitgevoerd\u003c/h4\u003e\n\u003cp\u003eHeeft u bijvoorbeeld de eco-activiteit Vroeg ras rooigewas (uiterlijk 31 augustus) op de helft van uw perceel uitgevoerd? Splits dan uw perceel in Mijn percelen en verstuur deze wijziging. De eco-activiteit staat automatisch op een van beide percelen in de Gecombineerde opgave. Let erop dat de eco-activiteit op het juiste perceel staat.\u003c/p\u003e\n\u003cul\u003e\n\u003cli data-list-item-id=\"ecdb8331b06279c85d1dc81aa19ff6a45\"\u003eHeeft u bij een splitsing een eco-activiteit van verlengde weidegang aangevraagd? Dan blijft deze eco-activiteit wel op beide percelen staan na de splitsing.\u003c/li\u003e\n\u003cli data-list-item-id=\"e339d47f743f9ef467fad6a157b3abc5e\"\u003eHeeft u bij een splitsing de eco-activiteit Biologische bedrijf (Skal) aangevraagd? Dan blijft deze eco-activiteit op beide percelen staan na een splitsing. Dit gebeurt alleen als u eerder in de opgave heeft aangegeven dat uw bedrijf volledig biologisch is.\u003c/li\u003e\n\u003cli data-list-item-id=\"e4679004e8134c174778e3e7d2ff69373\"\u003eIs uw bedrijf niet volledig biologisch? Dan staat de eco-activiteit op een van beide percelen.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eControleer uw percelen na een splitsing en verstuur daarna de Gecombineerde opgave opnieuw.\u003c/p\u003e\n"])</script><script>self.__next_f.push([1,"1f:T4b4,"])</script><script>self.__next_f.push([1,"\u003cp\u003eHad u een ander gewas als hoofdteelt of voorteelt op uw perceel dan nu in de Gecombineerde opgave geregistreerd staat? Verander eerst de hoofdteelt in Mijn percelen en verstuur deze wijziging. Daarna gaat u naar de Gecombineerde opgave. De voorteelt en nateelt wijzigt u alleen in de Gecombineerde opgave.\u003c/p\u003e\n\u003cp\u003eWijzigt u de uiterste inzaaidatum van de nateelt? Dan geeft u dit ook door in de Gecombineerde opgave.\u003c/p\u003e\n\u003ch4\u003eHeeft u een eco-activiteit aangevraagd op het perceel dat u gewijzigd heeft?\u003c/h4\u003e\n\u003cul\u003e\n\u003cli data-list-item-id=\"ece3d89849c0322da0b90f78734d32cf8\"\u003eKan de nieuwe gewascode niet voor de eerder opgegeven eco-activiteit ingezet worden? In de opgave wordt deze eco-activiteit dan automatisch verwijderd op het perceel.\u003c/li\u003e\n\u003cli data-list-item-id=\"e28ce719746ed08ee73047bbd47d8f7fc\"\u003eKan de nieuwe gewascode ook ingezet worden voor de eerder opgegeven eco-activiteit? Controleer dan of u nog voldoet aan de voorwaarden van de eco-activiteit. Trek de eco-activiteit in als deze niet meer klopt. Dit doet u door de eco-activiteit te verwijderen. Dit wijzigt u in het onderdeel Regelingen per perceel.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eVerstuur daarna uw opgave opnieuw om uw wijziging(en) door te geven.\u003c/p\u003e\n"])</script><script>self.__next_f.push([1,"20:T8a5,"])</script><script>self.__next_f.push([1,"\u003ch4\u003eEen deel van uw GLB-aanvraag intrekken\u003c/h4\u003e\n\u003cp\u003eKunt u zich niet houden aan de voorwaarden van bijvoorbeeld één GLB-subsidie? Maar wel aan de voorwaarden van de andere aangevraagde GLB-subsidies? Geef dan in de Gecombineerde opgave aan welke GLB-subsidies u van Ja naar Nee verandert. Dit doet u in het onderdeel GLB-subsidies.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eKunt u zich bijvoorbeeld op een deel van uw percelen niet houden aan de voorwaarden van een GLB-subsidie? Dan geeft u deze aanpassingen ook door. Wilt u de basispremie, eco-regeling en/of brede weersverzekering gedeeltelijk intrekken? Volg dan deze stappen:\u003c/p\u003e\n\u003col\u003e\n\u003cli data-list-item-id=\"e7a30f9a93ea9117bd00b64eab2a63b70\"\u003eU gaat naar Regelingen per perceel in de Gecombineerde opgave.\u003c/li\u003e\n\u003cli data-list-item-id=\"e2f479cee0e7759f3a39dd10273b0d31a\"\u003eOpen de percelen waar u de basispremie, eco-regeling en/of brede weersverzekering wilt intrekken.\u003c/li\u003e\n\u003cli data-list-item-id=\"ea8edd4751d4f13fc45a5b112d7221edd\"\u003eZet nu het vinkje uit bij de basispremie, eco-regeling en/of brede weersverzekering.\u003c/li\u003e\n\u003cli data-list-item-id=\"e0e101e89d42a7fa96fe4b0e243eb185e\"\u003eLaat de vinkjes op de percelen staan waar u de basispremie, eco-regeling en/of brede weersverzekering niet wilt intrekken.\u003c/li\u003e\n\u003cli data-list-item-id=\"e5e359a5abe612f0e26c25f154cdf7772\"\u003eHeeft u de wijzigingen aangebracht in Regelingen per perceel? Klik dan verder totdat u op het overzicht Regelingen en grond komt. Controleer bij de GLB-subsidies wat de aanpassingen voor u betekenen. Staat alles volgens u goed? Dan verstuurt u de Gecombineerde opgave opnieuw om uw wijzigingen door te geven.\u003c/li\u003e\n\u003c/ol\u003e\n\u003ch4\u003eDe GLB-aanvraag helemaal intrekken\u003c/h4\u003e\n\u003cp\u003eKunt u zich door omstandigheden niet houden aan de voorwaarden van alle GLB-subsidies? Trek dan uw aanvraag helemaal in. U wijzigt het antwoord van Ja naar Nee in het onderdeel GLB-subsidies.\u003c/p\u003e\n\u003cp\u003eBelangrijk: heeft u op een of meer percelen de basispremie, eco-regeling en/of brede weersverzekering aangevraagd? Om deze GLB-subsidies volledig in te trekken, haalt u eerst de vinkjes weg bij uw percelen. Dit doet u in het onderdeel Regelingen per perceel. Daarna keert u terug naar het onderdeel GLB-subsidies om het antwoord te wijzigen naar Nee.\u003c/p\u003e\n"])</script><script>self.__next_f.push([1,"21:T7cd,"])</script><script>self.__next_f.push([1,"\u003ch2\u003eUw GLB-subsidies uitbetalen\u003c/h2\u003e\n\u003cp\u003eVanaf 1 december starten we met uitbetalen. U ontvangt dan een brief met ons (voorlopig) besluit. Uiterlijk 30 juni 2027 heeft iedereen besluit ontvangen.\u003c/p\u003e\n\u003ch3\u003eUw aanvraag is (voor een deel) goedgekeurd\u003c/h3\u003e\n\u003cul\u003e\n\u003cli data-list-item-id=\"e111718124544f283a041fa7bdfb48897\"\u003eOns doel is dat 95% van de aanvragers een 1\u003csup\u003ee\u003c/sup\u003e betaling in december 2026 krijgt met het voorlopig tarief. De definitieve uitbetaling krijgt u vanaf het 1\u003csup\u003ee\u003c/sup\u003e kwartaal in 2027 met het definitieve tarief. We proberen om deze betaling zoveel mogelijk voor 15 mei 2027 te doen. Maar uiterlijk 30 juni 2027.\u003c/li\u003e\n\u003cli data-list-item-id=\"eb740b9997bea2f6e4de5aa48827d9ffc\"\u003eDe beslissing en uitbetaling voor de subsidie Behoud van zeldzame landbouwhuisdierrassen (ZLH) versturen we zoveel mogelijk vanaf februari 2027.\u003c/li\u003e\n\u003cli data-list-item-id=\"ebeaa43960bb8d56e06cd934ee9bc81cd\"\u003eDe beslissing en uitbetaling voor de Brede weersverzekering versturen we zoveel mogelijk vanaf december 2026.\u003c/li\u003e\n\u003cli data-list-item-id=\"e8caf306e0f6fe2796721417d4f5027e1\"\u003eDe beslissing en uitbetaling voor het ANLb versturen we uiterlijk halverwege maart 2027. Collectieven die een voorschot aanvragen, krijgen dit in november 2026.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003eUw aanvraag is (voor een deel) afgekeurd\u003c/h3\u003e\n\u003cul\u003e\n\u003cli data-list-item-id=\"e64df2fdad9c64371f8619c398f4be399\"\u003eWe kunnen verschillende redenen hebben om uw aanvraag af te keuren. De reden leest u in de brief met het besluit.\u003c/li\u003e\n\u003cli data-list-item-id=\"e93e8398f2e7947bbcfa4c8afa4420ba7\"\u003eBent u het niet eens met ons besluit? Dat kunt u aangeven door bezwaar te maken. Dit doet u binnen 6 weken na de datum die op de brief met het besluit staat. Wat u hiervoor nodig heeft en hoe u dit doet, leest u op \u003ca href=\"/onderwerpen/contact/juridische-zaken/bezwaar-maken\" data-entity-type=\"node\" data-entity-uuid=\"7aed8517-a69b-4bd3-bb5c-2cae8b66178a\" data-entity-substitution=\"canonical\"\u003eBezwaar maken\u003c/a\u003e.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eDe aanvragen in cijfers\u003c/h2\u003e\n"])</script><script>self.__next_f.push([1,"18:[\"$\",\"$L1b\",null,{\"id\":\"00fb2550-1ac3-4a81-9741-e2ec4bf7a1ca\",\"associatedWith\":[],\"commissionedBy\":[{\"id\":\"29e7fd76-4ead-4182-aaa7-8e845fe558a5\",\"name\":\"Ministerie van Landbouw, Visserij, Voedselzekerheid en Natuur\",\"type\":\"partner\"}],\"contentElements\":[{\"id\":\"b79d2dc5-f22d-4003-a339-23ce48ba7547\",\"type\":\"wysiwyg\",\"text\":\"$1c\"},{\"id\":\"d4fa5282-bfb3-4b7b-957d-0d6934c28d5a\",\"contentHeight\":900,\"contentLink\":{\"uri\":\"https://infographics.rvo.nl/glb-tijdlijn/\",\"title\":\"\",\"options\":[]},\"contentTitle\":\"GLB-tijdlijn\",\"externalLink\":{\"uri\":\"https://infographics.rvo.nl/glb-tijdlijn/\",\"title\":\"Lukt het laden niet? Open de interactieve infographic\",\"options\":[]},\"type\":\"embedded_content\"},{\"id\":\"544fb421-b0fd-4982-a9f5-70adf90ee81a\",\"type\":\"wysiwyg\",\"text\":\"$1d\"},{\"id\":\"c40a88d9-c6a8-4977-ab53-92c33249639c\",\"type\":\"accordion\",\"panels\":[{\"id\":\"cf89cb10-3c30-4835-9699-f0f1b81300ae\",\"type\":\"panel\",\"title\":\"Eco-activiteiten intrekken\",\"childElements\":[{\"id\":\"4660490e-6735-48a5-a87a-270333a706a8\",\"type\":\"wysiwyg\",\"text\":\"$1e\"}]},{\"id\":\"f0353445-8253-4d82-a7b8-412dd464108d\",\"type\":\"panel\",\"title\":\"Eco-activiteiten wijzigen\",\"childElements\":[{\"id\":\"b05c398d-50e4-463c-b7c5-dafd6420eaf9\",\"type\":\"wysiwyg\",\"text\":\"\u003cp\u003eTot en met 18 mei kunt u eco-activiteiten toevoegen en wijzigen. Na 18 mei:\u003c/p\u003e\\n\u003cul\u003e\\n\u003cli data-list-item-id=\\\"ebeeb3d8049b520cb494b92b32cfd512e\\\"\u003emag u geen eco-activiteiten toevoegen en wijzigen;\u003c/li\u003e\\n\u003cli data-list-item-id=\\\"ef16b10a926714aed5f88dd19b5ba8e51\\\"\u003emoet u een eco-activiteit verwijderen op een perceel als u de eco-activiteit niet kunt uitvoeren.\u003c/li\u003e\\n\u003c/ul\u003e\\n\u003cp\u003eEr is één uitzondering op het wijzigen. Tot uiterlijk 15 oktober mag u de eco-activiteit Weidegang minimaal 2.500 uur beweiding wijzigen naar Weidegang minimaal 1.500 uur beweiding. Andersom wijzigen mag niet. De aanpassing geeft u door in het onderdeel Eco-activiteit Weidegang in de Gecombineerde opgave. Daarna past u uw percelen aan in het onderdeel Regeling per perceel.\u003c/p\u003e\\n\u003cp\u003eHeeft u de wijziging aangebracht en de percelen gecontroleerd? Dan verstuurt u de Gecombineerde opgave opnieuw om uw wijziging(en) door te geven.\u003c/p\u003e\\n\"}]},{\"id\":\"a43416cf-efd6-4bbb-be3e-4e2f8724bc85\",\"type\":\"panel\",\"title\":\"Grond verkopen of aankopen\",\"childElements\":[{\"id\":\"635e3f3c-2e68-496b-8ee9-64646fd60697\",\"type\":\"wysiwyg\",\"text\":\"\u003cp\u003eVerkoopt u een stuk grond of heeft u een stuk grond niet meer (feitelijk) in gebruik op 15 mei? Pas de situatie aan in Mijn percelen en geef het perceel een einddatum. Verkoopt u bijvoorbeeld grond op 1 augustus? Dan is dat de einddatum van het perceel in Mijn percelen. Koopt u grond aan? Dan geeft u het perceel de juiste ingangsdatum. Alles met een ingangsdatum na 15 mei rekenen we niet mee in de grondoppervlakte voor de basispremie en de eco-regeling. De peildatum is 15 mei.\u003c/p\u003e\\n\u003cp\u003eGaat de wijziging om een of meer percelen op de peildatum 15 mei 2026? Dan moet u de wijziging ook doorgeven in de Gecombineerde opgave. Heeft u uw perceelsregistratie op orde gebracht? Dan gaat u naar de Gecombineerde opgave en controleert u uw wijzigingen in het onderdeel Grond. Klopt de situatie volgens u? Dan verstuurt u opnieuw de Gecombineerde opgave.\u003c/p\u003e\\n\"}]},{\"id\":\"26028afc-716b-4c02-919d-0740892bf20f\",\"type\":\"panel\",\"title\":\"Percelen aanpassen\",\"childElements\":[{\"id\":\"eae7424b-8bc8-4cc1-b0b4-70319c05567d\",\"type\":\"wysiwyg\",\"text\":\"\u003cp\u003eUw percelen kunt u verkleinen, splitsen of verwijderen in Mijn percelen. U bent verplicht uw bedrijfssituatie actueel te houden. Het verwijderen van percelen mag alleen als u dit perceel op 15 mei niet meer gebruikt. Brengt u wijzigingen aan op een of meer percelen voor 2025? Controleer dan in Mijn percelen of de peildatum op 15 mei 2026 staat.\u003c/p\u003e\\n\u003cp\u003eHeeft u uw perceelsregistratie op orde gebracht? Dan gaat u naar de Gecombineerde opgave en controleert u uw wijzigingen in het onderdeel Grond. Klopt de situatie volgens u? Dan verstuurt u opnieuw de opgave.\u003c/p\u003e\\n\"}]},{\"id\":\"13c22d38-8424-4895-ad8d-89a30e273a01\",\"type\":\"panel\",\"title\":\"Hoofdteelt, voorteelt of nateelt wijzigen op een perceel\",\"childElements\":[{\"id\":\"5c33a651-8186-473c-be8f-fe4c42bb7eb1\",\"type\":\"wysiwyg\",\"text\":\"$1f\"}]},{\"id\":\"c86ed303-e00d-4613-a976-31b7b311c2a8\",\"type\":\"panel\",\"title\":\"Uw GLB-aanvraag (gedeeltelijk) intrekken\",\"childElements\":[{\"id\":\"4b569092-a894-4df9-b20a-495316bd98f4\",\"type\":\"wysiwyg\",\"text\":\"$20\"}]}]},{\"id\":\"befc051e-ac95-4a8a-8658-faa93dcdce97\",\"type\":\"wysiwyg\",\"text\":\"$21\"},{\"id\":\"c8db51f2-824f-4839-90b9-6f13114be141\",\"type\":\"vector_image\",\"caption\":\"\u003cp\u003eWe hebben 52.702 Gecombineerde opgaves 2026 ontvangen tot en met 18 mei. We verwachtten 52.250 opgaves te ontvangen.\u003c/p\u003e\\n\u003cp\u003eOntvangen aantal aanvragen basispremie en eco-regeling:\u003cbr\u003e• \u0026nbsp; \u0026nbsp;43.823 aanvragen basispremie\u003cbr\u003e• \u0026nbsp; \u0026nbsp;32.058 aanvragen eco-regeling\u003c/p\u003e\\n\u003cp\u003ePercentage aanvragen basispremie met eco-regeling: 74%\u003c/p\u003e\\n\u003cp\u003eDe top 5 eco-activiteiten:\u003cbr\u003e1. Langjarig grasland: 586.865 hectare\u003cbr\u003e2. Grasland met kruiden: 181.670 hectare\u003cbr\u003e3. Precisiegewasbescherming: 180.118 hectare\u0026nbsp;\u003cbr\u003e4. Groenbedekking: 167.877 hectare\u0026nbsp;\u003cbr\u003e5. \u0026nbsp;Weidegang: minimaal 1.500 uur beweiden: 157.520 hectare\u003c/p\u003e\\n\u003cp\u003eOntvangen aantal aanvragen overige GLB-regelingen:\u003cbr\u003e• \u0026nbsp; 1.206 aanvragen Behoud van zeldzame landbouwhuisdierrassen\u003cbr\u003e• \u0026nbsp; 2.475 aanvragen Bredeweersverzekering\u003cbr\u003e• \u0026nbsp; 1.189 aanvragen Extra betaling jonge landbouwers\u003c/p\u003e\\n\",\"width\":1000,\"height\":1000,\"uri\":\"/sites/default/files/2026-05/GLB%20ontvangen%20aanvragen%20tm%2018%20mei%20%281%29.svg\",\"uriRet\":\"\",\"altText\":\"\"}],\"drupalNodeId\":2071660,\"breadcrumbs\":[{\"title\":\"Home\",\"uri\":\"/\"},{\"title\":\"Gemeenschappelijk landbouwbeleid (GLB) 2026\",\"uri\":\"/onderwerpen/glb-2026\"},{\"title\":\"GLB-subsidies: van aanvraag tot uitbetaling\",\"uri\":\"/onderwerpen/glb-2026/glb-aanvraag-tot-uitbetaling\"}],\"status\":true,\"title\":\"GLB-subsidies: van aanvraag tot uitbetaling\",\"created\":\"2026-03-12T13:24:00+00:00\",\"changed\":\"2026-09-18T08:00:54+00:00\",\"checked\":\"2026-09-18T10:00:00+02:00\",\"url\":\"/onderwerpen/glb-2026/glb-aanvraag-tot-uitbetaling\",\"intro\":\"\u003cp\u003eSubsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026.\u003c/p\u003e\\n\",\"summary\":\"\",\"metaTags\":[{\"tag\":\"meta\",\"attributes\":{\"name\":\"title\",\"content\":\"GLB-subsidies: van aanvraag tot uitbetaling | RVO.nl\"}},{\"tag\":\"meta\",\"attributes\":{\"name\":\"description\",\"content\":\"Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026.\"}},{\"tag\":\"link\",\"attributes\":{\"rel\":\"canonical\",\"href\":\"https://www.rvo.nl/onderwerpen/glb-2026/glb-aanvraag-tot-uitbetaling\"}},{\"tag\":\"meta\",\"attributes\":{\"property\":\"og:site_name\",\"content\":\"RVO.nl\"}},{\"tag\":\"meta\",\"attributes\":{\"property\":\"og:type\",\"content\":\"Onderwerp\"}},{\"tag\":\"meta\",\"attributes\":{\"property\":\"og:url\",\"content\":\"https://www.rvo.nl/onderwerpen/glb-2026/glb-aanvraag-tot-uitbetaling\"}},{\"tag\":\"meta\",\"attributes\":{\"property\":\"og:title\",\"content\":\"GLB-subsidies: van aanvraag tot uitbetaling\"}},{\"tag\":\"meta\",\"attributes\":{\"property\":\"og:description\",\"content\":\"Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026. Subsidies uit het Gemeenschappelijk landbouwbeleid (GLB) aanvragen of wijzigen? Of benieuwd naar de tarieven? We hebben alle informatie op een rij gezet. Aanvragen kon van 1 maart tot en met 18 mei 2026 in de Gecombineerde opgave. Wijzigingen doorgeven kan tot en met 15 oktober 2026.\"}},{\"tag\":\"meta\",\"attributes\":{\"property\":\"og:locale\",\"content\":\"nl\"}}],\"relatedLinks\":[{\"uri\":\"/onderwerpen/glb-2026/conditionaliteiten\",\"title\":\"Conditionaliteiten GLB 2026\",\"options\":{\"href\":\"entity:node/2059613\",\"data-entity-type\":\"node\",\"data-entity-uuid\":\"d086bc25-5cf1-4b85-9200-413cc96bb827\",\"data-entity-substitution\":\"canonical\"}},{\"uri\":\"/onderwerpen/glb-2026/glb-controle\",\"title\":\"Controleren en monitoren van GLB-subsidies\",\"options\":{\"hre
 15 oktober 2026.\u003c/p\u003e\\n\",\"summary\":\"\",\"metaTags\":\"$18:props:metaTags\",\"relatedLinks\":\"$18:props:relatedLinks\",\"belongsTo\":\"$18:props:belongsTo\",\"banner\":\"$18:props:banner\",\"subjects\":\"$18:props:subjects\",\"sectors\":\"$18:props:sectors\",\"tags\":\"$18:props:tags\",\"targets\":\"$18:props:targets\",\"countries\":\"$18:props:countries\",\"subsidies\":\"$18:props:subsidies\",\"type\":\"subject\",\"notifications\":\"$18:props:notifications\",\"externalRelatedLinks\":\"$18:props:externalRelatedLinks\",\"audienceReferences\":\"$18:props:audienceReferences\"}}]\n"])</script><script>self.__next_f.push([1,"1a:[\"$\",\"$d\",null,{\"children\":[\"$\",\"$L23\",null,{\"isInPreviewMode\":false}]}]\n"])</script></body></html>
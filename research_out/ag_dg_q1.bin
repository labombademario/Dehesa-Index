rres", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-valeur-venale-des-terres/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-03-07T08:24:58.495000+00:00", "deleted": null, "description": "R\u00e9sultats France enti\u00e8re y compris DOM \nProductions v\u00e9g\u00e9tales : Superficies, rendements, productions r\u00e9colt\u00e9es ou commercialis\u00e9es\nProductions animales : Cheptel pr\u00e9sent sur les exploitations, animaux finis produits. (production, poids moyen, poids produit), production et utilisation de lait \u00e0 la ferme.\nR\u00e9partition du territoire en (statistique agricole annuelle) : terres arables, cultures permanentes, surface agricole utilis\u00e9e, surface totale. ", "description_short": null, "extras": {"datagouv_ckan_id": "b6f476cf-3281-479c-a825-4c46656d174f", "datagouv_ckan_last_sync": "2014-09-17T03:38:19.442000"}, "featured": false, "frequency": "annual", "frequency_date": "2016-02-18T00:00:00+00:00", "harvest": null, "id": "5369a047a3a729239d20631f", "internal": {"created_at_internal": "2014-03-07T08:24:58.495000+00:00", "last_modified_internal": "2025-09-23T13:57:08.679000+00:00"}, "last_modified": "2025-09-23T13:57:08.679000+00:00", "last_update": "2025-09-23T13:57:08.677000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 2, "followers_by_months": {"2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0, "2026-07": 0, "2026-08": 0}, "resources_downloads": 8439, "reuses": 5, "reuses_by_months": {"2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 1, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0, "2026-07": 0, "2026-08": 1, "2026-09": 0}, "
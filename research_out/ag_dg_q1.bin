rie artisanale et hors boulangerie et p\u00e2tisserie artisanale.\nEntreprises de 10 personnes occup\u00e9es et plus\nSource Insee - Traitements SSP\nComp\u00e9tences en TIC\nConnexions et utilisations d\u2019internet\n\u00c9change de messages automatiques inter et intra-entreprises\nCha\u00eene logistique d\u2019approvisionnement\nGestion de la relation client\nCommerce \u00e9lectronique", "description_short": null, "extras": {"datagouv_ckan_id": "8d93a1fd-14b3-4876-b12e-d6bd1ee2bb43", "datagouv_ckan_last_sync": "2014-09-17T03:38:19.935000"}, "featured": false, "frequency": "annual", "frequency_date": "2015-11-10T00:00:00+00:00", "harvest": null, "id": "5369a204a3a729239d20673c", "internal": {"created_at_internal": "2014-04-24T14:48:15.664000+00:00", "last_modified_internal": "2025-12-03T18:58:16.116000+00:00"}, "last_modified": "2025-12-03T18:58:16.116000+00:00", "last_update": "2025-12-03T18:57:10.792000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 312, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 3758}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-technologies-de-l-information-et-de-la-communication-entreprises-des-iaa", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.7777777777777778, "spatial": true, "temporal_coverage": false, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2025-12-03T18:57:10.792000+00:00", "description": "L'enqu\u00eate TIC vise \u00e0 mieux conna\u00eetre l'informatisation et la diffusion des technologies de l'information et de la communication dans les entreprises. Elle cherche notamment \u00e0 appr\u00e9cier la place des outils nouveaux dans les relations externes de l'entreprise (Internet, commerce \u00e9lectronique) et dans leur fonctionnement interne (r\u00e9seaux, syst\u00e8mes int\u00e9gr\u00e9s de gestion). Elle est r\u00e9alis\u00e9e tous les ans \u00e0 la demande d\u2019Eurostat dans l\u2019ensemble des \u00e9tats membres. Le champ de l\u2019enqu\u00eate porte sur les entreprises de 10 salari\u00e9s et plus.\n\n**Principaux sujets trait\u00e9s**\n\n\\- comp\u00e9tences en TIC\\\n\\- acc\u00e8s \u00e0 internet et usages\\\n\\- \u00e9change de messages automatiques inter et intra-entreprises\\\n\\- usages d'outils collaboratifs\\\n\\- utilisation des technologies de radio-identification\\\n\\- commerce \u00e9lectronique\n\n\u2192 Publications issues de cette source et autres publicatons dans le domaine de l'innovation :\n\n*  Utilisation des technologies de l'information et de la communication (TIC) dans l'agroalimentaire - [Enqu\u00eate TIC IAA 2023](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2411/detail/), [Enqu\u00eate TIC IAA 2022](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2320/detail/),\u00a0[Enqu\u00eate TIC IAA 2021](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2209/detail/),\u00a0[Enqu\u00eate TIC IAA 2020](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2201/detail/),\u00a0[Enqu\u00eate TIC IAA 2019](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2008/detail/), [Enqu\u00eate TIC IAA 2018](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd1909/detail/), [Enqu\u00eate TIC IAA 2016](https://agreste.agriculture.gouv.fr/agreste-web/disaron/ChdAal182/detail/)\n", "extras": {"check:available": false, "check:date": "2025-12-03T18:57:12.592840+00:00", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 37315100, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "8ed3e9c4-0ea0-4853-82c8-9d4405e75c11", "internal": {"created_at_internal": "2025-12-03T18:57:10.792000+00:00", "last_modified_internal": "2025-12-03T18:57:10.792000+00:00"}, "last_modified": "2025-12-03T18:57:10.792000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/8ed3e9c4-0ea0-4853-82c8-9d4405e75c11", "metrics": {"views": 47}, "mime": null, "preview_url": null, "schema": null, "title": "Enqu\u00eate TIC dans les IAA", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-TIC_IAA-2023/methodon/"}], "schema": null, "slug": "agreste-techno
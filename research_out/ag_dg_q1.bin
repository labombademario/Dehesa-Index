, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-donnees-communales-du-recensement-agricole-cartographie-2020-et-tableaux-interactifs-historiques", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.8888888888888888, "spatial": true, "temporal_coverage": true, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2025-10-03T11:19:31.573000+00:00", "description": null, "extras": {"check:available": false, "check:date": "2025-10-03T11:19:43.800177+00:00", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34194748, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "xlsx", "harvest": null, "id": "d9b10c56-f53e-4d51-9cdf-0381bd8715fb", "internal": {"created_at_internal": "2025-10-03T11:19:31.573000+00:00", "last_modified_internal": "2025-10-03T11:19:31.573000+00:00"}, "last_modified": "2025-10-03T11:19:31.573000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/d9b10c56-f53e-4d51-9cdf-0381bd8715fb", "metrics": {"views": 2558}, "mime": null, "preview_url": null, "schema": null, "title": "Liste des indicateurs du RA 2020, cartographi\u00e9s au niveau communal", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/download/publication/publie/GeoclipAir2020/Liste-des-indicateurs-cartographiques-du-RA2020.xlsx"}, {"checksum": null, "created_at": "2025-09-25T10:31:46.172000+00:00", "description": "Cartographies, tableaux interactifs et \"Viz'Agreste (Explorer les Donn\u00e9es d\u00e9partementales\", qui fournit un comparatif communal entre 2010 et 2020).\\\n**Th\u00e9matiques** : \\\nEmploi ; main-d\u2019\u0153uvre, Chefs d'exploitations, etc.\\\nNombre d'exploitations ; superficies, statut juridique, succession \\\nGrandes cultures ; superficie, irrigation, COP, prairies, vignes,  etc.\\\n\u00c9levage : principaux cheptels Bovins Ovins Porcins, etc.\n", "extras": {"check:available": false, "check:date": "2025-09-25T10:31:48.386000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 33822893, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "a5b75525-31f7-4bff-91b0-922ff4f20562", "internal": {"created_at_internal": "2025-09-25T10:31:46.172000+00:00", "last_modified_internal": "2025-10-03T10:59:49.031000+00:00"}, "last_modified": "2025-10-03T10:59:49.031000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/a5b75525-31f7-4bff-91b0-922ff4f20562", "metrics": {"views": 2620}, "mime": null, "preview_url": null, "schema": null, "title": "Toutes les statistiques par commune sous Agreste", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/!searchurl/cda8b080-3e9e-4368-b41d-7a29c1da0be6!a0340cf7-e390-4990-9499-50f92e154864!342eb85c-de0f-4544-8bf5-862129a19ba6!09facbca-808a-4f4a-b5c0-bec9618b88da/search/"}, {"checksum": null, "created_at": "2025-09-25T10:03:48.806000+00:00", "description": "#### \u25cf structure des exploitations \u25cf emploi \u25cf cultures \u25cf \u00e9levage \u25cf recensements anciens \u25cf zonages\n\nD\u00
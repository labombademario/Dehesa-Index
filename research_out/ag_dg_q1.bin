09-23T12:56:01.757000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 33733196, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "5010edf4-fe67-4277-860a-326744822ffd", "internal": {"created_at_internal": "2025-09-23T12:55:56.801000+00:00", "last_modified_internal": "2025-09-23T13:57:08.677000+00:00"}, "last_modified": "2025-09-23T13:57:08.677000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/5010edf4-fe67-4277-860a-326744822ffd", "metrics": {"views": 4603}, "mime": null, "preview_url": null, "schema": null, "title": "La statistique agricole annuelle (SAA) : ", "type": "other", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-SAA/methodon/"}], "schema": null, "slug": "agreste-statistique-agricole-annuelle-saa", "spatial": {"geom": null, "granularity": "fr:departement", "zones": ["country:fr"]}, "tags": ["agriculture", "animaux", "cheptel", "lait", "production-agricole", "rendements", "statistique-agricole", "superficies", "terres-arables", "vegetaux"], "temporal_coverage": null, "title": "Agreste - Statistique agricole annuelle (SAA)", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-statistique-agricole-annuelle-saa/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2013-07-08T15:26:37.899000+00:00", "deleted": null, "description": "Statistiques Prodcom\u00a0: production commercialis\u00e9e en quantit\u00e9 et en valeur par produits. \nDonn\u00e9es en nomenclature d\u2019activit\u00e9 NAF r\u00e9vision 2.", "description_short": null, "extras": {"Date de production des donn\u00e9es": "23/07/2012", "Langue": "fran\u00e7ais", "Type de donn\u00e9es": "s\u00e9ries statistiques", "datagouv_ckan_id": "64b5cced-8760-4443-8113-a21ffbefabb6", "datagouv_ckan_last_sync": "2014-09-17T03:38:17.333000"}, "featured": false, "frequency": "annual", "frequency_date": "2016-02-05T00:00:00+00:00", "harvest": null, "id": "53699dfda3a729239d205d84", "internal": {"created_at_internal": "2013-07-08T15:26:37.899000+00:00", "last_modified_internal": "2025-12-03T17:12:01.810000+00:00"}, "last_modified": "2025-12-03T17:12:01.810000+00:00", "last_update": "2025-12-03T16:45:27.107000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 504, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 3863}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-production-commercialisee-des-iaa", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": false, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.6666666666666666, "spatial": true, "temporal_coverage": false, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2025-12-03T16:45:27.107000+00:00", "description": "<br />\n\nDisposer de donn\u00e9es annuelles sur les quantit\u00e9s et les valeurs de la production commercialis\u00e9e de l'ensemble des produits des branches relevant des industries agricoles et alimentaires. Recueillir des donn\u00e9es harmonis\u00e9es pour l'ensemble des pays de l'Union europ\u00e9enne.\n\n**Principaux sujets trait\u00e9s**\n\n\\- Productions commercialis\u00e9es en quantit\u00e9 physique et en valeur (facturations)\\\n\\- Productions r\u00e9alis\u00e9es en sous-traitance en quantit\u00e9 physique et en valeur (r\u00e9tributions vers\u00e9es aux sous-traitants pour la prestation)\\\n\\- Analyse de la client\u00e8le (r\u00e9partition du chiffre d\u2019a ffaires par type de client\u00e8le)\\\n\\- Mati\u00e8res premi\u00e8res utilis\u00e9es (viandes et abats)\\\n\\- Bilan annuel sur les huiles et les tourteaux (production, ventes destin\u00e9es \u00e0 l\u2019industrie non alimentaire, stocks au 30/06)\n\n**Toutes les publications issues de cette source :** \u00a0 [Chiffres et Donn\u00e9es n\u00b0 2024-5 (mars 2024)](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2405/detail/) ; [Chiffres et Donn\u00e9es n\u00b02023-7 (avril 2023)](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2307/detail/) ;\u00a0 [Chiffres et Donn\u00e9es n\u00b02021-11 (septembre 2021)](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd21011/detail/)\u00a0\n", "extras": {"check:available": false, "check:date": "2025-12-03T16:45:30.540395+00:00", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 37312055, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "31dbaff4-7711-4f99-8db6-88e812829111", "internal": {"created_at_internal": "2025-12-03T16:45:27.107000+00:00", "last_modified_internal": "2025-12-03T16:45:27.107000+00:00"}, "last_modified": "2025-12-03T16:45:27.107000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/31dbaff4-7711-4f99-8db6-88e812829111", "metrics": {"views": 89}, "mime": null, "preview_url": null, "schema": null, "title": "Enqu\u00eate annuelle de production commercialis\u00e9e (EAPC) ", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-EAPC-2023/methodon/"}], "schema": null, "slug": "agreste-production-commercialisee-des-iaa", "spatial": {"geom": null, "granularity": "other", "zones": ["country:fr"]}, "tags": ["commercialisee", "enquetes-de-branche", "prodcom", "production", "produits-des-iaa", "ventes"], "temporal_coverage": null, "title": "Agreste - Production commercialis\u00e9e des IAA", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-production-commercialisee-des-iaa/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": "RICA", "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-02-18T16:08:41.008000+00:00", "deleted": null, "description": "Mis en \u0153uvre en France depuis 1968, le r\u00e9seau d\u2019information comptable agricole est une\nenqu\u00eate r\u00e9alis\u00e9e dans les \u00c9tats membres de l\u2019Union europ\u00e9enne selon des r\u00e8gles et des\nprincipes communs. Il est r\u00e9gi en France par le d\u00e9cret n\u00b02010-78 du 23 f\u00e9vrier 2010 relatif\n\u00e0 la cr\u00e9ation d'un r\u00e9seau de donn\u00e9es d\u00e9nomm\u00e9 r\u00e9seau d'information comptable agricole \u2013\nRICA France.\nLes donn\u00e9es collect\u00e9es permettent notamment l'analyse de la diversit\u00e9 des revenus et\ncelle de leur formation, de dresser des diagnostics \u00e9conomiques et financiers, et de\nsimuler l'impact des politiques publiques.\n\nIl est pr\u00e9vu de renommer le r\u00e9seau d\u2019information comptable agricole (RICA) en un \u00ab r\u00e9seau\\\nd\u2019information sur la durabilit\u00e9 des exploitations agricoles \u00bb (RIDEA).\n", "description_short": null, "extras": {"datagouv_ckan_id": "d6f0a4e5-6ab2-4932-ab3c-347a980a26e6", "datagouv_ckan_last_sync": "2014-09-17T03:38:18.927000"}, "featured": false, "frequency": "annual", "frequency_date": "2016-02-18T00:00:00+00:00", "harvest": null, "id": "53699f0fa3a729239d206035", "internal": {"created_at_internal": "2014-02-18T16:08:41.008000+00:00", "last_modified_internal": "2025-10-21T14:51:35.780000+00:00"}, "last_modified": "2025-10-21T14:51:35.780000+00:00", "last_update": "2025-10-21T14:49:43.934000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 2, "discussions_open": 2, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 1237, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 7823}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-reseau-dinformation-comptable-agricole-france", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.7777777777777778, "spatial": true, "temporal_coverage": false, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2025-10-21T14:49:43.934000+00:00", "description": "Publications dans les collections Chiffres & Donn\u00e9es, Les Dossiers, Primeur\\\nTableaux interactifs\\\nS\u00e9ries longues chronologiques\\\nDonn\u00e9es individuelles (anonymis\u00e9es)\n", "extras": {"check:available": false, "check:date": "2025-10-21T14:49:46.031000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 35251620, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "7eeafd75-d28a-4835-9abc-3435f81dd912", "internal": {"created_at_internal": "2025-10-21T14:49:43.934000+00:00", "last_modified_internal": "2025-10-21T14:51:35.777000+00:00"}, "last_modified": "2025-10-21T14:51:35.777000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/7eeafd75-d28a-4835-9abc-3435f81dd912", "metrics": {"views": 188}, "mime": null, "preview_url": null, "schema": null, "title": "Pr\u00e9sentation de la source RICA et des produits de diffusion associ\u00e9s", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-RICA/methodon/"}, {"checksum": null, "created_at": "2025-09-23T14:08:36.990000+00:00", "description": "S\u00e9ries longues\n", "extras": {"check:available": false, "check:date": "2025-09-23T14:08:44.015000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 33735249, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "fa2b4843-5a7c-42d0-a3f0-e2787bb82b84", "internal": {"created_at_internal": "2025-09-23T14:08:36.990000+00:00", "last_modified_internal": "2025-10-21T14:51:05.958000+00:00"}, "last_modified": "2025-10-21T14:51:05.958000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/fa2b4843-5a7c-42d0-a3f0-e2787bb82b84", "metrics": {"views": 267}, "mime": null, "preview_url": null, "schema": null, "title": "R\u00e9seau d\u2019information comptable agricole (RICA) - S\u00e9ries longues", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/download/publication/publie/RICA-SeriesLongues/RICA_S%C3%A9ries-longues.xlsx"}, {"checksum": null, "created_at": "2014-05-07T04:48:47.300000+00:00", "description": "Les fichiers **Rica France** comportent les enregistrements individuels anonymis\u00e9s recueillis dans le cadre du r\u00e9seau d\u2019information comptable agricole.\\\nL\u2019essentiel des variables du Rica y sont pr\u00e9sentes. **Ces donn\u00e9es sont anonymis\u00e9es** de fa\u00e7on \u00e0 ce que l\u2019**identification** **des exploitations du r\u00e9seau**, tant de fa\u00e7on directe que de fa\u00e7on indirecte **ne soit pas possible**. Les m\u00e9thodes d\u2019anonymisation utilis\u00e9es garantissent l\u2019exactitude des r\u00e9sultats des analyses men\u00e9es par r\u00e9gion administrative, orientation technico-\u00e9conomique Otex et dimension Cdex. Ces donn\u00e9es peuvent \u00eatre t\u00e9l\u00e9charg\u00e9es et analys\u00e9es \u00e0 l\u2019aide d\u2019un logiciel d\u2019analyse statistique.\n", "extras": {"check:available": false, "check:count-availability": 817, "check:date": "2024-10-28T14:29:56.883000", "check:error": "https:///enquetes/reseau-d-information-comptable/ - Invalid redirect URL origin", "check:headers:charset": "utf-8", "check:timeout": false, "check:url": "http://agreste.agriculture.gouv.fr/enquetes/reseau-d-information-comptable/"}, "filesize": null, "filetype": "remote", "format": "zip, cubes multi-dimensionnels", "harvest": null, "id": "76f86a0d-4c28-4ae3-858c-66058199bd59", "internal": {"created_at_internal": "2014-05-07T04:48:47.300000+00:00", "last_modified_internal": "2025-10-21T14:34:48.250000+00:00"}, "last_modified": "2025-10-21T14:34:48.250000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/76f86a0d-4c28-4ae3-858c-66058199bd59", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 784}, "mime": null, "preview_url": null, "schema": null, "title": "Donn\u00e9es individuelles (anonymis\u00e9es) du RICA, par mill\u00e9sime, \u00e0 partir de 2000", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/servicon/I.2/listeTypeServicon/"}], "schema": null, "slug": "agreste-reseau-dinformation-comptable-agricole-france", "spatial": {"geom": null, "granularity": "fr:region", "zones": ["country:fr"]}, "tags": ["agricole", "revenu"], "temporal_coverage": null, "title": "Agreste - R\u00e9seau d'information comptable agricole France", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-reseau-dinformation-comptable-agricole-france/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-10-15T16:23:48.096000+00:00", "deleted": null, "description": "La connaissance et le suivi de l\u2019occupation du territoire sont des pr\u00e9occupations anciennes de la statistique agricole. Le concept de l\u2019enqu\u00eate Teruti repose sur l\u2019association originale de photographies a\u00e9riennes constituant la base de sondage et de relev\u00e9s de terrain effectu\u00e9s par des enqu\u00eateurs.\n\\\nDepuis 1982, elle a b\u00e9n\u00e9fici\u00e9 d\u2019un atout suppl\u00e9mentaire avec la mise en place d\u2019un \u00e9chantillon national obligatoire qui permettait de stabiliser le syst\u00e8me et d\u2019\u00e9tendre le champ d\u2019analyse, jusque l\u00e0 orient\u00e9 vers l\u2019espace agricole, \u00e0 l\u2019ensemble du territoire.\n\\\nR\u00e9nov\u00e9e en 2017 pour am\u00e9liorer \u00e0 moindre co\u00fbt la pr\u00e9cision des estimations de surfaces, l'enqu\u00eate s'appuie d\u00e9sormais sur un \u00e9chantillon de points suivis annuellement, soit \u00e0 partir de bases de donn\u00e9es g\u00e9ographiques existantes, soit de relev\u00e9s de terrain effectu\u00e9s par enqu\u00eateur. Les r\u00e9sultats de l'enqu\u00eate sont mesur\u00e9s sur la base d'un cycle d'observation de trois ann\u00e9es glissantes d'enqu\u00eates.\n", "description_short": null, "extras": {}, "featured": false, "frequency": "annual", "frequency_date": null, "harvest": null, "id": "543e8374c751df200e38016f", "internal": {"created_at_internal": "2014-10-15T16:23:48.096000+00:00", "last_modified_internal": "2025-11-06T10:45:27.036000+00:00"}, "last_modified": "2025-11-06T10:45:27.036000+00:00", "last_update": "2025-11-06T10:45:27.022000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 1, "discussions_open": 1, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 1809, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 8272}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-teruti-lucas-utilisation-du-territoire-1", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.8888888888888888, "spatial": true, "temporal_coverage": true, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2025-10-02T18:03:06.207000+00:00", "description": "es fichiers de donn\u00e9es joints correspondent aux s\u00e9ries longues sur l'occupation du territoire (TERUTI) depuis 1982 \u00e0 2023.\n", "extras": {"check:available": false, "check:date": "2025-10-02T18:04:04.117000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34163829, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "2eae1732-4a57-43fc-8d68-995feb24daaa", "internal": {"created_at_internal": "2025-10-02T18:03:06.207000+00:00", "last_modified_internal": "2025-10-02T18:03:06.207000+00:00"}, "last_modified": "2025-10-02T18:03:06.207000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/2eae1732-4a57-43fc-8d68-995feb24daaa", "metrics": {"views": 149}, "mime": null, "preview_url": null, "schema": null, "title": "Occupation du territoire (TERUTI) - S\u00e9ries longues depuis 1982 ", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/TERUTI-SeriesLongues/detail/"}, {"checksum": null, "created_at": "2025-10-02T17:53:28.426000+00:00", "description": "L'enqu\u00eate Teruti, r\u00e9alis\u00e9e par le service de la statistique et de la prospective (SSP) du minist\u00e8re charg\u00e9 de l'agriculture, permet de suivre la couverture et l\u2019usage du sol \u00e0 partir d\u2019un ensemble de points constituant un \u00e9chantillon repr\u00e9sentatif du territoire national.\\\nR\u00e9nov\u00e9e en 2017 pour am\u00e9liorer \u00e0 moindre co\u00fbt la pr\u00e9cision des estimations de surfaces, l'enqu\u00eate s'appuie d\u00e9sormais sur un \u00e9chantillon de points suivis annuellement, soit \u00e0 partir de bases de donn\u00e9es g\u00e9ographiques existantes, soit de relev\u00e9s de terrain effectu\u00e9s par enqu\u00eateur. Les r\u00e9sultats de l'enqu\u00eate sont mesur\u00e9s sur la base d'un cycle d'observation de trois ann\u00e9es glissantes d'enqu\u00eates.\n", "extras": {"check:available": false, "check:date": "2025-10-02T17:53:58.813000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34163620, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "b9416027-338b-43da-8fd7-915b979a01ba", "internal": {"created_at_internal": "2025-10-02T17:53:28.426000+00:00", "last_modified_internal": "2025-11-06T10:39:35.103000+00:00"}, "last_modified": "2025-11-06T10:39:35.103000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/b9416027-338b-43da-8fd7-915b979a01ba", "metrics": {"views": 92}, "mime": null, "preview_url": null, "schema": null, "title": "Utilisation du territoire (Teruti) en 2022", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-Teruti-Lucas/methodon/"}, {"checksum": null, "created_at": "2025-11-06T10:45:27.022000+00:00", "description": "L'enqu\u00eate Teruti, r\u00e9alis\u00e9e par le service de la statistique et de la prospective (SSP) du minist\u00e8re charg\u00e9 de l'agriculture, permet de suivre la couverture et l\u2019usage du sol \u00e0 partir d\u2019un ensemble de points constituant un \u00e9chantillon repr\u00e9sentatif du territoire national.\\\nR\u00e9nov\u00e9e en 2017 pour am\u00e9liorer \u00e0 moindre co\u00fbt la pr\u00e9cision des estimations de surfaces, l'enqu\u00eate s'appuie d\u00e9sormais sur un \u00e9chantillon de points suivis annuellement, soit \u00e0 partir de bases de donn\u00e9es g\u00e9ographiques existantes, soit de relev\u00e9s de terrain effectu\u00e9s par enqu\u00eateur. Les r\u00e9sultats de l'enqu\u00eate sont mesur\u00e9s sur la base d'un cycle d'observation de trois ann\u00e9es glissantes d'enqu\u00eates.\n", "extras": {"check:available": false, "check:date": "2025-11-06T10:45:30.888000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 36058484, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "f15189ef-d581-4eaa-a381-4768a5d715f1", "internal": {"created_at_internal": "2025-11-06T10:45:27.022000+00:00", "last_modified_internal": "2025-11-06T10:45:27.022000+00:00"}, "last_modified": "2025-11-06T10:45:27.022000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/f15189ef-d581-4eaa-a381-4768a5d715f1", "metrics": {"views": 114}, "mime": null, "preview_url": null, "schema": null, "title": "L'occupation du territoire en 2023 - Enqu\u00eates Teruti 2022-2023-2024 ", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2510/detail/"}, {"checksum": null, "created_at": "2025-10-02T18:35:38.249000+00:00", "description": "Les sols agricoles repr\u00e9sentent encore en 2009 plus de la moiti\u00e9 du territoire. Ils perdent en moyenne 93 000 hectares sur les trois derni\u00e8res ann\u00e9es. Les espaces dits naturels en occupent plus du tiers. Parmi eux, la for\u00eat, qui a longtemps progress\u00e9, ne semble plus gagner de terrain. Les espaces artificialis\u00e9s progressent donc et atteignent d\u00e9sormais 9 %.\n", "extras": {"check:available": false, "check:date": "2025-10-02T18:36:07.906000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34164848, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "47bc289f-5b5a-46b7-81a9-ebe90ad820ca", "internal": {"created_at_internal": "2025-10-02T18:35:38.249000+00:00", "last_modified_internal": "2025-11-06T10:41:28.457000+00:00"}, "last_modified": "2025-11-06T10:41:28.457000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/47bc289f-5b5a-46b7-81a9-ebe90ad820ca", "metrics": {"views": 71}, "mime": null, "preview_url": null, "schema": null, "title": "L'utilisation du territoire entre 2006 et 2009 : L'artificialisation atteint 9 % du territoire en 2009", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/Pri246/detail/"}, {"checksum": null, "created_at": "2025-10-02T18:32:41.143000+00:00", "description": "Collection Primeur n\u00b0 219 - Ann\u00e9e de r\u00e9f\u00e9rence 2004\n\nLe d\u00e9veloppement des maisons individuelles consomme 400000 hectares d'espaces naturels de 1992 \u00e0 2004, soit pr\u00e8s de 1 % du territoire. Ce sont pour l'essentiel des sols agricoles.\n", "extras": {"check:available": false, "check:date": "2025-10-02T18:33:20.810000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34164768, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "2fcb4eb7-49d8-486b-9a27-747d418ebd4e", "internal": {"created_at_internal": "2025-10-02T18:32:41.143000+00:00", "last_modified_internal": "2025-10-02T18:33:40.769000+00:00"}, "last_modified": "2025-10-02T18:33:40.769000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/2fcb4eb7-49d8-486b-9a27-747d418ebd4e", "metrics": {"views": 64}, "mime": null, "preview_url": null, "schema": null, "title": "Des territoires de plus en plus artificialis\u00e9s : la maison individuelle grignote les espaces naturels ", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/Pri219/detail/"}], "schema": null, "slug": "agreste-teruti-lucas-utilisation-du-territoire-1", "spatial": {"geom": null, "granularity": "fr:departement", "zones": ["country:fr"]}, "tags": ["artificialisation", "consommation", "sols", "territoire", "utilisation"], "temporal_coverage": {"end": "2014-10-31", "start": "1981-01-01"}, "title": "Agreste - Teruti - Lucas - Utilisation du territoire", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-teruti-lucas-utilisation-du-territoire-1/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-02-04T13:31:52.273000+00:00", "deleted": null, "description": "Agreste. Les derniers chiffres et les s\u00e9ries longues historiques mensuelles de surfaces, productions, abattages d\u2019animaux, \u00e9changes ext\u00e9rieurs, stocks, prix des produits de l\u2019agriculture et des Industries agroalimentaires. Les donn\u00e9es de climatologie, les immatriculations de tracteurs et machines agricoles, les cours des monnaies et les prix des produits \u00e9nerg\u00e9tiques, les livraisons et les prix des engrais, les donn\u00e9es de cadrage sur l\u2019emploi et les salaires. Les sigles et les principales d\u00e9finitions.", "description_short": null, "extras": {"datagouv_ckan_id": "adde94dd-25dd-4980-a438-22d71b0d7b95", "datagouv_ckan_last_sync": "2014-09-17T03:37:56.164000"}, "featured": false, "frequency": "monthly", "frequency_date": "2016-02-18T00:00:00+00:00", "harvest": null, "id": "53699187a3a729239d203ca7", "internal": {"created_at_internal": "2014-02-04T13:31:52.273000+00:00", "last_modified_internal": "2025-09-09T08:32:27.283000+00:00"}, "last_modified": "2025-09-09T08:32:27.283000+00:00", "last_update": "2025-09-09T08:32:03.477000+00:00", "license": "other-pd", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 615, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 6149}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-conjoncture-agricole-le-bulletin-mensuel", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": false, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.5555555555555556, "spatial": true, "temporal_coverage": false, "update_frequency": true, "update_fulfilled_in_time": false}, "resources": [{"checksum": null, "created_at": "2014-05-07T03:51:03.341000+00:00", "description": "Fichiers excel par th\u00e8me", "extras": {"check:available": false, "check:count-availability": 427, "check:date": "2024-10-28T14:30:12.942000", "check:error": "https:///conjoncture/le-bulletin/ - Invalid redirect URL origin", "check:headers:charset": "utf-8", "check:timeout": false, "check:url": "http://agreste.agriculture.gouv.fr/conjoncture/le-bulletin/"}, "filesize": null, "filetype": "remote", "format": "xls", "harvest": null, "id": "67a4770b-10b9-444d-a5f6-b40f50cc3f2b", "internal": {"created_at_internal": "2014-05-07T03:51:03.341000+00:00", "last_modified_internal": "2025-09-09T08:32:03.477000+00:00"}, "last_modified": "2025-09-09T08:32:03.477000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/67a4770b-10b9-444d-a5f6-b40f50cc3f2b", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 654}, "mime": null, "preview_url": null, "schema": null, "title": "Conjoncture agricole : le bulletin mensuel", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/BulConj/detail/"}], "schema": null, "slug": "agreste-conjoncture-agricole-le-bulletin-mensuel", "spatial": {"geom": null, "granularity": "other", "zones": ["country:fr"]}, "tags": ["agricole", "conjoncture"], "temporal_coverage": null, "title": "Agreste - Conjoncture agricole : le bulletin mensuel", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-conjoncture-agricole-le-bulletin-mensuel/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-10-16T10:39:39.580000+00:00", "deleted": null, "description": "Les enqu\u00eates sur les pratiques culturales ont pour objectif de d\u00e9crire et de caract\u00e9riser sur une fili\u00e8re culturale donn\u00e9e, les itin\u00e9raires techniques mis en \u0153uvre par les agriculteurs lors d\u2019une campagne agricole. Les donn\u00e9es collect\u00e9es sont notamment utilis\u00e9es pour \u00e9tablir des indicateurs agro-environnementaux (notamment l\u2019IFT) contribuant \u00e0 mesurer l\u2019usage des produits phytopharmaceutiques en agriculture. \\\nViticulture : Avant 2018, deux enqu\u00eates compl\u00e8tes sur les pratiques culturales en viticulture ont \u00e9t\u00e9 r\u00e9alis\u00e9es : \\\nla premi\u00e8re portait sur la campagne 2006 \\\net la seconde sur la campagne 2013. Cette derni\u00e8re, conduite en 2014, a donn\u00e9 lieu \u00e0 diverses publications en 2015 et 2016. Ces enqu\u00eates couvrent la plupart des bassins viticoles.\nUne enqu\u00eate plus l\u00e9g\u00e8re sur les pratiques phytosanitaires a \u00e9t\u00e9 conduite en 2010 et une nouvelle enqu\u00eate, portant sur la campagne 2016, a \u00e9t\u00e9 conduite en 2017. \\\nDepuis 2018, un ensemble d'enqu\u00eates sur les pratiques culturales est en place couvrant arboriculture et viticulture. Ce dispositif comprend des enqu\u00eates quinquennales et des enqu\u00eates interm\u00e9diaires, restreintes aux seules pratiques phytosanitaires, en coh\u00e9rence avec les objectifs du plan d'action Ecophyto.\n", "description_short": null, "extras": {}, "featured": false, "frequency": "punctual", "frequency_date": "2016-01-06T00:00:00+00:00", "harvest": null, "id": "543f844dc751df200b380178", "internal": {"created_at_internal": "2014-10-16T10:39:39.580000+00:00", "last_modified_internal": "2025-11-06T11:18:11.410000+00:00"}, "last_modified": "2025-11-06T11:18:11.410000+00:00", "last_update": "2025-10-02T14:47:18.832000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 721, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 6182}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-pratiques-culturales-en-arboriculture-et-viticulture", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.7777777777777778, "spatial": true, "temporal_coverage": false, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2025-10-02T14:47:18.832000+00:00", "description": "\u2192 **A VENIR** - Parution de deux publications, dans la collection des \u00ab Chiffres et Donn\u00e9es \u00bb, issues de la source de l'enqu\u00eate sur les pratiques culturales en arboriculture et viticulture en 2024 :\\\n1\u00b0) le nombre de traitements et l\u2019indicateur de fr\u00e9quence de traitements phytosanitaires (IFT) au 1er trimestre 2026, \\\n2\u00b0) les principaux r\u00e9sultats au 3e trimestre 2026.\n", "extras": {"check:available": false, "check:date": "2025-10-02T14:47:53.037794+00:00", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34159850, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "7z", "harvest": null, "id": "90e0d29b-c2a3-405f-8aaf-ececda63b359", "internal": {"created_at_internal": "2025-10-02T14:47:18.832000+00:00", "last_modified_internal": "2025-10-02T14:47:18.832000+00:00"}, "last_modified": "2025-10-02T14:47:18.832000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/90e0d29b-c2a3-405f-8aaf-ececda63b359", "metrics": {"views": 193}, "mime": null, "preview_url": null, "schema": null, "title": "Pratiques culturales en viticulture en 2016 puis 2019. ", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/P/!searchurl/listeTypeMethodon/"}], "schema": null, "slug": "agreste-pratiques-culturales-en-arboriculture-et-viticulture", "spatial": {"geom": null, "granularity": "other", "zones": []}, "tags": ["ift", "indicateurs-de-frequence-des-tra", "indices-de-frequence-des-traitem", "pratiques-phyto-sanitaires", "viticulture"], "temporal_coverage": null, "title": "Agreste - Pratiques culturales en arboriculture et viticulture", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-pratiques-culturales-en-arboriculture-et-viticulture/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-02-04T15:51:01.679000+00:00", "deleted": null, "description": "R\u00e9sultats des recensements agricoles de 2020 et 2010 :\nDes cartes par communes, canton, d\u00e9partement ou r\u00e9gions permettent d'acc\u00e9der \u00e0 des donn\u00e9es de cadrage sur les exploitations agricoles et des donn\u00e9es sur l'emploi agricole.\nCes donn\u00e9es peuvent \u00eatre visualis\u00e9es sous forme de tableaux. Quelques indicateurs sont \u00e9galement disponibles pour des recensements plus anciens, sous RA2010 (g\u00e9ographie 2010).\n", "description_short": null, "extras": {"datagouv_ckan_id": "37159d0b-44fd-4ddc-bd89-36f1583a8930", "datagouv_ckan_last_sync": "2014-09-17T03:37:55.641000"}, "featured": false, "frequency": "punctual", "frequency_date": null, "harvest": null, "id": "53699038a3a729239d20394f", "internal": {"created_at_internal": "2014-02-04T15:51:01.679000+00:00", "last_modified_internal": "2025-10-03T08:37:54.062000+00:00"}, "last_modified": "2025-10-03T08:37:54.062000+00:00", "last_update": "2025-10-03T08:37:54.061000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 2, "discussions_open": 2, "followers": 2, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 3013, "reuses": 5, "reuses_by_months": {"2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 1, "2026-05": 0, "2026-06": 2, "2026-07": 0, "2026-08": 0, "2026-09": 0}, "views": 15421}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata
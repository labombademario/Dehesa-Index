heck:url": "https://stats.agriculture.gouv.fr/disar/faces/report/tabDocBySource.jsp"}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "54bdb7a2-6eed-4bfe-b4f2-70316567edd1", "internal": {"created_at_internal": "2014-10-24T15:53:44.244000+00:00", "last_modified_internal": "2025-12-09T16:37:53.993000+00:00"}, "last_modified": "2025-12-09T16:37:53.993000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/54bdb7a2-6eed-4bfe-b4f2-70316567edd1", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 451}, "mime": null, "preview_url": null, "schema": null, "title": "Enqu\u00eate Structure ESEA 2023 : donn\u00e9es de cadrage", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2511/detail/"}, {"checksum": null, "created_at": "2025-12-09T16:33:44.578000+00:00", "description": "Les principaux r\u00e9sultats de l'enqu\u00eate ESEA 2016 sous forme de tableaux multidimensionnels personnalisables :\n\n* Caract\u00e9ristiques g\u00e9n\u00e9rales des exploitations par orientation, taille \u00e9conomique et statut juridique\n  ;\n* Caract\u00e9ristiques g\u00e9n\u00e9rales par orientation, classe de SAU et statut juridique ;\n* Commercialisation en circuit court\n  ;\n* Activit\u00e9s de diversification\n  ;\n* Orientation, taille, statut et mode de faire-valoir des exploitations.\n", "extras": {"check:available": false, "check:date": "2025-12-09T16:33:46.832000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 37623377, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "58dccae7-de6c-4cec-846e-001c2785c2d3", "internal": {"created_at_internal": "2025-12-09T16:33:44.578000+00:00", "last_modified_internal": "2025-12-09T16:33:44.578000+00:00"}, "last
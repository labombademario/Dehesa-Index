 source et de la m\u00e9thodologie. \\\nPour en savoir plus, utiliser le lien vers le site de l'Insee.\n", "extras": {"check:available": false, "check:count-availability": 170, "check:date": "2024-10-28T14:30:01.333000", "check:error": "https:///enquetes/industries-agroalimentaires-529/enquete-sur-la-production-de/ - Invalid redirect URL origin", "check:headers:charset": "utf-8", "check:timeout": false, "check:url": "http://agreste.agriculture.gouv.fr/enquetes/industries-agroalimentaires-529/enquete-sur-la-production-de/"}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "8413d82b-6fd7-4bf0-9582-641181b63ad6", "internal": {"created_at_internal": "2014-05-07T04:02:43.504000+00:00", "last_modified_internal": "2025-12-16T15:34:38.088000+00:00"}, "last_modified": "2025-12-16T15:34:38.088000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/8413d82b-6fd7-4bf0-9582-641181b63ad6", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 271}, "mime": null, "preview_url": null, "schema": null, "title": "Enqu\u00eate sur les investissements dans l'industrie pour prot\u00e9ger l'environnement ", "type": "documentation", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-IAA%20protection%20environnement/methodon/"}], "schema": null, "slug": "agreste-enquete-sur-les-investissements-dans-lindustrie-pour-proteger-lenvironnement", "spatial": {"geom": null, "granularity": "fr:region", "zones": ["country:fr"]}, "tags": ["dechets", "industries-agroalimentaires", "mode-de-traitement"], "temporal_coverage": {"end": "2008-12-31", "start": "2008-01-01"}, "title": "Agreste - Enqu\u00eate sur les investissements dans l'industrie pour prot\u00e9ger l'environnement", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-enquete-sur-les-investissements-dans-lindustrie-pour-proteger-lenvironnement/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acr
ervice"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-recoltes-de-bois-production-de-sciages-et-prix-du-bois", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": false, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.5555555555555556, "spatial": true, "temporal_coverage": false, "update_frequency": true, "update_fulfilled_in_time": false}, "resources": [{"checksum": null, "created_at": "2025-12-03T15:50:13.878000+00:00", "description": "Chaque ann\u00e9e, le Service de la statistique et de la prospective (SSP) du minist\u00e8re en charge de l\u2019agriculture r\u00e9alise une enqu\u00eate sur les exploitations foresti\u00e8res et scieries (EXF-SRI).\\\nCelle-ci fournit les donn\u00e9es de r\u00e9colte et de production de la fili\u00e8re for\u00eat-bois en France m\u00e9tropolitaine sur l\u2019ensemble du secteur et dans une nomenclature d\u00e9taill\u00e9e.\n\nLe [Chiffres et donn\u00e9es \"R\u00e9colte de bois et production de sciages en 2024\"](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2517/detail/)\n\n**Des fichiers de s\u00e9ries longues Exploitations foresti\u00e8res et scieries** **depuis 2005 incluant les donn\u00e9es r\u00e9gionales et nationales sont disponibles** **[ICI](https://agreste.agriculture.gouv.fr/agreste-web/disaron/EXFSRI-SeriesLongues/detail/). Ces fichiers de s\u00e9ries longues font l'objet de mises \u00e0 jour r\u00e9guli\u00e8res, y compris en dehors des publications des Chiffres & Donn\u00e9es.**\n", "extras": {"check:available": false, "check:date": "2025-12-03T15:50:17.202000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 37311040, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "61a80442-b703-4f67-8fed-1c752338de2e", "internal": {"created_at_internal": "2025-12-03T15:50:13.878000+00:00", "last_modified_internal": "2025-12-17T14:39:12.332000+00:00"}, "last_modified": "2025-12-17T14:39:12.332000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/61a80442-b703-4f67-8fed-1c752338de2e", "metrics": {"views": 133}, "mime": null, "preview_url": null, "schema": null, "title": "R\u00e9colte de bois et production de sciages en 2024 : recul global de la r\u00e9colte, hausse des sciages de conif\u00e8res ", "type": "other", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2517/detail/"}, {"checksum": null, "created_at": "2025-12-03T16:03:26.074000+00:00", "description": "#### Indices de prix des bois\n\n[Ici](https://agreste.agriculture.gouv.fr/agreste-web/disaron/bois/e2606dbb-73e6-4148-8ffc-0facf0e52155/search/) tous les tableaux de bord par trimestre pour les prix des bois de trituration et d'\u00e9nergie et par trimestre pour les prix de grumes de conif\u00e8res.\n", "extras": 
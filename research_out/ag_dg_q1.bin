5:18.126941+00:00", "check:error": "Cannot connect to host www.agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 37296485, "check:timeout": false, "check:url": "http://agreste.agriculture.gouv.fr/publications/graphagri/"}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "075c583b-d663-420b-b833-3ed328a773a5", "internal": {"created_at_internal": "2016-02-09T16:15:45.162000+00:00", "last_modified_internal": "2025-03-06T14:45:55.858000+00:00"}, "last_modified": "2025-03-06T14:45:55.858000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/075c583b-d663-420b-b833-3ed328a773a5", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 2386}, "mime": null, "preview_url": null, "schema": {"name": null, "url": null, "version": null}, "title": "Graphagri", "type": "api", "url": "https://www.agreste.agriculture.gouv.fr/agreste-web/disaron/!searchurl/6ae57cf9-22ec-464c-83cb-2ac0b526c0f3/search/"}], "schema": null, "slug": "agreste-graphagri", "spatial": {"geom": null, "granularity": "fr:region", "zones": ["country:fr"]}, "tags": ["agriculture", "agroalimentaire", "aides", "alimentation", "animaux", "aviculture", "bois", "bovins", "caprins", "cultures", "cuniculture", "engrais", "environnement", "exploitations", "foncier", "foret", "lait", "porcins", "sau", "sciages", "signes-de-qualite"], "temporal_coverage": null, "title": "Agreste - Graphagri", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-graphagri/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-04-16T15:16:54.925000+00:00", "deleted": null, "description": "Instrument de la gestion des march\u00e9s agricoles et de la politique agricole communautaires, les bilans d\u2019approvisionnement sont \u00e9tablis par tous les pays membres de l\u2019Union europ\u00e9enne. Le bilan, exprim\u00e9 en quantit\u00e9s, d\u00e9crit l\u2019\u00e9quilibre des ressources (stocks de d\u00e9but, production utilisable, importations) et des emplois (exportations, utilisations int\u00e9rieures, stocks finals) pour un produit donn\u00e9. Il permet, notamment, de d\u00e9terminer la consommation annuelle apparente par habitant pour les principales denr\u00e9es alimentaires et d\u2019en suivre l\u2019\u00e9volution.\nProduits : C\u00e9r\u00e9ales, riz, pommes de terre, prot\u00e9agineux", "description_short": null, "extras": {"datagouv_ckan_id": "1ea010b4-e2db-4f99-bda7-08a4525e9f48", "datagouv_ckan_last_sync": "2014-09-17T03:37:55.179000"}, "featured": false, "frequency": "annual", "frequency_date": "2016-02-18T00:00:00+00:00", "harvest": null, "id": "53698f9da3a729239d2037bd", "internal": {"created_at_internal": "2014-04-16T15:16:54.925000+00:00", "last_modified_internal": "2025-12-09T16:03:49.191000+00:00"}, "last_modified": "2025-12-09T16:03:49.191000+00:00", "last_update": "2025-10-02T18:19:29.760000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 1, "discussions_open": 1, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 501, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 5366}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b67
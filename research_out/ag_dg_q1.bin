cartostat/"}, "filesize": null, "filetype": "remote", "format": "html", "harvest": null, "id": "990a7354-7997-4fba-987f-7f53580e6f80", "internal": {"created_at_internal": "2014-05-07T03:45:28.577000+00:00", "last_modified_internal": "2025-10-03T08:37:54.061000+00:00"}, "last_modified": "2025-10-03T08:37:54.061000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/990a7354-7997-4fba-987f-7f53580e6f80", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 3017}, "mime": null, "preview_url": null, "schema": null, "title": "Cartographie des donn\u00e9es du recensement agricole ", "type": "main", "url": "https://stats.agriculture.gouv.fr/cartostat/"}], "schema": null, "slug": "agreste-cartographie-des-donnees-du-recensement-agricole", "spatial": {"geom": null, "granularity": "fr:commune", "zones": ["country:fr"]}, "tags": ["agriculture", "recensement"], "temporal_coverage": {"end": "2010-12-31", "start": "2010-01-01"}, "title": "Agreste - Cartographie des donn\u00e9es du recensement agricole ", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-cartographie-des-donnees-du-recensement-agricole/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2013-07-08T15:59:56.529000+00:00", "deleted": null, "description": "Agreste. \nDocuments pr\u00e9sent\u00e9s aux commissions des comptes de l'agriculture de juillet et d\u00e9cembre.\nDonn\u00e9es disponibles sous Disar / Donn\u00e9es en ligne / rubrique : Economie agricole / Comptes de l'agriculture. Donn\u00e9es de structure (nombre d'exploitations, surfaces et main d'oeuvre agricoles), comptes d\u00e9taill\u00e9s. S\u00e9ries par r\u00e9gion, d\u00e9partement et par orientation technico-\u00e9conomique de l'exploitation. Aides directes (subventions, gel des terres, paiements uniques DPU, ICHN, PHAE).", "descrip
verage": null, "title": "Agreste - Enqu\u00eates sur la structure des exploitations agricoles (ESEA)", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-enquetes-sur-la-structure-des-exploitations-agricoles-esea/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-05-06T09:59:26.123000+00:00", "deleted": null, "description": "Montants des investissements pour l\u2019environnement, nombre d\u2019\u00e9tablissements, domaine (eaux us\u00e9es, d\u00e9chets...), montants des \u00e9tudes pour la protection de l\u2019environnement, investissements d\u00e9di\u00e9s selon l\u2019activit\u00e9 ", "description_short": null, "extras": {"datagouv_ckan_id": "7c5f6d52-e56a-4f80-80ba-209e9a9acd63", "datagouv_ckan_last_sync": "2014-09-17T03:37:58.289000"}, "featured": false, "frequency": "annual", "frequency_date": "2016-02-18T00:00:00+00:00", "harvest": null, "id": "536992c2a3a729239d203fe9", "internal": {"created_at_internal": "2014-05-06T09:59:26.123000+00:00", "last_modified_internal": "2025-10-03T07:52:37.757000+00:00"}, "last_modified": "2025-10-03T07:52:37.757000+00:00", "last_update": "2025-10-03T07:52:37.756000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 583, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 3931}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-depenses-pour-proteger-l-environnement-dans-les-industries-agroalimentaires", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.7777777777777778, "spatial": true, "temporal_coverage": false, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2025-10-03T07:52:37.756000+00:00", "description": "En 2020, l\u2019activit\u00e9 des industries agroalimentaires g\u00e9n\u00e8re pr\u00e8s de 5,1 millions de tonnes de d\u00e9chets non dangereux hors min\u00e9raux et boues. Les d\u00e9chets dits organiques - provenant de mati\u00e8res d\u2019origine animale ou v\u00e9g\u00e9tale - repr\u00e9sentent 70 % de l\u2019ensemble des d\u00e9chets, en 2020 comme en 2016. Le secteur de la production et de la transformation de la viande concentre 40 % de ces d\u00e9chets organiques, suivi du secteur de la transformation des fruits et l\u00e9gumes avec 22 % . Les principaux contributeurs \u00e0 la production de d\u00e9chets non dangereux hors min\u00e9raux et boues sont les \u00e9tablissements de 50 \u00e0 99 salari\u00e9s avec plus de 1,4 million de tonnes produites, soit 28 %. Pour les d\u00e9chets organiques, ce sont les \u00e9tablissements de 100 \u00e0 249 salari\u00e9s qui contribuent le plus avec plus d\u2019un million de tonnes, soit 30 % du total. Ces d\u00e9chets organiques, qui peuvent comprendre des emballages, sont r\u00e9-employ\u00e9s ou valoris\u00e9s \u00e0 hauteur de 90 % dans l\u2019ensemble des IAA (83 % dans le secteur d\u2019activit\u00e9 de production de viande et 97 % dans le secteur des fruits et l\u00e9gumes).\n", "extras": {"check:available": false, "check:date": "2025-10-03T07:53:02.083626+00:00", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34190728, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "526269f8-d15b-4c76-89d4-073a51ac0d03", "internal": {"created_at_internal": "2025-10-03T07:52:37.756000+00:00", "last_modified_internal": "2025-10-03T07:52:37.756000+00:00"}, "last_modified": "2025-10-03T07:52:37.756000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/526269f8-d15b-4c76-89d4-073a51ac0d03", "metrics": {"views": 52}, "mime": null, "preview_url": null, "schema": null, "title": "Production de d\u00e9chets non dangereux dans les industries agroalimentaires en 2020", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2409/detail/"}, {"checksum": null, "created_at": "2025-10-03T07:38:19.326000+00:00", "description": "Toutes les publications annuelles 2011 \u00e0 2022 de la collection Chiffres et Donn\u00e9es\n", "extras": {"check:available": false, "check:date": "2025-10-03T07:39:07.201420+00:00", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34190409, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "3f59f074-a689-471c-a4b6-cb00efe513da", "internal": {"created_at_internal": "2025-10-03T07:38:19.326000+00:00", "last_modified_internal": "2025-10-03T07:38:19.326000+00:00"}, "last_modified": "2025-10-03T07:38:19.326000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/3f59f074-a689-471c-a4b6-cb00efe513da", "metrics": {"views": 41}, "mime": null, "preview_url": null, "schema": null, "title": "D\u00e9penses pour prot\u00e9ger l'environnement dans les IAA", "type": "other", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/D%C3%A9penses+pour+prot%C3%A9ger+l%27environnement/searchUiid/search/"}, {"checksum": null, "created_at": "2025-10-02T19:02:56.812000+00:00", "description": "L\u2019enqu\u00eate de l\u2019Insee sur les d\u00e9penses pour prot\u00e9ger l\u2019environnement dans\nl\u2019industrie (Antipol) permet de mesurer l\u2019effort r\u00e9alis\u00e9 dans ce domaine\npar les industriels. Le service de la statistique et de la prospective (SSP)\nanalyse ici les r\u00e9sultats de l\u2019enqu\u00eate pour les industries agroalimentaires et\nles scieries.\n", "extras": {"check:available": false, "check:date": "2025-10-02T19:03:40.369298+00:00", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34166831, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "a96f9482-0102-45f7-826e-9d54a5f41023", "internal": {"created_at_internal": "2025-10-02T19:02:56.812000+00:00", "last_modified_internal": "2025-10-02T19:02:56.812000+00:00"}, "last_modified": "2025-10-02T19:02:56.812000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/a96f9482-0102-45f7-826e-9d54a5f41023", "metrics": {"views": 47}, "mime": null, "preview_url": null, "schema": null, "title": "Enqu\u00eate sur les investissements dans l'industrie pour prot\u00e9ger l'environnement", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-IAA%20protection%20environnement/methodon/"}, {"checksum": null, "created_at": "2025-10-02T18:48:08.670000+00:00", "description": "Fiche de pr\u00e9sentation synth\u00e9tique.\n", "extras": {"check:available": false, "check:date": "2025-10-02T18:48:46.710000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 34165728, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "be57ff34-1d2f-472d-986f-fe6266824ec0", "internal": {"created_at_internal": "2025-10-02T18:48:08.670000+00:00", "last_modified_internal": "2025-10-02T19:00:12.183000+00:00"}, "last_modified": "2025-10-02T19:00:12.183000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/be57ff34-1d2f-472d-986f-fe6266824ec0", "metrics": {"views": 40}, "mime": null, "preview_url": null, "schema": null, "title": "\u00c9laboration des statistiques annuelles d\u2019entreprise (ESANE) dans les IAA", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-ESANE%20IAA/methodon/"}], "schema": null, "slug": "agreste-depenses-pour-proteger-l-environnement-dans-les-industries-agroalimentaires", "spatial": {"geom": null, "granularity": "fr:region", "zones": ["country:fr"]}, "tags": ["agroalimentaire", "dechets", "depenses", "eaux-usees", "environnement", "protection"], "temporal_coverage": null, "title": "Agreste - D\u00e9penses pour prot\u00e9ger l\u2019environnement dans les industries agroalimentaires", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-depenses-pour-proteger-l-environnement-dans-les-industries-agroalimentaires/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": "Enqu\u00eate Antipol", "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-05-02T09:43:12.397000+00:00", "deleted": null, "description": "Objectifs : Actualiser la connaissance sur le montant et la nature des \u00e9tudes, des investissements (tous les ans), et des d\u00e9penses courantes (tous les trois ans) pour prot\u00e9ger l'environnement. Derni\u00e8re ann\u00e9e disponible 2022.\n\\\nPrincipaux sujets trait\u00e9s : Les investissements (mat\u00e9riels enti\u00e8rement d\u00e9di\u00e9s \u00e0 la protection de l'environnement, achats d'\u00e9quipements de production plus performants en mati\u00e8re environnementale...), les \u00e9tudes (en vue d'un investissement ou r\u00e9glementaires) et les d\u00e9penses courantes (collect\u00e9es tous les 3 ans) destin\u00e9es \u00e0 prot\u00e9ger l'environnement.\n", "description_short": null, "extras": {"datagouv_ckan_id": "4226001c-4230-492b-8cb1-c3b5caa932d0", "datagouv_ckan_last_sync": "2014-09-17T03:38:07.895000"}, "featured": false, "frequency": "punctual", "frequency_date": null, "harvest": null, "id": "53699443a3a729239d2043da", "internal": {"created_at_internal": "2014-05-02T09:43:12.397000+00:00", "last_modified_internal": "2025-12-16T15:34:38.089000+00:00"}, "last_modified": "2025-12-16T15:34:38.089000+00:00", "last_update": "2019-07-23T15:23:31.249000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11
ot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 38202490, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "55dc4f05-3dbf-46f4-8fc5-5107c4eb7b92", "internal": {"created_at_internal": "2025-12-18T14:35:51.729000+00:00", "last_modified_internal": "2025-12-18T14:35:51.729000+00:00"}, "last_modified": "2025-12-18T14:35:51.729000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/55dc4f05-3dbf-46f4-8fc5-5107c4eb7b92", "metrics": {"views": 52}, "mime": null, "preview_url": null, "schema": null, "title": "Agreste - Collection Primeurs P\u00eache martitime", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/P%25C3%25AAche/e3514d99-7b66-488b-bd8d-c9612c396bed/search/"}, {"checksum": null, "created_at": "2025-12-18T10:10:11.951000+00:00", "description": "**Source et m\u00e9thodologie**\n\n<https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-Enquete%20aquaculture%202023/methodon/>\n\n**Principaux sujets trait\u00e9s**\n\n* Productions annuelles vendues en quantit\u00e9s et en valeur par esp\u00e8ce, par type d\u2019\u00e9levage, par stade d\u2019\u00e9levage (\u0153ufs, juv\u00e9niles et adultes) et par destination (consommation finale, autre entreprise, repeuplement) ;\u00a0\\\n  \\- l'emploi par genre, temps de travail, statut, dipl\u00f4me, nationalit\u00e9 ;- production certifi\u00e9e bio .\n\n- Derni\u00e8re publication issue de cette source : [Chiffres et Donn\u00e9es n\u00b02025-6 (mars 2025)](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2506/detail/ \"Navigation vers la rubrique Chiffres et Analyses\")\n", "extras": {"check:available": false, "check:date": "2025-12-18T10:10:33.549000", "check:error": "Cannot connect to host agreste.agriculture.gouv.fr:443 ssl:True [SSLCertVerificationError: (1, '[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:992)')]", "check:id": 38193618, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "b8372f27-953b-41fc-a6f8-dce82ffd4d14", "internal": {"created_at_internal": "2025-12-18T10:10:11.951000+00:00", "last_modified_internal": "2025-12-18T14:52:35.342000+00:00"}, "last_modified": "2025-12-18T14:52:35.342000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/b8372f27-953b-41fc-a6f8-dce82ffd4d14", "metrics": {"views": 73}, "mime": null, "preview_url": null, "schema": null, "title": "Enqu\u00eate annuelle aquaculture (conchyliculture, culture d'algues cyanobact\u00e9ries, pisciculture \u00e9tangs, pisciculture matine, salmoniculture \u00e9l\u00e9vage estrageons)", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/disaron/P%25C3%25AAche/2a7254f2-de3c-4640-b8db-a260ae244960/search/"}, {"checksum": null, "created_at": "2014-10-16T15:25:09.447000+00:00", "description": "#### Principaux sujets trait\u00e9s\n\n\\- productions annuelles vendues en quantit\u00e9s et en valeur par esp\u00e8ce, par stade d\u2019\u00e9levage (\u0153ufs, juv\u00e9niles et adultes) et par destination (consommation finale, autre entreprise, repeuplement) ;\\\n\\- entr\u00e9es annuelles de poissons/algues et d\u2019aliments, selon le stade d\u2019\u00e9levage et le lieu d\u2019origine ;\\\n\\- moyens de production de l\u2019entreprise ;\\\n\\- qualit\u00e9 (processus et produit), sanitaire et environnement ;\\\n\\- emploi par genre, temps de travail, statut, dipl\u00f4me, nationalit\u00e9 ;\\\n\\- innovation.\n\n* [Publication associ\u00e9e : Chiffres et Donn\u00e9es n\u00b0 2020-3](https://agreste.agriculture.gouv.fr/agreste-web/disaron/Chd2003/detail/)\n\n", "extras": {"check:available": false, "check:count-availability": 101, "check:date": "2024-10-28T14:30:29.736000", "check:error": "https:///enquetes/aquaculture/recensement-de-la-pisciculture/ - Invalid redirect URL origin", "check:headers:charset": "utf-8", "check:timeout": false, "check:url": "http://agreste.agriculture.gouv.fr/enquetes/aquaculture/recensement-de-la-pisciculture/"}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "ee481f62-9cfa-4913-a775-0271b243c20f", "internal": {"created_at_internal": "2014-10-16T15:25:09.447000+00:00", "last_modified_internal": "2025-12-18T10:04:19.812000+00:00"}, "last_modified": "2025-12-18T10:04:19.812000+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/ee481f62-9cfa-4913-a775-0271b243c20f", "metrics": {"nb_hits": 0, "nb_uniq_visitors": 0, "nb_visits": 0, "views": 246}, "mime": null, "preview_url": null, "schema": null, "title": "Agreste  - Recensement de la pisciculture, de l'algoculture et de la culture de cyanobact\u00e9ries 2018", "type": "main", "url": "https://agreste.agriculture.gouv.fr/agreste-web/methodon/S-Recens.Pisciculture%202019/methodon/"}], "schema": null, "slug": "agreste-peche-et-aquaculture", "spatial": {"geom": null, "granularity": "other", "zones": []}, "tags": ["bars", "daurades", "elevage", "esturgeons", "pisciculture", "poisson", "turbots"], "temporal_coverage": {"end": "2018-12-31", "start": "2018-01-01"}, "title": "Agreste  - P\u00eache et aquaculture.", "uri": "https://www.data.gouv.fr/api/1/datasets/agreste-peche-et-aquaculture/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2014-04-16T14:59:34.530000+00:00", "deleted": null, "description": "Prix des terres agricoles (terres et pr\u00e9s, et vignes), \u00e9volutions, principaux r\u00e9sultats.\n\nCes transactions sont trait\u00e9es selon un algorithme commun SSP-FNSafer pour produire des prix moyens, mini et maxi aux diff\u00e9rents niveaux g\u00e9ographiques. Pour les terres il s'agit d'un mod\u00e8le h\u00e9donique au niveau r\u00e9gional et de moyennes triennales au niveau d\u00e9partemental et petite r\u00e9gion agricole, apr\u00e8s filtrage des transactions sur trop petites surfaces et des aberrants. Pour les vignes, en raison du faible nombre de transactions, leurs r\u00e9sultats sont liss\u00e9s avec le concours des experts fonciers des SAFER.\n", "description_short": "Ces transactions sont trait\u00e9es pour produire des prix moyens, mini et maxi aux diff\u00e9rents niveaux g\u00e9ographiques. ", "extras": {"datagouv_ckan_id": "545f45eb-acb0-4f9e-b1b0-99c34c24efec", "datagouv_ckan_last_sync": "2014-09-17T03:38:20.412000"}, "featured": false, "frequency": "annual", "frequency_date": "2016-02-18T00:00:00+00:00", "harvest": null, "id": "5369a33ca3a729239d206a01", "internal": {"created_at_internal": "2014-04-16T14:59:34.530000+00:00", "last_modified_internal": "2025-10-10T07:54:49.453000+00:00"}, "last_modified": "2025-10-10T07:54:49.453000+00:00", "last_update": "2025-09-25T08:54:30.807000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 1, "discussions_open": 1, "followers": 1, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 1823, "reuses": 2, "reuses_by_months": {"2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0, "2026-07": 0, "2026-08": 1, "2026-09": 1}, "views": 9532}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png"
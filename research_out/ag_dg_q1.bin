que europ\u00e9enne** men\u00e9e entre les recensements agricoles pour suivre l\u2019\u00e9volution des structures. Elle fait suite \u00e0 l\u2019enqu\u00eate men\u00e9e en 2013.\n\nLes donn\u00e9es recueillies concernent les cultures sur la campagne 2015-2016, les cheptels pr\u00e9sents \u00e0 une date donn\u00e9e, les activit\u00e9s de diversification exerc\u00e9es au sein de l\u2019exploitation, la main-d\u2019\u0153uvre et le temps de travail, et certaines th\u00e9matiques plus sp\u00e9cifiques.\\\nL\u2019int\u00e9r\u00eat principal de l\u2019enqu\u00eate r\u00e9side dans la possibilit\u00e9 de croiser ces informations pour mesurer l\u2019\u00e9volution du nombre d\u2019exploitations et du travail agricole par type de structure et d\u00e9crire le fonctionnement des exploitations sur certaines th\u00e9matiques.\\\nEn 2016, cette enqu\u00eate se d\u00e9roule en m\u00eame temps que l'enqu\u00eate europ\u00e9enne sur la structure des vergers.\n", "description_short": null, "extras": {}, "featured": false, "frequency": "punctual", "frequency_date": null, "harvest": null, "id": "55816d8bc751df3d4b1d4bfc", "internal": {"created_at_internal": "2015-06-17T14:52:27.107000+00:00", "last_modified_internal": "2025-10-16T10:21:11.971000+00:00"}, "last_modified": "2025-10-16T10:21:11.971000+00:00", "last_update": "2015-06-17T14:53:49.502000+00:00", "license": "fr-lo", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 1, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads": 356, "reuses": 0, "reuses_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "views": 3781}, "organization": {"acronym": "MAASA", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ca3a7292c64a77edf", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/76/c906161a504b679bf225ad9703cd09-100.png", "name": "Minist\u00e8re de l'Agriculture, de l'agro-alimentaire et de la souverainet\u00e9 alimentaire", "page": "https://www.data.gouv.fr/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire", "uri": "https://www.data.gouv.fr/api/1/organizations/ministere-de-lagriculture-de-lagro-alimentaire-et-de-la-souverainete-alimentaire/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/agreste-enquete-structure-2016", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"all_resources_available": false, "dataset_description_quality": true, "has_open_format": true, "has_resources": true, "license": true, "resources_documentation": true, "score": 0.8888888888888888, "spatial": true, "temporal_coverage": true, "update_frequency": true, "update_fulfilled_in_time": true}, "resources": [{"checksum": null, "created_at": "2015-06-17T14:53:49.502000+00:00", "description": "Principaux r\u00e9sultats\r\n", "extras": {"check:available": false, "check:count-availability": 30, "check:date": "2024-10-28T14:31:04.654000", "check:error": "https:///enquetes/structure-des-exploitations-964/enquete-structure-2013/ - Invalid redirect URL origin", "check:timeout": false, "check:url": "http://agreste.agriculture.gouv.fr/enquetes/structure-des-exploitations-964/enquete-structure-2013/"}, "filesize": null, "filetype": "remote", "format": "url", "harvest": null, "id": "ffe83414-edd1-41ae-9f06-e1b94f2fb6db", "intern
/************************ CSS des scripts MLM ******************************/
#table-of-contents {
    width: 100%;
    top: 0;
    transition: top 0.3s;
    padding-bottom: 10px;
    margin-top: -20px;
}

#table-of-contents ul {
    list-style-type: none;
    padding: 0;
    margin: 0;
}

#table-of-contents ul li {
    display: inline;
}

#table-of-contents ul li:not(:last-child):after {
    content: "|";
    margin: 0 5px;
}

#table-of-contents ul:before {
    content: "Dans cette page : ";
    font-weight: bold;
}

#table-of-contentsH2::before {
    content: "Dans cette page";
    font-weight: bold;
    /* margin-bottom: 10px; Ajustez la marge selon vos préférences */
}

.sticky {
    position: fixed;
    top: 20;
    background: #F5FBEC;
    width: 70%!important;
    z-index: 1000;
    padding-left: 10px;
    margin-top;
    10px;
    box-shadow: 0 10px 10px rgba(0, 0, 0, 0.05);
    border-radius: 10px;
}

#progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 10px;
    background-color: #f3f3f3;
    z-index: 1001;
}

#progress-bar {
    height: 100%;
    width: 0;
    background-color: green;
}

h5 {
    font-weight: bold;
}

@media (max-width: 911px) {
    #table-of-contents,
    #table-of-contentsH2 {
        float: none;
        display: block;
        // padding: 10px;
        position: relative;
        z-index: 1;
        clear: both;
        //padding: 40px 30px;
        box-shadow: none;
        // margin : 10px;
        // background:white;
    }
}

.boite-verte {
    background: #c9eec7;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    padding: 30px 40px;
}




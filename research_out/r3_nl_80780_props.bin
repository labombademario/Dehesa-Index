    },{
      "odata.type":"Cbs.OData.Topic","ID":330,"Position":280,"ParentID":320,"Type":"Topic","Key":"VastePlanten_279","Title":"Vaste planten","Description":"Vaste planten zijn kruidachtige planten die meerdere jaren leven.\r\n_\r\nVoorbeelden zijn: monnikskap, anemoon, maar ook siergrassen en bamboe en varens.","Datatype":"Long","Unit":"aantal","Decimals":0,"Default":"Missing","PresentationType":"Absolute"

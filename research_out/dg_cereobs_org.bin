iption_short": null, "extras": {"dcat": {"license": ["https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf"], "rights": ["https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf"]}, "recommendations-externals": [{"id": "https://annuaire-entreprises.data.gouv.fr/", "messages": {"en": {"button": "Visit l'Annuaire des Entreprises", "message": "L'Annuaire des Entreprises allows you to easily find TVA numbers", "title": "Are you looking for your TVA number?"}, "fr": {"button": "Consulter l'Annuaire des Entreprises", "message": "L'Annuaire des Entreprises vous permet de facilement retrouver des num\u00e9ros de TVA.", "title": "Vous cherchez votre num\u00e9ro de TVA ?"}}, "score": 50, "source": "edito"}], "recommendations:sources": ["edito"]}, "featured": false, "frequency": "daily", "frequency_date": null, "harvest": {"backend": "DCAT", "dct_identifier": "https://data.economie.gouv.fr/explore/dataset/numeros-de-tva-intracommunautaires-francais/", "domain": "data.economie.gouv.fr", "issued_at": "2026-06-09T00:00:00+00:00", "last_update": "2026-10-03T00:04:19.820000+00:00", "modified_at": "2026-10-02T11:44:15.994000+00:00", "remote_id": "https://data.economie.gouv.fr/explore/dataset/numeros-de-tva-intracommunautaires-francais/", "remote_url": "https://data.economie.gouv.fr/explore/dataset/numeros-de-tva-intracommunautaires-francais/", "source_id": "5cd454758b4c4139d85b64f2", "uri": "https://data.economie.gouv.fr/explore/dataset/numeros-de-tva-intracommunautaires-francais/"}, "id": "6a2b4e2393218f1e63d7389b", "internal": {"created_at_internal": "2026-06-12T00:09:07.430000+00:00", "last_modified_internal": "2026-06-12T00:09:07.430000+00:00"}, "last_modified": "2026-10-02T11:44:15.994000+00:00", "last_update": "2026-10-02T11:44:15.994000+00:00", "license": "lov2", "metrics": {"dataservices": 3, "discussions": 1, "discussions_open": 1, "followers": 1, "followers_by_months": {"2025-07": 0, "2025-08": 0, "2025-09": 0,
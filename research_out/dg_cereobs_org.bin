{"data": [{"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [{"contact_form": null, "email": null, "id": "67b7c2641ec104bcb7e260bb", "name": "DGE", "organization": {"acronym": "MEF", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ea3a7292c64a77f02", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", "name": "Minist\u00e8res \u00e9conomiques et financiers", "page": "https://www.data.gouv.fr/organizations/ministeres-economiques-et-financiers", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministeres-economiques-et-financiers", "uri": "https://www.data.gouv.fr/api/1/organizations/ministeres-economiques-et-financiers/"}, "owner": null, "role": "publisher"}], "created_at": "2026-09-28T00:00:00+00:00", "deleted": null, "description": "Cette cartographie recense les 65 laur\u00e9ats de l'Appel \u00e0 manifestation d'int\u00e9r\u00eat (AMI) lanc\u00e9 par la Direction g\u00e9n\u00e9rale des Entreprises pour acc\u00e9l\u00e9rer la transition circulaire du secteur du commerce. \n\nCouvrant plusieurs mod\u00e8les d'affaires, les laur\u00e9ats de cet AMI proposent des solutions matures pour accompagner les entreprises du commerce dans leur transition circulaire : gestion des invendus et des d\u00e9chets, reconditionnement, r\u00e9paration, r\u00e9emploi des emballages, vente en vrac, \u00e9quipements circulaires ou encore solutions logicielles ou de location. \n\nEn parall\u00e8le du r\u00e9pertoire qui recense tous les laur\u00e9ats et leurs contacts, cette cartographie permet d'identifier le territoire d'implantation de chaque laur\u00e9at, partout en France hexagonale (onglet 1) et en Martinique (onglet 2). Preuve que le commerce circulaire repose sur une activit\u00e9 au local et des emplois non d\u00e9localisables.", "description_short": null, "extras": {}, "featured": false, "frequency": "unknown", "frequency_date": null, "harvest": {"backend": "DCAT", "dct_identifier": "https://data.economie.gouv.fr/explore/dataset/laureats-commerce-circulaire/", "domain": "data.economie.gouv.fr", "issued_at": "2026-09-28T00:00:00+00:00", "last_update": "2026-10-03T00:02:04.862000+00:00", "modified_at": "2026-09-18T12:45:12+00:00", "remote_id": "https://data.economie.gouv.fr/explore/dataset/laureats-commerce-circulaire/", "remote_url": "https://data.economie.gouv.fr/explore/dataset/laureats-commerce-circulaire/", "source_id": "5cd454758b4c4139d85b64f2", "uri": "https://data.economie.gouv.fr/explore/dataset/laureats-commerce-circulaire/"}, "id": "6abb01fec98f21f136ff6315", "internal": {"created_at_internal": "2026-09-29T00:10:38.239000+00:00", "last_modified_internal": "2026-09-29T00:10:38.239000+00:00"}, "last_modified": "2026-09-18T12:45:12+00:00", "last_update": "2026-09-18T12:45:12+00:00", "license": "notspecified", "metrics": {"dataservices": 2, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": 0, "resources_downloads": 8, "reuses": 0, "reuses_by_months": 0, "views": 196}, "organization": {"acronym": "MEF", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ea3a7292c64a77f02", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", "name": "Minist\u00e8res \u00e9conomiques et financiers", "page": "https://www.data.gouv.fr/organizations/ministeres-economiques-et-financiers", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "minis
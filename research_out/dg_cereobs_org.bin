0:04:19.816000+00:00", "uri": "https://data.economie.gouv.fr/api/v2/catalog/datasets/numeros-de-tva-intracommunautaires-francais/attachments/description_fichier_tvaintrapdf"}, "id": "a0c8521a-3de2-46af-9cc1-b4a7a51bf712", "internal": {"created_at_internal": "2026-06-16T00:17:47.483000+00:00", "last_modified_internal": "2026-06-16T00:17:47.483000+00:00"}, "last_modified": "2026-06-15T09:03:00+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/a0c8521a-3de2-46af-9cc1-b4a7a51bf712", "metrics": {"views": 261}, "mime": null, "preview_url": null, "schema": null, "title": "Description_fichier_TVAintra.pdf", "type": "other", "url": "https://data.economie.gouv.fr/api/v2/catalog/datasets/numeros-de-tva-intracommunautaires-francais/attachments/description_fichier_tvaintrapdf"}], "schema": null, "slug": "numeros-de-tva-intracommunautaire-francais", "spatial": null, "tags": ["economie", "entreprise", "fiscalite", "intracommunautaire", "tva"], "temporal_coverage": {"end": null, "start": "1900-12-31"}, "title": "Num\u00e9ros de TVA Intracommunautaire fran\u00e7ais", "uri": "https://www.data.gouv.fr/api/1/datasets/numeros-de-tva-intracommunautaire-francais/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [{"contact_form": null, "email": null, "id": "67b7c4428743ff58f7e260e4", "name": "DGCCRF", "organization": {"acronym": "MEF", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ea3a7292c64a77f02", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", "name": "Minist\u00e8res \u00e9conomiques et financiers", "page": "https://www.data.gouv.fr/organizations/ministeres-economiques-et-financiers", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministeres-economiques-et-financiers", "uri": "https://www.data.gouv.fr/api/1/organizations/ministeres-economiques-et-financiers/"}, "owner": null, "role": "publisher"}], "created_at": "2020-09-01T19:37:12+00:00", "deleted": null, "description": "Cette liste r\u00e9pertorie tous les compl\u00e9ments alimentaires ayant fait l\u2019objet d\u2019une d\u00e9claration aupr\u00e8s des services de la DGCCRF depuis le 26 avril 2016, et ayant obtenu une attestation de d\u00e9claration de commercialisation sur le territoire fran\u00e7ais.\n\nChaque compl\u00e9ment alimentaire est d\u00e9taill\u00e9 tant dans sa pr\u00e9sentation, composition que ses conditions d\u2019utilisation. La liste ci-jointe n\u2019est pas exhaustive. Elle ne recense que les compl\u00e9ments alimentaires qui ont \u00e9t\u00e9 d\u00e9clar\u00e9s apr\u00e8s le 26 avril 2016 via la t\u00e9l\u00e9proc\u00e9dure Teleicare mise en service \u00e0 cette date. La liste des produits d\u00e9clar\u00e9s avant cette date n'est pas et ne sera pas publi\u00e9e.\n\n17/11/2022 : Le jeu de donn\u00e9es est modifi\u00e9 pour all\u00e9ger les types de donn\u00e9es fournies -> \u00e9limination de donn\u00e9es redondantes : ObjectifsEffets, PopulationsARisques et Ingr\u00e9dients.\n\n04/09/2023 : Le format du jeu de donn\u00e9es nous contraint \u00e0 publier le champ \"ingr\u00e9dient\" en liste.\n\n25/10/2023 : Le jeu de donn\u00e9es est modifi\u00e9 - le champ \"plantes\" est affich\u00e9 \u00e0 la place du champ \"ingr\u00e9dients\", il contient les informations voulue sous une forme plus lisible.\n\n13/02/2025 : la t\u00e9l\u00e9proc\u00e9dure T\u00e9l\u00e9Icare va \u00eatre d\u00e9commissionn\u00e9e le 16/05/2025. Elle sera d\u00e9sormais remplac\u00e9e par l'application[ https://compl-alim.beta.gouv.fr/accueil/](https://compl-alim.beta.gouv.fr/accueil/)  \n\n\nL'historique des produits sera repris par cette nouvelle application. Ce jeu de donn\u00e9es est donc d\u00e9sormais obsol\u00e8te. Le jeu de donn\u00e9es qui prend sa suite est ici : <https://www.data.gouv.fr/fr/datasets/declarations-de-complements-alimentaires/>", "description_short": null, "extras": {"dcat": {"license": ["https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf"], "rights": ["https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf"]}}, "featured": false, "frequency": "unknown", "frequency_date": null, "harvest": {"backend": "DCAT", "dct_identifier": "https://data.economie.gouv.fr/explore/dataset/liste-des-complements-alimentaires-declares-preprod/", "domain": "data.economie.gouv.fr", "issued_at": "2020-09-01T19:37:12+00:00", "last_update": "2026-10-03T00:00:34.642000+00:00", "modified_at": "2020-09-01T19:37:12+00:00", "remote_id": "https://data.economie.gouv.fr/explore/dataset/liste-des-complements-alimentaires-declares-preprod/", "remote_url": "https://data.economie.gouv.fr/explore/dataset/liste-des-complements-alimentaires-declares-preprod/", "source_id": "5cd454758b4c4139d85b64f2", "uri": "https://data.economie.gouv.fr/explore/dataset/liste-des-complements-alimentaires-declares-preprod/"}, "id": "6a29fcbd93218f1e63d73865", "internal": {"created_at_internal": "2026-06-11T00:09:32.710000+00:00", "last_modified_internal": "2026-06-11T00:09:32.710000+00:00"}, "last_modified": "2020-09-01T19:37:12+00:00", "last_update": "2020-09-01T19:37:12+00:00", "license": "lov2", "metrics": {"dataservices": 1, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": 0, "resources_downloads": null, "reuses": 0, "reuses_by_months": 0, "views": 796}, "organization": {"acronym": "MEF", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ea3a7292c64a77f02", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", "name": "Minist\u00e8res \u00e9conomiques et financiers", "page": "https://www.data.gouv.fr/organizations/ministeres-economiques-et-financiers", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministeres-economiques-et-financiers", "uri": "https://www.data.gouv.fr/api/1/organizations/ministeres-economiques-et-financiers/"}, "owner": null, "page": "https://www.data.gouv.fr/datasets/obsolete-liste-des-complements-alimentaires-declares-1", "permissions": {"delete": false, "edit": false, "edit_resources": false}, "private": false, "quality": {"dataset_description_quality": true, "license": true, "score": 0.2222222222222222, "spatial": false, "temporal_coverage": false, "update_frequency": false}, "resources": [], "schema": null, "slug": "obsolete-liste-des-complements-alimentaires-declares-1", "spatial": null, "tags": ["alimentation", "complements-alimentaires", "consommation", "declaration-de-commercialisation", "entreprise", "industrie-et-services", "teleprocedure"], "temporal_coverage": null, "title": "[Obsol\u00e8te] Liste des compl\u00e9ments alimentaires d\u00e9clar\u00e9s", "uri": "https://www.data.gouv.fr/api/1/datasets/obsolete-liste-des-complements-alimentaires-declares-1/"}, {"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [{"contact_form": null, "email": "DB-2PERF@finances.gouv.fr", "id": "693b5b6e0139d2f8f229d3fc", "name": "Vitor-Emmanuel PORTELA", "organization": {"acronym": "MEF", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ea3a7292c64a77f02", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", "name": "Minist\u00e8res \u00e9conomiques et financiers", "page": "https://www.data.gouv.fr/organizations/ministeres-economiques-et-financiers", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministeres-economiques-et-financiers", "uri": "https://www.data.gouv.fr/api/1/organizations/ministeres-economiques-et-financiers/"}, "owner": null, "role": "contact"}, {"contact_form": null, "email": null, "id": "67b7c4468743ff58f7e260e6", "name": "DB", "organization": {"acronym": "MEF", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ea3a7292c64a77f02", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", "name": "Minist\u00e8res \u00e9conomiques et financiers", "page": "https://www.data.gouv.fr/organizations/ministeres-economiques-et-financiers", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministeres-economiques-et-financiers", "uri": "https://www.data.gouv.fr/api/1/organizations/ministeres-economiques-et-financiers/"}, "owner": null, "role": "creator"}, {"contact_form": null, "email": null, "id": "67b7c43f8743ff58f7e260df", "name": "DB", "organization": {"acronym": "MEF", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff8ea3a7292c64a77f02", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/3b/06ce9c1027460a87364418789747b6-100.jpg", "name": "Minist\u00e8res \u00e9conomiques et financiers", "page": "https://www.data.gouv.fr/organizations/ministeres-economiques-et-financiers", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "ministeres-economiques-et-financiers", "uri": "https://www.data.gouv.fr/api/1/organizations/ministeres-economiques-et-financiers/"}, "owner": null, "role": "publisher"}], "created_at": "2026-06-04T15:33:15+00:00", "deleted": null, "description": "**Les donn\u00e9es publi\u00e9es sont issues des rapports annuels de performance (RAP) 2025 annex\u00e9s au projet de loi de r\u00e8glement pour 2025.**\n\nLes donn\u00e9es de la performance permettent de visualiser facilement au moyen d\u2019indicateurs de performance, les objectifs poursuivis et leurs r\u00e9sultats, pour chacune des grandes politiques publiques financ\u00e9es par l\u2019\u00c9tat.  \nCette d\u00e9marche, qui s\u2019inscrit dans le cadre de la revalorisation de la loi de r\u00e8glement, vise \u00e0 compl\u00e9ter l\u2019analyse des documents budg\u00e9taires, dans le but d\u2019\u00e9clairer le d\u00e9bat en cours sur les finances publiques et sur la transformation de l\u2019\u00c9tat.", "description_short": null, "extras": {"dcat": {"license": ["https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf"], "rights": ["https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf"]}}, "featured": false, "frequency": "annual", "frequency_date": null, "harvest": {"backend": "DCAT", "dct_identifier": "https://data.economie.gouv.fr/explore/dataset/performance-de-la-depense-rap-2025/", "domain": "data.economie.gouv.fr", "issued_at": "2026-06-04T15:33:15+00:00", "last_update": "2026-10-03T00:03:58.817000+00:00", "modified_at": "2026-06-04T15:33:15+00:00", "remote_id": "https://data.economie.gouv.fr/explore/dataset/performance-de-la-depense-rap-2025/", "remote_url": "https://data.economie.gouv.fr/explore/dataset/performance-de-la-depense-rap-2025/", "source_id": "5cd454758b4c4139d85b64f2", "uri": "https://data.economie.gouv.fr/explore/dataset/performance-de-la-depense-rap-2025/"}, "id": "6a28ac92414df73a456c5eda", "internal": {"
{"data": [{"acronym": null, "badges": [], "business_number_id": "66920078400124", "created_at": "2026-09-04T13:28:07.789000+00:00", "deleted": null, "description": "CONCESSIONNAIRE DE MATERIEL AGRICOLE\n", "ext": {}, "extras": {}, "id": "6a9ac7674e6979810024d28f", "image_url": null, "last_modified": "2026-09-04T13:33:18.238000+00:00", "logo": null, "logo_thumbnail": null, "members": [{"label": "Administrateur", "role": "admin", "since": "2026-09-04T13:28:07.791000+00:00", "user": {"avatar": null, "avatar_thumbnail": null, "class": "User", "deleted": null, "email": "***@groupeblanchard.com", "first_name": "RICHARD", "id": "6a9ac5952c2a815172343872", "last_login_at": null, "last_name": "LE BRECH", "page": "https://www.data.gouv.fr/users/richard-le-brech", "slug": "richard-le-brech", "uri": "https://www.data.gouv.fr/api/1/users/richard-le-brech/"}}], "metrics": {"dataservices": 0, "dataservices_by_months": 0, "datasets": 1, "datasets_by_months": {"2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0, "2026-07": 0, "2026-08": 0, "2026-09": 1}, "datasets_followers_by_months": {"2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0, "2026-07": 0, "2026-08": 0, "2026-09": 0}, "datasets_reuses_by_months": {"2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0, "2026-02": 0, "2026-03": 0, "2026-04": 0, "2026-05": 0, "2026-06": 0, "2026-07": 0, "2026-08": 0, "2026-09": 0}, "followers": 0, "members": 1, "reuses": 0, "reuses_by_months": 0, "reuses_followers_by_months": 0, "views": 226}, "name": "BLANCHARD AGRICULTURE", "page": "https://www.data.gouv.fr/organizations/blanchard-agriculture", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "presentation_blocs_published_at": null, "slug": "blanchard-agriculture", "teams": [], "uri": "https://www.data.gouv.fr/api/1/organizations/blanchard-agriculture/", "url": "https://www.blanchardagriculture.com/", "zone": null}, {"acronym": "ESA", "badges": [], "business_number_id": null, "created_at": "2023-04-27T11:58:28.668000+00:00", "deleted": null, "description": "Situ\u00e9e \u00e0 Angers depuis 1898 et \u00e0 Paris depuis septembre 2022, l\u2019Ecole Sup\u00e9rieure des Agricultures est l\u2019\u00e9cole des transitions : agronomiques, environnementales et alimentaires. L\u2019ESA axe son champ d\u2019expertise sur 4 th\u00e8mes :\n\nla transition agro\u00e9cologique et la comp\u00e9titivit\u00e9 des fili\u00e8res,\nla transition num\u00e9rique,\nl\u2019alimentation et la valorisation des produits de terroirs,\nl\u2019agriculture des territoires et les paysages urbains.\nL\u2019ESA est un \u00e9tablissement d\u2019enseignement sup\u00e9rieur et de recherche de dimension internationale. Elle forme chaque ann\u00e9e 3 200 \u00e9tudiants : Ing\u00e9nieur agronome, BTS, Bachelor, Licence, Master et Doctorat. \nL\u2019ESA privil\u00e9gie une recherche finalis\u00e9e et pluridisciplinaire au service de ses fili\u00e8res, formations et de son rayonnement international. 5 Unit\u00e9s de recherche, 90 collaborateurs de recherche dont 41 enseignants-chercheurs, \u0153uvrent \u00e0 une recherche au service de la conception de syst\u00e8mes agricoles et alimentaires durables.", "ext": {}, "extras": {}, "id": "644a4744fbb73968beba76da", "image_url": null, "last_modified": "2025-07-10T14:37:04.666000+00:00", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a1/58588723144a0892b8aa70fc0d2621.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/a1/58588723144a0892b8aa70fc0d2621-100.jpg", "members": [{"label": "Administrateur", "role": "admin", "since": "2023-04-27T11:58:28.668000+00:00", "user": {"avatar": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/7f/d739b2a1e74390846b90188a002b7a.jpg", "avatar_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/7f/d739b2a1e74390846b90188a002b7a-500.jpg", "class": "User", "deleted": null, "email": "***@groupe-esa.com", "first_name": "Pierre", "id": "644a38da00f66f379af8deb1", "last_login_at": null, "last_name": "PICOUET", "page": "https://www.data.gouv.fr/users/pierre-picouet", "slug": "pierre-picouet", "uri": "https://www.data.gouv.fr/api/1/users/pierre-picouet/"}}], "metrics": {"dataservices": 0, "dataservices_by_months": 0, "datasets": 0, "datasets_by_months": 0, "datasets_followers_by_months": 0, "datasets_reuses_by_months": 0, "followers": 0, "members": 1, "reuses": 0, "reuses_by_months": 0, "reuses_followers_by_months": 0, "views": 0}, "name": "L'Ecole Sup\u00e9rieure des Agricultures", "page": "https://www.data.gouv.fr/organizations/lecole-superieure-des-agricultures", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "presentation_blocs_published_at": null, "slug": "lecole-superieure-des-agricultures", "teams": [], "uri": "https://www.data.gouv.fr/api/1/organizations/lecole-superieure-des-agricultures/", "url": "https://www.groupe-esa.com/", "zone": null}], "next_page": null, "page": 1, "page_size": 10, "previous_page": null, "total": 2}
    </Rubrica>
    <BilagIndhold id="ide42ee444-5db8-4bb8-aa89-2ca67807fccb">
      <TekstGruppe id="id31cabd2c-25d6-49ff-a9b5-73b479f508cc">
        <Exitus>
          <Linea>
            <Char formaChar="Bold">Tabel 1.</Char>
          </Linea>
          <Linea>
            <Char formaChar="Bold">Vægtningsfaktorer under basisstøtte</Char>
          </Linea>
        </Exitus>
        <Exitus>
          <Table width="680" style="column-width: 80pt 172pt 158pt 100pt;border-top: 0pt none #000000; border-left: 0pt none #000000; border-bottom: 0pt none #000000; border-right: 0pt none #000000; grid-H: 0pt none #000000; grid-V: 0pt none #000000;">
            <Tr>
              <Td bgcolor="#D0CECE" valign="top" style="border-top: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; border-right: 1pt solid #000000;">
                <Exitus>
                  <Linea>

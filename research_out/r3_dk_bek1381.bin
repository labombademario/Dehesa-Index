                    <Char>Afsnit II</Char>
                  </Linea>
                </Exitus>
              </Td>
              <Td bgcolor="#D0CECE" valign="top" style="border-top: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; border-right: 1pt solid #000000;">
                <Exitus>
                  <Linea>
                    <Char formaChar="Bold">Forpligtelse</Char>
                  </Linea>
                </Exitus>
              </Td>
              <Td bgcolor="#D0CECE" valign="top" style="border-top: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; border-right: 1pt solid #000000;">
                <Exitus>

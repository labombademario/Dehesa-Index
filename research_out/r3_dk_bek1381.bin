                </Exitus>
              </Td>
              <Td valign="top" style="border-top: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; border-right: 1pt solid #000000;">
                <Exitus>
                  <Linea>
                    <Char>Det samlede areal med tilskudsberettigede afgrøder skal udgøre mindst 5 pct. af omdriftsarealet.</Char>
                  </Linea>
                </Exitus>
              </Td>
              <Td valign="top" style="border-top: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; border-right: 1pt solid #000000;">
                <Exitus>
                  <Linea>
                    <Char>Arealet med tilskudsberettigede afgrøder udgør mindre end 5,0 pct. af det fastslåede omdriftsareal.</Char>
                  </Linea>
                </Exitus>
              </Td>
              <Td valign="top" style="border-top: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; border-right: 1pt solid #000000;">
                <Exitus formaEx="Center">
                  <Linea>
                    <Char>1,0</Char>
                  </Linea>
                </Exitus>
              </Td>
            </Tr>
          </Table>
        </Exitus>
        <Exitus>
          <Linea>
            <Char>** Vægtningsfaktoren finder anvendelse på det godkendte, ansøgte areal, som ansøger har søgt tilskud for under tilskudsordningen, jf. § 51, stk. 2.</Char>
          </Linea>
        </Exitus>
        <Exitus />
      </TekstGruppe>
    </BilagIndhold>
  </Bilag>
</Dokument>
  <TitelGruppe id="id62265d9b-c19e-469f-bdb8-64422024a41e">
    <Titel id="id5be8cc89-b967-4835-aa02-3d47af776e2b">
      <Linea>
        <Char>Bekendtgørelse om tilskud til bio-ordninger for 2026</Char>
      </Linea>
    </Titel>
  </TitelGruppe>
  <DokumentIndhold id="iddf3513c1-e13a-4b96-8c0b-a5c3260eccae">
    <Indledning id="id4a1ef634-69c7-4870-9dc7-e11c760216f9">
      <Exitus>
        <Linea>
          <Char>I medfør af § 2, stk. 1 og 4, § 4, § 13 og § 19, stk. 1 og 2, i lov nr. 407 af 25. april 2023 om administration af den fælles landbrugspolitik m.v. fastsættes efter bemyndigelse:</Char>
        </Linea>
      </Exitus>
    </Indledning>
    <Afsnit id="id34482c8d-fbfe-4315-9955-01de8e0ee273" localId="I">
      <Explicatus>Afsnit I</Explicatus>
      <Rubrica id="ida3e8781e-71cb-4e78-b372-28127ea89154">
        <Linea>
          <Char formaChar="Bold">Anvendelsesområde, definitioner, ansøgning og overdragelse af arealer</Char>
        </Linea>
      </Rubrica>
      <Kapitel id="idc26f4b5d-c24d-43c4-b26c-0aae10c05c0e" localId="1">
        <Explicatus>Kapitel 1</Explicatus>
        <Rubrica id="idc4ed4297-6b1a-4c0c-826c-9365abd12dc3">
          <Linea>
            <Char formaChar="Italic">Bekendtgørelsens anvendelsesområde</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id2bacf6ea-7eb0-4526-913d-3a04db8e76bd" localId="1">
            <Explicatus>§ 1.</Explicatus>
            <Stk id="idd1b3deac-8db1-431f-935b-367a1fbeeb3b">
              <Exitus>
                <Linea>
                  <Char>Der kan ydes tilskud til følgende bio-ordninger:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id6dd82cc4-b394-4889-80bb-2c4708f36811">
                <Index>
                  <Indentatio id="idafe54e07-2767-40b6-9eb7-d35b0b1311f9" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Økologisk arealstøtte, jf. afsnit II, med følgende tilskudskategorier:</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="idb94353cb-8ca0-4df0-9fe5-f77ff9f4e0c2">
                      <Index>
                        <Indentatio id="idc0247d78-e4d9-4285-a5a0-11cb1be4cec8" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>Basisstøtte.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id21617bc2-3641-4961-b59b-35612da64a4f" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>Omlægningstillæg.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="idc42e9802-8972-4533-9b92-014405eeaa81" formaInd="Litra">
                          <Explicatus>c)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>Frugt/bær-tillæg.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id2fb79fa3-c145-4bec-8155-1c43fd6beaa3" formaInd="Litra">
                          <Explicatus>d)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>Tillæg for reduceret kvælstoftilførsel.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9d4fc934-55aa-45f0-ba5b-ca14dc0ef97e" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud til midlertidig ekstensivering, jf. afsnit III, med følgende tilskudskategorier:</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="ide95bfc37-7f31-4f33-82b6-663e99d5c72e">
                      <Index>
                        <Indentatio id="id7f0e3638-738c-4b84-8a2d-df827bb895a1" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>Basistilskud til småbiotoper og braklagte arealer.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id414689fe-9cba-4961-b71d-6d911cb9ac97" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>Tillæg til småbiotoper og brak på kulstofrige lavbundsjorder og arealer med vådområdepotentiale.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idda4543fd-a733-4e29-addf-09fbddabd82f" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud til miljø- og klimavenligt græs, jf. afsnit IV.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idff6fb563-e630-4b77-ad71-3ab20154f56c" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud til varieret planteproduktion, jf. afsnit V.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id76b378fb-e11d-40de-ae80-b18db6558bf4" localId="2">
        <Explicatus>Kapitel 2</Explicatus>
        <Rubrica id="id22d9a18f-878d-4c4a-aeba-4256fe5a5e24">
          <Linea>
            <Char formaChar="Italic">Definitioner</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="ida81146f5-96f4-4c86-93bd-9e6bf5adbfbc" localId="2">
            <Explicatus>§ 2.</Explicatus>
            <Stk id="ide46bab16-1e00-4b6c-ae92-fa129a4bde1f">
              <Exitus>
                <Linea>
                  <Char>I denne bekendtgørelse forstås ved:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idb3f5a54f-fa0b-4522-8597-29efb9b15d40">
                <Index>
                  <Indentatio id="ide9c2bd83-ee6e-4560-8743-50b12359aec1" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Afgrødekategori: Afgrødekategori, som defineret i bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id75296989-4a91-4e4d-b32c-bb70b7ee0382" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøgt areal: Det areal, der søges om tilskud til under en tilskudsordning eller under en tilskudskategori.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id32df9a48-a0bb-407b-9aca-eaf4b6833b68" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Bestøverbrak: Braklagt areal, hvor der etableres en bestøvervenlig blomsterblanding med henblik på at forbedre biodiversiteten for de bestøvende insekter.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ida03fc9ca-3cac-45f3-b901-c13a226e546b" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Blomsterbrak: Braklagt areal, hvor der etableres en blomsterblanding bestående af frø- og nektarproducerende plantearter.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd019ae54-2447-40b2-a6f4-1b025412e7bf" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Braklagt areal: Omdriftsareal uden produktion af afgrøder eller afgræsning, som opretholdes i en stand, der gør det egnet til landbrugsproduktion uden forberedende foranstaltninger udover brug af de sædvanlige landbrugsmetoder og -maskiner.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id7a029f8a-24dc-4516-acd8-8d448bbd5cf5" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Forpligtelser: De forpligtelser, der gælder for ansøger til at udføre eller undlade en handling efter den ansøgte tilskudsordning eller tilskudskategori.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id51d081c3-e968-47b7-98c2-e04239304ab6" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>GLM: Minimumsstandarder for god landbrugs- og miljømæssig stand, som omhandlet i artikel 13 i Europa-Parlamentets og Rådets forordning (EU) 2021/2115 af 2. december 2021 og i bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb9634580-d307-416d-87d1-831419b9a34b" formaInd="Nummer">
                    <Explicatus>8)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Godkendt, ansøgt areal: Den del af det ansøgte areal, hvor kriterierne for tilskudsberettigelse er opfyldt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id6c536631-7715-4989-b4f4-bd1c6c76dcbc" formaInd="Nummer">
                    <Explicatus>9)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Grundbetaling: Grundlæggende indkomststøtte med henblik på bæredygtighed, som omhandlet i artikel 21 og 22 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id4453599b-db8d-41ef-8536-2e9f3ac91d42" formaInd="Nummer">
                    <Explicatus>10)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>IMK: Ministeriet for Grøn Treparts Internet Markkort.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide01dc375-5733-44ec-83a6-70e5790616cb" formaInd="Nummer">
                    <Explicatus>11)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Jordbearbejdning: Enhver form for bearbejdning af jorden, som kan foretages i forbindelse med jordbrugsmæssig anvendelse af jorden, herunder pløjning og harvning.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd8ec9d29-8209-4f4d-b4d5-838e0038692c" formaInd="Nummer">
                    <Explicatus>12)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Kriterier for tilskudsberettigelse: De kriterier, der skal være opfyldt for at kunne få tilskud efter den ansøgte tilskudsordning eller tilskudskategori.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id3c9eec3a-2b76-47a5-bb67-1a8b12e57d11" formaInd="Nummer">
                    <Explicatus>13)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Omdriftsafgrøde: Afgrøde, der dyrkes på omdriftsarealer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="iddc448236-f3d0-46f3-9f40-07a78529b2e9" formaInd="Nummer">
                    <Explicatus>14)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Omdriftsareal: Areal med produktion af afgrøder, der ikke anses som permanente afgrøder eller permanent græs, eller areal, der er til rådighed for produktion af afgrøder, men som ligger brak.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id47dde98d-75bd-4296-95ed-f515ac0d3446" formaInd="Nummer">
                    <Explicatus>15)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Overdragelse af areal: Det økonomiske ansvar for driften af arealet overdrages til en anden fysisk eller juridisk person ved salg, bortforpagtning, ophør af forpagtning eller en tilsvarende form for overdragelse.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ideffa4728-539c-440c-ab2f-366408038412" formaInd="Nummer">
                    <Explicatus>16)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Overtrådt areal: Den del af det godkendte, ansøgte areal, hvor en eller flere forpligtelser ikke er opfyldt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id34533b0d-1fab-47e8-b038-bd853667ab09" formaInd="Nummer">
                    <Explicatus>17)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Permanent græsareal: Areal, der dyrkes med græs eller andet grøntfoder, og som er holdt uden for omdriften i 5 år eller mere.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="iddad03dc1-c038-4385-8786-6c722e058702" formaInd="Nummer">
                    <Explicatus>18)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Planperiode: En planperiode, som defineret i § 10 i lov nr. 338 af 2. april 2019 om jordbrugets anvendelse af gødning og om næringsstofreducerende tiltag.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide521b69e-5290-42d8-a477-91bf1408318c" formaInd="Nummer">
                    <Explicatus>19)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Register for Gødningsregnskab: Det register, der føres i medfør af § 5, stk. 1, i lov nr. 338 af 2. april 2019 om jordbrugets anvendelse af gødning og om næringsstofreducerende tiltag.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2677a1e0-105c-433f-a1ae-2206a1cd6ba0" formaInd="Nummer">
                    <Explicatus>20)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Sanktionsfaktor: Den faktor, som det samlede vægtede, overtrådte areal ganges med for at fastlægge sanktionen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9a78eb47-b80c-43d6-a7a2-0694ee0468d4" formaInd="Nummer">
                    <Explicatus>21)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Småbiotop: Areal, der friholdes for udøvelse af landbrugsaktiviteter, og som med tilgroning, tilplantning eller vådgøring med henblik på at forbedre biodiversiteten, kan adskille sig i sin karakter fra de omkringliggende arealer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idf700d586-b459-41d4-a175-2ceade3886b4" formaInd="Nummer">
                    <Explicatus>22)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Solcelleanlæg: Tekniske anlæg med solceller, der enten kræver lokalplan eller landzonetilladelse efter planloven.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id3f3a15b5-3fb4-418a-b8ef-100c6dfe669b" formaInd="Nummer">
                    <Explicatus>23)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Styrelsen: Styrelsen for Grøn Arealomlægning og Vandmiljø.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id37d801c0-19cd-44f0-b399-64e09118b6e2" formaInd="Nummer">
                    <Explicatus>24)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud: Betegnelse for den økonomiske ydelse, der tildeles ansøger ved imødekommelse af en ansøgning til en af de i § 1 angivne tilskudsordninger eller tilskudskategorier, uanset om ydelsen benævnes som tilskud eller støtte i reglerne for tilskudsordningen eller tilskudskategorien.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id1b8a4c55-79b2-4222-bafd-bc68883567ca" formaInd="Nummer">
                    <Explicatus>25)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskudskategori: En del af en tilskudsordning med egne tilskudsbetingelser og egen tilskudssats.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id1b77376c-5eb0-4d73-8170-6572644626f1" localId="3">
        <Explicatus>Kapitel 3</Explicatus>
        <Rubrica id="id9272e7ac-2225-4f73-8098-a2ef7e1d09da">
          <Linea>
            <Char formaChar="Italic">Ansøgning og overdragelse af arealer</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id5663c580-bb0c-421b-8676-75bedfe58407" localId="3">
            <Explicatus>§ 3.</Explicatus>
            <Stk id="idad4b3415-108e-4f7e-a733-8be0c14bdd42">
              <Exitus>
                <Linea>
                  <Char>Ansøgning om tilskud skal ske i henhold til §§ 3-9, § 14, stk. 1, 2 og 5, § 15, § 16, stk. 1, og § 17 om henholdsvis fællesskema, Internet Markkort og fuldmagt i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id6364b051-43e3-4733-9653-a0b8f679e663" localId="4">
            <Explicatus>§ 4.</Explicatus>
            <Stk id="idbf9b3322-986e-4d11-98b0-4bb79780416a">
              <Exitus>
                <Linea>
                  <Char>Hvis et areal, hvortil der er søgt tilskud, bliver overdraget, vil tilskuddet uanset overdragelsen blive udbetalt til ansøger.</Char>
                </Linea>
                <Linea>
                  <Char>Ansøger forbliver ansvarlig for opfyldelse af kriterier for tilskudsberettigelse og forpligtelser.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idce6a82a3-d07a-463a-b06b-ccb6fce14d58">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Stk. 1 finder tilsvarende anvendelse, hvis rådigheden over et areal, hvortil der er søgt tilskud, overgår til en anden landbruger i 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
    </Afsnit>
    <Afsnit id="id463c461f-7684-4ffc-8e9a-7c3994949b93" localId="II">
      <Explicatus>Afsnit II</Explicatus>
      <Rubrica id="idc16d8db4-d8a9-44a4-a791-88a1d1946245">
        <Linea>
          <Char formaChar="Bold">Økologisk arealstøtte</Char>
        </Linea>
      </Rubrica>
      <Kapitel id="id5d3be759-689d-42a4-8a07-ff52b894adbf" localId="4">
        <Explicatus>Kapitel 4</Explicatus>
        <Rubrica id="id84827138-38df-4df9-a4ed-0037f2717bf9">
          <Linea>
            <Char formaChar="Italic">Ordningens indhold</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id2ac015f1-3831-4c14-98c7-cfee6ebdb41f" localId="5">
            <Explicatus>§ 5.</Explicatus>
            <Stk id="id87ec99d0-d123-469d-87e7-e39c1957e983">
              <Exitus>
                <Linea>
                  <Char>Der kan ydes økologisk arealstøtte for 2026 til at omlægge til og opretholde økologisk jordbrugsproduktion.</Char>
                </Linea>
                <Linea>
                  <Char>Økologisk arealstøtte omfatter basisstøtte for økologisk jordbrugsproduktion, der kan suppleres med de i nr. 1-3 anførte tillæg:</Char>
                </Linea>
              </Exitus>
              <Exitus id="iddb9fdb4d-adc9-42bb-83d8-898bdbe1ace9">
                <Index>
                  <Indentatio id="idb7bdfa7e-4143-4f84-bf90-38cd44ecc675" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Omlægningstillæg, der er et tillæg for arealer, der er under omlægning til økologisk jordbrugsproduktion.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id51c9efc1-c341-4e07-8d22-b56e98c90ff5" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Frugt/bær-tillæg, der er et tillæg for arealer med produktion af nærmere fastsatte typer af frugter og bær.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide9ebd542-bfe2-46b9-ad47-0d49a76b3f8d" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tillæg for reduceret kvælstoftilførsel, der er et tillæg for arealer på bedrifter med begrænset tilførsel af kvælstof.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idc8ad22a7-4dbf-486e-91bb-e04bb1beadfa">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Omlægningstillæg for et areal kan ikke ydes for mere end to på hinanden følgende kalenderår.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id8a4461e4-e1a1-487f-898f-a1f66f51e0ed">
            <Linea>
              <Char formaChar="Italic">Fradragsarealer inden for den ansøgte mark</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id431786ba-e68c-4113-8fa8-a5870043c798" localId="6">
            <Explicatus>§ 6.</Explicatus>
            <Stk id="id80ba3202-3a55-4336-ae8c-603a38924172">
              <Exitus>
                <Linea>
                  <Char>Ansøgning om støtte kan ikke omfatte følgende arealer:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id0b4e00b0-6e17-4930-abd8-6f0bf1ae95fa">
                <Index>
                  <Indentatio id="id904948df-e27f-417e-b45f-f615053b9f54" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som beliggende inden for 3-metersbræmmer omfattet af god landbrugs- og miljømæssig stand (GLM 4), jf. kort.lbst.dk/724 »3-metersbræmmer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5093b820-595c-45d7-82dd-694f7a50b6e7" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der den 1. november 2025 er registreret som § 3-areal på Danmarks Miljøportal, jf. kort.lbst.dk/724 »§ 3-arealer, 2026« og »§ 3-søer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc7582440-dae2-4cac-83d6-f248fe09ff68" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som omfattet af § 21 b, stk. 1, i lov om miljøbeskyttelse, jf. kort.lbst.dk/724 »25-meters beskyttelseszoner omkring vandboringer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id1fd21598-7dca-4aae-8243-56ed6db0fa98" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som arealer, der ikke er tilskudsberettigede under grundbetalingsordningen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb62bf161-4d6d-49f9-80a7-ec711c7a643e" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er indberettet i fællesskema som småbiotoper omfattet af ansøgning om tilskud til midlertidig ekstensivering under artikel 31 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idc1dd0a51-9c61-4634-91c7-7f800bb6128c">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>De i stk. 1 anførte arealer kan indgå i den indtegnede ansøgte mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark ikke overlapper med arealer, som omhandlet i stk. 1, anses størrelsen af den ansøgte mark som størrelsen af den indtegnede mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark overlapper med arealer, som omhandlet i stk. 1, anses de overlappende arealer ikke som omfattet af ansøgning om støtte og fratrækkes størrelsen af den indtegnede mark ved fastsættelse af størrelsen af den ansøgte mark.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id2d264811-894c-45a4-88f9-1f0f2e81001d" localId="5">
        <Explicatus>Kapitel 5</Explicatus>
        <Rubrica id="id7d3889f7-4a98-4a82-b3a3-9481bbc8ad1f">
          <Linea>
            <Char formaChar="Italic">Basisstøtte, kriterier for støtteberettigelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id0c90520c-dcec-4a79-b84c-a5f28c10fc01" localId="7">
            <Explicatus>§ 7.</Explicatus>
            <Stk id="ide11bb7c6-333d-40b8-916c-860282ebedeb">
              <Exitus>
                <Linea>
                  <Char>Basisstøtte for et areal er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id81f04ea3-6b5a-4d8e-8a2d-6007c6fe4833">
                <Index>
                  <Indentatio id="idb8ff4eb9-a4d5-49fa-8fb9-12474a50e391" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal have søgt om grundbetaling for arealet i 2026, og arealet skal være tilskudsberettiget under grundbetalingsordningen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb6710c07-ff02-41fe-9819-91a54a73823d" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøgers bedrift skal ved udløb af ansøgningsfristen være certificeret af styrelsen til økologisk jordbrugsproduktion eller være omfattet af en ansøgning herom.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id058bc672-a60e-40b6-ac25-3657f54199e3" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet skal senest den 1. januar 2026 være omlagt til eller være under omlægning til økologisk jordbrugsproduktion under en bedrift, der er certificeret af styrelsen til økologisk jordbrugsproduktion eller omfattet af en ansøgning herom.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id0ff43b07-0beb-4de9-8fca-f356add5d0e6" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må i 2026 ikke være indberettet i en ansøgning om grundbetaling som et areal, der er tilskudsberettiget i medfør af artikel 4, stk. 4, litra c, i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id1da37451-b82b-4dbd-85c2-e29353efd3ec" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det godkendte, ansøgte areal skal for hver enkelt mark udgøre mindst 0,01 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idaa29ecac-023e-4db7-b941-51f0e3ec19ab" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede godkendte, ansøgte areal under basisstøtte skal udgøre mindst 0,30 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idf90bc3ce-0e21-453c-b172-450b1f4742a9" localId="8">
            <Explicatus>§ 8.</Explicatus>
            <Stk id="idee012c19-2576-4e5d-8793-81252201a4de">
              <Exitus>
                <Linea>
                  <Char>Basisstøtte for et areal er endvidere betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idb6131762-bd56-4ca4-9fb7-a71ff6c71d01">
                <Index>
                  <Indentatio id="id8d053f2f-8e41-455b-8089-1f28bd966cad" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må med virkning inden for 2026 ikke være omfattet af tilsagn om tilskud til miljøvenligt landbrug eller til miljø- og klimavenligt landbrug under et af landdistriktsprogrammerne.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd901dac5-a658-4616-96be-9dbc39b5d43c" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må for 2026 ikke være omfattet af ansøgning om tilskud til midlertidig ekstensivering under artikel 31 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idea8c8e07-d9f6-4844-981e-5d153e7d60df" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må med virkning for 2026 ikke være omfattet af ansøgning om tilsagn om tilskud eller tilsagn om tilskud til pleje af græs- og naturarealer, til permanent ekstensivering eller til fastholdelse af arealer i vand- og klimaprojekter under artikel 70 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id611b7681-3e23-4e10-b998-25691eef1fcd" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke indgå i et minivådområde med omkringliggende areal, der er etableret med tilskud i medfør af anden lovgivning eller er omfattet af tilsagn om tilskud, der er meddelt i medfør af anden lovgivning senest i den planperiode, der udløber i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id2c97f822-ed49-4d30-90f2-a5cf710d35f6" localId="9">
            <Explicatus>§ 9.</Explicatus>
            <Stk id="id900e817b-79a4-4853-9f8b-e72a151ee31f">
              <Exitus>
                <Linea>
                  <Char>Basisstøtte for et areal er endvidere betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idd2adb57e-0c1e-47dd-9dc6-f8eec143a34d">
                <Index>
                  <Indentatio id="idb75db189-6241-4079-a877-fde6ac10fad5" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af en regulering, der har virkning i 2026, og som indebærer, at betingelserne for økologisk jordbrugsproduktion eller betingelser, der i hovedsagen svarer hertil, skal opfyldes for arealet som følge af</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="idbf19c2ae-25fe-4af2-bae6-d4817b90210a">
                      <Index>
                        <Indentatio id="id8bf7bf43-abf6-4634-8d6b-3eb6a701e857" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>tilskud i medfør af anden lovgivning end reglerne for de i § 8 omhandlede tilskudsordninger,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id00dda96d-7236-4543-8149-92e56fff3f39" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>aftale, der indebærer betaling for den nævnte regulering,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="idb6701ebc-3124-47ec-b8b7-3d64cc81695b" formaInd="Litra">
                          <Explicatus>c)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>servitut eller</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id21acbec6-a285-4ea0-bbdb-c2298a27a5c9" formaInd="Litra">
                          <Explicatus>d)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>krav, der er pålagt i medfør af anden lovgivning.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5237f721-c929-4647-af9f-44794229b4d9" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af en regulering, der har virkning i 2026, og som indebærer, at arealet ikke må eller i hovedsagen ikke må tilføres kemiske plantebeskyttelsesmidler, og ikke må tilføres gødning eller alene må tilføres den gødning, der efterlades af græssende husdyr, som følge af</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="id5d09f843-46d4-479c-87a5-7b4efbda5a44">
                      <Index>
                        <Indentatio id="id1d4527b8-b00d-41ab-84e1-c5c0b54fcb64" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>tilskud i medfør af anden lovgivning end reglerne for grundbetaling og reglerne for de i § 8 omhandlede tilskudsordninger,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="idb4c537aa-8433-4460-9845-96bc6c19810e" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>aftale, der indebærer betaling for den nævnte regulering,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="idf9be6035-066a-48e9-9749-a01dcad81eb5" formaInd="Litra">
                          <Explicatus>c)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>servitut eller</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="ida294e826-4307-4271-9682-2620635d0ac3" formaInd="Litra">
                          <Explicatus>d)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>krav, der er pålagt i medfør af anden lovgivning end bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id000a68c7-c3df-469e-9d1e-7352b80d860d" localId="6">
        <Explicatus>Kapitel 6</Explicatus>
        <Rubrica id="id6facc918-341e-4c57-8285-80b3a7aea6c5">
          <Linea>
            <Char formaChar="Italic">Basisstøtte, forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id8564a6fd-ca07-4866-9120-5ce9755e911c" localId="10">
            <Explicatus>§ 10.</Explicatus>
            <Stk id="id134cb28d-b554-40e1-8ef4-548af0472dd1">
              <Exitus>
                <Linea>
                  <Char>Basisstøtte for et areal er betinget af opfyldelse af følgende forpligtelser:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id254766f3-44fe-47f4-a311-8dcd85dd7989">
                <Index>
                  <Indentatio id="ide149c5c3-78bb-4191-8e17-542815338a3f" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet skal i hele 2026 være omlagt til eller være under omlægning til økologisk jordbrugsproduktion under en bedrift, der er certificeret af styrelsen til økologisk jordbrugsproduktion eller omfattet af en ansøgning herom.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id165365e5-c1cf-45fa-b50d-92629e28c0bb" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Plantebeskyttelsesmidler, der tilføres arealet i 2026, må kun omfatte plantebeskyttelsesmidler, der er tilladt i økologisk jordbrugsproduktion i Danmark.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id13c6463a-7533-4f3c-bf04-106573449cbd" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Gødning, der tilføres arealet i 2026, må kun omfatte gødning, der er tilladt i økologisk jordbrugsproduktion i Danmark.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id12b7e2a8-e069-4f86-94fc-6109e32db336" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Skatte-, moms- og driftsregnskaber, der vedrører 2026, skal opbevares af ansøger i mindst 5 år fra udbetalingstidspunktet.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="iddaeb925c-0c0b-4b06-b313-216cc4fd6b39" localId="11">
            <Explicatus>§ 11.</Explicatus>
            <Stk id="idd752c318-1e44-4d03-b1a0-71963946b0ab">
              <Exitus>
                <Linea>
                  <Char>For bedrifter, der ved udløb af ansøgningsfristen er registreret i Register for Gødningsregnskab med virkning for den planperiode, der udløber i 2026, er basisstøtte for et areal betinget af opfyldelse af følgende forpligtelser:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id34541ff2-659b-4921-af44-9f5476c2df07">
                <Index>
                  <Indentatio id="id4ef1ce09-8b43-44cf-a359-c847c55372c9" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>På bedriften må der i gennemsnit maksimalt tilføres 107 kg udnyttet kvælstof pr. ha harmoniareal i den planperiode, der udløber i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id6a01bae2-dfec-427c-9b67-4ee5c7e84ba4" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal for den planperiode, der udløber i 2026, udarbejde gødningsplanlægning og gødningsregnskab samt indsende gødningsregnskab efter reglerne i og regler fastsat i medfør af lov om jordbrugets anvendelse af gødning og om næringsstofreducerende tiltag.</Char>
                      </Linea>
                      <Linea>
                        <Char>Det skal af gødningsplanlægning og gødningsregnskab fremgå, at den i nr. 1 anførte forpligtelse henholdsvis er planlagt overholdt og er overholdt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id51718519-66f9-48fd-8718-9e1e0c7f8024" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Oplysninger om gødningsplanlægning for den planperiode, der udløber i 2026, skal fremgå af et særligt skema »Gødningskvote og Efterafgrøder«, som findes i Tast selv.</Char>
                      </Linea>
                      <Linea>
                        <Char>Oplysninger om gødningsplanlægning skal være modtaget i styrelsen senest ved udløb af ansøgningsfristen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id59e44803-5a40-4fb5-91ed-a5cd612cf228" localId="7">
        <Explicatus>Kapitel 7</Explicatus>
        <Rubrica id="idabb052b3-6be6-4e2c-82ac-3becdd36cee6">
          <Linea>
            <Char formaChar="Italic">Omlægningstillæg, kriterier for støtteberettigelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id8ce2cfb2-4bb3-44a9-828a-06798b04810d" localId="12">
            <Explicatus>§ 12.</Explicatus>
            <Stk id="id71fc5a25-5845-4ea6-bc8b-e085209cb7e1">
              <Exitus>
                <Linea>
                  <Char>Omlægningstillæg for et areal er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id34e1220f-1394-45a1-808b-71b708d0aaa3">
                <Index>
                  <Indentatio id="id7f64af16-71a4-4f5b-b7f0-e87e162d184e" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Der skal samtidig ansøges om basisstøtte for arealet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idfe65d439-8e1a-4ddb-859b-65e018909991" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Kriterier for støtteberettigelse for basisstøtte for arealet, jf. § 7, nr. 1-5, § 8 og § 9, skal opfyldes.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id75724dd5-fdc9-41f9-bff3-a4a8b027652a" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede godkendte, ansøgte areal under omlægningstillæg skal udgøre mindst 0,30 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id920f2f1a-e392-43d9-af33-636ace6f7ae3" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Omlægning af arealet til økologisk jordbrugsproduktion skal være påbegyndt den 2. januar 2024 eller senere.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idec177408-1e0f-4350-9ec8-6edfc3f56d4a" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke være indberettet som et braklagt areal i fællesskema for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id86376353-2ff8-43b1-8368-18981a3df670" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Forud for arealets aktuelle omlægningsdato skal arealet have været drevet uden for certificering til økologisk jordbrugsproduktion i en periode på mindst 5 år.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idd189c3f9-56e0-47f0-8c85-d4a8b5be87f0" localId="8">
        <Explicatus>Kapitel 8</Explicatus>
        <Rubrica id="idfc5261b6-1eac-44a0-9ed5-f831a5a7b6f9">
          <Linea>
            <Char formaChar="Italic">Omlægningstillæg, forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id7cc4d1a1-8d91-4ba4-99f4-840f13c177ea" localId="13">
            <Explicatus>§ 13.</Explicatus>
            <Stk id="id9656325b-35e8-4eaf-b36a-7d51c7d89d79">
              <Exitus>
                <Linea>
                  <Char>Omlægningstillæg for et areal er betinget af opfyldelse af de forpligtelser for basisstøtte for arealet, der er anført i § 10.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idebc48ac9-7b68-46e4-ad5e-611ef9d7837f" localId="14">
            <Explicatus>§ 14.</Explicatus>
            <Stk id="id5456ed14-ce52-44cd-a680-5bf3998f533d">
              <Exitus>
                <Linea>
                  <Char>Omlægningstillæg for et areal er betinget af, at for hvert kalenderår, der udbetales omlægningstillæg, bliver arealet i en umiddelbart efterfølgende sammenhængende periode på tre kalenderår drevet økologisk under en bedrift, der er certificeret af styrelsen til økologisk jordbrugsproduktion eller omfattet af en ansøgning herom, jf. dog stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id17785a7b-0f99-4478-8f16-3a26e222d4c0">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>I et kalenderår i den efterfølgende periode, jf. stk. 1, må til og med 2 ha af det samlede areal med omlægningstillæg være drevet ikke-økologisk.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis det ikke-økologisk drevne areal udgør over 2 ha af det nævnte samlede areal, anses forpligtelsen i stk. 1 som opfyldt for ikke-økologisk drevne arealer, der udgør maksimalt 10 pct. af den pågældende ansøgte marks areal med omlægningstillæg.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id385e899f-9ca5-4c27-be7e-07ff9f93a8f3">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hvis et areal, for hvilket der for det pågældende kalenderår er udbetalt omlægningstillæg, bliver overdraget helt eller delvis inden for den efterfølgende periode, jf. stk. 1, forbliver ansøger ansvarlig for opfyldelse af forpligtelsen i stk. 1.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id15cb0a58-2529-4afe-b0ad-1ff2bdeebc8f">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Stk. 3 finder tilsvarende anvendelse, hvis rådigheden over et areal, for hvilket der for det pågældende kalenderår er udbetalt omlægningstillæg, overgår til en anden landbruger inden for den efterfølgende periode.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idb1cb0387-4950-4e07-b804-8ffb1b058ee7">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved anvendelse af stk. 1-4 medtages ikke arealer med omlægningstillæg, der er krævet tilbagebetalt.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ide160ab44-63d4-42b4-b45b-5645fc4dffce">
              <Explicatus>Stk. 6.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Styrelsen kan i særlige tilfælde dispensere fra forpligtelsen i stk. 1.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id8f445daa-3fa1-42fe-87d3-8d325663b267" localId="9">
        <Explicatus>Kapitel 9</Explicatus>
        <Rubrica id="id145a6fd7-5bb9-44a2-8507-4582305062fa">
          <Linea>
            <Char formaChar="Italic">Frugt/bær-tillæg, kriterier for støtteberettigelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id773ee455-8995-43ce-b46c-cc29767ea354" localId="15">
            <Explicatus>§ 15.</Explicatus>
            <Stk id="idaa76b7c5-1950-43fd-a345-0a63e8790bdb">
              <Exitus>
                <Linea>
                  <Char>Frugt/bær-tillæg for et areal er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id325943a8-253a-44d5-83ac-6d5e74110e4f">
                <Index>
                  <Indentatio id="id471f04da-dba4-4bb4-a303-bff882ee6918" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Der skal samtidig ansøges om basisstøtte for arealet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id57ea8499-bd57-43dc-9fc5-047352482197" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Kriterier for støtteberettigelse for basisstøtte for arealet, jf. § 7, nr. 1-5, § 8 og § 9, skal opfyldes.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id3a42978c-7c92-4b9b-a479-6d5e07e52427" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede godkendte, ansøgte areal under frugt/bær-tillæg skal udgøre mindst 0,30 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id551c8ee0-baa2-4617-8a14-3c217eb68ce3" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet skal i fællesskema for 2026 være indberettet som et areal med frugt/bær, som omhandlet i § 16, stk. 2.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idc751ad41-cc54-4bae-a0fc-989adcd5ecb9" localId="10">
        <Explicatus>Kapitel 10</Explicatus>
        <Rubrica id="id33cad900-7dd5-4dc8-934f-4b3128446e87">
          <Linea>
            <Char formaChar="Italic">Frugt/bær-tillæg, forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id70202173-91f1-4671-b1c7-2c1e21e07872" localId="16">
            <Explicatus>§ 16.</Explicatus>
            <Stk id="id27c3f07d-590e-4bce-89f2-8d7bad618f02">
              <Exitus>
                <Linea>
                  <Char>Frugt/bær-tillæg for et areal er betinget af opfyldelse af de forpligtelser for basisstøtte for arealet, der er anført i § 10, og opfyldelse af de i stk. 2-6 anførte forpligtelser.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ide3781aef-5cdb-4687-bb3c-df21dd3f83cc">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Senest ved udløb af fristen for indgivelse af ændringer til fællesskema i 2026 skal der på arealet være etableret en eller flere af følgende frugter og bær og med mindst det anførte antal planter pr. ha for hovedafgrøden, jf. dog stk. 3:</Char>
                </Linea>
              </Exitus>
              <Exitus id="ida89b8047-175e-4735-8109-5e6c26f46ac2">
                <Index>
                  <Indentatio id="id79873300-e863-4248-89a4-2700bc2d7c18" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Surkirsebær (</Char>
                        <Char formaChar="Italic">Prunus cerasus</Char>
                        <Char>) 300 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id771ad146-b9be-4de7-80c3-fd2f9abc1019" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Æble (</Char>
                        <Char formaChar="Italic">Malus domestica</Char>
                        <Char>) 400 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id97511306-1bdb-41cc-a3a6-0f90f82cf7f5" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Pære (</Char>
                        <Char formaChar="Italic">Pyrus communis</Char>
                        <Char>) 400 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idba256308-1e5f-483c-8111-b29518827052" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Blommer (</Char>
                        <Char formaChar="Italic">Prunus domestica</Char>
                        <Char>) 400 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id996f6fd5-23b9-420c-9876-c3eb1329fafb" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Sødkirsebær (</Char>
                        <Char formaChar="Italic">Prunus avium</Char>
                        <Char>) 400 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id3b03f6b4-7b48-455b-93fd-1f17f3e4c1e8" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Trækvæde (</Char>
                        <Char formaChar="Italic">Cydonia oblonga</Char>
                        <Char>) 400 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8d4e3eaa-deca-470a-be0d-afdd1b8f873a" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hyld (</Char>
                        <Char formaChar="Italic">Sambucus nigra</Char>
                        <Char>) 600 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb3da2e52-ad68-47c2-a03a-0d6c40a344da" formaInd="Nummer">
                    <Explicatus>8)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hasselnød (herunder </Char>
                        <Char formaChar="Italic">Corylus maxima</Char>
                        <Char> og </Char>
                        <Char formaChar="Italic">Corylus avellana</Char>
                        <Char>) 225 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc40b1c62-9a7e-4222-914c-eb0bc6ed6214" formaInd="Nummer">
                    <Explicatus>9)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Almindelig valnød (</Char>
                        <Char formaChar="Italic">Juglans regia L.</Char>
                        <Char>) 100 planter pr. ha. For planter etableret efter 31. januar 2023 skal der anvendes podet plantemateriale.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id4ecd8c3d-b559-41ca-acb1-ed42b75b5f67" formaInd="Nummer">
                    <Explicatus>10)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ægte kastanje (</Char>
                        <Char formaChar="Italic">Castanea sativa</Char>
                        <Char> eller </Char>
                        <Char formaChar="Italic">Castanea crenata</Char>
                        <Char>) 100 planter pr. ha. For planter etableret efter 31. januar 2023 skal der anvendes podet plantemateriale.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id633eef04-2e61-42bf-adc0-26b8c0829359" formaInd="Nummer">
                    <Explicatus>11)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Morbær (</Char>
                        <Char formaChar="Italic">Morus spp.</Char>
                        <Char>) 600 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id879f2d83-89e0-4d45-bd2d-a5481124dbe4" formaInd="Nummer">
                    <Explicatus>12)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Brombær og brombær-krydsninger (</Char>
                        <Char formaChar="Italic">Rubus plicatus</Char>
                        <Char> eller </Char>
                        <Char formaChar="Italic">Rubus fruticosus</Char>
                        <Char>) 1.200 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id21b17df3-0e23-41a9-b346-80cdeae5e6ca" formaInd="Nummer">
                    <Explicatus>13)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Bærmispel (</Char>
                        <Char formaChar="Italic">Amelanchier laevis</Char>
                        <Char> eller </Char>
                        <Char formaChar="Italic">Amelanchier alnifolia</Char>
                        <Char>) 1.200 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5eaafbe2-de41-439f-85f8-daf42b7f4835" formaInd="Nummer">
                    <Explicatus>14)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Havtorn (</Char>
                        <Char formaChar="Italic">Hippophae rhamnoides</Char>
                        <Char>) 1.200 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idba6c4d0c-4b51-4c54-9f3c-081e2aee40c7" formaInd="Nummer">
                    <Explicatus>15)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Solbær (</Char>
                        <Char formaChar="Italic">Ribes nigrum</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide268de22-884d-497b-8fee-0ac23195413f" formaInd="Nummer">
                    <Explicatus>16)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ribs (</Char>
                        <Char formaChar="Italic">Ribes rubrum</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ida3a913fa-468e-4652-82ac-7220583fe7c2" formaInd="Nummer">
                    <Explicatus>17)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Stikkelsbær (</Char>
                        <Char formaChar="Italic">Ribes uva-crispa</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd9feb1d1-d34c-4439-8cb5-4a766b6027a8" formaInd="Nummer">
                    <Explicatus>18)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Blåbær (</Char>
                        <Char formaChar="Italic">Vaccinium myrtillus</Char>
                        <Char> eller </Char>
                        <Char formaChar="Italic">Vaccinium corymbosum</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide5fd1c09-0f8d-4e3d-afa9-2582fd56ded4" formaInd="Nummer">
                    <Explicatus>19)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hyben (</Char>
                        <Char formaChar="Italic">Rosa rugosa</Char>
                        <Char> eller </Char>
                        <Char formaChar="Italic">Rosa canina</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb5224d14-dccd-4e3e-9e42-bdd0203126de" formaInd="Nummer">
                    <Explicatus>20)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Surbær (</Char>
                        <Char formaChar="Italic">Aronia melanocarpa</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2216c356-63a4-4989-8be9-eb077693270d" formaInd="Nummer">
                    <Explicatus>21)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Japansk kvæde (</Char>
                        <Char formaChar="Italic">Chaenomeles speciosa</Char>
                        <Char> eller </Char>
                        <Char formaChar="Italic">Chaenomeles speciosa x japonica</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id20af0d5e-dcc4-43f7-ad41-a94e95400a2e" formaInd="Nummer">
                    <Explicatus>22)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Vindruer (</Char>
                        <Char formaChar="Italic">Vitis spp.</Char>
                        <Char>) 1.500 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide15ff11c-c433-4e5c-8ba3-81bcba8d77c1" formaInd="Nummer">
                    <Explicatus>23)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hindbær (</Char>
                        <Char formaChar="Italic">Rubus idaeus</Char>
                        <Char>) 2.000 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="iddb029eaf-2e5d-4014-87ca-1d3eedfce1ab" formaInd="Nummer">
                    <Explicatus>24)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Jordbær (</Char>
                        <Char formaChar="Italic">Fragaria ananassa</Char>
                        <Char>) 20.000 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idafd50301-600a-4c92-84dd-f153b8dc3fcb" formaInd="Nummer">
                    <Explicatus>25)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Storfrugtet tranebær (</Char>
                        <Char formaChar="Italic">Vaccinium macrocarpon</Char>
                        <Char>) 20.000 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5caf70ed-de69-4f1b-af82-cf6f254379b1" formaInd="Nummer">
                    <Explicatus>26)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tyttebær (</Char>
                        <Char formaChar="Italic">Vaccinium vitis-idaea</Char>
                        <Char>) 30.000 planter pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id791a0626-9a92-4bf7-bc87-4a16d33bf5d9">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>For eksisterende beplantninger kan styrelsen i særlige tilfælde dispensere fra de i stk. 2 anførte antal planter pr. ha. Ansøgning om dispensation skal være skriftlig og være modtaget i styrelsen senest ved udløb af fristen for indgivelse af ændringer til fællesskema i 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id42ef8fc6-1d65-474c-944c-b840f755b492">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hovedafgrøden er den afgrøde, som ansøger har indberettet for arealet i ansøgning om frugt/bær-tillæg for arealet.</Char>
                </Linea>
                <Linea>
                  <Char>Den indberettede hovedafgrøde skal være på arealet den 25. juli 2026 og med mindst det i stk. 2 anførte antal planter pr. ha for hovedafgrøden.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id4f121a86-f493-41f3-ad86-3bc1e35c3678">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hovedformålet med arealet skal være produktion af frugt eller bær med henblik på høst.</Char>
                </Linea>
                <Linea>
                  <Char>Hovedafgrøden skal være jævnt fordelt over arealet.</Char>
                </Linea>
                <Linea>
                  <Char>Hovedafgrøden skal fremstå som en plejet kultur i veldefinerede rækker, der muliggør høst af afgrøden og pleje af planterne.</Char>
                </Linea>
                <Linea>
                  <Char>Afstanden mellem rækkerne i hovedafgrøden må højst være 10 meter.</Char>
                </Linea>
                <Linea>
                  <Char>Afstanden måles fra centrum af planterne.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id4f5bdef5-2a85-4872-ac18-ba50e519651b">
              <Explicatus>Stk. 6.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>For hver enkelt mark, som arealet omfatter, må ubefæstede arbejdsarealer i udkanten af marken på to af markens sider være højst 10 meter brede og på markens øvrige sider være højst 5 meter brede.</Char>
                </Linea>
                <Linea>
                  <Char>Bredden måles fra centrum af planterne i den ydre række af frugt/bær.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id4665331d-31ed-4ea3-9e5b-df5578fd787a" localId="11">
        <Explicatus>Kapitel 11</Explicatus>
        <Rubrica id="id6779b2cd-574f-4714-a8ed-fb892ea4379e">
          <Linea>
            <Char formaChar="Italic">Tillæg for reduceret kvælstoftilførsel, kriterier for støtteberettigelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id012cfe03-859d-4f52-82e8-15f768aab059" localId="17">
            <Explicatus>§ 17.</Explicatus>
            <Stk id="idf8872d8a-ceeb-4575-bb34-1365a67bd6db">
              <Exitus>
                <Linea>
                  <Char>Tillæg for reduceret kvælstoftilførsel for et areal er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id653d449a-0cdb-43b1-a4f6-5d316259f605">
                <Index>
                  <Indentatio id="id5b5e9bdf-ad17-4e04-b117-b6c4bfaa54b9" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Der skal samtidig ansøges om basisstøtte for arealet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id3171d552-bb5d-4133-acfb-d0a461088ca6" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Kriterier for støtteberettigelse for basisstøtte for arealet, jf. § 7, nr. 1-5, § 8 og § 9, skal opfyldes.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id0ad84544-8bcc-4a0e-afa5-b3efe6706fc9" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede godkendte, ansøgte areal under tillæg for reduceret kvælstoftilførsel skal udgøre mindst 0,30 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id174a023c-d114-47c7-95ac-c2fdf78f5d64" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøgers bedrift skal ved udløb af ansøgningsfristen være registreret i Register for Gødningsregnskab med virkning for den planperiode, der udløber i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id0ff27a03-1fa7-4dd4-9c89-2e962db0ad87" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke være indberettet som et braklagt areal i fællesskema for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id7cef760b-429b-409d-b9d8-18a87d1b1eb1" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af en regulering, der har virkning i 2026, og som indebærer, at arealet ikke må tilføres gødning eller alene må tilføres den gødning, der efterlades af græssende husdyr, eller som indebærer, at der på arealet skal være tilført mindre end 107 kg udnyttet kvælstof pr. ha som følge af</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="idb3ee84be-a26e-492b-a4b8-1892cb25276c">
                      <Index>
                        <Indentatio id="id2bb3291d-e3e5-4891-b1b5-11ddb76e8192" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>tilskud i medfør af anden lovgivning end reglerne for grundbetaling og reglerne for de i § 8 omhandlede tilskudsordninger,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id9015728d-47b9-44b4-ba2d-a4f180ae1a74" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>aftale, der indebærer betaling for den nævnte regulering,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id3049d7f8-956c-407d-9668-85d214124091" formaInd="Litra">
                          <Explicatus>c)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>servitut eller</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id8229afba-de22-4e63-80a0-40e250bc4717" formaInd="Litra">
                          <Explicatus>d)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>krav, der er pålagt i medfør af anden lovgivning end bekendtgørelse om jordbrugsvirksomheders anvendelse af gødning og bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id910ef20c-cc28-4506-9dc5-00843ac6510c" localId="12">
        <Explicatus>Kapitel 12</Explicatus>
        <Rubrica id="id49ca52fd-bea1-4e33-ae28-73ba4c80fd07">
          <Linea>
            <Char formaChar="Italic">Tillæg for reduceret kvælstoftilførsel, forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idc3cb9634-475d-424d-a976-27d9d9480b7d" localId="18">
            <Explicatus>§ 18.</Explicatus>
            <Stk id="id35eac4f5-5ef4-49a2-8ea7-7d8468adc47c">
              <Exitus>
                <Linea>
                  <Char>Tillæg for reduceret kvælstoftilførsel for et areal er betinget af opfyldelse af følgende forpligtelser:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idc454f0e6-93bd-4b96-9292-f4501c99d480">
                <Index>
                  <Indentatio id="ida0b57c24-53b8-43b0-ad0d-b223a1f645f2" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>De forpligtelser for basisstøtte for arealet, der er anført i § 10, skal opfyldes.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc0e9bf76-c3da-4c1b-add4-66639df797d5" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>På bedriften må der i gennemsnit maksimalt tilføres 65 kg udnyttet kvælstof pr. ha harmoniareal i den planperiode, der udløber i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc8db1eaf-7595-4371-b306-602df47d4d8f" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal for den planperiode, der udløber i 2026, udarbejde gødningsplanlægning og gødningsregnskab samt indsende gødningsregnskab efter reglerne i og regler fastsat i medfør af lov om jordbrugets anvendelse af gødning og om næringsstofreducerende tiltag.</Char>
                      </Linea>
                      <Linea>
                        <Char>Det skal af gødningsplanlægning og gødningsregnskab fremgå, at den i nr. 2 anførte forpligtelse henholdsvis er planlagt overholdt og er overholdt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id59ffd3aa-6ea2-4478-8b6a-a0a4fe77a6bc" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Oplysninger om gødningsplanlægning for den planperiode, der udløber i 2026, skal fremgå af et særligt skema »Gødningskvote og Efterafgrøder«, som findes i Tast selv.</Char>
                      </Linea>
                      <Linea>
                        <Char>Oplysninger om gødningsplanlægning skal være modtaget i styrelsen senest ved udløb af ansøgningsfristen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id7c68e081-9167-444c-bffb-18d44b9e64de" localId="13">
        <Explicatus>Kapitel 13</Explicatus>
        <Rubrica id="ide34d8885-ec98-4990-8f3a-719e9590ca8f">
          <Linea>
            <Char formaChar="Italic">Støttens størrelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="ideec467c5-2e88-4480-8a19-c4adccef4107" localId="19">
            <Explicatus>§ 19.</Explicatus>
            <Stk id="idab57ec7d-840a-4671-ae6c-18da56dc5ae5">
              <Exitus>
                <Linea>
                  <Char>Støtten for 2026 udgør følgende beløb, jf. dog stk. 2 og 3:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idc5a896b1-9404-4661-b0dd-5222289e8fbf">
                <Index>
                  <Indentatio id="idf10d0968-500b-4441-b129-372d7cf3f65e" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Basisstøtte: 181,21 EUR pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd038bee3-1cf2-4aa2-a7f3-6ded6e4e1c4f" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Omlægningstillæg: 241,61 EUR pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id6f823a63-b6e1-4f2f-a246-32fdd63b43bf" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Frugt/bær-tillæg: 536,91 EUR pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id00d2275e-9f9a-425b-9129-e80e27745e79" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tillæg for reduceret kvælstoftilførsel: 87,25 EUR pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id7bcc8079-e933-40ad-92e1-3a299c2a4172">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved underansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan støtten blive forhøjet med maksimalt 10 pct. for den i stk. 1, nr. 2-4, anførte støtte og med maksimalt 25 pct. for den i stk. 1, nr. 1, anførte støtte.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ida6099a79-9947-4cda-83af-e2f4574bd54f">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved overansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan den i stk. 1, nr. 2-4, anførte støtte blive nedsat.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id1dd45820-a6f4-4eff-939f-1326a825c443" localId="20">
            <Explicatus>§ 20.</Explicatus>
            <Stk id="id9a3a9c7f-ab30-4506-bcd3-fddbd86788b9">
              <Exitus>
                <Linea>
                  <Char>Hvis det ansøgte areal er registreret i IMK som beliggende i en markblok af typen »Permanent græs (PGR)« med en tilknyttet tilskudsprocent, beregnes støtten på grundlag af det ansøgte areal, for hvilket kriterier og forpligtelser er opfyldt, ganget med markblokkens tilskudsprocent.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
    </Afsnit>
    <Afsnit id="idb2773d5f-475a-4159-8c0a-ed283bb3e210" localId="III">
      <Explicatus>Afsnit III</Explicatus>
      <Rubrica id="idbd93aae4-b3a5-431f-8568-bf987c0ff17e">
        <Linea>
          <Char formaChar="Bold">Tilskud til midlertidig ekstensivering</Char>
        </Linea>
      </Rubrica>
      <Kapitel id="id9381da79-3d2d-4379-a3a2-0cdf79a1a60e" localId="14">
        <Explicatus>Kapitel 14</Explicatus>
        <Rubrica id="id79e7b999-1d8c-49f6-9a0c-175816112c5f">
          <Linea>
            <Char formaChar="Italic">Ordningens indhold</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idb4f6fb22-ac68-4e2e-bb1a-943bf8c75b45" localId="21">
            <Explicatus>§ 21.</Explicatus>
            <Stk id="id32249a6e-7b49-4303-8510-7d0e581807da">
              <Exitus>
                <Linea>
                  <Char>Der kan ydes tilskud til landbrugere, der udlægger ikke-produktive arealer i form af småbiotoper på alle typer landbrugsarealer og brak på omdriftsarealer med henblik på at fremme biodiversiteten samt at fremme udtagning af kulstofrige lavbundsjorder i 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idd300d7a9-b4cf-4186-abde-4e9a3181ecef">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Der kan ydes et tillæg til småbiotoper og braklagte arealer, som udlægges på kulstofrige lavbundsjorder eller på arealer med vådområdepotentiale.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id39c6a6b8-af26-421c-9ba7-acba15e7cc8e">
            <Linea>
              <Char formaChar="Italic">Fradragsarealer inden for den ansøgte mark</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="iddd7956dd-ca81-4990-8ea9-bebf1c6ce4b2" localId="22">
            <Explicatus>§ 22.</Explicatus>
            <Stk id="id9ab4e5bb-2e10-4394-bddb-86a3c2d21a7a">
              <Exitus>
                <Linea>
                  <Char>Ansøgning om tilskud kan ikke omfatte følgende arealer:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id7cbbd214-61ec-44b1-86cb-0aa5148cae95">
                <Index>
                  <Indentatio id="id2fda6ca8-6b9f-47a9-95d5-54a71bdc85d2" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som beliggende inden for 3-metersbræmmer omfattet af god landbrugs- og miljømæssig stand (GLM 4), jf. kort.lbst.dk/724 »3-metersbræmmer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idfbb8efe8-c39d-4eee-8a4b-1e2b7908aa14" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der den 1. november 2025 er registreret som § 3-areal på Danmarks Miljøportal, jf. kort.lbst.dk/724 »§ 3-arealer, 2026« og »§ 3-søer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id51cb0da8-b37a-4eff-9d98-7f30a162b1ef" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som omfattet af § 21 b, stk. 1, i lov om miljøbeskyttelse, jf. kort.lbst.dk/724 »25-meters beskyttelseszoner omkring vandboringer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8c63c985-0e58-449a-a08f-1e625033ec20" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som arealer, der ikke er tilskudsberettigede under grundbetalingsordningen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idcc47bf02-408f-46d5-ba6a-89c3106a1d9b" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som arealer med særlig Natura 2000-udpegning, jf. kort.lbst.dk/724 »Særligt udpegede Natura 2000-arealer til pleje, 2024«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id15012f3f-6991-4970-8a50-dacdc249b783" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som arealer til opfyldelse af GLM 10, jf. bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb098997e-deb3-47cd-91bc-d1a9a06e9517" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der indberettes i ansøgningen som småbiotoper, og som for 2026 er registreret som arealer med et High Nature Value-indeks (HNV) på fem eller derover, jf. kort.lbst.dk/724 »HNV 5-13, august 2025«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id499e0ac3-764b-4fa0-83cd-bc998667e92a" formaInd="Nummer">
                    <Explicatus>8)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der indberettes i ansøgningen som småbiotoper, og som for 2026 er registreret som skovnegative områder, jf. kort.lbst.dk/724 »Områder hvor skovplantning er uønsket, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idad645d42-d3b5-414b-a94e-143f3d720f6b" formaInd="Nummer">
                    <Explicatus>9)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som markkrat.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idec00347a-9aa9-4096-863c-258f2b1bd0f9" formaInd="Nummer">
                    <Explicatus>10)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som GLM-søer og GLM-fortidsminder.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id922e17af-131e-4be9-b27d-e5bc60438dd0">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>De i stk. 1 anførte arealer kan indgå i den indtegnede ansøgte mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark ikke overlapper med arealer, som omhandlet i stk. 1, anses størrelsen af den ansøgte mark som størrelsen af den indtegnede mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark overlapper med arealer, som omhandlet i stk. 1, anses de overlappende arealer ikke som omfattet af ansøgning om tilskud og fratrækkes størrelsen af den indtegnede mark ved fastsættelse af størrelsen af den ansøgte mark, jf. dog stk. 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idcad3f20b-2da1-473d-8df5-a0422198c946">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Der kan fortsat ydes tilskud til de arealer, der er anført i stk. 1, nr. 2, 5 og 7, hvis de har været omfattet af tilskud under bio-ordningen biodiversitet &amp; bæredygtighed i 2025.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id560121d0-59e0-472b-8a95-fafb104ebe77" localId="15">
        <Explicatus>Kapitel 15</Explicatus>
        <Rubrica id="ida61e818d-0819-492b-824a-a5c34ea0bd3b">
          <Linea>
            <Char formaChar="Italic">Basistilskud til småbiotoper og braklagte arealer, fælles kriterier for tilskudsberettigelse og fælles forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Rubrica id="idc200557b-40f7-431f-a148-35bfd1214379">
            <Linea>
              <Char formaChar="Italic">Basistilskud til småbiotoper og braklagte arealer, fælles kriterier</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id098c002e-c0a4-49ef-ad50-2c3810be092f" localId="23">
            <Explicatus>§ 23.</Explicatus>
            <Stk id="id7494cf2d-3664-44c4-add9-3b1d8990675d">
              <Exitus>
                <Linea>
                  <Char>Tilskud for et areal er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id31ffd7cb-c4f8-4eea-ad50-0d0b58025a42">
                <Index>
                  <Indentatio id="id411abefb-f460-4a63-9d6c-0fdd23523c44" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger opfylder i 2026 GLM 10, som fremgår af bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idcb51d4e3-3500-4fa9-aff7-23804ddb0c04" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal have søgt om grundbetaling for arealet i 2025 og 2026, og arealet skal være tilskudsberettiget under grundbetalingsordningen i 2025 og 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idab817b43-1fce-4666-a34d-632bb8f81705" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det godkendte, ansøgte areal skal for hver enkelt mark udgøre mindst 0,01 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ideea24021-d60f-4c31-ba9a-d9c446b3c719" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede godkendte, ansøgte areal skal udgøre mindst 0,30 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id34fb2353-643c-4e54-851f-609bfdb09176" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede ansøgte areal må maksimalt udgøre 50 pct. af det samlede areal, hvor der er ansøgt om grundbetaling.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id9239b8c6-377f-4e31-8898-4644b8814a94">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>I beregningen af arealer, som ansøger har indberettet til en ansøgning om grundbetaling, jf. stk. 1, nr. 5, fratrækkes dog arealer omfattet af § 22, stk. 1, nr. 9 og 10, og de arealer hvortil der ikke ydes tilskud, jf. § 24, nr. 1 og 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idb13dbbd3-fbd1-4f12-a57c-440d27b1e2be" localId="24">
            <Explicatus>§ 24.</Explicatus>
            <Stk id="id0967c34f-1ec1-4e32-a9bb-32adf7892a6b">
              <Exitus>
                <Linea>
                  <Char>Tilskud for et areal er endvidere betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id90d8df4d-07ab-4cd5-a8f9-e93225dc7e3b">
                <Index>
                  <Indentatio id="id2d57209b-503b-4ae3-a465-77a5716f65f7" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke være indberettet i ansøgningen til opfyldelse af GLM 10, jf. bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8dab6e1f-fc25-444d-85f1-c2c2a2b403ba" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være indberettet i en ansøgning om grundbetaling som et areal, der er tilskudsberettiget i medfør af artikel 4, stk. 4, litra c, i Europa-Parlamentets og Rådets forordning (EU) 2021/2115 af 2. december 2021.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id37dfb1dd-1317-4436-a8a9-812d1133d5e7" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af en ansøgning om tilskud til varieret planteproduktion, til miljø- og klimavenligt græs eller til økologisk arealstøtte under artikel 31 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8526d0d3-7e6b-47ae-b44c-045109396581" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af tilsagn om tilskud eller ansøgning om tilsagn om tilskud til miljøvenligt landbrug, til miljø- og klimavenligt landbrug under et af landdistriktsprogrammerne.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id50e304ad-ef49-482f-9eda-f716b1c13f45" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af en ansøgning om tilsagn om tilskud eller tilsagn om tilskud til pleje af græs- og naturarealer, til permanent ekstensivering eller til fastholdelse af arealer i vand- og klimaprojekter under artikel 70 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9aa84fa2-6210-494d-b959-f2cbf63c7006" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke indgå i et minivådområde med omkringliggende areal, der er etableret med tilskud i medfør af anden lovgivning eller er omfattet af tilsagn om tilskud, der er meddelt i medfør af anden lovgivning senest i den planperiode, der udløber i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id1eea8790-b468-440c-9b36-997f6ddb5b91" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af en regulering, der har virkning i 2026, og som indebærer, at arealet ikke må udsættes for landbrugsaktiviteter med karakter af produktion som følge af</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="idae6e56ba-1df9-430e-9564-1a952a77693a">
                      <Index>
                        <Indentatio id="id10c36b8d-02f1-42d1-931f-ad92c38a6f5e" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>tilskud i medfør af anden lovgivning end reglerne for grundbetaling, ø-støtte og de i nr. 3-6 omhandlede tilskudsordninger,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id6c223ec7-7e4b-4934-b58e-53146d5adf61" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>aftale, der indebærer betaling for den nævnte regulering,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id8e34e692-4923-4ae5-bb09-015c92258d5e" formaInd="Litra">
                          <Explicatus>c)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>servitut eller</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id1807034e-b76b-4231-87eb-ab128ccf261f" formaInd="Litra">
                          <Explicatus>d)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>krav, der er pålagt i medfør af anden lovgivning end bekendtgørelse om jordbrugsvirksomheders anvendelse af gødning og bekendtgørelse om næringsstofreducerende tiltag og dyrkningsrelaterede tiltag i jordbruget.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id4dc89ed9-c363-420d-96cc-9a4d0cb57078" formaInd="Nummer">
                    <Explicatus>8)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke være anlagt med solcelleanlæg.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id3c7732dd-fd7e-4e6d-a6b1-720bdb7846a8">
            <Linea>
              <Char formaChar="Italic">Basistilskud til småbiotoper og braklagte arealer, fælles forpligtelser</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="ideedcdc31-7792-41bb-a61f-6685d3fe1f52" localId="25">
            <Explicatus>§ 25.</Explicatus>
            <Stk id="id5c276412-1d94-4218-ae67-520716aa2172">
              <Exitus>
                <Linea>
                  <Char>Ansøger forpligter sig til ikke at etablere solcelleanlæg i løbet af 2026 på arealet.</Char>
                </Linea>
                <Linea>
                  <Char>Ved etablering af solcelleanlæg forstås alle former for aktiviteter tilknyttet etablering og vedligeholdelse af solcelleanlæg.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ide09f45e1-c00b-418c-92fc-859143cf0e4e">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det er en forpligtelse, at arealer, hvor der søges tilskud under denne bio-ordning, ikke anvendes til opfyldelse af GLM 10, jf. bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idde0b30e4-3e0e-4240-a1f7-5d9701003144" localId="16">
        <Explicatus>Kapitel 16</Explicatus>
        <Rubrica id="idbefdb44e-b121-4101-95b5-6a7cf4732932">
          <Linea>
            <Char formaChar="Italic">Småbiotoper, yderligere kriterier for tilskudsberettigelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id2461edb0-8076-4f6c-ae71-7905c6593994" localId="26">
            <Explicatus>§ 26.</Explicatus>
            <Stk id="idbec94c71-496b-4d51-a891-7386d3a7883e">
              <Exitus>
                <Linea>
                  <Char>Tilskud for en småbiotop er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id8e74be08-374c-4837-b42b-a04bffbd8c9a">
                <Index>
                  <Indentatio id="idb85ef3c2-f8ca-47f2-a570-4c0cae0af441" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Den er udlagt fra 2023 eller senere på bedriftens landbrugsarealer.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id91fe46a0-6909-4463-9e64-a9cda68f70dc" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Den højst udgør 1,00 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id79ffdda7-9996-4313-8074-4f13d64d6d91" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Der er en afstand på mindst 5 meter mellem småbiotopen og andre småbiotoper inden for samme mark, jf. dog stk. 2.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id8da82c1d-f4ad-4090-9418-ea9bd409f33d">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hvis en småbiotop, jf. stk. 1, ligger mindre end 5 meter fra en anden småbiotop, må det samlede areal af småbiotoperne ikke udgøre mere end 1,00 ha.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id3d9ce2e6-6dbc-4810-a5f6-698d3d86f276">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Indberettes et areal, som var betragtet som permanent græs forud for ansøgningsfristen, jf. § 3 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, betragtes arealet fortsat som permanent græs uagtet indberetningen og realisering af afgrøde på den mark, som småbiotopen er placeret på.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id3e2f6613-a21e-42f1-889d-253c2e349c14" localId="17">
        <Explicatus>Kapitel 17</Explicatus>
        <Rubrica id="iddff1bb15-922d-487b-a354-6e9b5840503e">
          <Linea>
            <Char formaChar="Italic">Småbiotoper, yderligere forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id7bc94f29-bee1-435b-b5c1-a1507848511a" localId="27">
            <Explicatus>§ 27.</Explicatus>
            <Stk id="id539c9f4a-11c4-4d1b-9ee8-5784eabd0b29">
              <Exitus>
                <Linea>
                  <Char>Det er en forpligtelse, at der på småbiotopen ikke udføres landbrugsaktiviteter med karakter af produktion i hele kalenderåret 2026, herunder at plantemateriale ikke fjernes fra småbiotopen.</Char>
                </Linea>
                <Linea>
                  <Char>Ved landbrugsaktiviteter med karakter af produktion forstås aktiviteter, som fremgår af § 13, stk. 4, i bekendtgørelse om grundbetaling m.v. til landbrugere for 2026.</Char>
                </Linea>
                <Linea>
                  <Char>Følgende landbrugsaktiviteter er dog tilladte:</Char>
                </Linea>
              </Exitus>
              <Exitus id="ided8137c0-2441-4bf1-a54d-383f42335ae3">
                <Index>
                  <Indentatio id="iddc9763ec-78e7-495d-b0dc-bb8961b56f8d" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Forekomst af husdyr under forudsætning af, at husdyrene har adgang til mindst et andet areal, og småbiotopen udgøres af mindst 75 pct. buske eller træer.</Char>
                      </Linea>
                      <Linea>
                        <Char>Ansøger er i den forbindelse forpligtet til at sikre, at bevoksningen i form af træer og buske ikke i væsentlig grad beskadiges eller ødelægges.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id6b6afaf6-cdbc-4605-98e2-1cef88ae2562" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Jordbehandling i forbindelse med aktiv tilplantning eller isåning af planter eller vådgøring af jorden med henblik på at etablere småbiotoperne eller forbedre biodiversiteten.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id7aee0d07-c338-4cd1-802c-5f32ae010eb1" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Slåning og nedvisning i forbindelse med bekæmpelse af flyvehavre (</Char>
                        <Char formaChar="Italic">Avena fatua</Char>
                        <Char>) og kæmpebjørneklo (</Char>
                        <Char formaChar="Italic">Heracleum mantegazzianum</Char>
                        <Char>).</Char>
                      </Linea>
                      <Linea>
                        <Char>I denne forbindelse kan det bekæmpede plantemateriale fjernes fra marken, hvis dette følger af anden regulering.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id8a4b4635-9848-4826-9f7a-8f4ee6c00d4c" localId="18">
        <Explicatus>Kapitel 18</Explicatus>
        <Rubrica id="id3628216a-9922-46b6-8c33-158a09f4a3c8">
          <Linea>
            <Char formaChar="Italic">Braklagte arealer, yderligere forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idba9c5a25-1030-41d3-b7ad-e02b1aac9057" localId="28">
            <Explicatus>§ 28.</Explicatus>
            <Stk id="id2ee0f48b-574f-438a-9dee-4ff43ced2678">
              <Exitus>
                <Linea>
                  <Char>Det er en forpligtelse for at opnå tilskud til et braklagt areal, at der på arealet udføres én af de følgende aktiviteter:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idb6b919a9-072b-4b47-9476-3ec6eca3a23f">
                <Index>
                  <Indentatio id="id8a2fb4e2-05a8-486c-a90c-a8f3fee8c44d" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Mindst én slåning i perioden 1. april til og med 25. oktober, med henblik på at opretholde arealet i landbrugsmæssig stand.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id027d3402-040b-4697-8573-b9829f501a50" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Etablering af enten blomsterbrak, der pr. m</Char>
                        <Char formaChar="Superscript">2</Char>
                        <Char> består af mindst to forskellige frø- og nektarproducerende plantearter, eller bestøverbrak, der pr. m</Char>
                        <Char formaChar="Superscript">2</Char>
                        <Char> består af mindst tre forskellige plantearter, som er omfattet af bilag 1, senest den 30. april 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id6d7e55bf-787d-4a61-96bd-a5c66cfaffa8">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det er en forpligtelse, at der foretages en mekanisk jordbehandling ved den første etablering af blomsterbrak eller bestøverbrak, jf. stk. 1, nr. 2.</Char>
                </Linea>
                <Linea>
                  <Char>I efterfølgende ansøgningsår er mekanisk jordbehandling i forbindelse med etablering af blomsterbrak eller bestøverbrak tilladt, men ikke påkrævet.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idfac9b129-b7fb-424b-baa8-eac743c44aca">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det er en forpligtelse, at den udsåede blomsterblanding ved blomsterbrak eller bestøverbrak udgør mindst 50 pct. af plantedækket på arealet.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idfa1bc782-e3ab-4126-9e3e-7b9fa1acd2e2">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>I tilfælde af uforudsete vejrhændelser, der gør jorden uegnet til udsåning inden for etableringsfristen, jf. stk. 1, nr. 2, kan styrelsen meddele ansøgerne en udsættelse med op til 14 dage.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id0104be88-7cc0-4ff7-84e8-75ebe4552b74">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Hvis det konstateres, at et areal med bestøverbrak ikke opfylder betingelserne for bestøverbrak, men i stedet betingelserne for blomsterbrak, kan styrelsen i forbindelse med kontrolbesøg ændre afgrødekoden til blomsterbrak.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id120f98f1-dbbe-4d55-ae48-f92e9afa80f2" localId="29">
            <Explicatus>§ 29.</Explicatus>
            <Stk id="id7fd2a2b4-16da-4682-8e20-0529d8e81a6f">
              <Exitus>
                <Linea>
                  <Char>Det er en forpligtelse, at plantedækket på braklagte arealer ikke slås i perioden fra 1. maj til og med 31. juli af hensyn til yngleperioden for markens vildt- og fuglebestand, medmindre:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id088c4710-e9e7-41bf-9e2f-e182280b53fa">
                <Index>
                  <Indentatio id="id1868e307-0ee6-4605-8155-0e7de98ad2ad" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet er beliggende inden for de afstandsforpligtelser, der gælder efter bekendtgørelse om markfrø og om sædekorn, og landbrugeren har anmodet om slåning for at undgå fremmed bestøvning fra plantedækket på de braklagte arealer af de frø eller sædekorn, der ønskes certificeret.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id48ba321f-711a-430a-9b30-a151bce31a87" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Der foretages selektiv bekæmpelse af flyvehavre (</Char>
                        <Char formaChar="Italic">Avena fatua</Char>
                        <Char>) eller kæmpebjørneklo (</Char>
                        <Char formaChar="Italic">Heracleum mantegazzianum</Char>
                        <Char>).</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id9975762c-6a89-4243-95a0-9509d143e132">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger er forpligtet til at sikre, at der ikke anvendes pesticider på arealet i hele kalenderåret 2026.</Char>
                </Linea>
                <Linea>
                  <Char>Pesticider kan dog anvendes til selektiv bekæmpelse af flyvehavre (</Char>
                  <Char formaChar="Italic">Avena fatua</Char>
                  <Char>) eller kæmpebjørneklo (</Char>
                  <Char formaChar="Italic">Heracleum mantegazzianum</Char>
                  <Char>), hvis dette følger af anden regulering.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idee4575ee-3bea-4c60-9cd1-c1a2b414f021">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Plantemateriale fra det braklagte areal må ikke fjernes efter slåning eller nedvisning, jf. stk. 1, nr. 2, medmindre der er tale om bekæmpelse af flyvehavre (</Char>
                  <Char formaChar="Italic">Avena fatua</Char>
                  <Char>), jf. bekendtgørelse om flyvehavre, eller bekæmpelse af kæmpebjørneklo (</Char>
                  <Char formaChar="Italic">Heracleum mantegazzianum</Char>
                  <Char>) i overensstemmelse med en indsatsplan fra kommunen mod bekæmpelse af kæmpebjørneklo.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id58cd917b-36f2-46a8-8eaf-3bce437c5a35" localId="19">
        <Explicatus>Kapitel 19</Explicatus>
        <Rubrica id="ida220cd14-5892-48af-b58b-8293ce15ad72">
          <Linea>
            <Char>Tillæg til småbiotoper og brak på kulstofrige lavbundsjorder og arealer med vådområdepotentiale</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="ide4555247-04cf-480f-991b-3448284c74de" localId="30">
            <Explicatus>§ 30.</Explicatus>
            <Stk id="id8f9e3b67-65bb-4140-adac-194a73d7bd7b">
              <Exitus>
                <Linea>
                  <Char>Tillæg kan ydes for småbiotoper, braklagte arealer eller dele heraf, der udgøres af enten kulstofrige lavbundsjorde, jf. kort.lbst.dk/724 »Tørverig lavbund, 2024« eller arealer med vådområdepotentiale, jf. kort.lbst.dk/724 »Vådområdepotentiale«, der er mindst 0,01 ha.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id3df7633d-6c99-43fc-bf2b-2b23a2024c28">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Kriterier for basistilskud til enten småbiotoper eller braklagte arealer skal være opfyldte, jf. §§ 23, 24 og 26.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id44a96ede-b53a-4036-a96b-dd42ae74a6ed" localId="31">
            <Explicatus>§ 31.</Explicatus>
            <Stk id="id1bb7521c-16c7-4cbb-87d7-567374596b50">
              <Exitus>
                <Linea>
                  <Char>Det er en forpligtelse for, at der kan ydes tillæg, at forpligtelser for småbiotoper eller braklagte arealer er opfyldte, jf. § 25 og §§ 27-29.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="ide3c4e528-cae9-4f85-9952-3714cff6fbe2" localId="20">
        <Explicatus>Kapitel 20</Explicatus>
        <Rubrica id="id4f0eec3a-dddd-4adf-aceb-578c4c2642b5">
          <Linea>
            <Char formaChar="Italic">Tilskuddets størrelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id7ab097e9-649a-4cd3-b236-3f576d536bb5" localId="32">
            <Explicatus>§ 32.</Explicatus>
            <Stk id="id43a4f6ca-2da2-4ea2-92af-36e8f19ea00e">
              <Exitus>
                <Linea>
                  <Char>Tilskuddet udgør følgende beløb, jf. dog stk. 2 og 3:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idc78c0ac1-5ac8-4e21-aaa0-19a3f50db96d">
                <Index>
                  <Indentatio id="id82fe20b1-bb78-4d01-8823-96d03d62c1e3" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Basistilskud: 181,21 EUR pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2955cbe6-bc69-44ce-913b-7a44b5ac789d" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tillæg til kulstofrige lavbundsjorder: 261,74 EUR pr. ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idfbaf8b16-0ce0-4093-a784-669aa8976eb5">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved underansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan det i stk. 1, nr. 1, anførte tilskud blive forhøjet med maksimalt 35 pct.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id514ca5d7-f37e-4a9b-a38c-7fc0ffa7d413">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved overansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan det i stk. 1, nr. 1 og 2, anførte tilskud blive nedsat.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id8c428975-df68-4fbc-a44b-eb41ab9b8c06">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Der kan ydes et yderligere basistilskud, svarende til en fjerdedel af de fire pct. af bedriftens omdriftsareal, som anvendes til at opfylde GLM 10, hvis der via denne bio-ordning er udlagt tilskudsberettigede ikke-produktive elementer på mindst tre pct. af bedriftens omdriftsareal.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
    </Afsnit>
    <Afsnit id="id3f0a077c-9c29-41cc-9cc7-34c3fda2189b" localId="IV">
      <Explicatus>Afsnit IV</Explicatus>
      <Rubrica id="idf5e5c32b-0fd5-4cac-9b99-61ff6f8637b2">
        <Linea>
          <Char formaChar="Bold">Tilskud til miljø- og klimavenligt græs</Char>
        </Linea>
      </Rubrica>
      <Kapitel id="idd6e30606-8347-4a80-a237-6643de25b6a9" localId="21">
        <Explicatus>Kapitel 21</Explicatus>
        <Rubrica id="id9d61550c-8ffb-4353-8c20-c5ec880b8130">
          <Linea>
            <Char formaChar="Italic">Ordningens indhold</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id1790b8e9-e92d-4c4e-9a67-3996ba2b0fac" localId="33">
            <Explicatus>§ 33.</Explicatus>
            <Stk id="id00cffc5b-002b-47fe-85c7-2f0f697cf947">
              <Exitus>
                <Linea>
                  <Char>Der kan ydes tilskud til landbrugere, der anvender en længere omdriftstid i driften af visse græsarealer, som ikke udsættes for jordbearbejdning.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id452814d4-86de-41e5-8634-cf3b786ab22f">
            <Linea>
              <Char formaChar="Italic">Fradragsarealer inden for den ansøgte mark</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idc35f8150-a523-40d2-a2e4-47fe49a56b5d" localId="34">
            <Explicatus>§ 34.</Explicatus>
            <Stk id="id063c4c82-25da-40b6-bc5d-91e8bc67e84e">
              <Exitus>
                <Linea>
                  <Char>Ansøgning om tilskud kan ikke omfatte følgende arealer:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id0d8c329d-aef5-439b-9147-d7f84838e707">
                <Index>
                  <Indentatio id="idaeff2991-ea39-4b53-ab82-0a1ac6ba5e2a" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som beliggende inden for 3-metersbræmmer omfattet af god landbrugs- og miljømæssig stand (GLM 4), jf. kort.lbst.dk/724 »3-metersbræmmer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idae44eab6-5342-4052-838e-ca6d89659514" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der 1. november 2025 er registreret som § 3-areal på Danmarks Miljøportal, jf. kort.lbst.dk/724 »§ 3-arealer, 2026« og »§ 3-søer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9ac2ec3b-ac70-4903-a0ad-011644b8bbe8" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som omfattet af § 21 b, stk. 1, i lov om miljøbeskyttelse, jf. kort.lbst.dk/724 »25-meters beskyttelseszoner omkring vandboringer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id512b2d0e-b7f8-4cbc-8d18-48fc2f7597b1" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som arealer, der ikke er tilskudsberettigede under grundbetalingsordningen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idbe5b995f-5340-4f1f-87cb-3c8c6945e79b" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 ikke er registreret som beliggende inden for kortlaget »Miljø- og klimavenligt græs, 2026«, jf. kort.lbst.dk/724 »Miljø- og klimavenligt græs, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd3447b51-eccd-4989-bcd7-19664ed05a72" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som arealer til opfyldelse af GLM 10, jf. bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc6096d27-ac35-49fb-8313-d66c099aac42" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som markkrat.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id45ff90a2-6440-4d50-94e0-b60b2e86f07f" formaInd="Nummer">
                    <Explicatus>8)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som GLM-søer og GLM-fortidsminder.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idf2d145e3-d5fa-47f6-8307-fc83418fcd7c" formaInd="Nummer">
                    <Explicatus>9)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som permanente græsarealer beliggende inden for habitatområder omfattet af god landbrugs- og miljømæssig stand (GLM 9), jf. kort.lbst.dk/724 »GLM 9 forbud mod pløjning og omlægning, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="iddc7c6449-8715-4fca-8cb4-e4d37d6f82d3">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>De i stk. 1 anførte arealer kan indgå i den indtegnede ansøgte mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark ikke overlapper med arealer, som omhandlet i stk. 1, anses størrelsen af den ansøgte mark som størrelsen af den indtegnede mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark overlapper med arealer, som omhandlet i stk. 1, anses de overlappende arealer ikke som omfattet af ansøgning om tilskud og fratrækkes størrelsen af den indtegnede mark ved fastsættelse af størrelsen af den ansøgte mark.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id8875ed76-6b17-4416-b6a3-8946ece959e1" localId="22">
        <Explicatus>Kapitel 22</Explicatus>
        <Rubrica id="idb9395830-2e63-4f15-a504-06ff7fa85b8a">
          <Linea>
            <Char formaChar="Italic">Kriterier for tilskudsberettigelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idac0d6c58-d2bc-4dae-af03-4147f2208a9a" localId="35">
            <Explicatus>§ 35.</Explicatus>
            <Stk id="id2d9db0cb-5ce4-44a9-b67b-a755f37e90ef">
              <Exitus>
                <Linea>
                  <Char>Tilskud for et areal er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id2dcdacaa-539d-4f75-8454-990ca7145030">
                <Index>
                  <Indentatio id="id2246ee5b-d194-4ed9-ab50-d289f0f38161" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke have været udsat for jordbearbejdning fra den 1. maj 2024 til og med den 31. december 2025.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd38796df-3d2e-462c-9025-d632c9485959" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet skal i 2024 og 2025 i fællesskema have været indberettet med en af de i bilag 2 eller 3 anførte afgrøder.</Char>
                      </Linea>
                      <Linea>
                        <Char>De anførte afgrøder i bilag 3 må dog kun have været indberettet i 2023.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8422746b-5618-4a7d-80b1-88f82f3b56f5" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet skal i 2024 og 2025 have været udlagt med en af de i bilag 2 eller 3 anførte afgrøder.</Char>
                      </Linea>
                      <Linea>
                        <Char>De anførte afgrøder i bilag 3 må dog kun have været udlagt i 2024.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd4ce36b7-f023-4dce-b9ee-526d9d44ee5d" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal have søgt om grundbetaling for arealet i 2024, 2025 og 2026, og arealet skal være tilskudsberettiget under grundbetalingsordningen i 2024, 2025 og 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idcd49c0fc-0222-45ea-9564-3fc8fbfee975" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det godkendte, ansøgte areal skal for hver enkelt mark udgøre mindst 0,01 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb0016062-8f67-4bd5-af38-8fb751364ad0" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede godkendte, ansøgte areal skal udgøre mindst 0,30 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idb5379b10-4b2e-47c6-8e87-67489ff7b1d3" localId="36">
            <Explicatus>§ 36.</Explicatus>
            <Stk id="id03f5986c-cbd1-458f-b8d0-045c9113c600">
              <Exitus>
                <Linea>
                  <Char>Tilskud for et areal er endvidere betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="ide0874fbb-130d-4f88-b852-f6eff537b56c">
                <Index>
                  <Indentatio id="id14ceecb4-17ff-4398-a7cd-edcc772f3d2e" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af tilsagn om tilskud eller ansøgning om tilsagn om tilskud til miljøvenligt landbrug eller til miljø og klimavenligt landbrug under et af landdistriktsprogrammerne.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idf521e878-ce21-4d8e-b3a7-fef732a766aa" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af tilsagn om tilskud eller ansøgning om tilsagn om tilskud til pleje af græs- og naturarealer under artikel 70 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8f7b55e5-e267-4d6b-8aee-2e9d22420bac" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke være omfattet af ansøgning om tilskud til midlertidig ekstensivering eller til varieret planteproduktion under artikel 31 i forordning (EU) 2021/2115.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ida6680bfd-9ff0-4b4f-8669-d38f629951c0" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ved udløb af ansøgningsfristen ikke være omfattet af en regulering, der har virkning i 2026, og som indebærer, at arealet ikke må udsættes for jordbearbejdning som følge af</Char>
                      </Linea>
                    </Exitus>
                    <Exitus id="id0c4f69e4-3a04-425c-a930-916b0fe8e41e">
                      <Index>
                        <Indentatio id="id80110672-7fb7-4430-bf2f-04f78f6c5085" formaInd="Litra">
                          <Explicatus>a)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>tilskud i medfør af anden lovgivning end reglerne for de i nr. 1-4 omhandlede tilskudsordninger,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id3580a48e-a761-4f2e-b511-a6b415ffdd45" formaInd="Litra">
                          <Explicatus>b)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>aftale, der indebærer betaling for den nævnte regulering,</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id9065cdf7-c4b0-45db-9bf6-b8268dfd3abb" formaInd="Litra">
                          <Explicatus>c)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>servitut eller</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                        <Indentatio id="id8562fbc7-3f13-4b00-a264-e9250f172942" formaInd="Litra">
                          <Explicatus>d)</Explicatus>
                          <Exitus>
                            <Linea>
                              <Char>krav, der er pålagt i medfør af anden lovgivning end bekendtgørelse om jordbrugsvirksomheders anvendelse af gødning og bekendtgørelse om næringsstofreducerende tiltag og dyrkningsrelaterede tiltag i jordbruget.</Char>
                            </Linea>
                          </Exitus>
                        </Indentatio>
                      </Index>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="ide064cdd0-7aaa-4a0f-8ab0-c75c9174d5b2" localId="23">
        <Explicatus>Kapitel 23</Explicatus>
        <Rubrica id="ida2546389-8819-41f3-9e89-2785592ba411">
          <Linea>
            <Char formaChar="Italic">Forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idc1e98979-9f90-45ac-a20d-107d665640a2" localId="37">
            <Explicatus>§ 37.</Explicatus>
            <Stk id="ideffd6741-77df-42b3-aeed-f552cef38017">
              <Exitus>
                <Linea>
                  <Char>Tilskud for et areal er betinget af opfyldelse af følgende forpligtelser:</Char>
                </Linea>
              </Exitus>
              <Exitus id="idf522c53e-97da-4611-8100-4b88f8788e34">
                <Index>
                  <Indentatio id="id7a2816c8-b4d6-434e-bf87-59a533a413f7" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet skal være indberettet i fællesskema med en af de i bilag 2 anførte afgrøder i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id83f294e3-a0e0-414b-a18f-94fe5f58f9d4" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet skal være udlagt med en af de i bilag 2 anførte afgrøder i 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id318c9acc-4c25-424e-8d56-6c6cb78d0ecd" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Plantedækket skal opretholdes i hele 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc6f834b4-62e7-4504-982c-c0a0a2565a71" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke udsættes for jordbearbejdning i 2026</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="ideb81dbbf-3041-4e21-bf85-ee2791fbc77d" localId="24">
        <Explicatus>Kapitel 24</Explicatus>
        <Rubrica id="idf7640b77-3c31-46a0-9e9e-9da6a1892321">
          <Linea>
            <Char formaChar="Italic">Tilskuddets størrelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id2a09469f-b11f-4647-8465-0da382077080" localId="38">
            <Explicatus>§ 38.</Explicatus>
            <Stk id="idccab84c0-d9e3-404e-bcd6-d815d6e37e1c">
              <Exitus>
                <Linea>
                  <Char>Tilskuddet udgør 201,34 EUR pr. ha, jf. dog stk. 2 og 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idec04b7a7-413b-401b-939e-cdc4ad705f8e">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved underansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan det i stk. 1 anførte tilskud blive forhøjet med maksimalt 25 pct.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idfc84a6bb-ed75-45c1-ad4a-4cea785445de">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved overansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan det i stk. 1 anførte tilskud blive nedsat.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
    </Afsnit>
    <Afsnit id="id4b27b2d4-ea7f-45f0-82b8-451e158ca08c" localId="V">
      <Explicatus>Afsnit V</Explicatus>
      <Rubrica id="id08d6150f-c886-4aaf-97d0-7a9255abcc28">
        <Linea>
          <Char formaChar="Bold">Tilskud til varieret planteproduktion</Char>
        </Linea>
      </Rubrica>
      <Kapitel id="id0164ebbf-9b88-4c00-836e-9e70fa2bf0e9" localId="25">
        <Explicatus>Kapitel 25</Explicatus>
        <Rubrica id="id6245b9ac-669d-4b04-b1be-7291eae436b6">
          <Linea>
            <Char formaChar="Italic">Ordningens indhold</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idf5905451-1a31-491e-9481-0c5fe4b38290" localId="39">
            <Explicatus>§ 39.</Explicatus>
            <Stk id="id205982c2-b4b6-4191-b5c4-1d89ff4ec7e5">
              <Exitus>
                <Linea>
                  <Char>Der kan ydes tilskud til landbrugere, som på bedriftens omdriftsareal anvender øget afgrødediversificering og dyrker visse omdriftsafgrøder, som primært er afgrøder, der kan indgå i humant konsum og proteinafgrøder.</Char>
                </Linea>
                <Linea>
                  <Char>Tilskud ydes for arealer med de i bilag 4 anførte afgrøder.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id145ff329-cb41-4dca-8957-00b64d6c3279">
            <Linea>
              <Char formaChar="Italic">Fradragsarealer inden for den ansøgte mark</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id1ff7a46a-94b9-4956-9466-ab35cfd1c243" localId="40">
            <Explicatus>§ 40.</Explicatus>
            <Stk id="idb8a33e0b-927c-449b-80a2-639365ed1b0f">
              <Exitus>
                <Linea>
                  <Char>Ansøgning om tilskud kan ikke omfatte følgende arealer:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id9a0c2a6d-03d2-41df-9a79-a37bcc0283b7">
                <Index>
                  <Indentatio id="id3311e2bd-b9ae-4b63-9552-79f1de9a9696" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som beliggende inden for 3-metersbræmmer omfattet af god landbrugs- og miljømæssig stand (GLM 4), jf. kort.lbst.dk/724 »3-metersbræmmer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idaef300e6-cdea-4200-aa07-7e4602a5e983" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der 1. november 2025 er registreret som § 3-areal på Danmarks Miljøportal, jf. kort.lbst.dk/724 »§ 3-arealer, 2026« og »§ 3-søer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id5a0e2589-7761-4fd4-b406-befb7a0f3d3a" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret som omfattet af § 21 b, stk. 1, i lov om miljøbeskyttelse, jf. kort.lbst.dk/724 »25-meters beskyttelseszoner omkring vandboringer, 2026«.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id2b4b7bdb-a71e-4549-b756-58909608a6c9" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som arealer, der ikke er tilskudsberettigede under grundbetalingsordningen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id938f5e73-b616-4e21-8d45-1a8336df59cf" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som arealer til opfyldelse af GLM 10, jf. bekendtgørelse om konditionalitet og social konditionalitet for 2026.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ida05aaa3a-55fc-42e0-8c34-c03152f285f6" formaInd="Nummer">
                    <Explicatus>6)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som markkrat.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id689e87ab-7736-4210-9c73-03c167fcd6b1" formaInd="Nummer">
                    <Explicatus>7)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealer, der for 2026 er registreret i IMK som GLM-søer og GLM-fortidsminder.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idcbd86e8a-93ed-4bd7-ac94-5c38fd950e96">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>De i stk. 1 anførte arealer kan indgå i den indtegnede ansøgte mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark ikke overlapper med arealer, som omhandlet i stk. 1, anses størrelsen af den ansøgte mark som størrelsen af den indtegnede mark.</Char>
                </Linea>
                <Linea>
                  <Char>Hvis den indtegnede ansøgte mark overlapper med arealer, som omhandlet i stk. 1, anses de overlappende arealer ikke som omfattet af ansøgning om tilskud og fratrækkes størrelsen af den indtegnede mark ved fastsættelse af størrelsen af den ansøgte mark.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id773338ca-1a40-4c98-80d0-a1dfca2d9cf8" localId="26">
        <Explicatus>Kapitel 26</Explicatus>
        <Rubrica id="ide9ee4aaf-4028-4273-97f4-d627c6454be9">
          <Linea>
            <Char formaChar="Italic">Kriterier for tilskudsberettigelse</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idf1596e4d-2853-4438-9109-29a5dccf08e7" localId="41">
            <Explicatus>§ 41.</Explicatus>
            <Stk id="idf0e13d44-388b-4f39-9407-b507cdeb2bd0">
              <Exitus>
                <Linea>
                  <Char>Tilskud til varieret planteproduktion for et areal er betinget af opfyldelse af følgende kriterier:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id0f0907f0-432a-47eb-af5a-f8f7292e9748">
                <Index>
                  <Indentatio id="id6ba2a2a6-9bc1-4a98-9c80-0e4f694e349a" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ansøger skal have søgt om grundbetaling for arealet i 2026, og arealet skal være tilskudsberettiget under grundbetalingsordningen.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id422a2a4d-df4f-49bf-9d7f-235190e4ba46" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det godkendte, ansøgte areal skal for hver enkelt mark udgøre mindst 0,01 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id59e434a8-5bc7-407f-b787-6a1971ab6d01" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede godkendte, ansøgte areal skal udgøre mindst 0,30 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idc45322dd-9779-4de0-965e-ea791db0ff81" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Bedriftens samlede areal, hvortil der ansøges om tilskud, skal ved udløb af ansøgningsfristen udgøre mindst fem pct. af omdriftsarealet.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id89c74ce9-0108-4c17-af20-1f95e36c784c" formaInd="Nummer">
                    <Explicatus>5)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealet må ikke være anlagt med solcelleanlæg.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="idb4f3d5a2-c198-4c82-8865-167c33c2fbe7" localId="27">
        <Explicatus>Kapitel 27</Explicatus>
        <Rubrica id="id06a7029e-b4b5-45db-984f-086f8f1ae9b3">
          <Linea>
            <Char formaChar="Italic">Forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id6f78dd9f-f6a6-46df-b6c9-55b9b431f038" localId="42">
            <Explicatus>§ 42.</Explicatus>
            <Stk id="id2cd81ae7-bd78-4675-857f-868d346c7e22">
              <Exitus>
                <Linea>
                  <Char>Tilskud til varieret planteproduktion for et areal er betinget af opfyldelse af én af følgende forpligtelser i perioden fra 15. maj til og med 25. juli 2026:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id75d0f9c6-1f83-4150-8d68-70a14bf9c232">
                <Index>
                  <Indentatio id="idcee890c7-d09c-4903-a963-56e01a6e6939" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Landbrugere, som har et omdriftsareal på mindre end 20 ha, skal dyrke mindst to afgrødekategorier på bedriftens omdriftsareal.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id13ed94f7-0165-428e-b0cf-8df80a08fcf8" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Landbrugere, som har et omdriftsareal på mindst 20 til højst 60 ha, skal dyrke mindst tre afgrødekategorier på bedriftens omdriftsareal.</Char>
                      </Linea>
                      <Linea>
                        <Char>Den største af bedriftens afgrødekategorier må højst udgøre 70 pct. af omdriftsarealet.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idcf8e4851-f60b-4ba7-901d-6101cb8eb1f3" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Landbrugere, som har et omdriftsareal på over 60 ha, skal dyrke mindst fire afgrødekategorier på bedriftens omdriftsareal.</Char>
                      </Linea>
                      <Linea>
                        <Char>Den største af bedriftens afgrødekategorier må højst udgøre 70 pct. af omdriftsarealet, og de to største af bedriftens afgrødekategorier må højst udgøre 90 pct. af omdriftsarealet.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="id446eaefc-df57-42ea-a3ac-9f99bcdda72b">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Mindst én af afgrødekategorierne, jf. stk. 1, nr. 1-3, skal være én af de i bilag 4 anførte afgrødekategorier.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id0a59fa25-ed21-4775-b252-b96ef986284e">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det ansøgte areal skal i perioden fra 15. maj til og med 25. juli 2026 være dyrket med i bilag 4 anførte afgrøder.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id1340bf9b-7f44-490f-a4ef-869ca2f4dba7">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Det ansøgte areal, dyrket med de i bilag 4 anførte afgrøder, skal i perioden fra 15. maj til og med 25. juli 2026 udgøre mindst fem pct. af omdriftsarealet.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idf08f2fc9-7785-442e-9877-602006db8d95">
              <Explicatus>Stk. 5.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøger forpligter sig til ikke at etablere solcelleanlæg i løbet af 2026 på arealet.</Char>
                </Linea>
                <Linea>
                  <Char>Ved etablering af solcelleanlæg forstås alle former for aktiviteter tilknyttet etablering og vedligeholdelse af solcelleanlæg.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id848159cb-a69d-4cbd-b7e9-85d939bc5eaf" localId="28">
        <Explicatus>Kapitel 28</Explicatus>
        <Rubrica id="id66325965-f0e0-433c-a297-d4462a821f28">
          <Linea>
            <Char formaChar="Italic">Tilskuddets størrelse, m.v.</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idf5ee7e67-06f4-4be9-b36f-bff9237f578e" localId="43">
            <Explicatus>§ 43.</Explicatus>
            <Stk id="id51e8fa8c-37ae-4bcf-9fa5-18c72d827a14">
              <Exitus>
                <Linea>
                  <Char>Tilskuddet udgør 82,55 EUR pr. ha, jf. dog stk. 2 og 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id98cf2f40-0e3e-4156-b3d0-b668bdabe08d">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved underansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan det i stk. 1 anførte tilskud blive forhøjet med maksimalt 25 pct.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ida8ed8dd2-add6-4f46-bfc9-4e2cae88bc75">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved overansøgning under ordninger omfattet af artikel 31 i forordning (EU) 2021/2115 kan det i stk. 1 anførte tilskud blive nedsat.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
    </Afsnit>
    <Afsnit id="idc6088aef-76e7-4e47-aa2e-204a8dc11639" localId="VI">
      <Explicatus>Afsnit VI</Explicatus>
      <Rubrica id="iddadc237e-f4d7-4839-9680-3aacf3fd4a59">
        <Linea>
          <Char formaChar="Bold">Nedsættelse af tilskud, administrative sanktioner, kontrol m.v.</Char>
        </Linea>
      </Rubrica>
      <Kapitel id="id69592d6f-1ae4-486f-ba06-f584ff3caddc" localId="29">
        <Explicatus>Kapitel 29</Explicatus>
        <Rubrica id="idab79cc55-f519-4741-a0ad-d945acacada8">
          <Linea>
            <Char formaChar="Italic">Manglende opfyldelse af kriterier for tilskudsberettigelse og forpligtelser</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id9349e51b-8051-4b70-89d9-23b29d801925" localId="44">
            <Explicatus>§ 44.</Explicatus>
            <Stk id="ided23f78d-b1e2-48c9-b44c-87b269a01ef7">
              <Exitus>
                <Linea>
                  <Char>Opfylder ansøger ikke kriterierne for tilskudsberettigelse, jf. §§ 7-9, § 12, § 15, § 17, § 23, § 24, § 26, § 30, § 35, § 36 og § 41, skal tilskud, der er udbetalt, tilbagebetales.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id0355c497-d0d6-4284-ba02-1ef56ac30060">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Opfylder ansøger ikke de forpligtelser, der gælder for en ansøgt tilskudsordning, jf. § 10, § 11, § 13, § 14, § 16, § 18, § 25, §§ 27-29, § 31, § 37 og § 42, nedsættes tilskuddet helt eller delvist for de ansøgte arealer, som forpligtelsen vedrører.</Char>
                </Linea>
                <Linea>
                  <Char>Eventuelt udbetalt tilskud, der er omfattet heraf, skal tilbagebetales.</Char>
                </Linea>
                <Linea>
                  <Char>Ansøger pålægges en administrativ sanktion afhængig af alvor, omfang og varighed af den manglende opfyldelse af forpligtelser.</Char>
                </Linea>
                <Linea>
                  <Char>Tilskudsnedsættelse som følge af manglende opfyldelse af forpligtelser samt administrativ sanktion beregnes efter reglerne i § 51.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="idf66cbd13-528f-4934-a356-ab526eea86a1">
            <Linea>
              <Char formaChar="Italic">Forsinket indsendelse af ansøgning og dokumentation</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idc0c89363-4607-4750-9b50-ed61194a7784" localId="45">
            <Explicatus>§ 45.</Explicatus>
            <Stk id="iddabdf660-55ad-492a-adbb-7194a907b495">
              <Exitus>
                <Linea>
                  <Char>Ved indgivelse af ansøgning i fællesskema til en af de i § 1 angivne tilskudsordninger efter fristen i § 3 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, pålægges ansøger en administrativ sanktion svarende til en nedsættelse på 1 pct. pr. arbejdsdag af det tilskud, som ansøger ved rettidig indgivelse af fællesskema ville være berettiget til for 2026, jf. dog stk. 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id8678c4f0-20fd-4a4d-8a8d-3c3fa6ca8c92">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Reglen i stk. 1 finder tilsvarende anvendelse ved forsinket indgivelse af kontrakter, erklæringer, bilag eller øvrig påkrævet dokumentation for den ansøgte ordning, der skal medfølge indgivelse af fællesskema.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id60b2d90f-3f23-4c6d-bacf-42e1e2a67d5a">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Har ansøger fået dispensation fra den for tilskudsordningen gældende frist for indgivelse i henhold til § 9 i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, finder reglen i stk. 1 anvendelse på den nye frist, der meddeles ansøger.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id0d35a2dd-2bb1-4ce1-9ba8-2f56bc33da86">
            <Linea>
              <Char formaChar="Italic">Manglende indberetning af alle bedriftens landbrugsarealer</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id0ca23b57-9215-40e7-b759-64403c054d6b" localId="46">
            <Explicatus>§ 46.</Explicatus>
            <Stk id="idbe376c08-85e1-4589-b1eb-1db19da56e99">
              <Exitus>
                <Linea>
                  <Char>Har ansøger ikke indberettet alle bedriftens landbrugsarealer, jf. § 4, stk. 1, nr. 1, i bekendtgørelse nr. 1341 af 21. november 2025 om ansøgninger m.v. for landbrugere i Tast selv, pålægges en administrativ sanktion efter følgende regler:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id54d7cb37-8f92-43e8-bd74-e328a05cf00c">
                <Index>
                  <Indentatio id="id894aa623-09dc-4ada-9373-b263774494bb" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud ansøgt under den pågældende tilskudsordning nedsættes med 1 pct., når de arealer, der ikke er indberettet, udgør mere end 3 pct. og op til og med 10 pct. af det indberettede areal.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idb1ab7011-2ba5-4ed6-bb4d-77ae7f4a9d6b" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud ansøgt under den pågældende tilskudsordning nedsættes med 1 pct., når de arealer, der ikke er indberettet, udgør mere end 10 pct. og op til og med 20 pct. af det indberettede areal, og når de arealer, der ikke er indberettet, ikke overstiger 5,00 ha. Tilskuddet nedsættes med 2 pct., hvis de arealer, der ikke er indberettet, er over 5,00 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id9f0a6317-7f1e-4ac5-8378-f73725d93f10" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Tilskud ansøgt under den pågældende tilskudsordning nedsættes med 1 pct., når de arealer, der ikke er indberettet, udgør mere end 20 pct. af de arealer, der er indberettet, men ikke overstiger 5,00 ha. Tilskuddet nedsættes med 2 pct., når de arealer, der ikke er indberettet, udgør mere end 20 pct. af det indberettede areal og er på mere end 5,00 ha, men ikke overstiger 10,00 ha. Tilskuddet nedsættes med 3 pct., hvis de arealer, der ikke er indberettet, udgør mere end 20 pct. af det indberettede areal og overstiger 10,00 ha.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id4972a3e6-724e-4132-8773-7dec0e6dbdd0">
            <Linea>
              <Char formaChar="Italic">Force majeure og usædvanlige omstændigheder</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idff8ee3a6-a0c0-4a3e-8b88-3effb4729873" localId="47">
            <Explicatus>§ 47.</Explicatus>
            <Stk id="idb32b309c-e6cc-4fcd-a485-636be4413dc9">
              <Exitus>
                <Linea>
                  <Char>Kan ansøger ikke opfylde de forpligtelser, der gælder for den ansøgte tilskudsordning som følge af force majeure eller usædvanlige omstændigheder, bevarer ansøgeren retten til tilskud for de arealer, hvor force majeure eller de usædvanlige omstændigheder forhindrede opfyldelse af forpligtelserne, jf. dog stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="ida3df3e37-d139-4318-890e-f78caacc1896">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved udbetaling efter stk. 1 foretages en proportionel reduktion af tilskuddet for de dele af forpligtelsen, for hvilke der ikke er påløbet direkte eller indirekte omkostninger eller indtægtstab, inden force majeure eller de usædvanlige omstændigheder indtraf.</Char>
                </Linea>
                <Linea>
                  <Char>Reduktion af tilskud anvendes kun i forbindelse med manglende opfyldelse af forpligtelser.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="idadba0cf3-c6e9-48dc-8b30-00a185693e14" localId="48">
            <Explicatus>§ 48.</Explicatus>
            <Stk id="id22bfaebe-71f4-4779-a47e-bc86a0e5a9d3">
              <Exitus>
                <Linea>
                  <Char>I tilfælde af force majeure eller usædvanlige omstændigheder skal ansøger meddele styrelsen skriftligt herom sammen med en fyldestgørende dokumentation herfor senest 15 arbejdsdage fra det tidspunkt, hvor ansøgeren eller dennes stedfortræder er i stand til at give en sådan meddelelse.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id448241f4-deea-425b-9364-11ad39f8b27e" localId="30">
        <Explicatus>Kapitel 30</Explicatus>
        <Rubrica id="id2c2759c0-ae5c-4b11-8dcb-66f94ab66b82">
          <Linea>
            <Char formaChar="Italic">Beregning af tilskudsnedsættelse og administrative sanktioner m.v.</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="idc48606a1-02d4-436a-9410-0081e9aa0cfc" localId="49">
            <Explicatus>§ 49.</Explicatus>
            <Stk id="idfbe3e668-35a8-42dd-b890-1827733450b5">
              <Exitus>
                <Linea>
                  <Char>Det vægtede, overtrådte areal beregnes som det overtrådte areal ganget med en vægtningsfaktor, der afspejler alvor, omfang og varighed af den manglende opfyldelse af forpligtelsen.</Char>
                </Linea>
                <Linea>
                  <Char>Bilag 5 og 6 indeholder vægtningsfaktorer for forpligtelser under ordningerne for henholdsvis økologisk arealstøtte og tilskud til varieret planteproduktion.</Char>
                </Linea>
                <Linea>
                  <Char>For forpligtelser, der ikke er anført i bilag 5 og 6, er vægtningsfaktoren 1.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id55193b7f-901d-482c-8795-d588f8966017">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Overtrædelsesprocent beregnes ved at dividere det samlede vægtede, overtrådte areal med det samlede godkendte, ansøgte areal, jf. dog stk. 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idec2979eb-4250-47c2-bc7b-b52a3273f001">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved ansøgning om tilskud for arealer, som er registreret på IMK som beliggende i en markblok af typen permanent græs (PGR) med en tilknyttet tilskudsprocent, skal henholdsvis det godkendte, ansøgte areal samt et eventuelt vægtet, overtrådt areal ganges med den tilskudsprocent, der er gældende for markblokken, inden der foretages en beregning af overtrædelsesprocenten.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id1a3de5d7-0b3e-46c9-92cc-02c2c222163c" localId="50">
            <Explicatus>§ 50.</Explicatus>
            <Stk id="id5b8bf283-42a8-49b8-b29d-850bb14f3528">
              <Exitus>
                <Linea>
                  <Char>Det tilskudsberettigede areal fastsættes som det samlede godkendte, ansøgte areal fratrukket summen af eventuelt vægtede, overtrådte arealer, jf. dog stk. 2 og 3.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id6a574a5a-d2c6-4a90-ba17-c2a07cbe10d9">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Er forskellen mellem det tilskudsberettigede areal og det samlede ansøgte areal på 0,10 ha eller derunder, betragtes det tilskudsberettigede areal som lig med det samlede ansøgte areal.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id46b2e792-7385-45d7-9f37-676f8436e949">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Bestemmelsen i stk. 2 finder ikke anvendelse, hvis forskellen mellem det tilskudsberettigede areal og det samlede ansøgte areal udgør mere end 20 pct. af det samlede ansøgte areal.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id888c2c3e-a367-4bde-807d-6510e903920c" localId="51">
            <Explicatus>§ 51.</Explicatus>
            <Stk id="id805b95cd-007f-426a-a63b-fdd9dfea1650">
              <Exitus>
                <Linea>
                  <Char>Tilskudsnedsættelse ved manglende opfyldelse af forpligtelser samt administrative sanktioner herfor fastsættes som følger for en tilskudsordning eller tilskudskategori:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id2331d2fe-6e51-47f0-bc9a-b14c70558e8a">
                <Index>
                  <Indentatio id="id30b03157-f3fa-4c91-91a0-107bb366b86d" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis overtrædelsesprocenten for en tilskudsordning eller tilskudskategori højst udgør 10 pct., nedsættes tilskuddet med det samlede vægtede, overtrådte areal.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id141f2d2f-2837-4888-83a3-f851bb496ee0" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis overtrædelsesprocenten for en tilskudsordning eller tilskudskategori er på over 10 pct., men ikke over 25 pct., nedsættes tilskuddet med det samlede vægtede, overtrådte areal.</Char>
                      </Linea>
                      <Linea>
                        <Char>Herudover pålægges en sanktion svarende til det samlede vægtede, overtrådte areal ganget med en sanktionsfaktor på 0,2.</Char>
                      </Linea>
                      <Linea>
                        <Char>Hvis ansøgeren i tidligere år i perioden 2023-2027 har haft en overtrædelsesprocent på over 10 under den samme tilskudsordning eller tilskudskategori, er sanktionen det samlede vægtede, overtrådte areal ganget med en sanktionsfaktor på 0,5.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id67b9cbb1-fbf7-4f5c-87b7-103017025570" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Hvis overtrædelsesprocenten for en tilskudsordning eller tilskudskategori overstiger 25 pct., nedsættes tilskuddet med det samlede vægtede, overtrådte areal.</Char>
                      </Linea>
                      <Linea>
                        <Char>Herudover pålægges en sanktion svarende til det samlede vægtede, overtrådte areal ganget med en sanktionsfaktor på 0,3.</Char>
                      </Linea>
                      <Linea>
                        <Char>Hvis ansøgeren i tidligere år i perioden 2023-2027 har haft en overtrædelsesprocent på over 10 under den samme tilskudsordning eller tilskudskategori, er sanktionen det samlede vægtede, overtrådte areal ganget med en sanktionsfaktor på 1,0.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idbc3bd5fe-2719-4396-80b8-df53d8c90ffd">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved manglende opfyldelse af forpligtelser, der ikke knytter sig til de enkelte arealer, fastsættes størrelsen af det areal, hvor den manglende opfyldelse er konstateret, som størrelsen af det godkendte, ansøgte areal, der er ansøgt til efter den pågældende tilskudsordning eller tilskudskategori.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id0ace7d56-05c8-4010-a0e8-96dfee93fc3d">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ved manglende opfyldelse af flere forpligtelser på det samme areal beregnes vægtningsfaktoren ved at sammenlægge de vægtningsfaktorer, der er gældende for den manglende opfyldelse af hver enkelt forpligtelse.</Char>
                </Linea>
                <Linea>
                  <Char>Summen af vægtningsfaktorer for det enkelte areal kan maksimalt fastsættes til 1,0, jf. dog stk. 4.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idc0f86635-0fe1-4b0b-9651-712ac9bf727f">
              <Explicatus>Stk. 4.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>For tilskudsordninger med tilskudskategorier foretages beregning af vægtningsfaktoren ved manglende opfyldelse af flere forpligtelser på samme areal, jf. stk. 3, for hver tilskudskategori.</Char>
                </Linea>
                <Linea>
                  <Char>Summen af vægtningsfaktorer for det enkelte areal kan maksimalt fastsættes til 1,0 pr. tilskudskategori.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="idf7a33ac6-23ce-45f9-a708-3140f008f6f3">
            <Linea>
              <Char formaChar="Italic">Beregningsrækkefølge ved nedsættelse af tilskud</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id218ffa9d-9fc4-4611-8ac4-8f248387ec80" localId="52">
            <Explicatus>§ 52.</Explicatus>
            <Stk id="id53b55265-2188-4ea9-a953-1d9b27e2ce3c">
              <Exitus>
                <Linea>
                  <Char>Ansøgers samlede tilskud fra den pågældende tilskudsordning nedsættes i følgende rækkefølge:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id767685d6-1e23-4e40-939b-d372840de35f">
                <Index>
                  <Indentatio id="id42b2ae00-901a-4900-9b87-61331bbd83cb" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>De nedsættelser og sanktioner, der er fastsat i § 51, anvendes på ansøgers tilskud fra den pågældende tilskudsordning.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id8d649e45-b670-4347-96b8-e0337936c58a" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det beløb, der følger af anvendelsen af nr. 1, danner grundlag for beregningen af sanktioner i henhold til § 45.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idd36b79bf-35ea-45b5-8560-23791ac870ce" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det beløb, der følger af anvendelsen af nr. 2, danner grundlag for beregningen af sanktioner, der skal anvendes ved manglende indberetning af landbrugsarealer i henhold til § 46.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id4b6f2d15-c7e7-4397-b9b8-b9a4c85a4ba8" formaInd="Nummer">
                    <Explicatus>4)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Det samlede beløb, der følger af anvendelsen af nr. 3, danner grundlag for anvendelse af den tilpasningssats, der er angivet i artikel 17 i Europa-Parlamentets og Rådets forordning (EU) 2021/2116 af 2. december 2021.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="id554eac2b-15cb-4014-9686-0050cbfa86ff">
            <Linea>
              <Char formaChar="Italic">Sanktionsloft</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="iddff8d393-7c6e-41ab-9b50-2ebc5954592e" localId="53">
            <Explicatus>§ 53.</Explicatus>
            <Stk id="id55109ab2-fa32-47bc-9d6a-bb15c1bc2f6f">
              <Exitus>
                <Linea>
                  <Char>Ansøgere kan maksimalt pålægges administrative sanktioner for overtrædelse af forpligtelser under den ansøgte tilskudsordning eller tilskudskategori, der svarer til 100 pct. af det godkendte, ansøgte beløb fra tilskudsordningen eller tilskudskategorien for 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="idfe2218b0-e058-464b-b866-aa287ca91311">
            <Linea>
              <Char formaChar="Italic">Udelukkelse</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id416c7e2c-9dcc-4ae3-b327-aa694c82e958" localId="54">
            <Explicatus>§ 54.</Explicatus>
            <Stk id="id2cb9088d-fbc3-45f5-ab2d-2e11d747c0d1">
              <Exitus>
                <Linea>
                  <Char>Styrelsen kan udelukke en ansøger fra at søge en tilskudsordning i det følgende kalenderår, hvis ansøger i forbindelse med sin ansøgning til selvsamme tilskudsordning eller underliggende tilskudskategorier, har begået en meget alvorlig overtrædelse af loven, de i medfør af loven fastsatte regler eller Den Europæiske Unions forordninger omfattet af loven.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id6cbe38e0-4814-4001-ab5f-387ad748ca33">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>I vurderingen af overtrædelsens alvor, jf. stk. 1, skal der henses til overtrædelsens omfang, varighed og hyppighed.</Char>
                </Linea>
                <Linea>
                  <Char>I vurderingen indgår herudover ansøgers forsæt til at begå overtrædelsen eller graden af ansøgers uagtsomhed.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="ide9dc0e07-f2a5-4c19-a51a-ad9d3760dc34">
            <Linea>
              <Char formaChar="Italic">Suspension af økologisk arealstøtte</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="idfb54591f-6b78-4530-b49f-282803b0cd33" localId="55">
            <Explicatus>§ 55.</Explicatus>
            <Stk id="id2992ed12-2d86-400a-89f3-f0bb9cd2f524">
              <Exitus>
                <Linea>
                  <Char>Suspension af økologisk arealstøtte anvendes i tilfælde, hvor der fastslås manglende opfyldelse af en eller flere af forpligtelserne i § 11, nr. 2, 2. pkt., for så vidt angår gødningsplanlægning, § 11, nr. 3, § 18, nr. 3, 2. pkt., for så vidt angår gødningsplanlægning, og § 18, nr. 4, jf. § 58, stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="iddadc9d4e-2b0e-4876-8260-ea4ba06d600b">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Styrelsen sender i tilfælde af manglende opfyldelse af en eller flere af de i stk. 1 nævnte forpligtelser et brev til ansøger om afhjælpning af situationen med en frist hertil på 14 dage.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
        <ParagrafGruppe>
          <Rubrica id="ide36c5467-f056-48f4-bbb7-a3a5c7ed7cf6">
            <Linea>
              <Char formaChar="Italic">Bortfald af tilskud</Char>
            </Linea>
          </Rubrica>
          <Paragraf id="id3dd137ef-6b0a-4626-a8fa-d22e13befff9" localId="56">
            <Explicatus>§ 56.</Explicatus>
            <Stk id="id28a2b58e-5172-40f0-99c5-3b13436b70f7">
              <Exitus>
                <Linea>
                  <Char>Der ydes ikke tilskud under en bio-ordning, hvis der ikke samtidig ydes tilskud under grundbetalingsordningen.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id9dbb92e6-41ed-4e08-86b6-d5d6fcd7359c" localId="31">
        <Explicatus>Kapitel 31</Explicatus>
        <Rubrica id="id3e08aebb-8bc8-4ee5-84f5-b534ef1a0c81">
          <Linea>
            <Char formaChar="Italic">Satellitbaseret kontrol og georefererede billeder</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id6d875e31-5223-4269-9c17-e25d1e4768a2" localId="57">
            <Explicatus>§ 57.</Explicatus>
            <Stk id="id8fb7b57e-c627-4d09-ad78-6b3e944c97f2">
              <Exitus>
                <Linea>
                  <Char>Ansøgere informeres om de foreløbige resultater af den satellitbaserede kontrol for hvert enkelt ansøgt areal via en applikation, som styrelsen stiller til rådighed.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="idb1b5a6e4-c1c3-483f-bfa2-8380866316be">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Viser den satellitbaserede kontrol, at ansøger ikke opfylder de kriterier og forpligtelser, der gælder for arealet i henhold til den ansøgte tilskudsordning, sendes kontrolresultatet i partshøring hos ansøger, der har de i nr. 1-3 anførte muligheder:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id5674b68b-9618-459c-aead-39f8d9ce9f1d">
                <Index>
                  <Indentatio id="idb90ba4eb-ba2a-455e-af7d-17011fd7b9b9" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Afgive høringssvar ved at indsende billede af arealet, hvis ansøger mener, at kriteriet eller forpligtelsen allerede er opfyldt for det pågældende areal.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="idebefc127-9284-4f4b-ac64-72fac78b815b" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Opfylde kriteriet eller forpligtelsen, hvis det er muligt, og derefter afgive høringssvar ved at indsende billede, der dokumenterer kriteriets eller forpligtelsens opfyldelse.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id23422afa-4769-42b0-b8bc-511c27adc6c0" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Ændre sit fællesskema vedrørende anvendelsen af arealet.</Char>
                      </Linea>
                      <Linea>
                        <Char>Hvis ændringen vedrørende anvendelsen af arealet angår dele af arealet, og arealet dermed opdeles, skal der indsendes billeddokumentation for de dele af arealet, hvor ansøgeren mener, at kriteriet eller forpligtelsen er opfyldt.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
            <Stk id="idc1126413-7309-40b0-a3e6-74c67a0e5d99">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Ansøgers billeddokumentation for opfyldelse af de for arealet gældende kriterier eller forpligtelser skal kunne dokumenteres med georefererede billeder ud fra følgende forhold:</Char>
                </Linea>
              </Exitus>
              <Exitus id="id27b0825b-5484-4987-9aa0-3581863593d5">
                <Index>
                  <Indentatio id="id55daafc7-9188-43a5-bebc-7d443871e23c" formaInd="Nummer">
                    <Explicatus>1)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Billederne skal være taget med brug af funktionerne i den i stk. 1 nævnte applikation, således at billederne har den fornødne tidsfasthed og stedfasthed.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="ide07ec4ef-2e02-4bc1-852e-53c17beaf3cf" formaInd="Nummer">
                    <Explicatus>2)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Arealets beskaffenhed og eventuelle afgrøder skal fremgå tydeligt af billederne.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                  <Indentatio id="id6729b038-30f5-49af-a66e-36cde5d5ffda" formaInd="Nummer">
                    <Explicatus>3)</Explicatus>
                    <Exitus>
                      <Linea>
                        <Char>Billederne skal vise det areal, der ansøges om tilskud til.</Char>
                      </Linea>
                    </Exitus>
                  </Indentatio>
                </Index>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id7aef512c-274a-4c3e-933d-d36682ad4e0c" localId="32">
        <Explicatus>Kapitel 32</Explicatus>
        <Rubrica id="id8b25f8eb-0e5b-4063-b902-920a3c733bf9">
          <Linea>
            <Char formaChar="Italic">Obligatorisk digital kommunikation</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="id0ac51046-a1d1-4177-b3df-2b2e6c67881c" localId="58">
            <Explicatus>§ 58.</Explicatus>
            <Stk id="idf840e4af-decf-49b6-aa43-f8685e0ceea0">
              <Exitus>
                <Linea>
                  <Char>Afgørelser sendes digitalt til ansøger via Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id9d06dd78-274e-4abf-af44-23d21c84ceca">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Skemaet »Gødningskvote og Efterafgrøder«, jf. § 11, nr. 3, og § 18, nr. 4, skal indgives via Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id5e6e95da-9cba-44c9-b1a0-ee450c092df0" localId="59">
            <Explicatus>§ 59.</Explicatus>
            <Stk id="id3c84687d-d6fe-41df-b59b-030f5e46383d">
              <Exitus>
                <Linea>
                  <Char>Skriftlige partshøringer efter forvaltningslovens § 19, skriftlige anmodninger om supplerende oplysninger og skriftlige referater af telefoniske partshøringer efter forvaltningslovens § 19 sendes digitalt til ansøger via Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
          <Paragraf id="id35ff03c5-2a61-4840-b0e6-13ea94185ff6" localId="60">
            <Explicatus>§ 60.</Explicatus>
            <Stk id="id2a1ede62-72c2-466c-877f-2d62054998a5">
              <Exitus>
                <Linea>
                  <Char>Ansøgers besvarelse af forhold omfattet af § 59 skal indgives via Tast selv, jf. dog stk. 2.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id342181f8-a3b7-4978-96eb-6c7ec6d415af">
              <Explicatus>Stk. 2.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Besvarelse af partshøringer efter forvaltningslovens § 19 i forbindelse med den satellitbaserede kontrol skal ske ved digital indgivelse af billeddokumentation til styrelsen via den applikation, som styrelsen stiller til rådighed.</Char>
                </Linea>
                <Linea>
                  <Char>Supplerende oplysninger indgives via Tast selv.</Char>
                </Linea>
              </Exitus>
            </Stk>
            <Stk id="id24625c1e-516f-4031-a70b-e92f9f70f5d2">
              <Explicatus>Stk. 3.</Explicatus>
              <Exitus>
                <Linea>
                  <Char>Styrelsen kan dispensere fra kravet om, at høringssvar til kontrolresultatet fra den satellitbaserede kontrol skal afgives ved hjælp af den i stk. 2 nævnte applikation, hvis det på grund af omstændighederne ikke er muligt for ansøger at kommunikere digitalt med styrelsen via applikationen.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
      <Kapitel id="id1de6aec0-35a9-4f5c-89ad-3628df86ce04" localId="33">
        <Explicatus>Kapitel 33</Explicatus>
        <Rubrica id="idbcc38f22-248d-4b6e-9005-1dbd26a12e9b">
          <Linea>
            <Char formaChar="Italic">Ikrafttræden</Char>
          </Linea>
        </Rubrica>
        <ParagrafGruppe>
          <Paragraf id="ide2628824-fc1b-4a96-bf01-de54992a7105" localId="61">
            <Explicatus>§ 61.</Explicatus>
            <Stk id="id27f40e14-faf9-461e-8fa4-42a6caa080da">
              <Exitus>
                <Linea>
                  <Char>Bekendtgørelsen træder i kraft den 1. januar 2026.</Char>
                </Linea>
              </Exitus>
            </Stk>
          </Paragraf>
        </ParagrafGruppe>
      </Kapitel>
    </Afsnit>
  </DokumentIndhold>
  <UnderskriftGruppe id="id96cecba7-295d-46a2-b480-0ae26f3bad0a">
    <UnderskriftStedDato />
    <Underskriver />
  </UnderskriftGruppe>

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Alemania: humedad del suelo por Land (DWD)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "asOf",
  "unit",
  "source",
  "regions",
  "months",
  "values",
  "clim"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "enum": [
    "% nFK"
   ]
  },
  "regions": {
   "type": "array",
   "minItems": 17,
   "maxItems": 17
  },
  "months": {
   "type": "array",
   "minItems": 300
  },
  "values": {
   "type": "object",
   "minProperties": 17
  },
  "clim": {
   "type": "object",
   "minProperties": 17
  }
 }
}

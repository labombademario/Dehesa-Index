{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - PAC Dinamarca: importes y umbrales de 2026 (Retsinformation, BEK 1363 y 1381)",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "campaign",
  "kind",
  "source",
  "documents",
  "schemes",
  "thresholds",
  "verifiedAt",
  "changes"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "country": {
   "enum": [
    "DK"
   ]
  },
  "campaign": {
   "enum": [
    2026
   ]
  },
  "kind": {
   "enum": [
    "DECREE_AMOUNTS"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "retsinformation"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    }
   }
  },
  "documents": {
   "type": "array",
   "minItems": 2
  },
  "schemes": {
   "type": "array",
   "minItems": 4
  },
  "thresholds": {
   "type": "array",
   "minItems": 3
  },
  "verifiedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "changes": {
   "type": "array"
  }
 }
}

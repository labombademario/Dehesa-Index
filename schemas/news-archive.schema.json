{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - archivo semanal de noticias (titular, medio, fecha, region, temas, enlace; sin texto de la noticia)",
 "type": "object",
 "required": [
  "schemaVersion",
  "week",
  "from",
  "to",
  "coverage",
  "items",
  "rest",
  "generatedAt"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "week": {
   "type": "string",
   "pattern": "^\\d{4}-W\\d\\d$"
  },
  "from": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
  },
  "to": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "coverage": {
   "type": "object",
   "required": [
    "from"
   ],
   "properties": {
    "from": {
     "type": "string",
     "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
    }
   }
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "date",
     "region",
     "topic",
     "products",
     "source",
     "lang",
     "h",
     "url",
     "rel"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 3
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     },
     "region": {
      "type": "string",
      "enum": [
       "us",
       "ca",
       "uk",
       "eu",
       "global"
      ]
     },
     "topic": {
      "type": "string"
     },
     "topics": {
      "type": "array"
     },
     "products": {
      "type": "array"
     },
     "source": {
      "type": "string"
     },
     "lang": {
      "type": "string",
      "minLength": 2,
      "maxLength": 3
     },
     "h": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "rel": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "rest": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 6,
    "maxItems": 6
   }
  }
 }
}

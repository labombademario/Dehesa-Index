{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Espana: superficies y producciones de cultivos por provincia (MAPA), un grupo de cultivos",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "group",
  "groupName",
  "source",
  "measures",
  "units",
  "provinces",
  "campaigns"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "group": {
   "type": "string",
   "pattern": "^[a-z_]+$"
  },
  "groupName": {
   "type": "string",
   "minLength": 3
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "mapa_es"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://www\\.mapa\\.gob\\.es/"
    }
   }
  },
  "measures": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5
  },
  "units": {
   "type": "object",
   "required": [
    "area",
    "production"
   ],
   "properties": {
    "area": {
     "enum": [
      "ha"
     ]
    },
    "production": {
     "enum": [
      "t"
     ]
    }
   }
  },
  "provinces": {
   "type": "object",
   "minProperties": 40,
   "additionalSchema": {
    "type": "string",
    "minLength": 2
   }
  },
  "campaigns": {
   "type": "object",
   "minProperties": 1,
   "additionalSchema": {
    "type": "object",
    "required": [
     "status",
     "crops"
    ],
    "properties": {
     "status": {
      "enum": [
       "provisional",
       "final"
      ]
     },
     "crops": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "c",
        "n",
        "l",
        "t",
        "v"
       ],
       "properties": {
        "c": {
         "type": "string",
         "pattern": "^[A-Z]{2}\\d{4}$"
        },
        "n": {
         "type": "string",
         "minLength": 2
        },
        "l": {
         "type": "integer",
         "minimum": 0,
         "maximum": 6
        },
        "t": {
         "type": "array",
         "minItems": 5,
         "maxItems": 5
        },
        "v": {
         "type": "object",
         "minProperties": 1,
         "additionalSchema": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5
         }
        }
       }
      }
     }
    }
   }
  }
 }
}

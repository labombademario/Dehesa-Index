          "number",
          "null"
         ]
        }
       },
       "white": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       }
      }
     },
     "igp": {
      "type": "object",
      "required": [
       "all",
       "white"
      ],
      "properties": {
       "all": {
        "type": "array",
        "items": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "white": {
        "type": "array",
        "items": {
         "type": [

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Espana: balances historicos del vino 2009/10-2015/16 (MAPA)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "checkedAt",
  "source",
  "units",
  "campaigns",
  "categories",
  "codes",
  "labels",
  "status",
  "v",
  "files",
  "notes"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "checkedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "mapa_es"
     ]
    },
    "url": {
     "type": "string"
    }
   }
  },
  "units": {
   "type": "object",
   "required": [
    "wine"
   ]
  },
  "campaigns": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}/\\d{2}$"
   },
   "minItems": 5
  },
  "categories": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 5,
   "maxItems": 5
  },
  "codes": {
   "type": "array",

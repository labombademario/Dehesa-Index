{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Espana: precio de la tierra y canones de arrendamiento por comunidad y provincia (MAPA)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "years",
  "status",
  "source",
  "files",
  "types",
  "rentTypes",
  "price",
  "rent"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "years": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer",
    "minimum": 2000
   }
  },
  "status": {
   "type": "object"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    },
    "licence": {
     "type": "string"
    }
   }
  },
  "files": {
   "type": "object",
   "required": [
    "price",
    "rent"
   ]
  },
  "types": {
   "type": "object",
   "minProperties": 10
  },
  "rentTypes": {
   "type": "object",
   "minProperties": 3
  },
  "price": {
   "type": "object",
   "required": [
    "unit",
    "ccaa",
    "prov"
   ],
   "properties": {
    "unit": {
     "enum": [
      "EUR/ha"
     ]
    },
    "ccaa": {
     "type": "object",
     "minProperties": 17
    },
    "prov": {
     "type": "object",
     "required": [
      "year",
      "names",
      "values"
     ],
     "properties": {
      "year": {
       "type": "integer"
      },
      "names": {
       "type": "object",
       "minProperties": 50
      },
      "values": {
       "type": "object",
       "minProperties": 50
      }
     }
    }
   }
  },
  "rent": {
   "type": "object",
   "required": [
    "unit",
    "ccaa"
   ],
   "properties": {
    "unit": {
     "enum": [
      "EUR/ha/year"
     ]
    },
    "ccaa": {
     "type": "object",
     "minProperties": 17
    },
    "other": {
     "type": "object"
    }
   }
  },
  "log": {
   "type": "array"
  }
 }
}

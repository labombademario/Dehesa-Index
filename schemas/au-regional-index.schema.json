{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Australia: indice de agricultura por municipio y SA4",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "items",
  "states"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "abs"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "items": {
   "type": "object",
   "minProperties": 10
  },
  "states": {
   "type": "object",
   "minProperties": 8
  }
 }
}

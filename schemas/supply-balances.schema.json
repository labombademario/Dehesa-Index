{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - balances oficiales de oferta y demanda por pais (una campaña por clave; miles de toneladas)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "country",
  "sourceId",
  "source",
  "unit",
  "note",
  "items",
  "stocksToUse",
  "products",
  "campaigns",
  "cards",
  "chart"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "country": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "sourceId": {
   "type": "string"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "table": {
     "type": "string"
    }
   }
  },
  "unit": {
   "enum": [
    "kt"
   ]
  },
  "note": {
   "type": "object",
   "required": [
    "es",
    "en",
    "fr",
    "it"
   ],
   "properties": {
    "es": {
     "type": "string"
    },
    "en": {
     "type": "string"
    },
    "fr": {
     "type": "string"
    },
    "it": {
     "type": "string"
    }
   }
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "sub",
     "strong"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "object",
      "required": [
       "es",
       "en",
       "fr",
       "it"
      ],
      "properties": {
       "es": {
        "type": "string"
       },
       "en": {
        "type": "string"
       },
       "fr": {
        "type": "string"
       },
       "it": {
        "type": "string"
       }
      }
     },
     "sub": {
      "type": "integer"
     },
     "strong": {
      "type": "boolean"
     }
    }
   }
  },
  "stocksToUse": {
   "type": "object",
   "required": [
    "num",
    "den"
   ],
   "properties": {
    "num": {
     "type": "string"
    },
    "den": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "identity": {
   "type": "object",
   "required": [
    "total",
    "minus",
    "equals",
    "tolerancePct"
   ],
   "properties": {
    "total": {
     "type": "string"
    },
    "minus": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "equals": {
     "type": "string"
    },
    "tolerancePct": {
     "type": "number"
    }
   }
  },
  "products": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "object",
      "required": [
       "es",
       "en",
       "fr",
       "it"
      ],
      "properties": {
       "es": {
        "type": "string"
       },
       "en": {
        "type": "string"
       },
       "fr": {
        "type": "string"
       },
       "it": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "campaigns": {
   "type": "object",
   "minProperties": 1
  },
  "cards": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "chart": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Paises Bajos: precios semanales de cerdo y vacuno y sacrificios de cerdo (RVO)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "country",
  "source",
  "units",
  "pigPrice",
  "cattlePrice",
  "pigSlaughter"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "country": {
   "enum": [
    "NL"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url",
    "license",
    "files"
   ],
   "properties": {
    "id": {
     "enum": [
      "rvo"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "license": {
     "type": "string"
    }
   }
  },
  "units": {
   "type": "object"
  },
  "pigPrice": {
   "type": "object",
   "required": [
    "pigs",
    "piglets"
   ],
   "properties": {
    "pigs": {
     "type": "array",
     "minItems": 100
    },
    "piglets": {
     "type": "array"
    }
   }
  },
  "cattlePrice": {
   "type": "object",
   "required": [
    "labels",
    "data"
   ],
   "properties": {
    "labels": {
     "type": "object"
    },
    "data": {
     "type": "object"
    }
   }
  },
  "pigSlaughter": {
   "type": "object",
   "required": [
    "heads",
    "weight",
    "lean"
   ],
   "properties": {
    "heads": {
     "type": "array",
     "minItems": 100
    },
    "weight": {
     "type": "array"
    },
    "lean": {
     "type": "array"
    }
   }
  }
 }
}

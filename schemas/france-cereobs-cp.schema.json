{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Francia: estado semanal de los cereales de paja (Cere'Obs, FranceAgriMer)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "country",
  "source",
  "fields",
  "units",
  "crops"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "country": {
   "enum": [
    "FR"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url",
    "license"
   ],
   "properties": {
    "id": {
     "enum": [
      "franceagrimer"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "license": {
     "type": "string"
    }
   }
  },
  "fields": {
   "type": "array",
   "minItems": 12
  },
  "units": {
   "type": "string"
  },
  "crops": {
   "type": "object",
   "minProperties": 4
  }
 }
}

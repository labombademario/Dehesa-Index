{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - resumen semanal del blog (cifras y titulares enlazados de la semana ISO; sin prosa)",
 "type": "object",
 "required": [
  "schemaVersion",
  "week",
  "from",
  "to",
  "generatedAt",
  "complete",
  "coverage",
  "totals",
  "top",
  "byRegion"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "week": {
   "type": "string",
   "pattern": "^\\d{4}-W\\d\\d$"
  },
  "from": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
  },
  "to": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "complete": {
   "type": "boolean"
  },
  "coverage": {
   "type": "object",
   "required": [
    "from",
    "days"
   ],
   "properties": {
    "from": {
     "type": "string",
     "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
    },
    "days": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "totals": {
   "type": "object",
   "required": [
    "items",
    "sources",
    "byRegion",
    "byTopic",
    "byProduct",
    "byDay"
   ],
   "properties": {
    "items": {
     "type": "integer",
     "minimum": 1
    },
    "sources": {
     "type": "integer",
     "minimum": 1
    },
    "byRegion": {
     "type": "object"
    },
    "byTopic": {
     "type": "object"
    },
    "byProduct": {
     "type": "object"
    },
    "byDay": {
     "type": "object"
    }
   }
  },
  "top": {
   "type": "array",
   "minItems": 1,
   "maxItems": 12,
   "items": {
    "type": "object",
    "required": [
     "date",
     "region",
     "source",
     "lang",
     "h",
     "url"
    ],
    "properties": {
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     },
     "region": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "lang": {
      "type": "string"
     },
     "h": {
      "type": "string",
      "minLength": 3
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "products": {
      "type": "array"
     },
     "topic": {
      "type": "string"
     }
    }
   }
  },
  "byRegion": {
   "type": "object"
  }
 }
}

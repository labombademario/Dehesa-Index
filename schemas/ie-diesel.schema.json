{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Irlanda: gasoleo semanal (Boletin Petrolero UE), gasoleo marcado despachado e indice de combustibles agrarios (CSO)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "unit",
  "weekly",
  "clearance",
  "prices"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "pattern": "^EUR/l$"
  },
  "weekly": {
   "type": "array",
   "minItems": 500,
   "items": {
    "type": "array",
    "minItems": 4,
    "maxItems": 4
   }
  },
  "clearance": {
   "type": "array",
   "minItems": 90,
   "items": {
    "type": "array",
    "minItems": 5,
    "maxItems": 5
   }
  },
  "prices": {
   "type": "array",
   "minItems": 60,
   "items": {
    "type": "array",
    "minItems": 4,
    "maxItems": 4
   }
  }
 }
}

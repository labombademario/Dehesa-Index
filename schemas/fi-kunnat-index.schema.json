{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Finlandia por municipio: explotaciones, cultivos y ganado (Luke), indice",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "year",
  "kunnat",
  "ind",
  "regions",
  "totals",
  "national"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "luke_fi"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "year": {
   "type": "integer",
   "minimum": 2020
  },
  "ind": {
   "type": "array",
   "minItems": 29,
   "items": {
    "type": "string"
   }
  },
  "regions": {
   "type": "object",
   "minProperties": 5
  },
  "totals": {
   "type": "object"
  },
  "national": {
   "type": "object"
  },
  "kunnat": {
   "type": "integer",
   "minimum": 250,
   "maximum": 330
  }
 }
}
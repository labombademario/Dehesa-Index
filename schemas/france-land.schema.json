{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Francia: precio de la tierra por departamento (Agreste/FNSafer)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "unit",
  "years",
  "free",
  "rent",
  "source"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "unit": {
   "enum": [
    "EUR/ha"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "licence"
   ]
  },
  "years": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer",
    "minimum": 1960
   }
  },
  "free": {
   "type": "object",
   "minProperties": 85
  },
  "rent": {
   "type": "object",
   "minProperties": 40
  }
 }
}
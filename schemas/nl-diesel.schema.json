{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Países Bajos: gasóleo semanal (Boletín Petrolero UE), precio diario en surtidor (CBS) y precio agrario del gasóleo",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "unit",
  "weekly",
  "pump",
  "farm"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "pattern": "^EUR/l$"
  },
  "weekly": {
   "type": "array",
   "minItems": 500,
   "items": {
    "type": "array",
    "minItems": 4,
    "maxItems": 4
   }
  },
  "pump": {
   "type": "array",
   "minItems": 700,
   "items": {
    "type": "array",
    "minItems": 3,
    "maxItems": 3
   }
  },
  "farm": {
   "type": "array",
   "minItems": 20,
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2
   }
  }
 }
}

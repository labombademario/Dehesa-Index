{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Manitoba: ovino y caprino en subastas (Winnipeg y Grunthal, Manitoba Agriculture)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "unit",
  "classes",
  "marts",
  "disputed",
  "sales"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "mb_agri"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://www\\.gov\\.mb\\.ca/"
    }
   }
  },
  "unit": {
   "enum": [
    "C$/cwt"
   ]
  },
  "classes": {
   "type": "array",
   "minItems": 8,
   "maxItems": 8
  },
  "marts": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2
  },
  "disputed": {
   "type": "array"
  },
  "sales": {
   "type": "object",
   "minProperties": 1,
   "additionalSchema": {
    "type": "object",
    "minProperties": 1,
    "additionalSchema": {
     "type": "array",
     "minItems": 8,
     "maxItems": 8
    }
   }
  }
 }
}

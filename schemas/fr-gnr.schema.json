{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Francia: gazole non routier (GNR), gazole y fioul domestique (DGEC) y gazole por departamento",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "asOf",
  "unit",
  "source",
  "fields",
  "weekly",
  "stations"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "enum": [
    "EUR/l"
   ]
  },
  "fields": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5
  },
  "weekly": {
   "type": "array",
   "minItems": 100,
   "items": {
    "type": "array",
    "minItems": 5,
    "maxItems": 5
   }
  },
  "stations": {
   "type": "object",
   "required": [
    "date",
    "median",
    "n",
    "departments"
   ],
   "properties": {
    "departments": {
     "type": "object",
     "minProperties": 80
    }
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - EE. UU.: estado de ingesta de ganado y heno locales",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "sourceId",
  "run",
  "reports"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "sourceId": {
   "enum": [
    "usda_ams_mars"
   ]
  },
  "run": {
   "type": "object",
   "required": [
    "status"
   ],
   "properties": {
    "status": {
     "enum": [
      "OK",
      "PARTIAL",
      "FAILED",
      "NO_KEY"
     ]
    }
   }
  },
  "reports": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "kind",
     "state",
     "reportId",
     "status"
    ],
    "properties": {
     "kind": {
      "enum": [
       "cattle",
       "hay"
      ]
     },
     "state": {
      "type": "string"
     },
     "reportId": {
      "type": "integer"
     },
     "status": {
      "enum": [
       "OK",
       "NO_KEY",
       "NOT_RUN",
       "UNAVAILABLE",
       "AUTH_FAILURE",
       "ERROR",
       "EMPTY"
      ]
     }
    }
   }
  }
 }
}

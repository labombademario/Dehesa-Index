{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - PAC Dinamarca: seguimiento de cambios de los decretos en Retsinformation",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "source",
  "checkedAt",
  "baseline",
  "current",
  "reviewNeeded",
  "note"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "country": {
   "enum": [
    "DK"
   ]
  },
  "source": {
   "enum": [
    "retsinformation"
   ]
  },
  "checkedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "baseline": {
   "type": "object",
   "required": [
    "sections",
    "amendments"
   ],
   "properties": {
    "sections": {
     "type": "object"
    },
    "amendments": {
     "type": "object"
    }
   }
  },
  "current": {
   "type": "object",
   "required": [
    "sections",
    "amendments"
   ],
   "properties": {
    "sections": {
     "type": "object"
    },
    "amendments": {
     "type": "object"
    }
   }
  },
  "reviewNeeded": {
   "type": "array"
  },
  "note": {
   "type": "string"
  }
 }
}

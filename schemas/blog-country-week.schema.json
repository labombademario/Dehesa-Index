{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - La semana en un pais (datos publicados, precios que mas se movieron y titulares de sus medios; sin prosa)",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "week",
  "from",
  "to",
  "complete",
  "coverage",
  "totals",
  "movers",
  "releases",
  "news"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "country": {
   "type": "string",
   "enum": [
    "ES",
    "FR",
    "IT",
    "DE",
    "US"
   ]
  },
  "week": {
   "type": "string",
   "pattern": "^\\d{4}-W\\d\\d$"
  },
  "from": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
  },
  "to": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
  },
  "complete": {
   "type": "boolean"
  },
  "coverage": {
   "type": "object",
   "required": [
    "from"
   ],
   "properties": {
    "from": {
     "type": "string",
     "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
    }
   }
  },
  "totals": {
   "type": "object",
   "required": [
    "updates",
    "byBlock",
    "sources",
    "newSeries",
    "news"
   ],
   "properties": {
    "updates": {
     "type": "integer",
     "minimum": 0
    },
    "sources": {
     "type": "integer",
     "minimum": 0
    },
    "newSeries": {
     "type": "integer",
     "minimum": 0
    },
    "news": {
     "type": "integer",
     "minimum": 0
    },
    "byBlock": {
     "type": "object",
     "required": [
      "precios",
      "produccion",
      "comercio",
      "costes",
      "otros"
     ]
    }
   }
  },
  "movers": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "unit",
     "freq",
     "group",
     "block",
     "period",
     "value",
     "changePct",
     "seen"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "label": {
      "type": "string"
     },
     "unit": {
      "type": "string"
     },
     "freq": {
      "type": "string"
     },
     "group": {
      "type": "string"
     },
     "block": {
      "type": "string",
      "enum": [
       "precios",
       "produccion",
       "comercio",
       "costes",
       "otros"
      ]
     },
     "period": {
      "type": "string",
      "minLength": 4
     },
     "value": {
      "type": "number"
     },
     "changePct": {
      "type": [
       "number",
       "null"
      ]
     },
     "seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     }
    }
   }
  },
  "releases": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "unit",
     "freq",
     "group",
     "block",
     "period",
     "value",
     "changePct",
     "seen"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "label": {
      "type": "string"
     },
     "unit": {
      "type": "string"
     },
     "freq": {
      "type": "string"
     },
     "group": {
      "type": "string"
     },
     "block": {
      "type": "string",
      "enum": [
       "precios",
       "produccion",
       "comercio",
       "costes",
       "otros"
      ]
     },
     "period": {
      "type": "string",
      "minLength": 4
     },
     "value": {
      "type": "number"
     },
     "changePct": {
      "type": [
       "number",
       "null"
      ]
     },
     "seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     }
    }
   }
  },
  "news": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "date",
     "source",
     "lang",
     "h",
     "url"
    ],
    "properties": {
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     },
     "source": {
      "type": "string"
     },
     "lang": {
      "type": "string",
      "minLength": 2,
      "maxLength": 3
     },
     "h": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     }
    }
   }
  }
 }
}
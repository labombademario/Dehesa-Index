{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "title": "EE. UU.: valoración y avance semanal de los cultivos en un estado (USDA NASS)",
 "required": [
  "schemaVersion",
  "generatedAt",
  "state",
  "source",
  "year",
  "crops"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "state": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "year": {
   "type": "integer"
  },
  "crops": {
   "type": "object",
   "minProperties": 1
  }
 }
}

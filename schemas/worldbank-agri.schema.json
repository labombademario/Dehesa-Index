{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - perfil agrario, comercio agrario, precios/macro y medio ambiente por pais (Banco Mundial WDI)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "indicators",
  "countries"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url",
    "license"
   ],
   "properties": {
    "id": {
     "enum": [
      "world_bank_wdi"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "license": {
     "enum": [
      "CC BY 4.0"
     ]
    },
    "licenseUrl": {
     "type": "string"
    },
    "wdiLastUpdated": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "indicators": {
   "type": "object",
   "minProperties": 20
  },
  "countries": {
   "type": "object",
   "minProperties": 12
  }
 }
}

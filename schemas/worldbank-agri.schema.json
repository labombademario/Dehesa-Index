{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - perfil agrario, comercio agrario, precios/macro y medio ambiente por pais (Banco Mundial WDI)",
 "type": "object",
 "required": ["schemaVersion", "generatedAt", "source", "indicators", "countries"],
 "properties": {
  "schemaVersion": {"type": ["integer", "string"]},
  "generatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
  "source": {
   "type": "object",
   "required": ["id", "name", "url", "license"],
   "properties": {"id": {"const": "world_bank_wdi"}, "name": {"type": "string"}, "url": {"type": "string"}, "license": {"const": "CC BY 4.0"}, "licenseUrl": {"type": "string"}, "wdiLastUpdated": {"type": ["string", "null"]}}
  },
  "indicators": {
   "type": "object",
   "minProperties": 20,
   "additionalProperties": {
    "type": "object",
    "required": ["code", "group", "name", "license"],
    "properties": {
     "code": {"type": "string", "pattern": "^[A-Z0-9.]+$"},
     "group": {"enum": ["structure", "yield", "indices", "trade", "macro", "environment"]},
     "name": {"type": "string"},
     "unit": {"type": "string"},
     "license": {"const": "CC BY-4.0"},
     "origin": {"type": "string"}
    }
   }
  },
  "countries": {
   "type": "object",
   "minProperties": 12,
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "object",
     "required": ["y0", "v"],
     "properties": {"y0": {"type": "integer", "minimum": 1990}, "v": {"type": "array", "minItems": 1, "items": {"type": ["number", "null"]}}}
    }
   }
  }
 }
}

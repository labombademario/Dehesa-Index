{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "API v1: ultimos valores (data/api/v1/latest.json)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "series"
 ],
 "properties": {
  "series": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "object",
    "required": [
     "id",
     "date",
     "value",
     "unit",
     "currency",
     "attribution"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-(\\d{2}|Q\\d)"
     },
     "value": {
      "type": "number"
     }
    }
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Canada: indice de rendimientos por region",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "units",
  "years",
  "crops"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "statcan"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "units": {
   "type": "object",
   "minProperties": 4
  },
  "years": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2
  },
  "crops": {
   "type": "object",
   "minProperties": 1
  }
 }
}

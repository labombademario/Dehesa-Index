{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Australia: indice de sacrificio y carne",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "units",
  "periods",
  "states",
  "slaughter",
  "meat"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "abs"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "units": {
   "type": "object",
   "minProperties": 2
  },
  "periods": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2
  },
  "states": {
   "type": "array",
   "minItems": 9
  },
  "slaughter": {
   "type": "array",
   "minItems": 5
  },
  "meat": {
   "type": "array",
   "minItems": 5
  }
 }
}

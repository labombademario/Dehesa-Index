{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Product metadata",
 "type": "object",
 "required": [
  "schemaVersion",
  "bushelKg",
  "products"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "bushelKg": {
   "type": "object",
   "additionalSchema": {
    "type": "number",
    "minimum": 0.0001
   }
  },
  "products": {
   "type": "object",
   "minProperties": 15,
   "additionalSchema": {
    "type": "object",
    "required": [
     "name",
     "group",
     "kind",
     "instruments",
     "indices",
     "hs",
     "related"
    ],
    "properties": {
     "name": {
      "type": "object",
      "required": [
       "es",
       "en",
       "fr",
       "it"
      ],
      "additionalSchema": {
       "type": "string",
       "minLength": 1
      }
     },
     "group": {
      "enum": [
       "cereales",
       "oleaginosas",
       "lacteos",
       "ganaderia",
       "insumos",
       "energia",
       "aceites"
      ]
     },
     "kind": {
      "enum": [
       "crop",
       "dairy",
       "livestock",
       "input",
       "energy",
       "other"
      ]
     },
     "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "region",
        "product"
       ],
       "properties": {
        "region": {
         "enum": [
          "eu",
          "us",
          "ca",
          "uk"
         ]
        },
        "product": {
         "type": "string",
         "minLength": 1
        },
        "form": {
         "type": "string"
        },
        "label": {
         "type": "string"
        }
       }
      }
     },
     "indices": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "region",
        "product"
       ],
       "properties": {
        "region": {
         "enum": [
          "eu",
          "us",
          "ca",
          "uk"
         ]
        },
        "product": {
         "type": "string",
         "minLength": 1
        },
        "form": {
         "type": "string"
        },
        "label": {
         "type": "string"
        }
       }
      }
     },
     "psd": {
      "type": [
       "string",
       "null"
      ]
     },
     "hs": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^\\d{4}$"
      }
     },
     "related": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "product",
        "relation",
        "why"
       ],
       "properties": {
        "product": {
         "type": "string",
         "minLength": 1
        },
        "relation": {
         "enum": [
          "input",
          "feed"
         ]
        },
        "why": {
         "enum": [
          "fertilizer",
          "energy",
          "feed"
         ]
        }
       }
      }
     },
     "compare": {
      "type": "object",
      "required": [
       "eu",
       "per",
       "label"
      ],
      "properties": {
       "eu": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "per": {
        "enum": [
         100,
         1000
        ]
       },
       "label": {
        "type": "object",
        "required": [
         "es",
         "en",
         "fr",
         "it"
        ]
       }
      }
     }
    }
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - PAC España: reglas y calendario curados del RD 1048/2022",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "scheme",
  "status",
  "curated",
  "verifiedAt",
  "source",
  "note",
  "rules",
  "calendar",
  "campaignOverrides",
  "ecoschemes"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "country": {
   "enum": [
    "ES"
   ]
  },
  "scheme": {
   "type": "string"
  },
  "status": {
   "enum": [
    "CURRENT",
    "PROPOSED",
    "SUPERSEDED"
   ]
  },
  "curated": {
   "type": "boolean"
  },
  "verifiedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "instrument",
    "boeRef",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "boe_es"
     ]
    },
    "boeRef": {
     "enum": [
      "BOE-A-2022-23048"
     ]
    },
    "url": {
     "type": "string",
     "pattern": "^https://www\\.boe\\.es/"
    }
   }
  },
  "note": {
   "type": "string",
   "minLength": 20
  },
  "rules": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "object",
    "required": [
     "id",
     "topic",
     "legalBasis",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "legalBasis": {
      "type": "string",
      "minLength": 5
     },
     "text": {
      "type": "string",
      "minLength": 20
     },
     "articles": {
      "type": "array"
     },
     "topic": {
      "enum": [
       "payments",
       "abrs",
       "redistributive",
       "young",
       "eco",
       "amounts",
       "associated",
       "calendar"
      ]
     }
    }
   }
  },
  "calendar": {
   "type": "array",
   "minItems": 8,
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "legalBasis",
     "articles",
     "when",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "kind": {
      "enum": [
       "window-start",
       "deadline",
       "publication",
       "window"
      ]
     },
     "legalBasis": {
      "type": "string",
      "minLength": 5
     },
     "articles": {
      "type": "array",
      "minItems": 1
     },
     "when": {
      "type": "object",
      "required": [
       "month",
       "day",
       "yearOffset"
      ],
      "properties": {
       "month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
       },
       "day": {
        "type": "integer",
        "minimum": 1,
        "maximum": 31
       },
       "yearOffset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
       }
      }
     },
     "text": {
      "type": "string",
      "minLength": 10
     }
    }
   }
  },
  "campaignOverrides": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "campaign",
     "calendarId",
     "region",
     "date",
     "legalBasis",
     "text"
    ],
    "properties": {
     "campaign": {
      "type": "integer",
      "minimum": 2023,
      "maximum": 2030
     },
     "calendarId": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "legalBasis": {
      "type": "string",
      "minLength": 5
     },
     "text": {
      "type": "string",
      "minLength": 10
     }
    }
   }
  },
  "ecoschemes": {
   "type": "array",
   "minItems": 9,
   "maxItems": 9,
   "items": {
    "type": "object",
    "required": [
     "code",
     "name",
     "legalBasis",
     "articles",
     "surfaceTypes"
    ],
    "properties": {
     "code": {
      "enum": [
       "a",
       "b",
       "c",
       "d",
       "e",
       "f",
       "g",
       "h",
       "i"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 10
     },
     "legalBasis": {
      "type": "string",
      "minLength": 5
     },
     "articles": {
      "type": "array",
      "minItems": 1
     },
     "surfaceTypes": {
      "type": "array",
      "minItems": 1
     }
    }
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Manitoba: precios semanales de ganado vacuno en las subastas (Manitoba Agriculture)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "unit",
  "classes",
  "marts",
  "weeks"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "mb_agri"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://www\\.gov\\.mb\\.ca/"
    }
   }
  },
  "unit": {
   "enum": [
    "C$/cwt"
   ]
  },
  "classes": {
   "type": "array",
   "minItems": 15,
   "maxItems": 15
  },
  "marts": {
   "type": "array",
   "minItems": 7,
   "maxItems": 7
  },
  "weeks": {
   "type": "object",
   "minProperties": 1,
   "additionalSchema": {
    "type": "object",
    "required": [
     "head",
     "weekTotal",
     "ytd",
     "summary",
     "marts"
    ],
    "properties": {
     "head": {
      "type": "object",
      "minProperties": 7
     },
     "weekTotal": {
      "type": "integer",
      "minimum": 0
     },
     "ytd": {
      "type": "object",
      "minProperties": 2
     },
     "summary": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15
     },
     "marts": {
      "type": "object",
      "minProperties": 7,
      "additionalSchema": {
       "type": "object",
       "required": [
        "date",
        "rows"
       ],
       "properties": {
        "rows": {
         "type": "array",
         "minItems": 15,
         "maxItems": 15
        }
       }
      }
     }
    }
   }
  }
 }
}

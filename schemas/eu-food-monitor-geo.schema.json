{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Monitor de precios de alimentos de Eurostat por zona (data/eu-food-monitor/<GEO>.json)",
 "type": "object",
 "required": [
  "schemaVersion",
  "geo",
  "base",
  "end",
  "series"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "geo": {
   "type": "string",
   "pattern": "^[A-Z0-9_]{2,10}$"
  },
  "base": {
   "type": "string"
  },
  "end": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$"
  },
  "series": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "p",
     "i",
     "s",
     "v"
    ],
    "properties": {
     "p": {
      "type": "string"
     },
     "i": {
      "enum": [
       "ACPI",
       "PPI",
       "IPI",
       "HICP"
      ]
     },
     "s": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
     },
     "v": {
      "type": "array",
      "minItems": 12,
      "items": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "f": {
      "enum": [
       "p",
       "e"
      ]
     }
    }
   }
  }
 }
}

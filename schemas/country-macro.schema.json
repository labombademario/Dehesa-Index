{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dehesa Index - country macro indicators",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "countries"],
  "properties": {
    "schemaVersion": {"type": ["integer", "string"]},
    "generatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "countries": {"type": "object", "minProperties": 5}
  }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Polonia: precio de la tierra arable por voivodia (GUS/BDL)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "unit",
  "years",
  "classes",
  "source"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "unit": {
   "enum": [
    "PLN/ha"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "licence"
   ]
  },
  "years": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer",
    "minimum": 1999
   }
  },
  "classes": {
   "type": "object",
   "required": [
    "total",
    "fertile",
    "medium",
    "barren"
   ],
   "minProperties": 4
  }
 }
}

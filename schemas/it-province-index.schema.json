{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Italia: indice del censo agrario 2020 por provincia",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "year",
  "regions",
  "indicators"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "istat"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "year": {
   "type": "integer"
  },
  "indicators": {
   "type": "object",
   "minProperties": 40
  },
  "regions": {
   "type": "array",
   "minItems": 20,
   "maxItems": 20
  }
 }
}

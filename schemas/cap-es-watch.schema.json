{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - PAC España: seguimiento de cambios del texto consolidado del BOE",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "source",
  "boeRef",
  "checkedAt",
  "baseline",
  "current",
  "reviewNeeded",
  "note"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "country": {
   "enum": [
    "ES"
   ]
  },
  "source": {
   "enum": [
    "boe_es"
   ]
  },
  "boeRef": {
   "enum": [
    "BOE-A-2022-23048"
   ]
  },
  "checkedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "baseline": {
   "type": "object",
   "required": [
    "articles",
    "annexes",
    "provisions",
    "legal"
   ],
   "properties": {
    "articles": {
     "type": "object",
     "minProperties": 1,
     "additionalSchema": {
      "type": "object",
      "required": [
       "sha256",
       "chars"
      ],
      "properties": {
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "chars": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    },
    "annexes": {
     "type": "object",
     "minProperties": 1,
     "additionalSchema": {
      "type": "object",
      "required": [
       "sha256",
       "chars"
      ],
      "properties": {
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "chars": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    },
    "provisions": {
     "type": "object",
     "minProperties": 1,
     "additionalSchema": {
      "type": "object",
      "required": [
       "sha256",
       "chars"
      ],
      "properties": {
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "chars": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    },
    "legal": {
     "type": "object",
     "required": [
      "consolidatedAt",
      "amendments"
     ],
     "properties": {
      "consolidatedAt": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
      },
      "amendments": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "id",
         "relation",
         "text"
        ],
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^BOE-[A-Z]-\\d{4}-\\d+$"
         },
         "relation": {
          "type": "string"
         },
         "text": {

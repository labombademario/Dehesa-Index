{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Indice de denominaciones de origen por pais (eAmbrosia)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "countries"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    },
    "license": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "countries": {
   "type": "object",
   "minProperties": 20
  }
 }
}
{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - EE. UU.: rendimiento, superficie cosechada y produccion por condado (USDA NASS)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "crop",
  "slug",
  "metrics",
  "units",
  "series",
  "years",
  "counties"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "checkedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "usda_nass"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "crop": {
   "type": "string",
   "minLength": 2
  },
  "slug": {
   "type": "string",
   "pattern": "^[a-z-]+$"
  },
  "metrics": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "enum": [
     "yield",
     "harvested",
     "production"
    ]
   }
  },
  "units": {
   "type": "object",
   "required": [
    "yield",
    "harvested",
    "production"
   ]
  },
  "series": {
   "type": "object",
   "required": [
    "yield",
    "harvested",
    "production"
   ]
  },
  "years": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer",
    "minimum": 1990,
    "maximum": 2100
   }
  },
  "counties": {
   "type": "object",
   "minProperties": 1
  }
 }
}
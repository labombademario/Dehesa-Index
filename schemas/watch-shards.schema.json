{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Watchlist shard list (data/watch/index.json)",
 "type": "object",
 "required": [
  "schemaVersion",
  "prefixes",
  "n"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "doc": {
   "type": "string"
  },
  "prefixes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^[A-Z]{1,3}$"
   }
  },
  "n": {
   "type": "object"
  }
 }
}
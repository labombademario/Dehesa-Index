{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - EE. UU.: seguro de cosechas por condado (USDA RMA)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "state",
  "years",
  "lastFullYear",
  "fields",
  "counties"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "usda_rma"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "state": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "years": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "string",
    "pattern": "^\\d{4}$"
   }
  },
  "lastFullYear": {
   "type": "integer"
  },
  "fields": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "topYear": {
   "type": "integer"
  },
  "counties": {
   "type": "object",
   "minProperties": 1
  }
 }
}

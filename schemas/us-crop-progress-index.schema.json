{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "title": "EE. UU.: índice del estado de los cultivos por estado (USDA NASS)",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "year",
  "lastWeekEnding",
  "states"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "year": {
   "type": "integer"
  },
  "lastWeekEnding": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "states": {
   "type": "array",
   "minItems": 15,
   "items": {
    "type": "string",
    "pattern": "^[A-Z]{2}$"
   }
  }
 }
}

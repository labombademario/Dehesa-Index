{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - PAC Polonia: tasas oficiales (Dziennik Ustaw)",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "kind",
  "currency",
  "campaigns",
  "sources",
  "documents",
  "items",
  "estimates2026",
  "notes",
  "verifiedAt"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "country": {
   "enum": [
    "PL"
   ]
  },
  "kind": {
   "enum": [
    "OFFICIAL_UNIT_RATES"
   ]
  },
  "currency": {
   "enum": [
    "PLN"
   ]
  },
  "campaigns": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer"
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1
  },
  "documents": {
   "type": "array",
   "minItems": 10
  },
  "items": {
   "type": "array",
   "minItems": 20
  },
  "estimates2026": {
   "type": "object"
  },
  "notes": {
   "type": "array",
   "minItems": 1
  },
  "verifiedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 }
}

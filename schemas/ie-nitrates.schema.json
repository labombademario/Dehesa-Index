{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Irlanda: nitratos en aguas subterraneas y estado de los rios (EPA via CSO)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "groundwater",
  "rivers"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "groundwater": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "array",
    "minItems": 7,
    "maxItems": 7
   }
  },
  "rivers": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "array",
    "minItems": 6,
    "maxItems": 6
   }
  }
 }
}

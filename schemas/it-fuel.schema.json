{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Italia: gasoleo de automocion y calefaccion (MASE) y por region (MIMIT)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "asOf",
  "unit",
  "source",
  "fields",
  "weekly",
  "stations"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "enum": [
    "EUR/l"
   ]
  },
  "fields": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3
  },
  "weekly": {
   "type": "array",
   "minItems": 500,
   "items": {
    "type": "array",
    "minItems": 3,
    "maxItems": 3
   }
  },
  "stations": {
   "type": "object",
   "required": [
    "date",
    "median",
    "n",
    "regions"
   ],
   "properties": {
    "regions": {
     "type": "object",
     "minProperties": 18
    }
   }
  }
 }
}

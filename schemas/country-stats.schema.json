{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dehesa Index - country statistics file",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "countries"],
  "properties": {
    "schemaVersion": {"type": ["integer", "string"]},
    "generatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "countries": {
      "type": "object", "minProperties": 1,
      "additionalSchema": {
        "type": "object", "required": ["name", "source", "series"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "source": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 2}, "url": {"type": "string"}, "license": {"type": "string"}}},
          "series": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["id", "group", "label", "unit", "frequency", "latestPeriod", "latest", "points"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "group": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "unit": {"type": "string", "minLength": 1},
                "frequency": {"type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "semiannual", "annual"]},
                "latestPeriod": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?|-Q[1-4]|-S[12])?$"},
                "latest": {"type": "number"},
                "changePct": {"type": ["number", "null"]},
                "points": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "maxItems": 2}}
              }
            }
          }
        }
      }
    }
  }
}

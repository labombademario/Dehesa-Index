{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Reino Unido: desembarques de pesca por especie, nacion y puerto (MMO, 5 anos) y serie historica",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "reportYear",
  "years",
  "units",
  "uk",
  "nations",
  "ports",
  "portsTotal",
  "history"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url",
    "license"
   ],
   "properties": {
    "id": {
     "enum": [
      "mmo_fish"
     ]
    },
    "url": {
     "type": "string",
     "pattern": "^https://www\\.gov\\.uk/"
    },
    "license": {
     "type": "string"
    }
   }
  },
  "reportYear": {
   "type": "integer"
  },
  "years": {
   "type": "array",
   "items": {
    "type": "integer"
   },
   "minItems": 5,
   "maxItems": 5
  },
  "units": {
   "type": "object"
  },
  "uk": {
   "type": "object",
   "required": [
    "species",
    "totals"
   ]
  },
  "nations": {
   "type": "object",
   "required": [
    "England",
    "Wales",
    "Scotland",
    "Northern Ireland"
   ]
  },
  "ports": {
   "type": "array",
   "minItems": 40
  },
  "portsTotal": {
   "type": "object"
  },
  "portsNote": {
   "type": "string"
  },
  "history": {
   "type": "object",
   "required": [
    "years",
    "qty",
    "val"
   ]
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - EE. UU.: estado de ingesta de rendimientos por condado",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "sourceId",
  "run",
  "crops"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "sourceId": {
   "enum": [
    "usda_nass"
   ]
  },
  "run": {
   "type": "object",
   "required": [
    "status"
   ],
   "properties": {
    "status": {
     "enum": [
      "OK",
      "PARTIAL",
      "FAILED",
      "NO_KEY",
      "AUTH_FAILURE"
     ]
    }
   }
  },
  "crops": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "slug",
     "key",
     "status"
    ],
    "properties": {
     "slug": {
      "type": "string"
     },
     "key": {
      "type": "string"
     },
     "status": {
      "enum": [
       "OK",
       "PARTIAL",
       "NO_DATA",
       "ERROR",
       "INVALID",
       "AUTH_FAILURE",
       "NOT_RUN",
       "UNAVAILABLE",
       "RATE_LIMITED"
      ]
     }
    }
   }
  }
 }
}
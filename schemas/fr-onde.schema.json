{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Francia: rios sin agua por departamento y mes (ONDE, Hub'Eau)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "asOf",
  "source",
  "classes",
  "deptNames",
  "months"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$"
  },
  "classes": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3
  },
  "deptNames": {
   "type": "object",
   "minProperties": 60
  },
  "months": {
   "type": "array",
   "minItems": 40,
   "items": {
    "type": "object",
    "required": [
     "month",
     "total",
     "departments"
    ]
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Austria: SPEI por Land (GeoSphere) y aguas subterraneas (BMLUK)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "lands",
  "austria",
  "history"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "lands": {
   "type": "object",
   "minProperties": 9
  },
  "austria": {
   "type": "object",
   "required": [
    "spei30",
    "spei90"
   ]
  },
  "history": {
   "type": "array",
   "minItems": 1
  }
 }
}

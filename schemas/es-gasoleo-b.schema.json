{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Espana: precio del gasoleo B (agricola) en las gasolineras por provincia (MITECO)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "asOf",
  "unit",
  "source",
  "latest",
  "provFields",
  "history"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "enum": [
    "EUR/l"
   ]
  },
  "latest": {
   "type": "object",
   "required": [
    "date",
    "b",
    "nb",
    "a",
    "provinces"
   ],
   "properties": {
    "b": {
     "type": "number",
     "minimum": 0.3,
     "maximum": 4
    },
    "nb": {
     "type": "integer",
     "minimum": 300
    },
    "provinces": {
     "type": "object",
     "minProperties": 40
    }
   }
  },
  "provFields": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4
  },
  "history": {
   "type": "object",
   "required": [
    "fields",
    "rows"
   ],
   "properties": {
    "rows": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  }
 }
}

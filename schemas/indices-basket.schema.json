{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "title": "Cesta de precios (data/indices/<region>/<cesta>.json)",
 "required": [
  "schemaVersion",
  "generatedAt",
  "id",
  "region",
  "basket",
  "name",
  "verdict",
  "basePeriod",
  "base",
  "weighting",
  "first",
  "last",
  "rows",
  "changeMoMPct",
  "members",
  "attribution",
  "methodology",
  "points"
 ],
 "properties": {
  "region": {
   "enum": [
    "us",
    "eu",
    "uk",
    "ca"
   ]
  },
  "verdict": {
   "enum": [
    "apto",
    "condiciones"
   ]
  },
  "base": {
   "type": "number"
  },
  "weighting": {
   "enum": [
    "equal"
   ]
  },
  "first": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$"
  },
  "last": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$"
  },
  "rows": {
   "type": "integer",
   "minimum": 24
  },
  "members": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "required": [
     "id",
     "product",
     "name",
     "weightPct",
     "unit",
     "currency",
     "frequency",
     "sourceName",
     "license",
     "verdict",
     "attribution"
    ],
    "properties": {
     "verdict": {
      "enum": [
       "apto",
       "condiciones"
      ]
     },
     "weightPct": {
      "type": "number"
     }
    }
   }
  },
  "attribution": {
   "type": "string",
   "minLength": 3
  },
  "points": {
   "type": "array",
   "minItems": 24,
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2
   }
  }
 }
}

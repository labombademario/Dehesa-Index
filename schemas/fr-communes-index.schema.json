{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Francia: indice del censo agrario 2020 por comuna",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "year",
  "communes",
  "ind",
  "regions"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "agreste_ra"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "year": {
   "type": "integer"
  },
  "communes": {
   "type": "integer",
   "minimum": 25000
  },
  "ind": {
   "type": "object",
   "minProperties": 14
  },
  "regions": {
   "type": "object",
   "minProperties": 13
  },
  "totals": {
   "type": "object"
  }
 }
}

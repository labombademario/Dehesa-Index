{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Francia: restricciones de agua por departamento (VigiEau)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "country",
  "source",
  "levels",
  "departments",
  "counts",
  "history",
  "notes"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "country": {
   "enum": [
    "FR"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url",
    "license"
   ],
   "properties": {
    "id": {
     "enum": [
      "vigieau"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "license": {
     "type": "string"
    }
   }
  },
  "levels": {
   "type": "array",
   "minItems": 4
  },
  "departments": {
   "type": "array",
   "minItems": 90
  },
  "counts": {
   "type": "object"
  },
  "history": {
   "type": "array",
   "minItems": 1
  },
  "notes": {
   "type": "object"
  }
 }
}

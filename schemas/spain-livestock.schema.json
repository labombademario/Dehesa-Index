{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Espana: efectivos de ganado por provincia (MAPA), una especie",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "species",
  "source",
  "units",
  "periods",
  "vars",
  "v"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "species": {
   "enum": [
    "bovino",
    "ovino",
    "caprino",
    "porcino"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "mapa_es"
     ]
    },
    "url": {
     "type": "string"
    }
   }
  },
  "units": {
   "enum": [
    "cabezas"
   ]
  },
  "periods": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-(05|11)$"
   }
  },
  "vars": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "src"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^\\d{2}$"
     },
     "src": {
      "type": "string"
     }
    }
   }
  },
  "v": {
   "type": "object",
   "minProperties": 51
  }
 }
}
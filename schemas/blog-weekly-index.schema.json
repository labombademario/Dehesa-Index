{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - indice de resumenes semanales del blog",
 "type": "object",
 "required": [
  "schemaVersion",
  "weeks",
  "generatedAt"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "weeks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "week",
     "from",
     "to",
     "complete",
     "items",
     "sources",
     "coverageFrom"
    ],
    "properties": {
     "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d\\d$"
     },
     "from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     },
     "to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     },
     "complete": {
      "type": "boolean"
     },
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "sources": {
      "type": "integer",
      "minimum": 1
     },
     "coverageFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
     }
    }
   }
  }
 }
}

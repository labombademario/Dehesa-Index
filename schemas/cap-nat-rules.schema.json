{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - PAC Francia/Italia/Polonia/Portugal/Belgica: reglas curadas",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "scheme",
  "status",
  "curated",
  "verifiedAt",
  "source",
  "note",
  "interventions",
  "rules",
  "calendar",
  "campaignOverrides",
  "i18n"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "country": {
   "enum": [
    "FR",
    "IT",
    "PL",
    "PT",
    "BE",
    "HR",
    "EL",
    "NL",
    "AT",
    "IE",
    "RO",
    "HU",
    "CZ",
    "SE",
    "FI",
    "SK",
    "SI",
    "EE",
    "BG",
    "LV"
   ]
  },
  "scheme": {
   "type": "string"
  },
  "status": {
   "enum": [
    "CURRENT"
   ]
  },
  "curated": {
   "type": "boolean"
  },
  "verifiedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "instrument",
    "ref",
    "url"
   ]
  },
  "interventions": {
   "type": "array",
   "minItems": 5
  },
  "rules": {
   "type": "array",
   "minItems": 8
  },
  "calendar": {
   "type": "array",
   "minItems": 0
  },
  "campaignOverrides": {
   "type": "array"
  },
  "i18n": {
   "type": "object",
   "required": [
    "note",
    "rules",
    "calendar",
    "overrides"
   ]
  }
 }
}

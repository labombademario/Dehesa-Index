{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Embalses de España uno a uno (MITECO, Boletín Hidrológico) con su ubicación (Wikidata)",
 "type": "object",
 "required": ["schemaVersion", "generatedAt", "asOf", "unit", "source", "coordsSource", "fields", "items"],
 "properties": {
  "schemaVersion": {"type": "integer"},
  "generatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
  "asOf": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "unit": {"type": "string", "enum": ["hm3"]},
  "source": {"type": "object", "required": ["name", "url"]},
  "coordsSource": {"type": "object", "required": ["name", "url", "license"]},
  "fields": {"type": "array", "minItems": 9, "maxItems": 9},
  "items": {"type": "array", "minItems": 300, "items": {"type": "array", "minItems": 9, "maxItems": 9}}
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Italia: severidad hidrica por distrito (ISPRA)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "levels",
  "districts",
  "history"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "levels": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4
  },
  "districts": {
   "type": "object",
   "minProperties": 7
  },
  "history": {
   "type": "array",
   "minItems": 1
  }
 }
}

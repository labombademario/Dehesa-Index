{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Polonia: avisos de sequia hidrologica (IMGW-PIB)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "asOf",
  "source",
  "voivodeships",
  "warnings",
  "history"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "voivodeships": {
   "type": "object",
   "minProperties": 16
  },
  "warnings": {
   "type": "array"
  },
  "history": {
   "type": "array",
   "minItems": 1
  }
 }
}

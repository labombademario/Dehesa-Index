{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Belgica: emisiones de gases de efecto invernadero de la agricultura (Eurostat, inventario nacional)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "unit",
  "source",
  "years",
  "agriculture",
  "national",
  "machinery",
  "byCategory",
  "bySpecies",
  "byGas"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "unit": {
   "type": "string",
   "enum": [
    "kt CO2-eq"
   ]
  },
  "years": {
   "type": "array",
   "minItems": 30,
   "items": {
    "type": "integer"
   }
  },
  "agriculture": {
   "type": "array",
   "minItems": 30
  },
  "national": {
   "type": "array",
   "minItems": 30
  },
  "machinery": {
   "type": "array",
   "minItems": 30
  },
  "byCategory": {
   "type": "object",
   "minProperties": 5
  },
  "bySpecies": {
   "type": "object",
   "minProperties": 4
  },
  "byGas": {
   "type": "object",
   "minProperties": 2
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - EE. UU.: indice del seguro por condado",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "years",
  "lastFullYear",
  "states",
  "counties"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "usda_rma"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "years": {
   "type": "array"
  },
  "lastFullYear": {
   "type": "integer"
  },
  "states": {
   "type": "object",
   "minProperties": 48
  },
  "counties": {
   "type": "integer",
   "minimum": 2500
  }
 }
}

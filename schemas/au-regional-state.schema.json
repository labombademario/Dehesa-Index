{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Australia: agricultura por municipio y SA4 (ABS)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "state",
  "items",
  "lga",
  "sa4"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "abs"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "state": {
   "type": "string",
   "pattern": "^[A-Z]{2,3}$"
  },
  "items": {
   "type": "object",
   "minProperties": 10
  },
  "lga": {
   "type": "object",
   "minProperties": 1
  },
  "sa4": {
   "type": "object",
   "minProperties": 1
  }
 }
}

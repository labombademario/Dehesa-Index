{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Polonia: gasoleo, fioul y devolucion de akcyza",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "asOf",
  "unit",
  "source",
  "fields",
  "weekly",
  "vat",
  "refund",
  "farmCostPLN"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "enum": [
    "EUR/l"
   ]
  },
  "fields": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5
  },
  "weekly": {
   "type": "array",
   "minItems": 500,
   "items": {
    "type": "array",
    "minItems": 5,
    "maxItems": 5
   }
  },
  "vat": {
   "type": "number"
  },
  "refund": {
   "type": "object",
   "required": [
    "zlPerLitre",
    "year",
    "act",
    "url"
   ]
  },
  "farmCostPLN": {
   "type": "number"
  }
 }
}

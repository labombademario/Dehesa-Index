{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Belgica (Flandes): nitrato en aguas superficiales de zonas agricolas (VMM)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "series"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{4}$"
  },
  "series": {
   "type": "array",
   "minItems": 15,
   "items": {
    "type": "array",
    "minItems": 3,
    "maxItems": 3
   }
  }
 }
}

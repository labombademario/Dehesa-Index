{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Italia: valor de la tierra por region (CREA)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "unit",
  "years",
  "regions",
  "macro",
  "italy",
  "source"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "unit": {
   "enum": [
    "EUR/ha"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "licence"
   ]
  },
  "years": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "integer",
    "minimum": 1960
   }
  },
  "regions": {
   "type": "object",
   "minProperties": 20
  },
  "macro": {
   "type": "object",
   "minProperties": 5
  },
  "italy": {
   "type": "array",
   "minItems": 10
  }
 }
}
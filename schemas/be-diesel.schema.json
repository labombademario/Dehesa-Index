{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Belgica: gasoleo agricola (tarifa oficial) y gasoleo/fioul semanales",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "unit",
  "vat",
  "daily",
  "weekly",
  "farmNoVat"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "pattern": "^EUR/l$"
  },
  "vat": {
   "type": "number"
  },
  "daily": {
   "type": "array",
   "minItems": 100,
   "items": {
    "type": "array",
    "minItems": 5,
    "maxItems": 5
   }
  },
  "weekly": {
   "type": "array",
   "minItems": 500,
   "items": {
    "type": "array",
    "minItems": 4,
    "maxItems": 4
   }
  },
  "farmNoVat": {
   "type": "number"
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "WASDE: libro acumulado de revisiones (data/us-markets/wasde-ledger.json)",
 "type": "object",
 "required": [
  "reports",
  "items"
 ],
 "properties": {
  "reports": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}$"
   }
  },
  "items": {
   "type": "object",
   "minProperties": 150
  }
 }
}

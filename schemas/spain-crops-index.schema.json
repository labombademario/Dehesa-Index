{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Espana: indice de los libros del MAPA leidos (superficies y producciones de cultivos)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "checkedAt",
  "source",
  "files",
  "groups"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "checkedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "mapa_es"
     ]
    },
    "url": {
     "type": "string"
    }
   }
  },
  "files": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "campaign",
     "file",
     "label",
     "mode",
     "groups",
     "bdRows",
     "bdUsed"
    ],
    "properties": {
     "campaign": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
     },
     "file": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "mode": {
      "enum": [
       "shared",
       "own"
      ]
     },
     "groups": {
      "type": "array",
      "minItems": 1
     },
     "bdRows": {
      "type": "integer",
      "minimum": 1
     },
     "bdUsed": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "groups": {
   "type": "object",
   "minProperties": 1,
   "additionalSchema": {
    "type": "object",
    "required": [
     "name",
     "file",
     "campaigns",
     "crops"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "file": {
      "type": "string",
      "pattern": "^crops-[a-z_]+\\.json$"
     },
     "campaigns": {
      "type": "array",
      "minItems": 1
     },
     "crops": {
      "type": "object"
     }
    }
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Países Bajos: nitrato en agua de lixiviación y zanjas (RIVM LMM), aguas subterráneas y balance de N (Eurostat)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "leaching",
  "ditch",
  "groundwater",
  "nBalance"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "leaching": {
   "type": "object"
  },
  "ditch": {
   "type": "object"
  },
  "groundwater": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2
   }
  },
  "nBalance": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2
   }
  }
 }
}

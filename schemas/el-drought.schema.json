{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Grecia: sequia por provincia (EDO CDI)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "classes",
  "periods",
  "counties"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "classes": {
   "type": "array",
   "minItems": 6,
   "maxItems": 6
  },
  "periods": {
   "type": "array",
   "minItems": 30,
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   }
  },
  "counties": {
   "type": "object"
  }
 }
}

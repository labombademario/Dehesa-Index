{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Polonia: censo agrario 2020 por municipio (gmina), un fichero por voivodia",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "voivodeship",
  "year",
  "gminy"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "gus_poland"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "voivodeship": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "year": {
   "type": "integer"
  },
  "gminy": {
   "type": "object",
   "minProperties": 1
  }
 }
}

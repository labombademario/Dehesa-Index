{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Alemania: indice del censo agrario por Land",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "years",
  "units",
  "lands",
  "tables"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "destatis"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "years": {
   "type": "array",
   "minItems": 3
  },
  "units": {
   "type": "object",
   "minProperties": 3
  },
  "lands": {
   "type": "array",
   "minItems": 16,
   "maxItems": 16
  },
  "tables": {
   "type": "object",
   "minProperties": 3
  }
 }
}

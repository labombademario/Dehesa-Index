{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Canada: desembarques comerciales de pesca marina por provincia y especie (DFO, 1990-ultimo ano)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "units",
  "years",
  "provinces",
  "species",
  "totals",
  "landings",
  "suppressed"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url",
    "license"
   ],
   "properties": {
    "id": {
     "enum": [
      "dfo_landings"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://open\\.canada\\.ca/"
    },
    "license": {
     "type": "string"
    }
   }
  },
  "units": {
   "type": "object"
  },
  "years": {
   "type": "array",
   "items": {
    "type": "integer"
   },
   "minItems": 20
  },
  "provinces": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 8,
   "maxItems": 8
  },
  "species": {
   "type": "array",
   "minItems": 20,
   "items": {
    "type": "object",
    "required": [
     "key",
     "name",
     "group"
    ],
    "properties": {
     "key": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "group": {
      "enum": [
       "groundfish",
       "pelagics",
       "shellfish",
       "other"
      ]
     }
    }
   }
  },
  "totals": {
   "type": "object"
  },
  "landings": {
   "type": "object"
  },
  "suppressed": {
   "type": "array"
  }
 }
}

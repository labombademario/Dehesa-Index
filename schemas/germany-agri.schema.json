{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Alemania: produccion agricola por Bundesland, precios de la tierra y alquileres (Destatis GENESIS)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "crops",
  "lastHarvestYear",
  "production",
  "landPrice",
  "rent"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "license": {
     "enum": [
      "Datenlizenz Deutschland – Namensnennung 2.0"
     ]
    },
    "tables": {
     "type": "array",
     "minItems": 9
    }
   }
  },
  "crops": {
   "type": "array",
   "minItems": 12,
   "items": {
    "type": "object",
    "required": [
     "k",
     "de"
    ],
    "properties": {
     "k": {
      "type": "string"
     },
     "de": {
      "type": "string"
     }
    }
   }
  },
  "lastHarvestYear": {
   "type": "integer",
   "minimum": 2020,
   "maximum": 2100
  },
  "production": {
   "type": "object",
   "required": [
    "nat",
    "land"
   ],
   "properties": {
    "nat": {
     "type": "object",
     "minProperties": 12
    },
    "land": {
     "type": "object",
     "minProperties": 12
    }
   }
  },
  "landPrice": {
   "type": "object",
   "required": [
    "nat",
    "natPre",
    "land"
   ],
   "properties": {
    "nat": {
     "type": "object",
     "minProperties": 3
    },
    "natPre": {
     "type": "array",
     "minItems": 25
    },
    "land": {
     "type": "object",
     "minProperties": 14
    }
   }
  },
  "rent": {
   "type": "object",
   "required": [
    "nat",
    "land"
   ],
   "properties": {
    "nat": {
     "type": "object",
     "minProperties": 3
    },
    "land": {
     "type": "object",
     "minProperties": 14
    }
   }
  }
 }
}

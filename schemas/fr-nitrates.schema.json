{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Francia: nitratos en aguas subterraneas por departamento (ADES, Hub'Eau)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "unit",
  "source",
  "deptFields",
  "deptNames",
  "years"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "unit": {
   "type": "string",
   "enum": [
    "mg/l NO3"
   ]
  },
  "deptFields": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4
  },
  "deptNames": {
   "type": "object",
   "minProperties": 60
  },
  "years": {
   "type": "array",
   "minItems": 5,
   "items": {
    "type": "object",
    "required": [
     "year",
     "points",
     "median",
     "over25",
     "over50",
     "departments"
    ]
   }
  }
 }
}

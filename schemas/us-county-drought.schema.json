{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - EE. UU.: sequia por condado (U.S. Drought Monitor)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "state",
  "weeks",
  "counties"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "us_drought_monitor"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "state": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "unit": {
   "type": "string"
  },
  "categories": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "weeks": {
   "type": "array",
   "minItems": 40,
   "maxItems": 60,
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   }
  },
  "counties": {
   "type": "object",
   "minProperties": 1
  }
 }
}

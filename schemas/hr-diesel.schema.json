{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Croacia: precios maximos oficiales del gasoleo y gasoleo azul (Vlada) y gasoleo semanal de la UE",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "asOf",
  "unit",
  "vat",
  "official",
  "weekly"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "unit": {
   "type": "string",
   "pattern": "^EUR/l$"
  },
  "vat": {
   "type": "number"
  },
  "official": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "array",
    "minItems": 6,
    "maxItems": 6
   }
  },
  "weekly": {
   "type": "array",
   "minItems": 500,
   "items": {
    "type": "array",
    "minItems": 4,
    "maxItems": 4
   }
  }
 }
}

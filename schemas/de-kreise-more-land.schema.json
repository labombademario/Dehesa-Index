{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Alemania: censo agrario por distrito: rendimientos, bovinos, empleo agrario e historico 1999-2007, un fichero por Land",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "land",
  "years",
  "kreise"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "destatis"
     ]
    },
    "url": {
     "type": "string",
     "minLength": 8
    }
   }
  },
  "years": {
   "type": "object",
   "minProperties": 5
  },
  "land": {
   "type": "string",
   "pattern": "^[A-Z]{2}$"
  },
  "kreise": {
   "type": "object",
   "minProperties": 1
  }
 }
}
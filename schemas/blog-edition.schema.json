{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - edicion semanal del blog (borrador editorial derivado del resumen)",
 "type": "object",
 "required": [
  "schemaVersion",
  "week",
  "from",
  "to",
  "status",
  "canonicalUrl",
  "editorial",
  "distribution",
  "derivedFrom",
  "languages",
  "sources"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "week": {
   "type": "string",
   "pattern": "^\\d{4}-W\\d{2}$"
  },
  "status": {
   "enum": [
    "DRAFT",
    "APPROVED",
    "PUBLISHED"
   ]
  },
  "canonicalUrl": {
   "type": "string",
   "pattern": "^https://dehesaindex\\.com/blog\\.html#\\d{4}-W\\d{2}$"
  },
  "editorial": {
   "type": "object",
   "required": [
    "reviewedBy",
    "reviewedAt"
   ]
  },
  "distribution": {
   "type": "object",
   "required": [
    "substack"
   ],
   "properties": {
    "substack": {
     "type": "object",
     "required": [
      "state",
      "url"
     ],
     "properties": {
      "state": {
       "enum": [
        "NOT_PUBLISHED",
        "PUBLISHED"
       ]
      }
     }
    }
   }
  },
  "languages": {
   "type": "object",
   "required": [
    "es",
    "en",
    "fr",
    "it"
   ]
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "source",
     "headline",
     "url"
    ]
   }
  }
 }
}

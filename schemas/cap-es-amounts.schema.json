{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - PAC España: importes planificados, mínimos y máximos del RD 1048/2022 (BOE)",
 "type": "object",
 "required": [
  "schemaVersion",
  "country",
  "scheme",
  "status",
  "kind",
  "campaigns",
  "source",
  "allocations",
  "regions",
  "ecoschemes",
  "ecoschemeBudget",
  "degressivity",
  "associatedAid",
  "discrepancies",
  "notes",
  "verifiedAt",
  "changes"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "country": {
   "enum": [
    "ES"
   ]
  },
  "scheme": {
   "type": "string"
  },
  "status": {
   "enum": [
    "CURRENT",
    "PROPOSED",
    "SUPERSEDED"
   ]
  },
  "kind": {
   "enum": [
    "RD_PLANNED_MIN_MAX"
   ]
  },
  "campaigns": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "instrument",
    "boeRef",
    "url",
    "pdfUrl",
    "consolidated",
    "consolidatedAt"
   ],
   "properties": {
    "id": {
     "enum": [
      "boe_es"
     ]
    },
    "instrument": {
     "type": "string"
    },
    "boeRef": {
     "enum": [
      "BOE-A-2022-23048"
     ]
    },
    "url": {
     "type": "string",
     "pattern": "^https://www\\.boe\\.es/"
    },
    "pdfUrl": {
     "type": "string",
     "pattern": "^https://www\\.boe\\.es/"
    },
    "consolidated": {
     "type": "boolean"
    },
    "consolidatedAt": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
   }
  },
  "allocations": {
   "type": "object",
   "required": [
    "abrs",
    "redistributive",
    "young",
    "youngWomen"
   ],
   "properties": {
    "abrs": {
     "type": "array",
     "minItems": 5,
     "maxItems": 5
    },
    "redistributive": {
     "type": "array",
     "minItems": 5,
     "maxItems": 5
    },
    "young": {
     "type": "array",
     "minItems": 5,
     "maxItems": 5
    },
    "youngWomen": {
     "type": "array",
     "minItems": 5,
     "maxItems": 5
    }
   }
  },
  "regions": {
   "type": "object",
   "minProperties": 20,
   "additionalSchema": {
    "type": "object",
    "required": [
     "abrs",
     "redistributiveTiers",
     "young",
     "youngWomen",
     "allocation"
    ],
    "properties": {
     "abrs": {
      "type": "object",
      "required": [
       "planned",
       "min",
       "max"
      ],
      "properties": {
       "planned": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "min": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "max": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       }
      }
     },
     "young": {
      "type": "object",
      "required": [
       "planned",
       "min",
       "max"
      ],
      "properties": {
       "planned": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "min": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "max": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       }
      }
     },
     "youngWomen": {
      "type": "object",
      "required": [
       "planned",
       "min",
       "max"
      ],
      "properties": {
       "planned": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "min": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "max": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       }
      }
     },
     "redistributiveTiers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "object",
       "required": [
        "fromHa",
        "toHa",
        "annexVIIIAmount",
        "planned",
        "min",
        "max"
       ],
       "properties": {
        "fromHa": {
         "type": "number",
         "minimum": 0
        },
        "toHa": {
         "type": "number",
         "minimum": 0
        },
        "annexVIIIAmount": {
         "type": "number",
         "minimum": 0
        },
        "planned": {
         "type": "array",
         "minItems": 5,
         "maxItems": 5
        },
        "min": {
         "type": "array",
         "minItems": 5,
         "maxItems": 5
        },
        "max": {
         "type": "array",
         "minItems": 5,
         "maxItems": 5
        }
       }
      }
     },
     "allocation": {
      "type": "object",
      "required": [
       "abrs",
       "redistributive",
       "young"
      ],
      "properties": {
       "abrs": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "redistributive": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       },
       "young": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5
       }
      }
     }
    }
   }
  },
  "ecoschemes": {
   "type": "array",
   "minItems": 30,
   "items": {
    "type": "object",
    "required": [
     "id",
     "scheme",
     "practice",
     "surfaceType",
     "territory",
     "label",
     "planned",
     "min",
     "max"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^eco-[a-i]-"
     },
     "scheme": {
      "enum": [
       "a",
       "b",
       "c",
       "d",
       "e",
       "f",
       "g",
       "h",
       "i"
      ]
     },
     "practice": {
      "type": "string",
      "minLength": 3
     },
     "surfaceType": {
      "type": "string",
      "minLength": 3
     },
     "territory": {
      "enum": [
       "peninsula",
       "insular",
       "baleares"
      ]
     },
     "label": {
      "type": "string",
      "minLength": 5
     },
     "planned": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     },
     "min": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     },
     "max": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  },
  "ecoschemeBudget": {
   "type": "array",
   "minItems": 10,
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "scheme",
     "label",
     "amount"
    ],
    "properties": {
     "scheme": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "amount": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  },
  "degressivity": {
   "type": "array",
   "minItems": 8,
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "surfaceType",
     "label",
     "thresholdHa"
    ],
    "properties": {
     "surfaceType": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "thresholdHa": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "associatedAid": {
   "type": "array",
   "minItems": 30,
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "kind",
     "unit",
     "min",
     "max"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^asoc-"
     },
     "label": {
      "type": "string",
      "minLength": 5
     },
     "kind": {
      "enum": [
       "crop",
       "livestock"
      ]
     },
     "unit": {
      "enum": [
       "EUR/ha",
       "EUR/animal"
      ]
     },
     "min": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     },
     "max": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
     }
    }
   }
  },
  "discrepancies": {
   "type": "array"
  },
  "notes": {
   "type": "array",
   "minItems": 1
  },
  "verifiedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "changes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "detectedAt",
     "summary"
    ],
    "properties": {
     "detectedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "summary": {
      "type": "string",
      "minLength": 5
     }
    }
   }
  }
 }
}

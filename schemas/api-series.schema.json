{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "API v1: serie (data/api/v1/series/<region>/<producto>.json)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "first",
  "last",
  "rows",
  "points",
  "id",
  "product",
  "region",
  "unit",
  "currency",
  "frequency",
  "sourceName",
  "license",
  "verdict",
  "attribution"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^(us|eu|uk|ca)/[a-z0-9_]+$"
  },
  "region": {
   "enum": [
    "us",
    "eu",
    "uk",
    "ca"
   ]
  },
  "verdict": {
   "enum": [
    "apto",
    "condiciones"
   ]
  },
  "attribution": {
   "type": "string",
   "minLength": 3
  },
  "license": {
   "type": "string",
   "minLength": 1
  },
  "rows": {
   "type": "integer",
   "minimum": 1
  },
  "points": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2
   }
  }
 }
}

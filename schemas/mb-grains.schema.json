{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Dehesa Index - Manitoba: granos y oleaginosas semanales y mensuales (precio neto en el elevador de Winnipeg, Manitoba Agriculture)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "unit",
  "crops",
  "disputed",
  "weeks",
  "monthly"
 ],
 "properties": {
  "schemaVersion": {
   "type": [
    "integer",
    "string"
   ]
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "id",
    "name",
    "url"
   ],
   "properties": {
    "id": {
     "enum": [
      "mb_agri"
     ]
    },
    "name": {
     "type": "string"
    },
    "url": {
     "type": "string",
     "pattern": "^https://www\\.gov\\.mb\\.ca/"
    }
   }
  },
  "disputed": {
   "type": "array"
  },
  "weeks": {
   "type": "object",
   "minProperties": 1,
   "additionalSchema": {
    "type": "array",
    "minItems": 12,
    "maxItems": 12
   }
  },
  "unit": {
   "enum": [
    "C$/t"
   ]
  },
  "crops": {
   "type": "array",
   "minItems": 12,
   "maxItems": 12
  },
  "monthly": {
   "type": "object",
   "minProperties": 12
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Argentina: cultivos extensivos por provincia (MAGyP, Estimaciones agricolas)",
 "type": "object",
 "required": [
  "schemaVersion",
  "generatedAt",
  "source",
  "fields",
  "campaigns",
  "lastCampaign",
  "national",
  "provinces"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
  },
  "source": {
   "type": "object",
   "required": [
    "name",
    "url",
    "license"
   ]
  },
  "fields": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4
  },
  "campaigns": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "string",
    "pattern": "^\\d{4}/\\d{4}$"
   }
  },
  "lastCampaign": {
   "type": "string",
   "pattern": "^\\d{4}/\\d{4}$"
  },
  "national": {
   "type": "object",
   "minProperties": 5
  },
  "provinces": {
   "type": "object",
   "minProperties": 14
  }
 }
}

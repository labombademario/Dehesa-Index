{"openapi":"3.1.0","info":{"title":"Dehesa Index Data API","version":"v1","description":"Only sources whose commercial verdict is fit or fit with conditions. Every series carries its source, licence and attribution text: quote it when reusing. No estimates and no gap filling. Static JSON files: no key, no rate limit beyond the CDN; be reasonable and cache.","license":{"name":"Per source: see each series","url":"https://dehesaindex.com/condiciones"}},"servers":[{"url":"https://dehesaindex.com"}],"paths":{"/data/api/v1/index.json":{"get":{"operationId":"listSeries","summary":"Catalogue of series with source, licence and attribution","responses":{"200":{"description":"Catalogue","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Index"}}}}}}},"/data/api/v1/latest.json":{"get":{"operationId":"latestAll","summary":"Latest value, previous value and change of every series","responses":{"200":{"description":"Latest values","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Latest"}}}}}}},"/data/api/v1/water/index.json":{"get":{"operationId":"waterCatalogue","summary":"Catalogue of river and drought datasets with source, licence and attribution","responses":{"200":{"description":"Water catalogue","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/data/api/v1/water/rivers/{country}.json":{"get":{"operationId":"getRivers","summary":"River stations of one country: latest level and discharge, state, percentile against history and 30 days of daily points","parameters":[{"name":"country","in":"path","required":true,"description":"Country","schema":{"type":"string","enum":["de","nl","fr","be","ca","us"]}}],"responses":{"200":{"description":"River stations","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/data/api/v1/water/drought/eu.json":{"get":{"operationId":"getDroughtEu","summary":"European Drought Observatory Combined Drought Indicator by country: share of the area in each class, last 13 periods","responses"